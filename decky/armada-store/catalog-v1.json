    {
      "id": "droiddeck-proton",
      "name": "DroidDeck Proton",
      "summary": "GE-Proton for ARM64 with Valve bleeding-edge Wine and DroidDeck fixes",
      "category": "proton",
      "icon": "https://avatars.githubusercontent.com/u/333418672?v=4",
      "install": {
        "type": "proton",
        "releases": "https://api.github.com/repos/Droid-Deck/DroidDeck-Proton/releases?per_page=20",
