+    #[tokio::test]
+    async fn restore_host_charge_limit_power_supply() {
+        let handle = testing::start();
+        let battery = path(POWER_SUPPLY_PATHS[0]).join("battery");
+        create_dir_all(&battery).await.unwrap();
+        write(battery.join("type"), "Battery\n").await.unwrap();
+        write(battery.join(SB_LIMIT_PATH), "100\n").await.unwrap();
+
+        for (method, expected) in [
+            (BatteryChargeLimitMethod::PowerSupply, 100),
+            (BatteryChargeLimitMethod::HostPowerSupply, 80),
+        ] {
+            handle
+                .test
+                .set_device_config(DeviceConfig {
+                    battery_charge_limit: Some(BatteryChargeLimitConfig {
+                        suggested_minimum_limit: 55,
+                        method,
+                    }),
+                    ..DeviceConfig::default()
+                })
+                .await;
+
+            restore_host_charge_limit(80).await.unwrap();
+            assert_eq!(get_max_charge_level().await.unwrap(), expected);
+        }
+    }
+
+    #[tokio::test]
+    async fn restore_host_charge_limit_waits_for_sysfs() {
+        let handle = testing::start();
+        handle
+            .test
+            .set_device_config(DeviceConfig {
+                battery_charge_limit: Some(BatteryChargeLimitConfig {
+                    suggested_minimum_limit: 55,
+                    method: BatteryChargeLimitMethod::HostPowerSupply,
+                }),
+                ..DeviceConfig::default()
+            })
+            .await;
+        let battery = path(POWER_SUPPLY_PATHS[0]).join("battery");
+        assert!(!try_exists(&battery).await.unwrap());
+        let appear = async {
+            sleep(Duration::from_millis(200)).await;
+            create_dir_all(&battery).await.unwrap();
+            write(battery.join("type"), "Battery\n").await.unwrap();
+            write(battery.join(SB_LIMIT_PATH), "100\n").await.unwrap();
+        };
+        let (restored, ()) = tokio::join!(restore_host_charge_limit(80), appear);
+        restored.unwrap();
+        assert_eq!(get_max_charge_level().await.unwrap(), 80);
+
+        let threshold = battery.join(SB_LIMIT_PATH);
+        fs::remove_file(&threshold).await.unwrap();
+        let err = restore_host_charge_limit(80).await.unwrap_err();
+        assert!(err.to_string().contains("did not become available"));
+        assert!(!try_exists(&threshold).await.unwrap());
+    }
