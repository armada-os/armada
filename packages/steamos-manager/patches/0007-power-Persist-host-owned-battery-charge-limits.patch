+pub(crate) async fn host_charge_limit_configured() -> Result<bool> {
+    let config = device_config().await?;
+    Ok(config
+        .as_ref()
+        .and_then(|config| config.battery_charge_limit.as_ref())
+        .is_some_and(|config| matches!(config.method, BatteryChargeLimitMethod::HostPowerSupply)))
+}
+
+pub(crate) async fn restore_host_charge_limit(limit: i32) -> Result<()> {
+    if !host_charge_limit_configured().await? {
+        return Ok(());
+    }
+    ensure!((1..=100).contains(&limit), "Invalid saved charge limit");
+    let path = tokio::time::timeout(Duration::from_secs(5), async {
+        loop {
+            match find_battery_charge_path().await {
+                Err(err)
+                    if err
+                        .downcast_ref::<std::io::Error>()
+                        .is_some_and(|err| err.kind() == ErrorKind::NotFound) =>
+                {
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                }
+                result => return result,
+            }
+        }
+    })
+    .await
+    .map_err(|_| anyhow!("Battery charge limit did not become available during startup"))??;
+    let mut file = fs::OpenOptions::new()
+        .write(true)
+        .truncate(true)
+        .open(path)
+        .await?;
+    file.write_all(limit.to_string().as_bytes()).await?;
+    file.sync_data().await?;
+    Ok(())
+}
+
 pub(crate) async fn get_max_charge_level() -> Result<i32> {
     let path = find_battery_charge_path().await?;
     parse_max_charge_level(read_to_string(path).await)
@@ -1712,6 +1755,66 @@ pub(crate) mod test {
