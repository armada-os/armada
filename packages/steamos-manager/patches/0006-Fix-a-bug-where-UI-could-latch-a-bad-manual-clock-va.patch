From 1de72d1cfc0fc8deb3792a874d2e298304273677 Mon Sep 17 00:00:00 2001
From: Matthieu Bucchianeri <mbucchia@valvesoftware.com>
Date: Tue, 28 Jul 2026 18:23:04 -0700
Subject: [PATCH] Fix a bug where UI could latch a bad manual clock value.

---
 steamos-manager/src/gpu.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/steamos-manager/src/gpu.rs b/steamos-manager/src/gpu.rs
index 39f3b8e..66c5d23 100644
--- a/steamos-manager/src/gpu.rs
+++ b/steamos-manager/src/gpu.rs
@@ -762,10 +762,10 @@ impl GpuPerformanceLevelDriver for DevfreqGpuPerformanceLevelDriver {
     }
 
     async fn set_clocks(&mut self, clocks: u32) -> Result<()> {
-        self.manual_clocks = Some(clocks);
         if self.level == DevfreqPerformanceLevel::Auto {
             return Ok(());
         }
+        self.manual_clocks = Some(clocks);
 
         let cur = self.get_clocks().await?;
         let out = clocks * 1_000_000u32;
-- 
2.56.0

