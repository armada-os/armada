#!/bin/bash
# Apply the packaged OpenABL over copies the hash catalog recognizes as ROCKNIX
# or older OpenABL, or that a booted OpenABL vouches for with an older version.
set -euo pipefail

target_root=/
SPLASH=${SPLASH:-/usr/libexec/armada/armada-splash-progress}
ABL_VERSION_TOOL=${ABL_VERSION_TOOL:-/usr/libexec/openabl-updater/abl-version}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --target-root) shift; target_root=${1:?target root required} ;;
        *) echo "armada-abl-update: unknown argument: $1" >&2; exit 2 ;;
    esac
    shift
done

manifest="${target_root%/}/usr/lib/openabl-updater/manifest"
manifest_get() {
    sed -n "s/^$1=//p" "${manifest}" | head -1
}
is_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
is_version() { [[ "$1" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; }
version_is_older() {
    [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1)" = "$1" ]
}
abl_releases=${ARMADA_ABL_RELEASES:-"${target_root%/}/usr/lib/openabl-updater/legacy-releases.tsv"}
abl_identity() {
    ARMADA_ABL_RELEASES="${abl_releases}" python3 "${ABL_VERSION_TOOL}" --with-soc "$1"
}

[ -r "${manifest}" ] || { echo "armada-abl-update: target has no ABL manifest" >&2; exit 7; }
testing=${ARMADA_ABL_TESTING:-0}
if [ "${testing}" = 1 ]; then
    device_id=${ARMADA_ABL_DEVICE_ID:?test device id required}
    soc=${ARMADA_ABL_SOC:?test SoC required}
else
    eval "$(/usr/libexec/armada/device-env)"
    device_id=${ARMADA_DEVICE_ID:-}
    soc=${ARMADA_SOC_CLASS:-}
fi
[ -n "${device_id}" ] && [ "${device_id}" != unknown ] || {
    echo "armada-abl-update: device is not recognized by Armada" >&2; exit 7;
}
case "${soc}" in SM8250|SM8550|SM8650|SM8750) ;; *)
    echo "armada-abl-update: unsupported SoC '${soc:-unknown}'" >&2; exit 7 ;;
esac

soc_id=$(cat "${ARMADA_ABL_SOC_ID_PATH:-/sys/devices/soc0/soc_id}" 2>/dev/null || true)
case "${soc_id}" in
    356) soc_id_class=SM8250 ;;
    601|603) soc_id_class=SM8550 ;;
    682) soc_id_class=SM8650 ;;
    639|706) soc_id_class=SM8750 ;;
    *) soc_id_class="" ;;
esac
[ "${soc_id_class}" = "${soc}" ] || {
    echo "armada-abl-update: SoC id '${soc_id:-unknown}' does not confirm ${soc}" >&2
    exit 7
}

target_hash=$(manifest_get "ARMADA_ABL_SHA256_${soc}")
target_name=$(manifest_get ARMADA_ABL_NAME)
version=$(manifest_get ARMADA_ABL_VERSION)
payload="${target_root%/}/usr/lib/openabl-updater/abl_signed-${soc}.elf"
is_sha256 "${target_hash}" && [ -s "${payload}" ] || {
    echo "armada-abl-update: invalid target payload metadata" >&2; exit 7;
}
[ "$(sha256sum "${payload}" | cut -d' ' -f1)" = "${target_hash}" ] || {
    echo "armada-abl-update: target payload hash mismatch" >&2; exit 7;
}
[ "${target_name}" = OpenABL ] && is_version "${version}" || {
    echo "armada-abl-update: invalid target '${target_name:-unknown} ${version}'" >&2; exit 7;
}
target_version=${version}
payload_size=$(stat -c %s "${payload}")

if [ "${testing}" = 1 ]; then
    abl_a=${ARMADA_ABL_A:?test abl_a required}
    abl_b=${ARMADA_ABL_B:?test abl_b required}
else
    abl_a=/dev/disk/by-partlabel/abl_a
    abl_b=/dev/disk/by-partlabel/abl_b
fi
part_a=$(readlink -f "${abl_a}" 2>/dev/null || true)
part_b=$(readlink -f "${abl_b}" 2>/dev/null || true)
[ -n "${part_a}" ] && [ -n "${part_b}" ] && [ "${part_a}" != "${part_b}" ] || {
    echo "armada-abl-update: ABL partitions are missing or ambiguous" >&2; exit 7;
}
if [ "${testing}" != 1 ]; then
    [ -b "${part_a}" ] && [ -b "${part_b}" ] || { echo "armada-abl-update: ABL targets are not block devices" >&2; exit 7; }
    [ "$(lsblk -ndo PKNAME "${part_a}")" = "$(lsblk -ndo PKNAME "${part_b}")" ] || {
        echo "armada-abl-update: ABL partitions are not on the same device" >&2; exit 7;
    }
fi
part_size() { if [ "${testing}" = 1 ]; then stat -c %s "$1"; else blockdev --getsize64 "$1"; fi; }
[ "$(part_size "${part_a}")" -ge "${payload_size}" ] && [ "$(part_size "${part_b}")" -ge "${payload_size}" ] || {
    echo "armada-abl-update: target payload is larger than an ABL partition" >&2; exit 7;
}
prefix_hash() { head -c "${payload_size}" "$1" | sha256sum | cut -d' ' -f1; }
hash_a=$(prefix_hash "${part_a}")
hash_b=$(prefix_hash "${part_b}")

if [ "${hash_a}" = "${target_hash}" ] && [ "${hash_b}" = "${target_hash}" ]; then
    echo "armada-abl-update: OpenABL ${version} already installed"
    exit 0
fi

unknown_copies=()
check_installed() {
    local name=$1 part=$2 hash=$3 identity installed_name installed installed_soc
    [ "${hash}" = "${target_hash}" ] && return 0
    identity=$(abl_identity "${part}" 2>/dev/null) || { unknown_copies+=("${name}"); return 0; }
    read -r installed_name installed installed_soc <<<"${identity}"
    [ "${installed_soc}" = "${soc}" ] || {
        echo "armada-abl-update: ${name} is ${installed_name} ${installed} for ${installed_soc}, expected ${soc}; refusing to overwrite" >&2
        exit 7
    }
    if [ "${installed_name}" = ROCKNIX ]; then
        echo "armada-abl-update: ${name} ROCKNIX ${installed} is eligible for OpenABL ${target_version}"
        return 0
    fi
    if [ "${installed}" = "${target_version}" ]; then
        echo "armada-abl-update: ${name} reports OpenABL ${installed} but differs from the approved payload" >&2
        exit 7
    fi
    version_is_older "${installed}" "${target_version}" || {
        echo "armada-abl-update: ${name} OpenABL ${installed} is newer than target ${target_version}" >&2
        exit 7
    }
    echo "armada-abl-update: ${name} OpenABL ${installed} is eligible for ${target_version}"
}
check_installed abl_a "${part_a}" "${hash_a}"
check_installed abl_b "${part_b}" "${hash_b}"

# Unlisted copies go by the booted OpenABL's version. The same version with
# other bytes is a custom or CI build, so leave it like a newer one.
if [ "${#unknown_copies[@]}" -gt 0 ]; then
    running=$(python3 "${ABL_VERSION_TOOL}" --firmware 2>/dev/null) || running=""
    read -r running_name running_version <<<"${running:-}"
    [ "${running_name:-}" = OpenABL ] && is_version "${running_version:-}" || {
        echo "armada-abl-update: ${unknown_copies[*]}: not a recognized ROCKNIX or OpenABL image" >&2
        exit 7
    }
    version_is_older "${running_version}" "${target_version}" || {
        echo "armada-abl-update: booted OpenABL ${running_version} is not older than ${target_version}; leaving it"
        exit 0
    }
    echo "armada-abl-update: booted OpenABL ${running_version}; replacing ${unknown_copies[*]} with ${target_version}"
fi

lock=${ARMADA_ABL_LOCK:-/run/armada-abl.lock}
exec 9>"${lock}"
flock -n 9 || { echo "armada-abl-update: another ABL update is running" >&2; exit 7; }
"${SPLASH}" "Updating bootloader. Do not power off." || true

write_failed() {
    echo "armada-abl-update: $*" >&2
    "${SPLASH}" --error "Bootloader update failed. Recovery may be required." || true
    return 1
}
write_one() {
    local part=$1 sector=512
    [ "$(prefix_hash "${part}")" = "${target_hash}" ] && return 0
    [ "${testing}" = 1 ] || sector=$(blockdev --getss "${part}")
    dd if="${payload}" of="${part}" bs="${sector}" conv=fsync,notrunc status=none ||
        write_failed "write failed for ${part}"
    [ "${testing}" = 1 ] || blockdev --flushbufs "${part}" ||
        write_failed "cache flush failed for ${part}"
    [ "$(prefix_hash "${part}")" = "${target_hash}" ] ||
        write_failed "readback failed for ${part}"
}

# ROCKNIX uses this fixed order; Armada adds a flush and readback between copies.
write_one "${part_a}"
write_one "${part_b}"
sync
echo "armada-abl-update: installed OpenABL ${version} for ${device_id} (${soc})"
