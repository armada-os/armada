# Dated image just BEFORE GUEST_SNAPSHOT: a newer image downgrading to the
# snapshot trips package-split file conflicts and keyring-rejected signatures.
GUEST_BUILDER_IMAGE=docker.io/library/archlinux:base-devel-20260809.0.570793

# Arch Archive snapshot matching the FEX guest rootfs pinned in the armada
# image build (rootfs.fex-emu.gg/ArchLinux/2026-08-11); keeps toolchain and
# glibc at the rootfs date. Bump together with the rootfs pin.
GUEST_SNAPSHOT=2026/08/11
