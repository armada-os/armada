From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: thor: hall wake, touch orientation, DPU dithering

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -5,6 +5,7 @@
 
 /dts-v1/;
 
+#include <dt-bindings/input/gpio-keys.h>
 #include "qcs8550-ayn-common.dtsi"
 
 / {
@@ -30,6 +31,8 @@
 
 	gpio-keys-lid {
 		compatible = "gpio-keys";
+		pinctrl-0 = <&hall_lid_n>;
+		pinctrl-names = "default";
 
 		hall-lid-sensor {
 			label = "Hall Lid Sensor";
@@ -37,6 +40,7 @@
 			linux,input-type = <EV_SW>;
 			linux,code = <SW_LID>;
 			linux,can-disable;
+			wakeup-event-action = <EV_ACT_DEASSERTED>;
 			wakeup-source;
 		};
 	};
@@ -167,6 +171,9 @@
 &display_panel {
 	compatible = "chipone,icna3520";
 
+	/* 8bpc DSI link; dither the DPU 10-bit downconvert to hide banding */
+	armada,dpu-8bpc-dither;
+
 	pinctrl-0 = <&dsi_s_rst_active>, <&dsi_s_te_active>;
 	pinctrl-1 = <&dsi_s_rst_suspend>, <&dsi_s_te_suspend>;
 	pinctrl-names = "default", "sleep";
@@ -275,8 +282,6 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1920>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "top_touchscreen";
 	};
@@ -393,8 +398,6 @@
 
 		touchscreen-size-x = <1080>;
 		touchscreen-size-y = <1240>;
-		touchscreen-swapped-x-y;
-		touchscreen-inverted-x;
 
 		label = "bottom_touchscreen";
 
@@ -451,6 +454,15 @@
 		function = "gpio";
 		bias-pull-up;
 		output-disable;
+	};
+
+	/* Open-drain hall output: with no pull-up the released (lid open)
+	   level is undefined. */
+	hall_lid_n: hall-lid-n-state {
+		pins = "gpio17";
+		function = "gpio";
+		bias-pull-up;
+		output-disable;
 	};
 };
 

From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: ayn-thor: ignore power key with the lid closed

Point the PON power key at the hall lid switch so presses while
suspended with the lid closed do not wake the device.

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -34,7 +34,7 @@
 		pinctrl-0 = <&hall_lid_n>;
 		pinctrl-names = "default";
 
-		hall-lid-sensor {
+		lid_switch: hall-lid-sensor {
 			label = "Hall Lid Sensor";
 			gpios = <&tlmm 17 GPIO_ACTIVE_LOW>;
 			linux,input-type = <EV_SW>;
@@ -479,3 +479,8 @@
 &spk_amp_r {
 	firmware-name = "qcom/sm8550/ayn/thor/aw883xx_acf.bin";
 };
+
+&pon_pwrkey {
+	/* Ignore presses while suspended with the lid closed. */
+	lid-switch = <&lid_switch>;
+};

From: cerroverb <84094990+cerroverb@users.noreply.github.com>
Subject: [PATCH] arm64: dts: qcom: ayn-thor: run the gamepad MCU at its maximum report rate

report-period 0 (rsinput patch 1309) takes the Thor gamepad from about 167
to about 215 reports per second. The Thor UART line still goes idle between
frames at that rate, so it needs no shorter RX DMA transfer.

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-thor.dts
@@ -484,3 +484,11 @@
 	/* Ignore presses while suspended with the lid closed. */
 	lid-switch = <&lid_switch>;
 };
+
+/*
+ * MCU maximum, about 215 reports per second instead of 167. Thor only: the other
+ * boards sharing qcs8550-ayn-common.dtsi are untested at this period.
+ */
+&gamepad {
+	report-period = <0>;
+};
