 		startup-delay-us = <10000>;
 
 		gpio = <&tlmm 99 GPIO_ACTIVE_HIGH>;
-		regulator-always-on;
 		regulator-boot-on;
 		enable-active-high;
 	};
@@ -1096,7 +958,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1462,7 +1324,6 @@
 	no-mmc;
 
 	qcom,dll-config = <0x0007442c>;
-	sdhci-caps-mask = <0x3 0x0>;
 
 	status = "okay";
 };
@@ -1700,6 +1561,7 @@
 
 	gamepad: gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
 
 		gamepad-name = "AYN Odin2 Gamepad";
 		gamepad-bus = <0x0003>;
@@ -1707,7 +1569,7 @@
 		gamepad-pid = <0x3001>;
 		gamepad-rev = <0x0001>;
 
-		vdd-supply = <&vreg_bob2>;
+		vdd-supply = <&vdd_mcu_3v3>;
 		enable-gpios = <&tlmm 12 GPIO_ACTIVE_HIGH>;
 		pinctrl-0 = <&mcu_en_active>;
 		pinctrl-names = "default";
@@ -1765,3 +1627,18 @@
 &xo_board {
 	clock-frequency = <76800000>;
 };
+
+/* The codec keeps these rails enabled through s2idle; idle them in LPM */
+&vreg_l15b_1p8 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
+
+&vreg_bob1 {
+	regulator-state-mem {
+		regulator-on-in-suspend;
+		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+	};
+};
