/dts-v1/;

#include "cq8725s-ayn-common.dtsi"

/delete-node/ &cpusys_vm_mem;

/ {
	model = "AYN Odin 3 Portal";
	compatible = "ayn,odin3portal", "qcom,cq8725s", "qcom,sm8750";

	aliases {
		mmc0 = &sdhc_2;
	};

	pwm-fan {
		pwms = <&pm8550_pwm 3 50000>;
	};

	gpio-keys {
		key-volume-up {
			wakeup-source;
		};
	};

	reserved-memory {
		reserved@9b09c000 {
			reg = <0x0 0x9b09c000 0x0 0x4000>;
			no-map;
		};

		reserved@9eb80000 {
			reg = <0x0 0x9eb80000 0x0 0x80000>;
			no-map;
		};

		splash_mem: framebuffer@fc800000 {
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			no-map;
		};
	};
};

&gunyah_hyp_mem {
	reg = <0x0 0x80000000 0x0 0x1200000>;
};

&i2c4 {
	touchscreen@38 {
		/* FT5452: provisional use of the family FT5x06 protocol. */
		compatible = "focaltech,ft5426";
	};
};

&mdss_dsi0 {
	panel@0 {
		compatible = "vtdr6130,o3p";
		tvdd-supply = <&vreg_l4b_1p8>;
		rotation = <270>;
	};
};

&remoteproc_cdsp {
	status = "disabled";
};

&remoteproc_mpss {
	status = "disabled";
};

&remoteproc_soccp {
	status = "disabled";
};

&sdc2_default {
	cmd-pins {
		drive-strength = <16>;
	};

	data-pins {
		drive-strength = <16>;
	};
};

&uart15 {
	gamepad {
		gamepad-name = "AYN Odin3 Portal Gamepad";
	};
};

&usb {
	/delete-property/ usb-role-switch;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
};

&{/thermal-zones/cpu-0-0-0-thermal} {
	polling-delay = <1000>;

	trips {
		fan_little_on: fan-on {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "active";
		};

		fan_little_high: fan-high {
			temperature = <75000>;
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map-fan-low {
			trip = <&fan_little_on>;
			cooling-device = <&pwm_fan 2 4>;
		};

		map-fan-high {
			trip = <&fan_little_high>;
			cooling-device = <&pwm_fan 5 7>;
		};
	};
};

&{/thermal-zones/cpu-1-0-0-thermal} {
	polling-delay = <1000>;

	trips {
		fan_big_on: fan-on {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "active";
		};

		fan_big_high: fan-high {
			temperature = <75000>;
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map-fan-low {
			trip = <&fan_big_on>;
			cooling-device = <&pwm_fan 2 4>;
		};

		map-fan-high {
			trip = <&fan_big_high>;
			cooling-device = <&pwm_fan 5 7>;
		};
	};
};
