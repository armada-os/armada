/dts-v1/;

#include "cq8725s-ayn-common.dtsi"

/delete-node/ &cpusys_vm_mem;

/ {
	model = "AYN Odin 3 Portal";
	compatible = "ayn,odin3portal", "qcom,cq8725s", "qcom,sm8750";

	aliases {
		mmc0 = &sdhc_2;
	};

	sound {
		model = "SM8750-AYN-Portal";
	};

	pwm-fan {
		pwms = <&pm8550_pwm 3 50000>;
	};

	gpio-keys {
		key-volume-up {
			wakeup-source;
		};
	};

	reserved-memory {
		reserved@9b09c000 {
			reg = <0x0 0x9b09c000 0x0 0x4000>;
			no-map;
		};

		reserved@9eb80000 {
			reg = <0x0 0x9eb80000 0x0 0x80000>;
			no-map;
		};

		splash_mem: framebuffer@fc800000 {
			reg = <0x0 0xfc800000 0x0 0x2b00000>;
			no-map;
		};
	};
};

&apps_rsc {
	regulators-0 {
		vreg_l17b_2p5: ldo17 {
			regulator-name = "vreg_l17b_2p5";
			regulator-min-microvolt = <2504000>;
			regulator-max-microvolt = <2504000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-1 {
		vdd-l1-supply = <&vreg_s7i_1p2>;

		vreg_l1d_1p2: ldo1 {
			regulator-name = "vreg_l1d_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;

		qcom,pmic-id = "j";

		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&gunyah_hyp_mem {
	reg = <0x0 0x80000000 0x0 0x1200000>;
};

&i2c4 {
	touchscreen@38 {
		/* FT5452: provisional use of the family FT5x06 protocol. */
		compatible = "focaltech,ft5426";
	};
};

&mdss_dsi0 {
	panel@0 {
		compatible = "vtdr6130,o3p";
		tvdd-supply = <&vreg_l4b_1p8>;
		rotation = <270>;
	};
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/ayn/odin3portal/adsp.mbn",
			"qcom/sm8750/ayn/odin3portal/adsp_dtb.mbn";
};

&remoteproc_cdsp {
	status = "disabled";
};

&remoteproc_mpss {
	status = "disabled";
};

&remoteproc_soccp {
	firmware-name = "qcom/sm8750/ayn/odin3portal/soccp.mbn";
};

&sdc2_default {
	cmd-pins {
		drive-strength = <16>;
	};

	data-pins {
		drive-strength = <16>;
	};
};

&spk_amp_l {
	firmware-name = "qcom/sm8750/ayn/odin3portal/aw883xx_acf.bin";
};

&spk_amp_r {
	firmware-name = "qcom/sm8750/ayn/odin3portal/aw883xx_acf.bin";
};

&uart15 {
	gamepad {
		gamepad-name = "AYN Odin3 Portal Gamepad";
	};
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	/delete-property/ resets;
	/delete-property/ reset-names;

	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&usb {
	/delete-property/ usb-role-switch;
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	phys = <&usb_hsphy>;
	phy-names = "usb2-phy";
};

&{/thermal-zones/cpu-0-0-0-thermal} {
	polling-delay = <1000>;

	trips {
		fan_little_on: fan-on {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "active";
		};

		fan_little_high: fan-high {
			temperature = <75000>;
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map-fan-low {
			trip = <&fan_little_on>;
			cooling-device = <&pwm_fan 2 4>;
		};

		map-fan-high {
			trip = <&fan_little_high>;
			cooling-device = <&pwm_fan 5 7>;
		};
	};
};

&{/thermal-zones/cpu-1-0-0-thermal} {
	polling-delay = <1000>;

	trips {
		fan_big_on: fan-on {
			temperature = <55000>;
			hysteresis = <5000>;
			type = "active";
		};

		fan_big_high: fan-high {
			temperature = <75000>;
			hysteresis = <5000>;
			type = "active";
		};
	};

	cooling-maps {
		map-fan-low {
			trip = <&fan_big_on>;
			cooling-device = <&pwm_fan 2 4>;
		};

		map-fan-high {
			trip = <&fan_big_high>;
			cooling-device = <&pwm_fan 5 7>;
		};
	};
};
