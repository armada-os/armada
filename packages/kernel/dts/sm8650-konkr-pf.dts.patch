From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: pocket-fit: dedicated sound card and controller MCU

--- a/arch/arm64/boot/dts/qcom/sm8650-konkr-pf.dts
+++ b/arch/arm64/boot/dts/qcom/sm8650-konkr-pf.dts
@@ -13,6 +13,10 @@
 	compatible = "konkr,pocket-fit", "qcom,sm8650";
 };
 
+&{/sound} {
+	compatible = "konkr,pocket-fit-sndcard";
+};
+
 &mdss_dsi0 {
 	status = "okay";
 	vdda-supply = <&vreg_l3i_1p2>;
@@ -86,3 +90,39 @@
 		status = "okay";
 	};
 };
+
+&remoteproc_adsp {
+	firmware-name = "qcom/sm8650/konkr/pf/adsp.mbn",
+			"qcom/sm8650/konkr/pf/adsp_dtb.mbn";
+};
+
+&uart13 {
+	mcu {
+		compatible = "konkr,pocket-fit-mcu";
+	};
+};
+
+&wcd939x {
+	qcom,hphl-jack-type-normally-closed;
+	qcom,ground-jack-type-normally-closed;
+};
+
+/*
+ * HPH PCM ("HiFi") playback, which the UCM profile uses on this board because
+ * the PDM path hisses: the RX macro sends the PCM stream on master port 9 (the
+ * stock Android swr-port-mapping, and the FIT Elite's), which sm8650.dtsi
+ * leaves unconfigured. Give port 9 the PCM timing sm8650.dtsi has at port 8
+ * (the FIT Elite's port 9 values) and the PCM data format enable.
+ */
+&swr1 {
+	qcom,pcm-ports-mask = <0x200>;
+	qcom,ports-sinterval =		/bits/ 16 <0x03 0x1f 0x1f 0x07 0x03 0xff 0xff 0x31 0x31 0xff 0xff 0xff>;
+	qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x09 0x01 0xff 0xff 0x00 0x00 0xff 0xff 0xff>;
+	qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00 0xff 0xff 0x00 0x00 0xff 0xff 0xff>;
+	qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff 0xff 0xff 0x00 0x00 0xff 0xff 0xff>;
+	qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff 0xff 0xff 0x0f 0x0f 0xff 0xff 0xff>;
+	qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff 0xff 0xff 0x18 0x18 0xff 0xff 0xff>;
+	qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff 0xff 0xff 0x01 0x01 0xff 0xff 0xff>;
+	qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0x01 0x03 0xff 0xff 0x00 0x00 0xff 0xff 0xff>;
+	qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00 0xff 0xff 0x01 0x01 0xff 0xff 0xff>;
+};
