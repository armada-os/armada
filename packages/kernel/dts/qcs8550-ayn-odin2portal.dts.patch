From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: odin2portal: add gpio back buttons, ADSP remote heap for the sensors

--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-odin2portal.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-odin2portal.dts
@@ -292,3 +292,65 @@
 	firmware-name = "qcom/sm8550/ayn/odin2portal/aw883xx_acf.bin";
 };
 
+&tlmm {
+	paddle_keys_default: paddle-keys-default-state {
+		pins = "gpio57", "gpio58";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+};
+
+/*
+ * AYN Odin 2 Portal has two extra back buttons (M1, M2) on the lower back of
+ * the device. They are plain active-low SoC TLMM GPIOs (M1 = GPIO_57,
+ * M2 = GPIO_58), not on the gamepad MCU UART and not ADC (despite AYN's
+ * Android "adckey"/keydetect.ko naming). Expose them as a gpio-keys
+ * device emitting BTN_Z (M1) / BTN_C (M2); ROCKNIX's InputPlumber map
+ * (ayn_mcu.yaml) routes BTN_Z -> LeftPaddle2 and BTN_C -> RightPaddle2.
+ * RE'd from the AYN Android keydetect driver (gpio_request 358/359 =
+ * TLMM base 301 + offsets 57/58), same scheme as the AYN Odin 3.
+ */
+/ {
+	gpio-keys-paddles {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&paddle_keys_default>;
+
+		key-paddle-m1 {
+			label = "Back Paddle M1";
+			linux,code = <BTN_Z>;
+			gpios = <&tlmm 57 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+		};
+
+		key-paddle-m2 {
+			label = "Back Paddle M2";
+			linux,code = <BTN_C>;
+			gpios = <&tlmm 58 GPIO_ACTIVE_LOW>;
+			debounce-interval = <15>;
+		};
+	};
+};
+
+/*
+ * Qualcomm sensor core (SSC) on the ADSP: the FastRPC sensors process needs a
+ * remote heap, or it cannot start and the IMU (gyro/accel) never appears.
+ * Heap node and properties from the Odin 2 gyro work by justjoseorg in
+ * SteamOS-ARM-Port (qcs8550-ayn-odin2-gyro.dtsi): LPASS 0x16, ADSP_HEAP 0x25.
+ */
+&{/reserved-memory} {
+	adsp_rpc_remote_heap_mem: adsp-rpc-remote-heap {
+		compatible = "shared-dma-pool";
+		alloc-ranges = <0x0 0x00000000 0x0 0xffffffff>;
+		alignment = <0x0 0x400000>;
+		size = <0x0 0xc00000>;
+		reusable;
+	};
+};
+
+&{/soc@0/remoteproc@6800000/glink-edge/fastrpc} {
+	memory-region = <&adsp_rpc_remote_heap_mem>;
+	qcom,fastrpc-adsp-sensors-pdr;
+	qcom,vmids = <0x16 0x25>;
+};
