From: seilent <github@seilent.net>
Subject: [PATCH] backlight: qcom-wled: always disable ovp irq at probe

The bootloader can leave the WLED module enabled, so
wled_configure_ovp_irq skipped disable_irq and the first enable_irq in
wled_ovp_work became unbalanced. wled->brightness is 0 at probe, so the
first nonzero update always goes through wled_module_enable and
reenables the irq. Always disable the irq after request.

---
--- a/drivers/video/backlight/qcom-wled.c
+++ b/drivers/video/backlight/qcom-wled.c
@@ -1627,7 +1627,6 @@
 				  struct platform_device *pdev)
 {
 	int rc;
-	u32 val;
 
 	wled->ovp_irq = platform_get_irq_byname(pdev, "ovp");
 	if (wled->ovp_irq < 0) {
@@ -1645,14 +1644,8 @@
 		return 0;
 	}
 
-	rc = regmap_read(wled->regmap, wled->ctrl_addr +
-			 WLED3_CTRL_REG_MOD_EN, &val);
-	if (rc < 0)
-		return rc;
-
 	/* Keep OVP irq disabled until module is enabled */
-	if (!(val & WLED3_CTRL_REG_MOD_EN_MASK))
-		disable_irq(wled->ovp_irq);
+	disable_irq(wled->ovp_irq);
 
 	return 0;
 }
