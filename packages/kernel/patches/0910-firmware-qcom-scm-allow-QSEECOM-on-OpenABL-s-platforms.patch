From 1ffffdce2708c7f093fde87aa39f7735832e231e Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 13 Oct 2026 03:57:42 -0700
Subject: [PATCH] firmware: qcom: scm: allow QSEECOM on OpenABL's platforms

Linux gets the UEFI variables on these SoCs only through
qcom_qseecom_uefisecapp, which needs the machine on the allowlist:
SDM845, SM4450, SM6115, SM8250, SM8550, SM8650 and SM8750, matched by
the SoC compatible every board tree lists. Tested on SM6115.
---
 drivers/firmware/qcom/qcom_scm.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 6b601a4..2baedb9 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -2316,6 +2316,13 @@ static const struct of_device_id qcom_scm_qseecom_allowlist[] __maybe_unused = {
 	{ .compatible = "qcom,mahua-crd" },
 	{ .compatible = "qcom,purwa-iot-evk" },
 	{ .compatible = "qcom,sc8180x-primus" },
+	{ .compatible = "qcom,sdm845" },
+	{ .compatible = "qcom,sm4450" },
+	{ .compatible = "qcom,sm6115" },
+	{ .compatible = "qcom,sm8250" },
+	{ .compatible = "qcom,sm8550" },
+	{ .compatible = "qcom,sm8650" },
+	{ .compatible = "qcom,sm8750" },
 	{ .compatible = "qcom,x1e001de-devkit" },
 	{ .compatible = "qcom,x1e80100-crd" },
 	{ .compatible = "qcom,x1e80100-qcp" },
