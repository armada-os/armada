From: Diogo Trindade <diogotr7@gmail.com>
Subject: [PATCH] input: rsinput: add a constrained calibration transport

The controller MCU owns the persistent KTH577x joystick calibration. The
vendor tools drive it with six top-level commands, but rsinput currently has
no way to capture original status payloads or issue those commands.

Add an opt-in misc character device for an engineering calibration helper.
The device is registered only when the controller's device-tree node has the
'mcu-calibration' property.
Reads return versioned fixed-size records containing unmodified 14-byte or
26-byte status payloads. Writes accept a versioned fixed-size record and
permit only the observed commands, their exact payload lengths, and their
valid transaction ordering. Userspace never supplies the UART envelope,
sequence number, or checksum.

Reject suspend during an active calibration transaction and retain open
calibration sessions safely across device removal.

This interface deliberately does not calculate coefficients, replay anything
at boot, or claim that END rolls a partially written calibration back.
---
diff --git a/Documentation/ABI/testing/dev-rsinput-calibration b/Documentation/ABI/testing/dev-rsinput-calibration
new file mode 100644
index 0000000..6389b3a
--- /dev/null
+++ b/Documentation/ABI/testing/dev-rsinput-calibration
@@ -0,0 +1,48 @@
+What:		/dev/rsinput-calibration-<serdev-name>
+Date:		September 2026
+Contact:	Diogo Trindade <diogotr7@gmail.com>
+Description:
+		Engineering transport for persistent KTH577x stick calibration
+		on controller MCUs handled by rsinput. The misc device is mode
+		0600 and permits one open file at a time. Its parent in sysfs is
+		the associated serdev device.
+
+		Each read must request exactly one 48-byte struct
+		rsinput_cal_sample. The record carries ABI version 1, flags zero,
+		a monotonic timestamp, driver generation, MCU sequence, cumulative
+		FIFO-drop count, and the unmodified first 14 or 26 bytes of a
+		controller status payload. poll() reports readable records and
+		reports error and hangup after device removal.
+
+		Each write must supply exactly one 64-byte struct
+		rsinput_cal_command with ABI version 1. Reserved bytes and unused
+		payload bytes must be zero. Only these payloads are accepted:
+
+			A0 01		enter left calibration mode
+			A1 01		enter right calibration mode
+			A0 00		end calibration mode
+			A2 + 4 bytes	write left centre
+			A3 + 58 bytes	write left calibration table
+			A5 + 4 bytes	write right centre
+			A6 + 58 bytes	write right calibration table
+
+		The centre and table commands are accepted only for an active side,
+		and a table only after that side's centre. A successful write means
+		the complete UART frame was accepted by serdev; it does not prove
+		that sensor NVM committed the values. A partial or timed-out write
+		is never retried automatically: apart from END, the transaction
+		state advances when transmission is attempted, so a failed mode
+		entry can still be ended and a failed centre or table write
+		cannot be repeated in that mode.
+
+		Closing a file with a mode active attempts the generic A0 00 end
+		command. END is cleanup, not rollback: A2, A3, A5, and A6 may alter
+		sensor NVM as soon as their transmission begins. Suspend is rejected
+		while a calibration mode remains active and, once a centre or table
+		write has been attempted, until the file is closed. Probe and resume
+		never replay calibration writes.
+
+		Userspace must continuously drain samples during capture, establish
+		the cumulative-drop baseline from its first record, and reject any
+		increase. It must treat a failed or partial persistent write as an
+		unknown outcome and must not retry it automatically.
diff --git a/drivers/input/joystick/rsinput.c b/drivers/input/joystick/rsinput.c
index b1e80c5..e99f071 100644
--- a/drivers/input/joystick/rsinput.c
+++ b/drivers/input/joystick/rsinput.c
@@ -6,20 +6,28 @@
  *
  */

+#include <linux/atomic.h>
 #include <linux/errno.h>
+#include <linux/fs.h>
 #include <linux/gpio/consumer.h>
 #include <linux/init.h>
 #include <linux/input.h>
 #include <linux/kernel.h>
+#include <linux/kref.h>
+#include <linux/miscdevice.h>
 #include <linux/module.h>
 #include <linux/minmax.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/poll.h>
+#include <linux/property.h>
 #include <linux/regulator/consumer.h>
 #include <linux/serdev.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/qcom_hv_haptics.h>
+#include <linux/uaccess.h>
 #include <linux/workqueue.h>
+#include <uapi/linux/rsinput.h>
 #include <uapi/linux/sched/types.h>

 static int update_params=0;
@@ -134,6 +142,16 @@ module_param(axis_righty_antideadzone,int,0660);

 #define RSINPUT_TX_TIMEOUT_MS      250
 #define RSINPUT_STATUS_MIN_LEN     14
+#define RSINPUT_CAL_LEFT           BIT(0)
+#define RSINPUT_CAL_RIGHT          BIT(1)
+#define RSINPUT_CAL_LEFT_CENTER    BIT(0)
+#define RSINPUT_CAL_LEFT_TABLE     BIT(1)
+#define RSINPUT_CAL_RIGHT_CENTER   BIT(2)
+#define RSINPUT_CAL_RIGHT_TABLE    BIT(3)
+#define RSINPUT_CAL_FIFO_ORDER     8
+#define RSINPUT_CAL_FIFO_SIZE      BIT(RSINPUT_CAL_FIFO_ORDER)
+
+struct rsinput_calibration;

 struct rsinput_driver {
     struct serdev_device *serdev;
@@ -154,6 +172,26 @@ struct rsinput_driver {
     int rumble_effect_id;
     int rumble_val;
     struct mutex tx_lock;
+    struct rsinput_calibration *calibration;
+};
+
+struct rsinput_calibration {
+    struct miscdevice miscdev;
+    struct kref refcount;
+    struct mutex io_lock;
+    spinlock_t sample_lock;
+    wait_queue_head_t sample_wait;
+    struct rsinput_cal_sample samples[RSINPUT_CAL_FIFO_SIZE];
+    struct rsinput_driver *drv;
+    atomic_t opened;
+    u32 generation;
+    u32 sample_head;
+    u32 sample_tail;
+    u32 dropped;
+    u8 active_sides;
+    u8 stages;
+    bool persistent;
+    bool disconnected;
 };

 static const unsigned int keymap[] = {
@@ -291,6 +329,42 @@ static void handle_cmd_commod(struct rsinput_driver *drv, const uint8_t *data, s
     }
 }

+static void rsinput_calibration_sample(struct rsinput_driver *drv,
+                                       const uint8_t *frame,
+                                       size_t payload_length)
+{
+    struct rsinput_calibration *cal = READ_ONCE(drv->calibration);
+    struct rsinput_cal_sample *sample;
+    size_t sample_length;
+    unsigned long flags;
+
+    if (!cal || payload_length < RSINPUT_CAL_INPUT_SIZE ||
+        !atomic_read(&cal->opened))
+        return;
+
+    spin_lock_irqsave(&cal->sample_lock, flags);
+    if (cal->sample_head - cal->sample_tail >= RSINPUT_CAL_FIFO_SIZE) {
+        cal->sample_tail++;
+        cal->dropped++;
+    }
+    sample = &cal->samples[cal->sample_head & (RSINPUT_CAL_FIFO_SIZE - 1)];
+    sample->timestamp_ns = ktime_get_ns();
+    sample->generation = ++cal->generation;
+    sample->sequence = frame[FRAME_POS_SEQ];
+    sample_length = payload_length >= RSINPUT_CAL_STATUS_SIZE ?
+                    RSINPUT_CAL_STATUS_SIZE : RSINPUT_CAL_INPUT_SIZE;
+    sample->length = sample_length;
+    memset(sample->data, 0, sizeof(sample->data));
+    memcpy(sample->data, &frame[FRAME_POS_DATA_1],
+           sample_length);
+    sample->abi_version = RSINPUT_CAL_ABI_VERSION;
+    sample->flags = 0;
+    cal->sample_head++;
+    spin_unlock_irqrestore(&cal->sample_lock, flags);
+
+    wake_up_interruptible(&cal->sample_wait);
+}
+
 static void handle_cmd_status(struct rsinput_driver *drv, const uint8_t *data, size_t payload_length) {
     if (payload_length >= RSINPUT_STATUS_MIN_LEN) {
     static unsigned long prev_states;
@@ -298,6 +372,8 @@ static void handle_cmd_status(struct rsinput_driver *drv, const uint8_t *data, s
     unsigned long current_states = keys, changes;
     int i;

+    rsinput_calibration_sample(drv, data, payload_length);
+
     if (update_params) {
         input_set_abs_params(drv->input, ABS_X,
             INT_SIGN(axis_leftx_min) * ( abs(axis_leftx_min) - axis_leftx_antideadzone ),
@@ -484,6 +560,285 @@ static const struct serdev_device_ops rsinput_rx_ops = {
     .write_wakeup = rsinput_write_wakeup,
 };

+static bool rsinput_calibration_command_valid(struct rsinput_calibration *cal,
+                                              const struct rsinput_cal_command *cmd)
+{
+    if (cmd->abi_version != RSINPUT_CAL_ABI_VERSION ||
+        memchr_inv(cmd->reserved, 0, sizeof(cmd->reserved)) ||
+        cmd->length > RSINPUT_CAL_MAX_PAYLOAD ||
+        memchr_inv(cmd->data + cmd->length, 0,
+                   RSINPUT_CAL_MAX_PAYLOAD - cmd->length))
+        return false;
+
+    switch (cmd->command) {
+    case RSINPUT_CAL_CMD_LEFT_MODE:
+        if (cmd->length != 1 || cmd->data[0] > 1)
+            return false;
+        return cmd->data[0] ? !(cal->active_sides & RSINPUT_CAL_LEFT) :
+                              cal->active_sides;
+    case RSINPUT_CAL_CMD_RIGHT_MODE:
+        return cmd->length == 1 && cmd->data[0] == 1 &&
+               !(cal->active_sides & RSINPUT_CAL_RIGHT);
+    case RSINPUT_CAL_CMD_LEFT_CENTER:
+        return cmd->length == 4 &&
+               (cal->active_sides & RSINPUT_CAL_LEFT) &&
+               !(cal->stages & (RSINPUT_CAL_LEFT_CENTER |
+                                RSINPUT_CAL_LEFT_TABLE));
+    case RSINPUT_CAL_CMD_LEFT_TABLE:
+        return cmd->length == RSINPUT_CAL_TABLE_SIZE &&
+               (cal->active_sides & RSINPUT_CAL_LEFT) &&
+               (cal->stages & RSINPUT_CAL_LEFT_CENTER) &&
+               !(cal->stages & RSINPUT_CAL_LEFT_TABLE);
+    case RSINPUT_CAL_CMD_RIGHT_CENTER:
+        return cmd->length == 4 &&
+               (cal->active_sides & RSINPUT_CAL_RIGHT) &&
+               !(cal->stages & (RSINPUT_CAL_RIGHT_CENTER |
+                                RSINPUT_CAL_RIGHT_TABLE));
+    case RSINPUT_CAL_CMD_RIGHT_TABLE:
+        return cmd->length == RSINPUT_CAL_TABLE_SIZE &&
+               (cal->active_sides & RSINPUT_CAL_RIGHT) &&
+               (cal->stages & RSINPUT_CAL_RIGHT_CENTER) &&
+               !(cal->stages & RSINPUT_CAL_RIGHT_TABLE);
+    default:
+        return false;
+    }
+}
+
+static void rsinput_calibration_advance(struct rsinput_calibration *cal,
+                                        const struct rsinput_cal_command *cmd)
+{
+    switch (cmd->command) {
+    case RSINPUT_CAL_CMD_LEFT_MODE:
+        if (cmd->data[0]) {
+            cal->active_sides |= RSINPUT_CAL_LEFT;
+            cal->stages &= ~(RSINPUT_CAL_LEFT_CENTER |
+                             RSINPUT_CAL_LEFT_TABLE);
+        } else {
+            cal->active_sides = 0;
+            cal->stages = 0;
+        }
+        break;
+    case RSINPUT_CAL_CMD_RIGHT_MODE:
+        cal->active_sides |= RSINPUT_CAL_RIGHT;
+        cal->stages &= ~(RSINPUT_CAL_RIGHT_CENTER |
+                         RSINPUT_CAL_RIGHT_TABLE);
+        break;
+    case RSINPUT_CAL_CMD_LEFT_CENTER:
+        cal->stages |= RSINPUT_CAL_LEFT_CENTER;
+        cal->persistent = true;
+        break;
+    case RSINPUT_CAL_CMD_LEFT_TABLE:
+        cal->stages |= RSINPUT_CAL_LEFT_TABLE;
+        cal->persistent = true;
+        break;
+    case RSINPUT_CAL_CMD_RIGHT_CENTER:
+        cal->stages |= RSINPUT_CAL_RIGHT_CENTER;
+        cal->persistent = true;
+        break;
+    case RSINPUT_CAL_CMD_RIGHT_TABLE:
+        cal->stages |= RSINPUT_CAL_RIGHT_TABLE;
+        cal->persistent = true;
+        break;
+    }
+}
+
+static void rsinput_calibration_release_ref(struct kref *ref)
+{
+    struct rsinput_calibration *cal =
+        container_of(ref, struct rsinput_calibration, refcount);
+
+    kfree(cal->miscdev.name);
+    kfree(cal);
+}
+
+static int rsinput_calibration_open(struct inode *inode, struct file *file)
+{
+    struct miscdevice *misc = file->private_data;
+    struct rsinput_calibration *cal =
+        container_of(misc, struct rsinput_calibration, miscdev);
+
+    if (atomic_cmpxchg(&cal->opened, 0, 1))
+        return -EBUSY;
+    if (!kref_get_unless_zero(&cal->refcount)) {
+        atomic_set(&cal->opened, 0);
+        return -ENODEV;
+    }
+
+    spin_lock_irq(&cal->sample_lock);
+    if (cal->disconnected) {
+        spin_unlock_irq(&cal->sample_lock);
+        atomic_set(&cal->opened, 0);
+        kref_put(&cal->refcount, rsinput_calibration_release_ref);
+        return -ENODEV;
+    }
+    /* A new reader starts with samples produced after this open. */
+    cal->sample_tail = cal->sample_head;
+    cal->dropped = 0;
+    spin_unlock_irq(&cal->sample_lock);
+
+    file->private_data = cal;
+    return nonseekable_open(inode, file);
+}
+
+static ssize_t rsinput_calibration_read(struct file *file, char __user *buf,
+                                        size_t count, loff_t *ppos)
+{
+    struct rsinput_calibration *cal = file->private_data;
+    struct rsinput_cal_sample sample;
+    unsigned long flags;
+    int ret;
+
+    if (count != sizeof(sample))
+        return -EINVAL;
+
+    if (!(file->f_flags & O_NONBLOCK)) {
+        ret = wait_event_interruptible(cal->sample_wait,
+                READ_ONCE(cal->disconnected) ||
+                READ_ONCE(cal->sample_head) !=
+                    READ_ONCE(cal->sample_tail));
+        if (ret)
+            return ret;
+    }
+
+    spin_lock_irqsave(&cal->sample_lock, flags);
+    if (cal->sample_head == cal->sample_tail) {
+        ret = cal->disconnected ? -ENODEV : -EAGAIN;
+        spin_unlock_irqrestore(&cal->sample_lock, flags);
+        return ret;
+    }
+    sample = cal->samples[cal->sample_tail & (RSINPUT_CAL_FIFO_SIZE - 1)];
+    cal->sample_tail++;
+    sample.dropped = cal->dropped;
+    spin_unlock_irqrestore(&cal->sample_lock, flags);
+
+    if (copy_to_user(buf, &sample, sizeof(sample)))
+        return -EFAULT;
+    return sizeof(sample);
+}
+
+static ssize_t rsinput_calibration_write(struct file *file,
+                                         const char __user *buf,
+                                         size_t count, loff_t *ppos)
+{
+    struct rsinput_calibration *cal = file->private_data;
+    struct rsinput_cal_command cmd;
+    u8 payload[RSINPUT_CAL_MAX_PAYLOAD + 1];
+    bool end;
+    int ret;
+
+    if (count != sizeof(cmd))
+        return -EINVAL;
+    if (copy_from_user(&cmd, buf, sizeof(cmd)))
+        return -EFAULT;
+
+    mutex_lock(&cal->io_lock);
+    if (cal->disconnected || !cal->drv) {
+        ret = -ENODEV;
+        goto out;
+    }
+    if (!rsinput_calibration_command_valid(cal, &cmd)) {
+        ret = -EINVAL;
+        goto out;
+    }
+
+    end = cmd.command == RSINPUT_CAL_CMD_LEFT_MODE && !cmd.data[0];
+    if (!end)
+        rsinput_calibration_advance(cal, &cmd);
+
+    payload[0] = cmd.command;
+    memcpy(&payload[1], cmd.data, cmd.length);
+    ret = rsinput_send_command(cal->drv, CMD_COMMOD, payload,
+                               cmd.length + 1);
+    if (!ret) {
+        if (end)
+            rsinput_calibration_advance(cal, &cmd);
+        ret = sizeof(cmd);
+    }
+out:
+    mutex_unlock(&cal->io_lock);
+    return ret;
+}
+
+static __poll_t rsinput_calibration_poll(struct file *file, poll_table *wait)
+{
+    struct rsinput_calibration *cal = file->private_data;
+
+    poll_wait(file, &cal->sample_wait, wait);
+    if (READ_ONCE(cal->disconnected))
+        return EPOLLERR | EPOLLHUP;
+    if (READ_ONCE(cal->sample_head) !=
+        READ_ONCE(cal->sample_tail))
+        return EPOLLIN | EPOLLRDNORM;
+    return 0;
+}
+
+static int rsinput_calibration_release(struct inode *inode, struct file *file)
+{
+    struct rsinput_calibration *cal = file->private_data;
+    const u8 end = 0;
+
+    mutex_lock(&cal->io_lock);
+    if (cal->active_sides && cal->drv && !cal->disconnected) {
+        const u8 payload[] = { RSINPUT_CAL_CMD_LEFT_MODE, end };
+
+        rsinput_send_command(cal->drv, CMD_COMMOD, payload, sizeof(payload));
+    }
+    cal->active_sides = 0;
+    cal->stages = 0;
+    cal->persistent = false;
+    mutex_unlock(&cal->io_lock);
+
+    atomic_set(&cal->opened, 0);
+    kref_put(&cal->refcount, rsinput_calibration_release_ref);
+    return 0;
+}
+
+static const struct file_operations rsinput_calibration_fops = {
+    .owner = THIS_MODULE,
+    .open = rsinput_calibration_open,
+    .read = rsinput_calibration_read,
+    .write = rsinput_calibration_write,
+    .poll = rsinput_calibration_poll,
+    .release = rsinput_calibration_release,
+    .llseek = noop_llseek,
+};
+
+static int rsinput_calibration_register(struct rsinput_driver *drv)
+{
+    struct rsinput_calibration *cal;
+    int ret;
+
+    cal = kzalloc(sizeof(*cal), GFP_KERNEL);
+    if (!cal)
+        return -ENOMEM;
+
+    cal->miscdev.minor = MISC_DYNAMIC_MINOR;
+    cal->miscdev.name = kasprintf(GFP_KERNEL, "rsinput-calibration-%s",
+                                  dev_name(&drv->serdev->dev));
+    if (!cal->miscdev.name) {
+        kfree(cal);
+        return -ENOMEM;
+    }
+    cal->miscdev.fops = &rsinput_calibration_fops;
+    cal->miscdev.parent = &drv->serdev->dev;
+    cal->miscdev.mode = 0600;
+    kref_init(&cal->refcount);
+    mutex_init(&cal->io_lock);
+    spin_lock_init(&cal->sample_lock);
+    init_waitqueue_head(&cal->sample_wait);
+    atomic_set(&cal->opened, 0);
+    cal->drv = drv;
+
+    ret = misc_register(&cal->miscdev);
+    if (ret) {
+        kref_put(&cal->refcount, rsinput_calibration_release_ref);
+        return ret;
+    }
+
+    WRITE_ONCE(drv->calibration, cal);
+    return 0;
+}
+
 static void rsinput_rumble_work(struct work_struct *work)
 {
     struct rsinput_driver *drv =
@@ -703,13 +1058,36 @@ static int rsinput_probe(struct serdev_device *serdev) {
         return error;
     }

+    if (device_property_read_bool(&serdev->dev, "mcu-calibration")) {
+        error = rsinput_calibration_register(drv);
+        if (error)
+            dev_warn(&serdev->dev,
+                     "Calibration transport unavailable: %d\n", error);
+    }
+
     return 0;
 }

 static void rsinput_remove(struct serdev_device *serdev) {
     struct rsinput_driver *drv = serdev_device_get_drvdata(serdev);
-
+    struct rsinput_calibration *cal = READ_ONCE(drv->calibration);
+
+    if (cal) {
+        misc_deregister(&cal->miscdev);
+        mutex_lock(&cal->io_lock);
+        cal->disconnected = true;
+        cal->drv = NULL;
+        cal->active_sides = 0;
+        cal->stages = 0;
+        cal->persistent = false;
+        mutex_unlock(&cal->io_lock);
+        wake_up_interruptible(&cal->sample_wait);
+    }
     serdev_device_close(serdev);
+    if (cal) {
+        WRITE_ONCE(drv->calibration, NULL);
+        kref_put(&cal->refcount, rsinput_calibration_release_ref);
+    }
     input_unregister_device(drv->input);
     /* flush, not cancel: unregister queues the final rumble stop */
     if (drv->rumble_work.func)
@@ -727,8 +1105,18 @@ static void rsinput_remove(struct serdev_device *serdev) {
 static int rsinput_suspend(struct device *dev)
 {
     struct rsinput_driver *drv = dev_get_drvdata(dev);
+    struct rsinput_calibration *cal = READ_ONCE(drv->calibration);
+    bool busy = false;
     int error;

+    if (cal) {
+        mutex_lock(&cal->io_lock);
+        busy = cal->active_sides || cal->persistent;
+        mutex_unlock(&cal->io_lock);
+    }
+    if (busy)
+        return -EBUSY;
+
     /* a pending rumble start must not fire into or after haptics suspend */
     if (drv->rumble_work.func)
         cancel_work_sync(&drv->rumble_work);
diff --git a/include/uapi/linux/rsinput.h b/include/uapi/linux/rsinput.h
new file mode 100644
index 0000000..85de6ff
--- /dev/null
+++ b/include/uapi/linux/rsinput.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0-only WITH Linux-syscall-note */
+#ifndef _UAPI_LINUX_RSINPUT_H
+#define _UAPI_LINUX_RSINPUT_H
+
+#include <linux/types.h>
+
+#define RSINPUT_CAL_ABI_VERSION 1
+#define RSINPUT_CAL_MAX_PAYLOAD 58
+#define RSINPUT_CAL_TABLE_SIZE  58
+#define RSINPUT_CAL_INPUT_SIZE  14
+#define RSINPUT_CAL_STATUS_SIZE 26
+
+#define RSINPUT_CAL_CMD_LEFT_MODE    0xa0
+#define RSINPUT_CAL_CMD_RIGHT_MODE   0xa1
+#define RSINPUT_CAL_CMD_LEFT_CENTER  0xa2
+#define RSINPUT_CAL_CMD_LEFT_TABLE   0xa3
+#define RSINPUT_CAL_CMD_RIGHT_CENTER 0xa5
+#define RSINPUT_CAL_CMD_RIGHT_TABLE  0xa6
+
+/* A complete write record. Unused data bytes must be zero. */
+struct rsinput_cal_command {
+    __u16 abi_version;
+    __u8 command;
+    __u8 length;
+    __u8 data[RSINPUT_CAL_MAX_PAYLOAD];
+    __u8 reserved[2];
+};
+
+/* A complete read record containing an unmodified status payload. */
+struct rsinput_cal_sample {
+    __aligned_u64 timestamp_ns;
+    __u32 generation;
+    __u8 sequence;
+    __u8 length;
+    __u8 data[RSINPUT_CAL_STATUS_SIZE];
+    __u32 dropped;
+    __u16 abi_version;
+    __u16 flags;
+};
+
+#endif /* _UAPI_LINUX_RSINPUT_H */
