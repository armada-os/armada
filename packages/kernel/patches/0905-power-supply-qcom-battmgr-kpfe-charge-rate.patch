 }
 
+static void qcom_battmgr_charge_rate_ack(struct qcom_battmgr *battmgr,
+					const void *data, size_t len)
+{
+	const struct {
+		struct pmic_glink_hdr hdr;
+		__le32 result;
+	} *response = data;
+
+	if (len != sizeof(*response))
+		battmgr->error = -ENODATA;
+	else
+		battmgr->error = le32_to_cpu(response->result) ? -EIO : 0;
+	complete(&battmgr->ack);
+}
+
 static void qcom_battmgr_callback(const void *data, size_t len, void *priv)
 {
 	const struct pmic_glink_hdr *hdr = data;
 	struct qcom_battmgr *battmgr = priv;
 	unsigned int opcode = le32_to_cpu(hdr->opcode);
+	unsigned int pending = READ_ONCE(battmgr->pending_opcode);
 
 	if (opcode == BATTMGR_NOTIFICATION)
 		qcom_battmgr_notification(battmgr, data, len);
-	else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
-		 battmgr->variant == QCOM_BATTMGR_X1E80100)
+	else if (opcode == BATTMGR_SET_CHARGE_RATE && battmgr->host_charge_limit) {
+		if (pending == opcode)
+			qcom_battmgr_charge_rate_ack(battmgr, data, len);
+	} else if (battmgr->host_charge_limit && pending == BATTMGR_SET_CHARGE_RATE) {
+		/* A late property response cannot acknowledge a rate request. */
+		return;
+	} else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
+		   battmgr->variant == QCOM_BATTMGR_X1E80100) {
 		qcom_battmgr_sc8280xp_callback(battmgr, data, len);
-	else
+	} else {
 		qcom_battmgr_sm8350_callback(battmgr, data, len);
+	}
 }
 
