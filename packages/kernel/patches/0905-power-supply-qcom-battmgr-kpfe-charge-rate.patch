Subject: [PATCH] power: supply: qcom_battmgr: fix KPFE charge limiting

The KONKR Pocket FIT Elite can report a latched Over voltage fault
after its native firmware limiter lowers the float-voltage target at
a partial charge limit.

On KPFE, apply the existing start and end thresholds using the firmware
charge-rate command. Handle transitions on battery and USB notifications
so charging can stop when the limit is reached during s2idle.

On an eligible awake USB-PD attachment during a charge-limit hold,
briefly release the stop to allow higher input voltage negotiation.
Reapply the stop once the voltage rises, the cable is removed, or the
polling deadline expires.

---
 1 file changed, 589 insertions(+), 6 deletions(-)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index 37bcd95..8444a87 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -4,12 +4,18 @@
  * Copyright (c) 2022, Linaro Ltd
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
+#include <linux/atomic.h>
 #include <linux/auxiliary_bus.h>
+#include <linux/delay.h>
 #include <linux/devm-helpers.h>
+#include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/nvmem-consumer.h>
+#include <linux/of.h>
 #include <linux/of_device.h>
+#include <linux/pm.h>
+#include <linux/pm_wakeup.h>
 #include <linux/power_supply.h>
 #include <linux/property.h>
 #include <linux/soc/qcom/pdr.h>
@@ -31,6 +37,8 @@ enum qcom_battmgr_variant {
 
 #define BATTMGR_REQUEST_NOTIFICATION	0x4
 
+#define BATTMGR_SET_CHARGE_RATE		0x6
+
 #define BATTMGR_NOTIFICATION		0x7
 #define NOTIF_BAT_PROPERTY		0x30
 #define NOTIF_USB_PROPERTY		0x32
@@ -139,6 +147,13 @@ struct qcom_battmgr_discharge_time_request {
 	__le32 reserved;
 };
 
+struct qcom_battmgr_charge_rate_request {
+	struct pmic_glink_hdr hdr;
+	__le32 battery_id;
+	__le32 charge_rate;
+	__le32 charging_path;
+};
+
 struct qcom_battmgr_charge_ctrl_request {
 	struct pmic_glink_hdr hdr;
 	__le32 enable;
@@ -327,6 +342,28 @@ struct qcom_battmgr {
 	struct completion ack;
 
 	bool service_up;
+	bool host_charge_limit;
+	bool host_ready;
+	bool host_threshold_changed;
+	bool host_stopping;
+	bool native_limit_enabled;
+	bool host_inhibited;
+	bool host_rate_valid;
+	atomic_t host_epoch;
+	int host_ready_epoch;
+	int host_rate_epoch;
+	unsigned int pending_opcode;
+	struct delayed_work host_work;
+	bool host_pd_online;
+	bool host_pd_offline_seen;
+	bool host_pd_pending;
+	bool host_pd_restop;
+	bool host_pd_confirm_twice;
+	bool host_pd_suspended;
+	int host_pd_epoch;
+	int host_pd_rate_error_epoch;
+	unsigned long host_pd_offline_at;
+	unsigned long host_pd_check_until;
 
 	struct qcom_battmgr_info info;
 	struct qcom_battmgr_status status;
@@ -345,9 +382,12 @@ struct qcom_battmgr {
 
 static int qcom_battmgr_request(struct qcom_battmgr *battmgr, void *data, size_t len)
 {
+	const struct pmic_glink_hdr *hdr = data;
 	unsigned long left;
 	int ret;
 
+	if (battmgr->host_charge_limit)
+		WRITE_ONCE(battmgr->pending_opcode, le32_to_cpu(hdr->opcode));
 	reinit_completion(&battmgr->ack);
 
 	battmgr->error = 0;
@@ -457,6 +497,52 @@ static const u8 sm8350_bat_prop_map[] = {
 	[POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT_MAX] = BATT_CHG_CTRL_LIM_MAX,
 };
 
+static int qcom_battmgr_host_get(struct qcom_battmgr *battmgr, int opcode, int property)
+{
+	int ret = qcom_battmgr_request_property(battmgr, opcode, property, 0);
+
+	return ret > 0 ? -EIO : ret;
+}
+
+/* Only report a hold when the acknowledged stop agrees with live telemetry. */
+static int qcom_battmgr_host_read_status(struct qcom_battmgr *battmgr,
+				       union power_supply_propval *val)
+{
+	static const unsigned int props[] = { BATT_HEALTH, BATT_CAPACITY, BATT_CURR_NOW };
+	int epoch, i, ret;
+
+	mutex_lock(&battmgr->lock);
+	epoch = atomic_read(&battmgr->host_epoch);
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_STATUS);
+	if (ret)
+		goto out;
+
+	val->intval = battmgr->status.status;
+	if (!READ_ONCE(battmgr->service_up) || !battmgr->host_ready ||
+	    battmgr->host_ready_epoch != epoch || !battmgr->host_rate_valid ||
+	    battmgr->host_rate_epoch != epoch || !battmgr->host_inhibited ||
+	    battmgr->info.charge_ctrl_end == CHARGE_CTRL_END_THR_MAX ||
+	    (val->intval != POWER_SUPPLY_STATUS_DISCHARGING &&
+	     val->intval != POWER_SUPPLY_STATUS_NOT_CHARGING))
+		goto out;
+
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, props[i]);
+		if (ret)
+			goto out;
+	}
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+	if (!ret && epoch == atomic_read(&battmgr->host_epoch) && battmgr->usb.online &&
+	    battmgr->status.health == POWER_SUPPLY_HEALTH_GOOD &&
+	    battmgr->status.percent <= 100 &&
+	    battmgr->status.current_now >= -50000 && battmgr->status.current_now <= 50000)
+		val->intval = battmgr->status.percent >= battmgr->info.charge_ctrl_end ?
+			POWER_SUPPLY_STATUS_FULL : POWER_SUPPLY_STATUS_NOT_CHARGING;
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+
 static int qcom_battmgr_bat_sm8350_update(struct qcom_battmgr *battmgr,
 					  enum power_supply_property psp)
 {
@@ -524,6 +610,8 @@ static int qcom_battmgr_bat_get_property(struct power_supply *psy,
 
 	if (!battmgr->service_up)
 		return -EAGAIN;
+	if (battmgr->host_charge_limit && psp == POWER_SUPPLY_PROP_STATUS)
+		return qcom_battmgr_host_read_status(battmgr, val);
 
 	if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
 	    battmgr->variant == QCOM_BATTMGR_X1E80100)
@@ -677,7 +765,7 @@ static int qcom_battmgr_set_charge_control(struct qcom_battmgr *battmgr,
 		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
 		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
 		.hdr.opcode = cpu_to_le32(BATTMGR_CHG_CTRL_LIMIT_EN),
-		.enable = cpu_to_le32(1),
+		.enable = cpu_to_le32(!battmgr->host_charge_limit),
 		.target_soc = cpu_to_le32(target_soc),
 		.delta_soc = cpu_to_le32(delta_soc),
 	};
@@ -685,11 +773,391 @@ static int qcom_battmgr_set_charge_control(struct qcom_battmgr *battmgr,
 	return qcom_battmgr_request(battmgr, &request, sizeof(request));
 }
 
+/* Retain the last policy decision between thresholds, including while unplugged. */
+static bool qcom_battmgr_host_should_inhibit(unsigned int soc, unsigned int start,
+					    unsigned int end, bool inhibited)
+{
+	if (end == CHARGE_CTRL_END_THR_MAX)
+		return false;
+	if (soc >= end)
+		return true;
+	if (soc <= start)
+		return false;
+	return inhibited;
+}
+
+/* Called with the request mutex held. Firmware retains thresholds when disabled. */
+static int qcom_battmgr_host_prepare(struct qcom_battmgr *battmgr, int epoch)
+{
+	u32 start, end;
+	int ret;
+
+	if (!READ_ONCE(battmgr->service_up) || READ_ONCE(battmgr->host_stopping))
+		return -EAGAIN;
+	if (battmgr->host_ready && battmgr->host_ready_epoch == epoch)
+		return 0;
+
+	battmgr->host_ready = false;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_START_THR);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_END_THR);
+	if (ret)
+		return ret;
+	start = battmgr->info.charge_ctrl_start;
+	end = battmgr->info.charge_ctrl_end;
+	if (start < CHARGE_CTRL_START_THR_MIN || start > CHARGE_CTRL_START_THR_MAX ||
+	    end < CHARGE_CTRL_END_THR_MIN || end > CHARGE_CTRL_END_THR_MAX || start > end)
+		return -ERANGE;
+
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_EN);
+	if (ret)
+		return ret;
+	if (battmgr->native_limit_enabled) {
+		ret = qcom_battmgr_set_charge_control(battmgr, end, end - start);
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_EN);
+		if (ret)
+			return ret;
+		if (battmgr->native_limit_enabled)
+			return -EIO;
+	}
+	if (epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+
+	battmgr->host_ready_epoch = epoch;
+	battmgr->host_ready = true;
+	return 0;
+}
+
+static void qcom_battmgr_host_queue(struct qcom_battmgr *battmgr)
+{
+	if (!battmgr->host_charge_limit || READ_ONCE(battmgr->host_stopping))
+		return;
+	/* GLINK notifications can be handled while user space remains suspended. */
+	pm_wakeup_event(battmgr->dev, 5000);
+	mod_delayed_work(system_wq, &battmgr->host_work, 0);
+}
+
+/* Caller holds the request mutex. The ACK is scoped to this service lifetime. */
+static int qcom_battmgr_host_set_rate(struct qcom_battmgr *battmgr, bool inhibit, int epoch)
+{
+	struct qcom_battmgr_charge_rate_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_SET_CHARGE_RATE),
+		.battery_id = cpu_to_le32(0),
+		.charge_rate = cpu_to_le32(inhibit ? 0 : 100),
+		.charging_path = cpu_to_le32(0),
+	};
+	int ret;
+
+	battmgr->host_rate_valid = false;
+	if (!READ_ONCE(battmgr->service_up) || epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	if (ret) {
+		/* This service may still send an untagged rate response. */
+		battmgr->host_pd_rate_error_epoch = epoch;
+		return ret;
+	}
+	if (epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+
+	battmgr->host_inhibited = inhibit;
+	battmgr->host_rate_epoch = epoch;
+	battmgr->host_rate_valid = true;
+	return 0;
+}
+
+/* A short cable bounce cannot start another negotiation window. */
+static void qcom_battmgr_host_pd_connection(struct qcom_battmgr *battmgr, int epoch)
+{
+	if (battmgr->host_pd_epoch != epoch) {
+		battmgr->host_pd_epoch = epoch;
+		battmgr->host_pd_pending = false;
+		battmgr->host_pd_offline_seen = false;
+	}
+
+	if (!battmgr->usb.online) {
+		if (!battmgr->host_pd_offline_seen)
+			battmgr->host_pd_offline_at = jiffies;
+		battmgr->host_pd_offline_seen = true;
+		battmgr->host_pd_online = false;
+		battmgr->host_pd_pending = false;
+	} else if (!battmgr->host_pd_online) {
+		battmgr->host_pd_pending = !battmgr->host_pd_suspended &&
+			battmgr->host_pd_offline_seen &&
+			time_after_eq(jiffies, battmgr->host_pd_offline_at + HZ);
+		battmgr->host_pd_check_until = jiffies + 4 * HZ;
+		battmgr->host_pd_online = true;
+		battmgr->host_pd_offline_seen = false;
+	}
+}
+
+static int qcom_battmgr_host_pd_source(void)
+{
+	union power_supply_propval type, maximum;
+	struct power_supply *psy;
+	int ret;
+
+	/* KPFE has one USB-C port on the PMIC GLINK UCSI instance. */
+	psy = power_supply_get_by_name("ucsi-source-psy-pmic_glink.ucsi.01");
+	if (!psy)
+		return -EAGAIN;
+	ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_ONLINE, &type);
+	if (!ret && !type.intval)
+		ret = -EAGAIN;
+	if (!ret)
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_USB_TYPE, &type);
+	if (!ret && type.intval != POWER_SUPPLY_USB_TYPE_PD &&
+	    type.intval != POWER_SUPPLY_USB_TYPE_PD_PPS)
+		ret = -EAGAIN;
+	if (!ret)
+		ret = power_supply_get_property(psy, POWER_SUPPLY_PROP_VOLTAGE_MAX,
+						&maximum);
+	power_supply_put(psy);
+	if (ret)
+		return ret;
+	/* Some firmware confirms PD but does not export the source PDOs. */
+	return !maximum.intval || maximum.intval >= 9000000;
+}
+
+static int qcom_battmgr_host_pd_reapply_stop(struct qcom_battmgr *battmgr, int epoch)
+{
+	int ret;
+
+	ret = qcom_battmgr_host_set_rate(battmgr, true, epoch);
+	/*
+	 * A failed release may still reply while we wait for the stop.
+	 * Require two successful replies in that case: at most one can
+	 * be for the release, and every subsequent request is a stop.
+	 */
+	if (!ret && battmgr->host_pd_confirm_twice) {
+		battmgr->host_pd_confirm_twice = false;
+		battmgr->host_rate_valid = false;
+		ret = -EAGAIN;
+	}
+	if (!ret) {
+		battmgr->host_pd_restop = false;
+	} else if (READ_ONCE(battmgr->service_up)) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+	}
+	return ret;
+}
+
+/* Called with the request mutex held after the battery stop has been applied. */
+static int qcom_battmgr_host_pd_upgrade(struct qcom_battmgr *battmgr, int epoch)
+{
+	unsigned long deadline;
+	int ret, high_samples = 0;
+
+	if (!battmgr->host_pd_pending || battmgr->host_pd_suspended)
+		return 0;
+	if (battmgr->host_pd_rate_error_epoch == epoch ||
+	    time_after_eq(jiffies, battmgr->host_pd_check_until)) {
+		battmgr->host_pd_pending = false;
+		return 0;
+	}
+	ret = qcom_battmgr_host_pd_source();
+	if (ret == -EAGAIN) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+		return 0;
+	}
+	if (ret <= 0) {
+		battmgr->host_pd_pending = false;
+		return 0;
+	}
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_MAX);
+	if (!ret && !battmgr->usb.voltage_max) {
+		queue_delayed_work(system_wq, &battmgr->host_work, msecs_to_jiffies(250));
+		return 0;
+	}
+	battmgr->host_pd_pending = false;
+	if (ret || battmgr->usb.voltage_max != 5000000)
+		return ret;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH);
+	if (ret || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD)
+		return ret;
+
+	pm_wakeup_event(battmgr->dev, 6000);
+	deadline = jiffies + msecs_to_jiffies(2500);
+	/* Even a timed-out release may have reached firmware. Always send stop. */
+	battmgr->host_pd_restop = true;
+	ret = qcom_battmgr_host_set_rate(battmgr, false, epoch);
+	battmgr->host_pd_confirm_twice = !!ret;
+	while (!ret && time_before(jiffies, deadline)) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+		if (ret || !battmgr->usb.online || epoch != atomic_read(&battmgr->host_epoch) ||
+		    time_after_eq(jiffies, deadline))
+			break;
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_VOLT_NOW);
+		if (ret)
+			break;
+		if (battmgr->usb.voltage_now >= 8000000) {
+			if (++high_samples == 2)
+				break;
+		} else {
+			high_samples = 0;
+		}
+		msleep(100);
+	}
+	ret = qcom_battmgr_host_pd_reapply_stop(battmgr, epoch);
+	if (!ret)
+		dev_info(battmgr->dev, "USB-PD reconnect: %s; battery stop restored\n",
+			 high_samples == 2 ? "higher voltage observed" : "no higher voltage observed");
+	return ret;
+}
+
+static void qcom_battmgr_host_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(to_delayed_work(work), struct qcom_battmgr,
+						  host_work);
+	bool inhibit, changed = false;
+	int epoch, ret;
+
+	mutex_lock(&battmgr->lock);
+	epoch = atomic_read(&battmgr->host_epoch);
+	if (battmgr->host_pd_restop) {
+		ret = qcom_battmgr_host_pd_reapply_stop(battmgr, epoch);
+		if (ret)
+			goto out;
+		changed = true;
+	}
+	ret = qcom_battmgr_host_prepare(battmgr, epoch);
+	if (ret)
+		goto out;
+	/* Refresh the notification gate even when user space is suspended. */
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+	if (ret)
+		goto out;
+	qcom_battmgr_host_pd_connection(battmgr, epoch);
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CAPACITY);
+	if (ret)
+		goto out;
+	if (battmgr->status.percent > 100) {
+		ret = -ERANGE;
+		goto out;
+	}
+
+	inhibit = qcom_battmgr_host_should_inhibit(battmgr->status.percent,
+		battmgr->info.charge_ctrl_start, battmgr->info.charge_ctrl_end,
+		battmgr->host_inhibited && !battmgr->host_threshold_changed);
+	if (battmgr->host_rate_valid && battmgr->host_rate_epoch == epoch &&
+	    inhibit == battmgr->host_inhibited)
+		goto applied;
+	if (!inhibit) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH);
+		if (ret || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD)
+			goto out;
+	}
+	ret = qcom_battmgr_host_set_rate(battmgr, inhibit, epoch);
+	if (ret)
+		goto out;
+	changed = true;
+applied:
+	battmgr->host_threshold_changed = false;
+	if (inhibit)
+		ret = qcom_battmgr_host_pd_upgrade(battmgr, epoch);
+	else
+		battmgr->host_pd_pending = false;
+out:
+	mutex_unlock(&battmgr->lock);
+	if (ret && ret != -EAGAIN)
+		dev_err_ratelimited(battmgr->dev, "host charge limit update failed: %d\n", ret);
+	if (changed)
+		power_supply_changed(battmgr->bat_psy);
+}
+
+static int qcom_battmgr_host_set_threshold(struct qcom_battmgr *battmgr,
+					 bool set_start, int value)
+{
+	u32 start, end;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_host_prepare(battmgr, atomic_read(&battmgr->host_epoch));
+	if (ret)
+		goto out;
+	start = battmgr->info.charge_ctrl_start;
+	end = battmgr->info.charge_ctrl_end;
+	if (set_start) {
+		start = clamp(value, CHARGE_CTRL_START_THR_MIN, CHARGE_CTRL_START_THR_MAX);
+		if (start > end)
+			end = min_t(u32, start + CHARGE_CTRL_DELTA_SOC, CHARGE_CTRL_END_THR_MAX);
+	} else {
+		end = clamp(value, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
+		if (start >= end)
+			start = end - CHARGE_CTRL_DELTA_SOC;
+	}
+	if (start == battmgr->info.charge_ctrl_start && end == battmgr->info.charge_ctrl_end)
+		goto out;
+	ret = qcom_battmgr_set_charge_control(battmgr, end, end - start);
+	if (ret) {
+		/* A timed-out request might still have persisted: reload before retrying. */
+		battmgr->host_ready = false;
+		goto out;
+	}
+	if (end != battmgr->info.charge_ctrl_end)
+		battmgr->host_threshold_changed = true;
+	battmgr->info.charge_ctrl_start = start;
+	battmgr->info.charge_ctrl_end = end;
+out:
+	mutex_unlock(&battmgr->lock);
+	qcom_battmgr_host_queue(battmgr);
+	return ret;
+}
+
+static void qcom_battmgr_host_stop(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	WRITE_ONCE(battmgr->host_stopping, true);
+	/* Also reject a late enqueue from an in-flight notification callback. */
