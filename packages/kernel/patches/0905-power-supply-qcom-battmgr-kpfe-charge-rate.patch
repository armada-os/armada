 };
 
+static int qcom_battmgr_host_get(struct qcom_battmgr *battmgr, int opcode, int property)
+{
+	int ret = qcom_battmgr_request_property(battmgr, opcode, property, 0);
+
+	return ret > 0 ? -EIO : ret;
+}
+
+/* Only report a hold when the acknowledged stop agrees with live telemetry. */
+static int qcom_battmgr_host_read_status(struct qcom_battmgr *battmgr,
+				       union power_supply_propval *val)
+{
+	static const unsigned int props[] = { BATT_HEALTH, BATT_CAPACITY, BATT_CURR_NOW };
+	int epoch, i, ret;
+
+	mutex_lock(&battmgr->lock);
+	epoch = atomic_read(&battmgr->host_epoch);
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_STATUS);
+	if (ret)
+		goto out;
+
+	val->intval = battmgr->status.status;
+	if (!READ_ONCE(battmgr->service_up) || !battmgr->host_ready ||
+	    battmgr->host_ready_epoch != epoch || !battmgr->host_rate_valid ||
+	    battmgr->host_rate_epoch != epoch || !battmgr->host_inhibited ||
+	    battmgr->info.charge_ctrl_end == CHARGE_CTRL_END_THR_MAX ||
+	    (val->intval != POWER_SUPPLY_STATUS_DISCHARGING &&
+	     val->intval != POWER_SUPPLY_STATUS_NOT_CHARGING))
+		goto out;
+
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, props[i]);
+		if (ret)
+			goto out;
+	}
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+	if (!ret && epoch == atomic_read(&battmgr->host_epoch) && battmgr->usb.online &&
+	    battmgr->status.health == POWER_SUPPLY_HEALTH_GOOD &&
+	    battmgr->status.percent <= 100 &&
+	    battmgr->status.current_now >= -50000 && battmgr->status.current_now <= 50000)
+		val->intval = battmgr->status.percent >= battmgr->info.charge_ctrl_end ?
+			POWER_SUPPLY_STATUS_FULL : POWER_SUPPLY_STATUS_NOT_CHARGING;
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
