+/* Retain the last policy decision between thresholds, including while unplugged. */
+static bool qcom_battmgr_host_should_inhibit(unsigned int soc, unsigned int start,
+					    unsigned int end, bool inhibited)
+{
+	if (end == CHARGE_CTRL_END_THR_MAX)
+		return false;
+	if (soc >= end)
+		return true;
+	if (soc <= start)
+		return false;
+	return inhibited;
+}
+
+/* Called with the request mutex held. Firmware retains thresholds when disabled. */
+static int qcom_battmgr_host_prepare(struct qcom_battmgr *battmgr, int epoch)
+{
+	u32 start, end;
+	int ret;
+
+	if (!READ_ONCE(battmgr->service_up) || READ_ONCE(battmgr->host_stopping))
+		return -EAGAIN;
+	if (battmgr->host_ready && battmgr->host_ready_epoch == epoch)
+		return 0;
+
+	battmgr->host_ready = false;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_START_THR);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_END_THR);
+	if (ret)
+		return ret;
+	start = battmgr->info.charge_ctrl_start;
+	end = battmgr->info.charge_ctrl_end;
+	if (start < CHARGE_CTRL_START_THR_MIN || start > CHARGE_CTRL_START_THR_MAX ||
+	    end < CHARGE_CTRL_END_THR_MIN || end > CHARGE_CTRL_END_THR_MAX || start > end)
+		return -ERANGE;
+
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_EN);
+	if (ret)
+		return ret;
+	if (battmgr->native_limit_enabled) {
+		ret = qcom_battmgr_set_charge_control(battmgr, end, end - start);
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_CTRL_EN);
+		if (ret)
+			return ret;
+		if (battmgr->native_limit_enabled)
+			return -EIO;
+	}
+	if (epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+
+	battmgr->host_ready_epoch = epoch;
+	battmgr->host_ready = true;
+	return 0;
+}
+
+static void qcom_battmgr_host_queue(struct qcom_battmgr *battmgr)
+{
+	if (!battmgr->host_charge_limit || READ_ONCE(battmgr->host_stopping))
+		return;
+	/* GLINK notifications can be handled while user space remains suspended. */
+	pm_wakeup_event(battmgr->dev, 5000);
+	schedule_work(&battmgr->host_work);
+}
+
+/* Caller holds the request mutex. The ACK is scoped to this service lifetime. */
+static int qcom_battmgr_host_set_rate(struct qcom_battmgr *battmgr, bool inhibit, int epoch)
+{
+	struct qcom_battmgr_charge_rate_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_SET_CHARGE_RATE),
+		.battery_id = cpu_to_le32(0),
+		.charge_rate = cpu_to_le32(inhibit ? 0 : 100),
+		.charging_path = cpu_to_le32(0),
+	};
+	int ret;
+
+	battmgr->host_rate_valid = false;
+	if (!READ_ONCE(battmgr->service_up) || epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	if (ret)
+		return ret;
+	if (epoch != atomic_read(&battmgr->host_epoch))
+		return -EAGAIN;
+
+	battmgr->host_inhibited = inhibit;
+	battmgr->host_rate_epoch = epoch;
+	battmgr->host_rate_valid = true;
+	return 0;
+}
+
+static void qcom_battmgr_host_worker(struct work_struct *work)
+{
+	struct qcom_battmgr *battmgr = container_of(work, struct qcom_battmgr, host_work);
+	bool inhibit, changed = false;
+	int epoch, ret;
+
+	mutex_lock(&battmgr->lock);
+	epoch = atomic_read(&battmgr->host_epoch);
+	ret = qcom_battmgr_host_prepare(battmgr, epoch);
+	if (ret)
+		goto out;
+	/* Refresh the notification gate even when user space is suspended. */
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE);
+	if (ret)
+		goto out;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CAPACITY);
+	if (ret)
+		goto out;
+	if (battmgr->status.percent > 100) {
+		ret = -ERANGE;
+		goto out;
+	}
+
+	inhibit = qcom_battmgr_host_should_inhibit(battmgr->status.percent,
+		battmgr->info.charge_ctrl_start, battmgr->info.charge_ctrl_end,
+		battmgr->host_inhibited && !battmgr->host_threshold_changed);
+	if (battmgr->host_rate_valid && battmgr->host_rate_epoch == epoch &&
+	    inhibit == battmgr->host_inhibited)
+		goto applied;
+	if (!inhibit) {
+		ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH);
+		if (ret || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD)
+			goto out;
+	}
+	ret = qcom_battmgr_host_set_rate(battmgr, inhibit, epoch);
+	if (ret)
+		goto out;
+	changed = true;
+applied:
+	battmgr->host_threshold_changed = false;
+out:
+	mutex_unlock(&battmgr->lock);
+	if (ret && ret != -EAGAIN)
+		dev_err_ratelimited(battmgr->dev, "host charge limit update failed: %d\n", ret);
+	if (changed)
+		power_supply_changed(battmgr->bat_psy);
+}
+
+static int qcom_battmgr_host_set_threshold(struct qcom_battmgr *battmgr,
+					 bool set_start, int value)
+{
+	u32 start, end;
+	int ret;
+
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_host_prepare(battmgr, atomic_read(&battmgr->host_epoch));
+	if (ret)
+		goto out;
+	start = battmgr->info.charge_ctrl_start;
+	end = battmgr->info.charge_ctrl_end;
+	if (set_start) {
+		start = clamp(value, CHARGE_CTRL_START_THR_MIN, CHARGE_CTRL_START_THR_MAX);
+		if (start > end)
+			end = min_t(u32, start + CHARGE_CTRL_DELTA_SOC, CHARGE_CTRL_END_THR_MAX);
+	} else {
+		end = clamp(value, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
+		if (start >= end)
+			start = end - CHARGE_CTRL_DELTA_SOC;
+	}
+	if (start == battmgr->info.charge_ctrl_start && end == battmgr->info.charge_ctrl_end)
+		goto out;
+	ret = qcom_battmgr_set_charge_control(battmgr, end, end - start);
+	if (ret) {
+		/* A timed-out request might still have persisted: reload before retrying. */
+		battmgr->host_ready = false;
+		goto out;
+	}
+	if (end != battmgr->info.charge_ctrl_end)
+		battmgr->host_threshold_changed = true;
+	battmgr->info.charge_ctrl_start = start;
+	battmgr->info.charge_ctrl_end = end;
+out:
+	mutex_unlock(&battmgr->lock);
+	qcom_battmgr_host_queue(battmgr);
+	return ret;
+}
+
+static void qcom_battmgr_host_stop(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	WRITE_ONCE(battmgr->host_stopping, true);
+	/* Also reject a late enqueue from an in-flight notification callback. */
+	disable_work_sync(&battmgr->host_work);
+	disable_work_sync(&battmgr->enable_work);
+}
+
+static void qcom_battmgr_host_disable_wakeup(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+
+	device_init_wakeup(battmgr->dev, false);
+}
+
+static void qcom_battmgr_host_shutdown(struct auxiliary_device *adev)
+{
+	struct qcom_battmgr *battmgr = auxiliary_get_drvdata(adev);
+	int ret;
+
+	if (!battmgr || !battmgr->host_charge_limit)
+		return;
+	qcom_battmgr_host_stop(battmgr);
+	mutex_lock(&battmgr->lock);
+	if (!READ_ONCE(battmgr->service_up))
+		goto out;
+	ret = qcom_battmgr_host_get(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH);
+	if (ret || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD)
+		goto out;
+	if (battmgr->host_inhibited || !battmgr->host_rate_valid)
+		qcom_battmgr_host_set_rate(battmgr, false, atomic_read(&battmgr->host_epoch));
+out:
+	mutex_unlock(&battmgr->lock);
+}
+
 static int qcom_battmgr_set_charge_start_threshold(struct qcom_battmgr *battmgr, int start_soc)
 {
 	u32 target_soc, delta_soc;
 	int ret;
+
+	if (battmgr->host_charge_limit)
+		return qcom_battmgr_host_set_threshold(battmgr, true, start_soc);
 
 	start_soc = clamp(start_soc, CHARGE_CTRL_START_THR_MIN, CHARGE_CTRL_START_THR_MAX);
 
@@ -722,6 +1020,9 @@
 {
 	u32 delta_soc = CHARGE_CTRL_DELTA_SOC;
 	int ret;
+
+	if (battmgr->host_charge_limit)
+		return qcom_battmgr_host_set_threshold(battmgr, false, end_soc);
 
 	end_soc = clamp(end_soc, CHARGE_CTRL_END_THR_MIN, CHARGE_CTRL_END_THR_MAX);
 
@@ -1245,9 +1546,14 @@
 	case NOTIF_BAT_STATUS:
 	case NOTIF_BAT_PROPERTY:
 	case NOTIF_BAT_CHARGING_STATE:
+		if (READ_ONCE(battmgr->usb.online) &&
+		    READ_ONCE(battmgr->info.charge_ctrl_end) < CHARGE_CTRL_END_THR_MAX)
+			qcom_battmgr_host_queue(battmgr);
 		power_supply_changed(battmgr->bat_psy);
 		break;
 	case NOTIF_USB_PROPERTY:
+		if (READ_ONCE(battmgr->info.charge_ctrl_end) < CHARGE_CTRL_END_THR_MAX)
