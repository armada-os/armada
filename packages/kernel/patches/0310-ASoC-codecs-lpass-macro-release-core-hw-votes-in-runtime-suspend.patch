From: seilent <github@seilent.net>
Subject: [PATCH] ASoC: codecs: lpass-macro: release core HW votes in runtime suspend on Pocket MICRO 2

The rx, tx, wsa and va macros take the macro and dcodec LPASS core
votes at probe and hold them for the device lifetime, so the ADSP never
power collapses. On the AYANEO Pocket MICRO 2 drop them in runtime
suspend and take them again in runtime resume.

---
diff --git a/sound/soc/codecs/lpass-rx-macro.c b/sound/soc/codecs/lpass-rx-macro.c
index e9e557e03..48d3807aa 100644
--- a/sound/soc/codecs/lpass-rx-macro.c
+++ b/sound/soc/codecs/lpass-rx-macro.c
@@ -13,6 +13,7 @@
 #include <sound/pcm_params.h>
 #include <sound/soc-dapm.h>
 #include <sound/tlv.h>
+#include <linux/of.h>
 #include <linux/of_clk.h>
 #include <linux/clk-provider.h>
 
@@ -666,6 +667,7 @@ struct rx_macro {
 	struct clk *npl;
 	struct clk *macro;
 	struct clk *dcodec;
+	bool drop_core_votes;
 	struct clk *fsgen;
 	struct clk_hw hw;
 };
@@ -3913,6 +3915,7 @@ static int rx_macro_probe(struct platform_device *pdev)
 		return PTR_ERR(rx->regmap);
 
 	dev_set_drvdata(dev, rx);
+	rx->drop_core_votes = of_machine_is_compatible("ayaneo,pocket-micro2");
 
 	rx->dev = dev;
 
@@ -4030,6 +4033,11 @@ static int rx_macro_runtime_suspend(struct device *dev)
 	clk_disable_unprepare(rx->npl);
 	clk_disable_unprepare(rx->mclk);
 
+	if (rx->drop_core_votes) {
+		clk_disable_unprepare(rx->dcodec);
+		clk_disable_unprepare(rx->macro);
+	}
+
 	return 0;
 }
 
@@ -4038,10 +4046,20 @@ static int rx_macro_runtime_resume(struct device *dev)
 	struct rx_macro *rx = dev_get_drvdata(dev);
 	int ret;
 
+	if (rx->drop_core_votes) {
+		ret = clk_prepare_enable(rx->macro);
+		if (ret)
+			return ret;
+
+		ret = clk_prepare_enable(rx->dcodec);
+		if (ret)
+			goto err_dcodec;
+	}
+
 	ret = clk_prepare_enable(rx->mclk);
 	if (ret) {
 		dev_err(dev, "unable to prepare mclk\n");
-		return ret;
+		goto err_mclk;
 	}
 
 	ret = clk_prepare_enable(rx->npl);
@@ -4063,6 +4081,12 @@ static int rx_macro_runtime_resume(struct device *dev)
 	clk_disable_unprepare(rx->npl);
 err_npl:
 	clk_disable_unprepare(rx->mclk);
+err_mclk:
+	if (rx->drop_core_votes)
+		clk_disable_unprepare(rx->dcodec);
+err_dcodec:
+	if (rx->drop_core_votes)
+		clk_disable_unprepare(rx->macro);
 
 	return ret;
 }
