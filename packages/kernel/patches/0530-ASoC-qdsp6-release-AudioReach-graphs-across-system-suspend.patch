 static const struct snd_pcm_hardware q6apm_dai_hardware_capture = {
 	.info =                 (SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_BLOCK_TRANSFER |
 				 SNDRV_PCM_INFO_MMAP_VALID | SNDRV_PCM_INFO_INTERLEAVED |
-				 SNDRV_PCM_INFO_PAUSE | SNDRV_PCM_INFO_RESUME |
+				 SNDRV_PCM_INFO_PAUSE |
 				 SNDRV_PCM_INFO_NO_REWINDS | SNDRV_PCM_INFO_SYNC_APPLPTR |
 				 SNDRV_PCM_INFO_BATCH),
 	.formats =              (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE),
@@ -110,7 +110,7 @@ static const struct snd_pcm_hardware q6apm_dai_hardware_capture = {
 static const struct snd_pcm_hardware q6apm_dai_hardware_playback = {
 	.info =                 (SNDRV_PCM_INFO_MMAP | SNDRV_PCM_INFO_BLOCK_TRANSFER |
 				 SNDRV_PCM_INFO_MMAP_VALID | SNDRV_PCM_INFO_INTERLEAVED |
-				 SNDRV_PCM_INFO_PAUSE | SNDRV_PCM_INFO_RESUME |
+				 SNDRV_PCM_INFO_PAUSE |
 				 SNDRV_PCM_INFO_NO_REWINDS | SNDRV_PCM_INFO_SYNC_APPLPTR |
 				 SNDRV_PCM_INFO_BATCH),
 	.formats =              (SNDRV_PCM_FMTBIT_S16_LE | SNDRV_PCM_FMTBIT_S24_LE),
@@ -211,6 +211,19 @@ static void event_handler_compr(uint32_t opcode, uint32_t token,
 	}
 }
 
+static void q6apm_dai_release_graph(struct q6apm_dai_rtd *prtd, int stream)
+{
+	if (prtd->state)
+		q6apm_graph_stop(prtd->graph);
+	q6apm_free_fragments(prtd->graph, stream);
+	q6apm_graph_close(prtd->graph);
+	prtd->graph = NULL;
+	prtd->state = Q6APM_STREAM_IDLE;
+	prtd->queue_ptr = 0;
+	prtd->last_pos_index = 0;
+	prtd->push_pull_size = 0;
+}
+
 static int q6apm_dai_prepare(struct snd_soc_component *component,
 			     struct snd_pcm_substream *substream)
 {
@@ -240,8 +253,10 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 		/* clear the previous setup if any  */
 		q6apm_graph_stop(prtd->graph);
 		q6apm_free_fragments(prtd->graph, substream->stream);
+		prtd->state = Q6APM_STREAM_IDLE;
 	}
 
+	prtd->queue_ptr = 0;
 	prtd->last_pos_index = 0;
 	prtd->pcm_count = snd_pcm_lib_period_bytes(substream);
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
@@ -317,6 +332,10 @@ static int q6apm_dai_ack(struct snd_soc_component *component, struct snd_pcm_sub
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
 	int i, ret = 0, avail_periods;
 
+	/* SYNC_PTR can get here before prepare has allocated fragments */
+	if (!prtd->graph || prtd->state == Q6APM_STREAM_IDLE)
+		return 0;
+
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph))
 		return 0;
 
@@ -458,14 +477,8 @@ static int q6apm_dai_close(struct snd_soc_component *component,
 	struct snd_pcm_runtime *runtime = substream->runtime;
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
 
-	if (prtd->state) {
-		/* only stop graph that is started */
-		q6apm_graph_stop(prtd->graph);
-		q6apm_free_fragments(prtd->graph, substream->stream);
-	}
-
-	q6apm_graph_close(prtd->graph);
-	prtd->graph = NULL;
+	if (prtd->graph)
+		q6apm_dai_release_graph(prtd, substream->stream);
 	kfree(prtd);
 	runtime->private_data = NULL;
 
@@ -479,6 +492,9 @@ static snd_pcm_uframes_t q6apm_dai_pointer(struct snd_soc_component *component,
 	struct q6apm_dai_rtd *prtd = runtime->private_data;
 	snd_pcm_uframes_t ptr;
 
+	if (!prtd->graph)
+		return 0;
+
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
 		int retries = 10;
 		uint32_t index, fc1, fc2;
@@ -1001,6 +1017,72 @@ static const struct snd_compress_ops q6apm_dai_compress_ops = {
 	.copy		= q6apm_compr_copy,
 };
 
+/* Device PM: the card's device link orders this before the BE restores the sink graph */
+static void q6apm_dai_walk(struct snd_soc_component *component, bool release)
+{
+	struct snd_soc_pcm_runtime *rtd;
+	struct snd_pcm_substream *ss;
+	struct snd_soc_component *c;
+	struct q6apm_graph *graph;
+	int i, dir;
+
+	if (!component->card)
+		return;
+
+	for_each_card_rtds(component->card, rtd) {
+		if (!rtd->pcm)
+			continue;
+		guard(mutex)(&rtd->pcm->open_mutex);
+		for_each_rtd_components(rtd, i, c) {
+			if (c != component)
+				continue;
+			for (dir = 0; dir < 2; dir++) {
+				for (ss = rtd->pcm->streams[dir].substream; ss; ss = ss->next) {
+					struct q6apm_dai_rtd *prtd;
+
+					if (!ss->runtime)
+						continue;
+					prtd = ss->runtime->private_data;
+					if (!prtd)
+						continue;
+					if (release && prtd->graph) {
+						q6apm_dai_release_graph(prtd, dir);
+					} else if (!release && !prtd->graph) {
+						graph = q6apm_graph_open(component->dev, event_handler, prtd,
+									 snd_soc_rtd_to_cpu(rtd, 0)->driver->id,
+									 dir);
+						if (IS_ERR(graph))
+							dev_err(component->dev, "Failed to reopen graph (%ld)\n",
+								PTR_ERR(graph));
+						else
+							prtd->graph = graph;
+					}
+				}
+			}
+		}
+	}
+}
+
+static int q6apm_dai_suspend(struct device *dev)
+{
+	struct snd_soc_component *component = snd_soc_lookup_component(dev, NULL);
+
+	if (component)
+		q6apm_dai_walk(component, true);
+	return 0;
+}
+
+static int q6apm_dai_resume(struct device *dev)
+{
+	struct snd_soc_component *component = snd_soc_lookup_component(dev, NULL);
+
+	if (component)
+		q6apm_dai_walk(component, false);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(q6apm_dai_pm_ops, q6apm_dai_suspend, q6apm_dai_resume);
+
 static const struct snd_soc_component_driver q6apm_fe_dai_component = {
 	.name		= DRV_NAME,
 	.open		= q6apm_dai_open,
@@ -1052,6 +1134,7 @@ static struct platform_driver q6apm_dai_platform_driver = {
 	.driver = {
 		.name = "q6apm-dai",
 		.of_match_table = of_match_ptr(q6apm_dai_device_id),
+		.pm = pm_sleep_ptr(&q6apm_dai_pm_ops),
 	},
 	.probe = q6apm_dai_probe,
 };
diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
