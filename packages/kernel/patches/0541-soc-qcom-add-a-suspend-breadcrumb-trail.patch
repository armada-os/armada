From: Armada <noreply@armada.local>
Subject: [PATCH] soc: qcom: add a suspend breadcrumb trail

Debug aid for suspend hangs that end in a reset, where the kernel log and
trace buffers are lost with the hang.

Record the late system suspend/resume sequence into a reserved memory
region described by an "armada,suspend-trail" node:
- PM notifier and suspend_resume phases (dpm_*, CPU_OFF, syscore,
  machine_suspend), with the wakeup IRQ at post-suspend;
- PSCI domain idle entry and exit with the composite state;
- every RPMh TCS write (active votes from suspend prepare on, sleep and
  wake sets from the noirq phase on) and active-request completions;
- the APPS RSC power-domain notifier result, i.e. whether the sleep and
  wake sets were flushed before the domain collapsed;
- IRQs from the noirq phase until noirq resume.

Each record is 24 bytes and carries the arch counter and CPU. The next
boot prints the last 40 records of the previous trail and exposes the
whole trail in debugfs (suspend_trail/last and suspend_trail/current),
provided the reset kept DRAM contents.

On the Odin 3 every reset path loses DRAM, so a compact summary also goes
to a PMIC SDAM block, the first of the "armada,sdam" phandles that the
SPMI arbiter lets this EE write. It restarts at each suspend and holds
counters (s2idle entries, PSCI domain idle enter/exit overall and at
system level, RSC flushes with the last result and the sleep/wake
command counts), the last PSCI state, CPU and IRQ, each CPU's last idle
depth and whether it is still inside PSCI, and a ring of the last 96
one-byte stage codes. SDAM keeps its contents
across any reset short of losing the battery. The next boot logs the
summary and exposes it in suspend_trail/sdam_last (decoded) and
suspend_trail/sdam_last_raw.

Non-obvious choices:
- The ring counter lives in normal kernel memory; the reserved region is
  mapped write-combine and atomics on non-cacheable memory are not
  reliable.
- Records are written with a sentinel seq first and committed with a
  barrier, so a torn record from the moment of a hang is skipped.
- Only rpmh_rsc_pd_callback() is touched outside the new driver, to
  record the flush result; everything else uses existing tracepoints.
- Ownership is probed by writing back the first data byte unchanged,
  so a block another EE owns, and the previous boot's trail, are left
  untouched until a block is claimed.
- SDAM writes go through the PMIC regmap, which is fast_io over the
  raw-spinlocked SPMI arbiter, so they are safe from the idle path. TCS
  writes are only counted; each SDAM event costs one ring byte plus a
  30-byte header write.
---
diff --git a/drivers/soc/qcom/Kconfig b/drivers/soc/qcom/Kconfig
index 2b524154d9fb..a65812579d90 100644
--- a/drivers/soc/qcom/Kconfig
+++ b/drivers/soc/qcom/Kconfig
@@ -163,6 +163,20 @@ config QCOM_RPMH
 	  of hardware components aggregate requests for these resources and
 	  help apply the aggregated state on the resource.
 
+config QCOM_SUSPEND_TRAIL
+	bool "Qualcomm suspend breadcrumb trail"
+	depends on ARM64 && PM_SLEEP && TRACEPOINTS && DEBUG_FS
+	depends on QCOM_RPMH=y
+	help
+	  Record the late system suspend and resume sequence (PM phases,
+	  PSCI domain idle entry and exit, RPMh TCS writes and flushes, late
+	  IRQs) into a reserved memory region described by an
+	  "armada,suspend-trail" node. When a suspend hang ends in a reset
+	  that keeps DRAM contents, the next boot prints the tail of the
+	  previous trail and exposes it in debugfs.
+
+	  If unsure, say N.
+
 config QCOM_SMEM
 	tristate "Qualcomm Shared Memory Manager (SMEM)"
 	depends on HWSPINLOCK
diff --git a/drivers/soc/qcom/Makefile b/drivers/soc/qcom/Makefile
index 798643be3590..2a667b6e33fe 100644
--- a/drivers/soc/qcom/Makefile
+++ b/drivers/soc/qcom/Makefile
@@ -22,6 +22,7 @@ obj-$(CONFIG_QCOM_RPM_MASTER_STATS)	+= rpm_master_stats.o
 obj-$(CONFIG_QCOM_RPMH)		+= qcom_rpmh.o
 qcom_rpmh-y			+= rpmh-rsc.o
 qcom_rpmh-y			+= rpmh.o
+obj-$(CONFIG_QCOM_SUSPEND_TRAIL)	+= suspend-trail.o
 obj-$(CONFIG_QCOM_SMD_RPM)	+= rpm-proc.o smd-rpm.o
 qcom_smem-y			+= smem.o smem_dramc.o
 obj-$(CONFIG_QCOM_SMEM) +=	qcom_smem.o
diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index f881af35ecfc..95bc13508314 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -29,6 +29,7 @@
 
 #include <clocksource/arm_arch_timer.h>
 #include <soc/qcom/cmd-db.h>
+#include <soc/qcom/suspend-trail.h>
 #include <soc/qcom/tcs.h>
 #include <dt-bindings/soc/qcom,rpmh-rsc.h>
 
@@ -944,10 +945,15 @@ static int rpmh_rsc_pd_callback(struct notifier_block *nfb,
 				unsigned long action, void *v)
 {
 	struct rsc_drv *drv = container_of(nfb, struct rsc_drv, genpd_nb);
+	int ret = 0;
 
 	/* We don't need to lock as genpd on/off are serialized */
-	if ((action == GENPD_NOTIFY_PRE_OFF) &&
-	    (rpmh_rsc_ctrlr_is_busy(drv) || rpmh_flush(&drv->client)))
+	if (action == GENPD_NOTIFY_PRE_OFF)
+		ret = rpmh_rsc_ctrlr_is_busy(drv) ? -EAGAIN :
+		      rpmh_flush(&drv->client);
+
+	qcom_suspend_trail_late(QST_EV_RSC_PD, drv->id, action, ret);
+	if (ret)
 		return NOTIFY_BAD;
 
 	return NOTIFY_OK;
diff --git a/drivers/soc/qcom/suspend-trail.c b/drivers/soc/qcom/suspend-trail.c
new file mode 100644
index 000000000000..f3e5696db1fd
--- /dev/null
+++ b/drivers/soc/qcom/suspend-trail.c
@@ -0,0 +1,743 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Suspend breadcrumb trail for Qualcomm platforms.
+ *
+ * Records the late system suspend/resume sequence (PM phases, PSCI domain
+ * idle entry and exit, RPMh TCS writes and flushes, late IRQs) into a
+ * reserved memory region. If the system hangs and resets with DRAM contents
+ * intact, the next boot prints the tail of the previous trail and exposes
+ * all of it in debugfs, showing how far suspend or resume got.
+ */
+
+#define pr_fmt(fmt) "suspend-trail: " fmt
+
+#include <linux/debugfs.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/regmap.h>
+#include <linux/seq_file.h>
+#include <linux/spinlock.h>
+#include <linux/suspend.h>
+#include <linux/vmalloc.h>
+
+#include <asm/arch_timer.h>
+#include <clocksource/arm_arch_timer.h>
+#include <soc/qcom/suspend-trail.h>
+#include <trace/events/irq.h>
+#include <trace/events/power.h>
+
+#include "rpmh-internal.h"
+#include "trace-rpmh.h"
+
+#define TRAIL_MAGIC	0x4c525453	/* "STRL" */
+#define TRAIL_VERSION	1
+
+struct trail_hdr {
+	u32 magic;
+	u32 version;
+	u32 boot;
+	u32 nent;
+	u32 head;
+	u32 rsvd[11];
+};
+
+struct trail_entry {
+	u64 ts;
+	u32 seq;
+	u8 ev;
+	u8 cpu;
+	u16 x;
+	u32 a;
+	u32 b;
+};
+
+static const char * const sr_names[] = {
+	"?", "freeze_processes", "thaw_processes", "sync_filesystems",
+	"suspend_enter", "dpm_prepare", "dpm_suspend", "dpm_suspend_late",
+	"dpm_suspend_noirq", "CPU_OFF", "CPU_ON", "syscore_suspend",
+	"syscore_resume", "machine_suspend", "dpm_resume_noirq",
+	"dpm_resume_early", "dpm_resume", "dpm_complete",
+	"console_resume_all",
+};
+
+#define SR_DPM_SUSPEND_NOIRQ	8
+#define SR_MACHINE_SUSPEND	13
+#define SR_DPM_RESUME_NOIRQ	14
+
+static const char * const tcs_states[] = { "sleep", "wake", "active", "?" };
+static const char * const pd_actions[] = { "pre-off", "off", "pre-on", "on" };
+
+static struct trail_hdr *hdr;
+static struct trail_entry *ents;
+static u32 nent;
+static atomic_t trail_seq = ATOMIC_INIT(0);
+static bool trail_armed;
+static bool trail_late;
+
+static void *last_trail;
+static size_t trail_size;
+
+/*
+ * A compact copy of the trail in a PMIC SDAM block, which keeps its contents
+ * across resets that lose DRAM. Counters wrap at 8 bits; the ring holds the
+ * most recent stage codes.
+ */
+#define SDAM_DATA		0x40
+#define SDAM_MAGIC0		'S'
+#define SDAM_MAGIC1		'T'
+#define SDAM_RING_LEN		96
+
+/*
+ * Counters cover the last suspend cycle and wrap at 8 bits. cpu_state holds,
+ * per CPU, the last PSCI domain idle depth (1 CPU, 2 cluster, 3 system) with
+ * BIT(7) set while the CPU is inside the PSCI call.
+ */
+struct sdam_rec {
+	u8 magic[2];
+	u8 boot;
+	u8 n_s2idle;
+	__le16 idx;
+	u8 n_psci_enter;
+	u8 n_psci_exit;
+	u8 n_flush;
+	s8 flush_ret;
+	u8 last_cpu;
+	u8 n_irq;
+	__le32 psci_state;
+	__le16 irq_hwirq;
+	u8 n_sleep_cmds;
+	u8 n_wake_cmds;
+	u8 n_sys_enter;
+	u8 n_sys_exit;
+	u8 cpu_state[8];
+	u8 rsvd[2];
+	u8 ring[SDAM_RING_LEN];
+} __packed;
+static_assert(sizeof(struct sdam_rec) == 128);
+
+#define SDAM_HDR_LEN		offsetof(struct sdam_rec, rsvd)
+
+static struct device_node *trail_np;
+static struct regmap *sdam_map;
+static u32 sdam_base;
+static DEFINE_SPINLOCK(sdam_lock);
+static struct sdam_rec sdam_cur, sdam_prev;
+static struct debugfs_blob_wrapper sdam_prev_blob;
+static bool sdam_prev_valid;
+static u8 sdam_sleep_cmds, sdam_wake_cmds;
+
+static void sdam_note(u8 ev, u16 x, u32 a, u32 b);
+
+static void trail_record(u8 ev, u16 x, u32 a, u32 b)
+{
+	struct trail_entry *e;
+	u32 seq;
+
+	sdam_note(ev, x, a, b);
+
+	if (!hdr)
+		return;
+
+	seq = atomic_inc_return(&trail_seq) - 1;
+	e = &ents[seq % nent];
+	WRITE_ONCE(e->seq, U32_MAX);
+	WRITE_ONCE(e->ts, __arch_counter_get_cntvct());
+	WRITE_ONCE(e->ev, ev);
+	WRITE_ONCE(e->cpu, raw_smp_processor_id());
+	WRITE_ONCE(e->x, x);
+	WRITE_ONCE(e->a, a);
+	WRITE_ONCE(e->b, b);
+	wmb();
+	WRITE_ONCE(e->seq, seq);
+	WRITE_ONCE(hdr->head, seq + 1);
+	wmb();
+}
+
+void qcom_suspend_trail_late(u8 ev, u16 x, u32 a, u32 b)
+{
+	if (READ_ONCE(trail_late))
+		trail_record(ev, x, a, b);
+}
+
+static void probe_suspend_resume(void *data, const char *action, int val,
+				 bool start)
+{
+	unsigned int id;
+
+	if (!READ_ONCE(trail_armed))
+		return;
+
+	for (id = ARRAY_SIZE(sr_names) - 1; id > 0; id--)
+		if (!strcmp(action, sr_names[id]))
+			break;
+
+	if (id == SR_DPM_SUSPEND_NOIRQ && start)
+		WRITE_ONCE(trail_late, true);
+
+	trail_record(QST_EV_SR, start, id, val);
+
+	if (id == SR_DPM_RESUME_NOIRQ && !start)
+		WRITE_ONCE(trail_late, false);
+}
+
+static void probe_psci_enter(void *data, unsigned int cpu, unsigned int state,
+			     bool s2idle)
+{
+	qcom_suspend_trail_late(QST_EV_PSCI_ENTER, s2idle, state, cpu);
+}
+
+static void probe_psci_exit(void *data, unsigned int cpu, unsigned int state,
+			    bool s2idle)
+{
+	qcom_suspend_trail_late(QST_EV_PSCI_EXIT, s2idle, state, cpu);
+}
+
+static void probe_rpmh_send(void *data, struct rsc_drv *d, int m,
+			    enum rpmh_state state, int n, u32 h,
+			    const struct tcs_cmd *c)
+{
+	u16 x = (state & 0x3) | (m & 0xf) << 2 | (n & 0x1f) << 6 |
+		(c->wait ? BIT(11) : 0) | (d->id & 0xf) << 12;
+
+	if (state == RPMH_ACTIVE_ONLY_STATE) {
+		if (READ_ONCE(trail_armed))
+			trail_record(QST_EV_TCS, x, c->addr, c->data);
+	} else {
+		qcom_suspend_trail_late(QST_EV_TCS, x, c->addr, c->data);
+	}
+}
+
+static void probe_rpmh_tx_done(void *data, struct rsc_drv *d, int m,
+			       const struct tcs_request *r)
+{
+	if (READ_ONCE(trail_armed))
+		trail_record(QST_EV_TX_DONE, m, r->cmds[0].addr, r->num_cmds);
+}
+
+static void probe_irq_entry(void *data, int irq, struct irqaction *action)
+{
+	struct irq_data *d = irq_get_irq_data(irq);
+
+	qcom_suspend_trail_late(QST_EV_IRQ, 0, irq, d ? d->hwirq : 0);
+}
+
+static void sdam_note(u8 ev, u16 x, u32 a, u32 b)
+{
+	struct sdam_rec *r = &sdam_cur;
+	unsigned long flags;
+	u8 code, depth;
+	u16 idx;
+
+	if (!READ_ONCE(sdam_map))
+		return;
+
+	switch (ev) {
+	case QST_EV_PM:
+		code = a == PM_SUSPEND_PREPARE ? 0x01 : 0x02;
+		break;
+	case QST_EV_SR:
+		code = 0x10 + a * 2 + (x ? 0 : 1);
+		break;
+	case QST_EV_PSCI_ENTER:
+		code = 0x40;
+		break;
+	case QST_EV_PSCI_EXIT:
+		code = 0x41;
+		break;
+	case QST_EV_RSC_PD:
+		code = 0x50 + (a & 0x3) * 2 + (b ? 1 : 0);
+		break;
+	case QST_EV_IRQ:
+		code = 0x60;
+		break;
+	case QST_EV_TCS:
+		/* Only count the sleep/wake sets; they land at flush time. */
+		if ((x & 0x3) == RPMH_SLEEP_STATE)
+			sdam_sleep_cmds++;
+		else if ((x & 0x3) == RPMH_WAKE_ONLY_STATE)
+			sdam_wake_cmds++;
+		return;
+	default:
+		return;
+	}
+
+	spin_lock_irqsave(&sdam_lock, flags);
+
+	switch (ev) {
+	case QST_EV_SR:
+		if (a == SR_MACHINE_SUSPEND && x)
+			r->n_s2idle++;
+		break;
+	case QST_EV_PSCI_ENTER:
+		depth = ((a >> 24) & 0x3) + 1;
+		r->n_psci_enter++;
+		r->n_sys_enter += depth == 3;
+		r->last_cpu = b;
+		r->psci_state = cpu_to_le32(a);
+		r->cpu_state[b % ARRAY_SIZE(r->cpu_state)] = BIT(7) | depth;
+		break;
+	case QST_EV_PSCI_EXIT:
+		depth = ((a >> 24) & 0x3) + 1;
+		r->n_psci_exit++;
+		r->n_sys_exit += depth == 3;
+		r->last_cpu = b;
+		r->cpu_state[b % ARRAY_SIZE(r->cpu_state)] = depth;
+		break;
+	case QST_EV_RSC_PD:
+		if (a == GENPD_NOTIFY_PRE_OFF) {
+			r->n_flush++;
+			r->flush_ret = (s8)b;
+			r->n_sleep_cmds = sdam_sleep_cmds;
+			r->n_wake_cmds = sdam_wake_cmds;
+			sdam_sleep_cmds = 0;
+			sdam_wake_cmds = 0;
+		}
+		break;
+	case QST_EV_IRQ:
+		r->n_irq++;
+		r->irq_hwirq = cpu_to_le16(b);
+		break;
+	}
+
+	idx = le16_to_cpu(r->idx);
+	r->ring[idx % SDAM_RING_LEN] = code;
+	regmap_write(sdam_map, sdam_base + SDAM_DATA +
+		     offsetof(struct sdam_rec, ring) + idx % SDAM_RING_LEN,
+		     code);
+	r->idx = cpu_to_le16(idx + 1);
+	regmap_bulk_write(sdam_map, sdam_base + SDAM_DATA, r, SDAM_HDR_LEN);
+
+	spin_unlock_irqrestore(&sdam_lock, flags);
+}
+
+static const char *sdam_code_name(u8 code, char *buf, size_t len)
+{
+	if (code == 0x01)
+		return "pm-prepare";
+	if (code == 0x02)
+		return "pm-post";
+	if (code >= 0x12 && code < 0x10 + 2 * ARRAY_SIZE(sr_names)) {
+		snprintf(buf, len, "%s-%s", sr_names[(code - 0x10) / 2],
+			 code & 1 ? "end" : "begin");
+		return buf;
+	}
+	if (code == 0x40)
+		return "psci-enter";
+	if (code == 0x41)
+		return "psci-exit";
+	if (code >= 0x50 && code < 0x58) {
+		snprintf(buf, len, "rsc-%s%s", pd_actions[(code - 0x50) / 2],
+			 code & 1 ? "-FAILED" : "");
+		return buf;
+	}
+	if (code == 0x60)
+		return "irq";
+	snprintf(buf, len, "code-%#x", code);
+	return buf;
+}
+
+static void sdam_show(struct seq_file *m, const struct sdam_rec *r)
+{
+	unsigned int i, n, first, idx;
+	char name[40];
+
+	seq_printf(m,
+		   "boot %u s2idle %u psci-enter %u psci-exit %u flush %u (last ret %d, sleep cmds %u, wake cmds %u)\n",
+		   r->boot, r->n_s2idle, r->n_psci_enter, r->n_psci_exit,
+		   r->n_flush, r->flush_ret, r->n_sleep_cmds, r->n_wake_cmds);
+	seq_printf(m, "last psci state %#x on cpu%u, irqs %u (last hwirq %u)\n",
+		   le32_to_cpu(r->psci_state), r->last_cpu, r->n_irq,
+		   le16_to_cpu(r->irq_hwirq));
+	seq_printf(m, "system-level psci enter %u exit %u\n", r->n_sys_enter,
+		   r->n_sys_exit);
+	for (i = 0; i < ARRAY_SIZE(r->cpu_state); i++)
+		seq_printf(m, "cpu%u: %s depth %u\n", i,
+			   r->cpu_state[i] & BIT(7) ? "IN PSCI" : "out",
+			   r->cpu_state[i] & 0x7f);
+
+	idx = le16_to_cpu(r->idx);
+	n = min_t(unsigned int, idx, SDAM_RING_LEN);
+	first = idx - n;
+	seq_printf(m, "last %u of %u stage codes, oldest first:\n", n, idx);
+	for (i = first; i < idx; i++)
+		seq_printf(m, "  %3u %s\n", i,
+			   sdam_code_name(r->ring[i % SDAM_RING_LEN], name,
+					  sizeof(name)));
+}
+
+static int sdam_last_show(struct seq_file *m, void *unused)
+{
+	if (!sdam_prev_valid)
+		seq_puts(m, "no SDAM trail from the previous boot\n");
+	else
+		sdam_show(m, &sdam_prev);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sdam_last);
+
+static int sdam_current_show(struct seq_file *m, void *unused)
+{
+	struct sdam_rec r;
+	unsigned long flags;
+
+	spin_lock_irqsave(&sdam_lock, flags);
+	r = sdam_cur;
+	spin_unlock_irqrestore(&sdam_lock, flags);
+	sdam_show(m, &r);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(sdam_current);
+
+/*
+ * Claims an SDAM block if the SPMI arbiter lets this EE write it. Ownership is
+ * probed by writing back the first data byte unchanged, so blocks owned by
+ * other EEs and the previous trail are left untouched.
+ */
+static int sdam_claim(struct device_node *np)
+{
+	struct platform_device *pdev;
+	struct regmap *map;
+	char name[40];
+	unsigned int i, n, idx;
+	u32 base;
+
+	pdev = of_find_device_by_node(np);
+	if (!pdev)
+		return -EPROBE_DEFER;
+	map = dev_get_regmap(pdev->dev.parent, NULL);
+	put_device(&pdev->dev);
+	if (!map || of_property_read_u32(np, "reg", &base))
+		return -ENODEV;
+
+	if (regmap_bulk_read(map, base + SDAM_DATA, &sdam_prev,
+			     sizeof(sdam_prev)))
+		return -EIO;
+	if (regmap_write(map, base + SDAM_DATA, sdam_prev.magic[0])) {
+		pr_info("SDAM: %#x is not writable from this EE\n", base);
+		return -EPERM;
+	}
+
+	sdam_prev_valid = sdam_prev.magic[0] == SDAM_MAGIC0 &&
+			  sdam_prev.magic[1] == SDAM_MAGIC1;
+	if (sdam_prev_valid) {
+		pr_info("SDAM: previous boot %u: s2idle %u psci-enter %u psci-exit %u flush %u (ret %d, %u sleep/%u wake cmds), last psci state %#x cpu%u, irqs %u (hwirq %u)\n",
+			sdam_prev.boot, sdam_prev.n_s2idle,
+			sdam_prev.n_psci_enter, sdam_prev.n_psci_exit,
+			sdam_prev.n_flush, sdam_prev.flush_ret,
+			sdam_prev.n_sleep_cmds, sdam_prev.n_wake_cmds,
+			le32_to_cpu(sdam_prev.psci_state), sdam_prev.last_cpu,
+			sdam_prev.n_irq, le16_to_cpu(sdam_prev.irq_hwirq));
+		pr_info("SDAM: system-level psci enter %u exit %u, cpus in psci: %*phN\n",
+			sdam_prev.n_sys_enter, sdam_prev.n_sys_exit,
+			(int)sizeof(sdam_prev.cpu_state), sdam_prev.cpu_state);
+		idx = le16_to_cpu(sdam_prev.idx);
+		n = min_t(unsigned int, idx, 16);
+		for (i = idx - n; i != idx; i++)
+			pr_info("SDAM:   %3u %s\n", i,
+				sdam_code_name(sdam_prev.ring[i % SDAM_RING_LEN],
+					       name, sizeof(name)));
+	} else {
+		pr_info("SDAM: no trail from the previous boot\n");
+	}
+
+	memset(&sdam_cur, 0, sizeof(sdam_cur));
+	sdam_cur.magic[0] = SDAM_MAGIC0;
+	sdam_cur.magic[1] = SDAM_MAGIC1;
+	sdam_cur.boot = sdam_prev_valid ? sdam_prev.boot + 1 : 1;
+	if (regmap_bulk_write(map, base + SDAM_DATA, &sdam_cur,
+			      sizeof(sdam_cur))) {
+		pr_err("SDAM: cannot write %#x\n", base);
+		return -EIO;
+	}
+
+	sdam_base = base;
+	WRITE_ONCE(sdam_map, map);
+	pr_info("SDAM: recording to PMIC SDAM %#x\n", base);
+	return 0;
+}
+
+/* Claims the first usable "armada,sdam" block. Process context only. */
+static void sdam_resolve(void)
+{
+	struct device_node *np;
+	int i, ret;
+
+	if (sdam_map || !trail_np)
+		return;
+
+	for (i = 0; (np = of_parse_phandle(trail_np, "armada,sdam", i)); i++) {
+		ret = sdam_claim(np);
+		of_node_put(np);
+		/* Keep the order stable across boots: wait for an earlier block. */
+		if (!ret || ret == -EPROBE_DEFER)
+			return;
+	}
+}
+
+static int __init qcom_suspend_trail_sdam_init(void)
+{
+	sdam_resolve();
+	return 0;
+}
+late_initcall_sync(qcom_suspend_trail_sdam_init);
+
+/* Restarts the SDAM record so it describes only the coming suspend. */
+static void sdam_new_cycle(void)
+{
+	unsigned long flags;
+
+	if (!sdam_map)
+		return;
+
+	spin_lock_irqsave(&sdam_lock, flags);
+	memset(&sdam_cur.n_s2idle, 0,
+	       sizeof(sdam_cur) - offsetof(struct sdam_rec, n_s2idle));
+	sdam_sleep_cmds = 0;
+	sdam_wake_cmds = 0;
+	regmap_bulk_write(sdam_map, sdam_base + SDAM_DATA, &sdam_cur,
+			  sizeof(sdam_cur));
+	spin_unlock_irqrestore(&sdam_lock, flags);
+}
+
+static int trail_pm_notify(struct notifier_block *nb, unsigned long action,
+			   void *unused)
+{
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+		sdam_resolve();
+		sdam_new_cycle();
+		WRITE_ONCE(trail_armed, true);
+		trail_record(QST_EV_PM, 0, action, 0);
+		break;
+	case PM_POST_SUSPEND:
+		trail_record(QST_EV_PM, 0, action, pm_wakeup_irq());
+		WRITE_ONCE(trail_late, false);
+		WRITE_ONCE(trail_armed, false);
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block trail_pm_nb = {
+	.notifier_call = trail_pm_notify,
+};
+
+static int trail_format(char *buf, size_t len, const struct trail_entry *e,
+			u32 rate)
+{
+	u64 sec = div_u64(e->ts, rate);
+	u64 usec = div_u64((e->ts - sec * rate) * USEC_PER_SEC, rate);
+	int n;
+
+	n = scnprintf(buf, len, "%8u %5llu.%06llu cpu%u ", e->seq, sec, usec,
+		      e->cpu);
+
+	switch (e->ev) {
+	case QST_EV_BOOT:
+		n += scnprintf(buf + n, len - n, "boot %u", e->a);
+		break;
+	case QST_EV_PM:
+		n += scnprintf(buf + n, len - n, "pm %s wakeup_irq=%u",
+			       e->a == PM_SUSPEND_PREPARE ? "suspend-prepare" :
+			       e->a == PM_POST_SUSPEND ? "post-suspend" : "?",
+			       e->b);
+		break;
+	case QST_EV_SR:
+		n += scnprintf(buf + n, len - n, "%s %s val=%d",
+			       e->a < ARRAY_SIZE(sr_names) ? sr_names[e->a] : "?",
+			       e->x ? "begin" : "end", (int)e->b);
+		break;
+	case QST_EV_PSCI_ENTER:
+	case QST_EV_PSCI_EXIT:
+		n += scnprintf(buf + n, len - n, "psci-%s state=%#x s2idle=%u",
+			       e->ev == QST_EV_PSCI_ENTER ? "enter" : "exit",
+			       e->a, e->x);
+		break;
+	case QST_EV_TCS:
+		n += scnprintf(buf + n, len - n,
+			       "tcs %s drv%u tcs%u cmd%u addr=%#x data=%#x%s",
+			       tcs_states[e->x & 0x3], e->x >> 12,
+			       (e->x >> 2) & 0xf, (e->x >> 6) & 0x1f, e->a, e->b,
+			       e->x & BIT(11) ? " wait" : "");
+		break;
+	case QST_EV_TX_DONE:
+		n += scnprintf(buf + n, len - n, "tx-done tcs%u addr=%#x n=%u",
+			       e->x, e->a, e->b);
+		break;
+	case QST_EV_IRQ:
+		n += scnprintf(buf + n, len - n, "irq %u hwirq %u", e->a, e->b);
+		break;
+	case QST_EV_RSC_PD:
+		n += scnprintf(buf + n, len - n, "rsc%u-pd %s ret=%d", e->x,
+			       e->a < ARRAY_SIZE(pd_actions) ?
+			       pd_actions[e->a] : "?", (int)e->b);
+		break;
+	default:
+		n += scnprintf(buf + n, len - n, "ev%u x=%#x a=%#x b=%#x",
+			       e->ev, e->x, e->a, e->b);
+		break;
+	}
+
+	return n;
+}
+
+/* Calls fn on each surviving entry of a trail image, oldest first. */
+static void trail_walk(const void *image,
+		       void (*fn)(const struct trail_entry *e, void *arg),
+		       void *arg, u32 max)
+{
+	const struct trail_hdr *h = image;
+	const struct trail_entry *es = image + sizeof(*h);
+	u32 newest = 0, first, s, i;
+	bool any = false;
+
+	for (i = 0; i < h->nent; i++) {
+		if (!es[i].ev || es[i].seq == U32_MAX)
+			continue;
+		if (!any || es[i].seq > newest)
+			newest = es[i].seq;
+		any = true;
+	}
+	if (!any)
+		return;
+
+	first = newest + 1 > h->nent ? newest + 1 - h->nent : 0;
+	if (max && newest + 1 - first > max)
+		first = newest + 1 - max;
+
+	for (s = first; s <= newest; s++) {
+		const struct trail_entry *e = &es[s % h->nent];
+
+		if (e->ev && e->seq == s)
+			fn(e, arg);
+	}
+}
+
+static void trail_show_entry(const struct trail_entry *e, void *arg)
+{
+	struct seq_file *m = arg;
+	char buf[128];
+
+	trail_format(buf, sizeof(buf), e, arch_timer_get_rate());
+	seq_printf(m, "%s\n", buf);
+}
+
+static int trail_last_show(struct seq_file *m, void *unused)
+{
+	if (!last_trail) {
+		seq_puts(m, "no trail from the previous boot\n");
+		return 0;
+	}
+
+	seq_printf(m, "boot %u\n", ((struct trail_hdr *)last_trail)->boot);
+	trail_walk(last_trail, trail_show_entry, m, 0);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(trail_last);
+
+static int trail_current_show(struct seq_file *m, void *unused)
+{
+	void *image = vmalloc(trail_size);
+
+	if (!image)
+		return -ENOMEM;
+
+	memcpy(image, hdr, trail_size);
+	seq_printf(m, "boot %u\n", hdr->boot);
+	trail_walk(image, trail_show_entry, m, 0);
+	vfree(image);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(trail_current);
+
+static void trail_print_entry(const struct trail_entry *e, void *arg)
+{
+	char buf[128];
+
+	trail_format(buf, sizeof(buf), e, arch_timer_get_rate());
+	pr_info("  %s\n", buf);
+}
+
+static int __init qcom_suspend_trail_init(void)
+{
+	struct device_node *np;
+	struct resource res;
+	struct dentry *dir;
+	u32 boot = 0;
+	void *base;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "armada,suspend-trail");
+	if (!np)
+		return 0;
+
+	trail_np = np;
+	ret = of_address_to_resource(np, 0, &res);
+	if (ret)
+		return ret;
+
+	trail_size = resource_size(&res);
+	if (trail_size < sizeof(*hdr) + 64 * sizeof(*ents))
+		return -EINVAL;
+
+	base = memremap(res.start, trail_size, MEMREMAP_WC);
+	if (!base)
+		return -ENOMEM;
+
+	nent = (trail_size - sizeof(*hdr)) / sizeof(*ents);
+
+	if (((struct trail_hdr *)base)->magic == TRAIL_MAGIC &&
+	    ((struct trail_hdr *)base)->version == TRAIL_VERSION &&
+	    ((struct trail_hdr *)base)->nent == nent) {
+		last_trail = vmalloc(trail_size);
+		if (last_trail) {
+			memcpy(last_trail, base, trail_size);
+			boot = ((struct trail_hdr *)last_trail)->boot;
+			pr_info("previous boot %u left %u events, last 40:\n",
+				boot, ((struct trail_hdr *)last_trail)->head);
+			trail_walk(last_trail, trail_print_entry, NULL, 40);
+		}
+	} else {
+		pr_info("no trail from the previous boot\n");
+	}
+
+	memset(base, 0, trail_size);
+	hdr = base;
+	ents = base + sizeof(*hdr);
+	hdr->magic = TRAIL_MAGIC;
+	hdr->version = TRAIL_VERSION;
+	hdr->boot = boot + 1;
+	hdr->nent = nent;
+	wmb();
+
+	trail_record(QST_EV_BOOT, 0, hdr->boot, 0);
+
+	WARN_ON(register_trace_suspend_resume(probe_suspend_resume, NULL));
+	WARN_ON(register_trace_psci_domain_idle_enter(probe_psci_enter, NULL));
+	WARN_ON(register_trace_psci_domain_idle_exit(probe_psci_exit, NULL));
+	WARN_ON(register_trace_rpmh_send_msg(probe_rpmh_send, NULL));
+	WARN_ON(register_trace_rpmh_tx_done(probe_rpmh_tx_done, NULL));
+	WARN_ON(register_trace_irq_handler_entry(probe_irq_entry, NULL));
+	register_pm_notifier(&trail_pm_nb);
+
+	dir = debugfs_create_dir("suspend_trail", NULL);
+	debugfs_create_file("last", 0400, dir, NULL, &trail_last_fops);
+	debugfs_create_file("current", 0400, dir, NULL, &trail_current_fops);
+	debugfs_create_file("sdam_last", 0400, dir, NULL, &sdam_last_fops);
+	debugfs_create_file("sdam_current", 0400, dir, NULL, &sdam_current_fops);
+	sdam_prev_blob.data = &sdam_prev;
+	sdam_prev_blob.size = sizeof(sdam_prev);
+	debugfs_create_blob("sdam_last_raw", 0400, dir, &sdam_prev_blob);
+
+	pr_info("%u entries at %pa\n", nent, &res.start);
+	return 0;
+}
+subsys_initcall(qcom_suspend_trail_init);
