+                &cts_data->fw_upgrade_work, msecs_to_jiffies(15000));
+    } else if (!READ_ONCE(cts_data->firmware_ready)) {
+        queue_delayed_work(cts_data->workqueue, &cts_data->fw_upgrade_work, 0);
+        ret = 0;
+    } else {
