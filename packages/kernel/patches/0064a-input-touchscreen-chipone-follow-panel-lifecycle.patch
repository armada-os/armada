+    }
+    if (ret)
+        dev_err(cts_data->device, "Panel preparation failed: %d\n", ret);
 }
 
+static int cts_panel_prepared(struct drm_panel_follower *follower)
+{
+    struct chipone_ts_data *cts_data =
+        container_of(follower, struct chipone_ts_data, panel_follower);
+    struct cts_platform_data *pdata = cts_data->pdata;
+    unsigned long flags;
+
+    down_write(&pdata->panel_io_lock);
+    pdata->panel_powered = true;
+    up_write(&pdata->panel_io_lock);
+    spin_lock_irqsave(&pdata->irq_lock, flags);
+    pdata->irq_blocked = false;
+    spin_unlock_irqrestore(&pdata->irq_lock, flags);
+    queue_work(cts_data->workqueue, &cts_data->ts_resume_work);
+    return 0;
+}
+
+static int cts_panel_unpreparing(struct drm_panel_follower *follower)
+{
+    struct chipone_ts_data *cts_data =
+        container_of(follower, struct chipone_ts_data, panel_follower);
+    struct cts_platform_data *pdata = cts_data->pdata;
+    unsigned long flags;
+    int ret = 0;
+
+    mutex_lock(&pdata->start_lock);
+    spin_lock_irqsave(&pdata->irq_lock, flags);
+    pdata->irq_blocked = true;
+    spin_unlock_irqrestore(&pdata->irq_lock, flags);
+    mutex_unlock(&pdata->start_lock);
+
+    cancel_work_sync(&cts_data->ts_resume_work);
+    cancel_delayed_work_sync(&cts_data->fw_upgrade_work);
+    if (cts_data->initialized) {
+        cts_plat_disable_irq(pdata);
+        synchronize_irq(pdata->irq);
+        ret = cts_suspend(cts_data);
+        /* A failed sleep command must not leave recovery work running. */
+        cts_disable_esd_protection(cts_data);
+        cts_plat_release_all_touch(pdata);
+    }
+
+    down_write(&pdata->panel_io_lock);
+    pdata->panel_powered = false;
+    up_write(&pdata->panel_io_lock);
+    return ret;
+}
+
+static const struct drm_panel_follower_funcs cts_panel_follower_funcs = {
+    .panel_prepared = cts_panel_prepared,
+    .panel_unpreparing = cts_panel_unpreparing,
+};
