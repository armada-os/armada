-/* Provided by the WCD939x USBSS analog-switch driver (built-in). */
-int wcd939x_usbss_audio_config(struct device *dev, bool enable);
 
 static void wcd939x_mbhc_ext_switch_ctrl(struct snd_soc_component *component,
 					 bool enable)
@@ -4008,6 +4039,21 @@
 	if (ret)
 		return ret;
 
+	if (device_property_present(dev, "qcom,usbss-measurement") &&
+	    (wcd939x->typec_analog_mux || device_property_present(dev, "qcom,usbss")))
+		return dev_err_probe(dev, -EINVAL,
+				     "USBSS measurement requires an independent headphone jack\n");
+
+	wcd939x->usbss_measurement = devm_wcd939x_usbss_get(dev, "qcom,usbss-measurement");
+	if (IS_ERR(wcd939x->usbss_measurement))
+		return dev_err_probe(dev, PTR_ERR(wcd939x->usbss_measurement),
+				     "failed to acquire USBSS measurement provider\n");
+	if (wcd939x->usbss_measurement) {
+		ret = wcd939x_usbss_init_measurement(wcd939x->usbss_measurement);
+		if (ret)
+			return dev_err_probe(dev, ret, "USBSS measurement initialization failed\n");
+	}
+
 	ret = wcd939x_add_slave_components(wcd939x, dev, &match);
 	if (ret)
 		return ret;
