 		}
 	}
@@ -2585,6 +2599,13 @@
 	}
 
 zdet_complete:
+	if (measurement) {
+		measurement_error = wcd939x_usbss_measurement_set_taps(measurement);
+		if (measurement_error)
+			dev_err(component->dev, "USBSS measurement taps failed: %d\n",
+				measurement_error);
+	}
+
 	/* Enable surge protection again after impedance detection */
 	snd_soc_component_write_field(component, WCD939X_HPH_SURGE_EN,
 				      WCD939X_EN_EN_SURGE_PROTECTION_HPHR, true);
@@ -2610,6 +2631,15 @@
