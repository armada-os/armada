diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -44,6 +44,13 @@
 #define	CONVERT_S3_15(val) \
 	(((((u64)val) & ~BIT_ULL(63)) >> 17) & GENMASK_ULL(17, 0))
 
+/* color management lives in the DSPP, which only joins the topology on a modeset */
+static bool dpu_crtc_state_needs_dspp(const struct drm_crtc_state *crtc_state)
+{
+	return crtc_state->ctm || crtc_state->gamma_lut || crtc_state->degamma_lut ||
+	       to_dpu_crtc_state(crtc_state)->lut3d;
+}
+
 static struct dpu_kms *_dpu_crtc_get_kms(struct drm_crtc *crtc)
 {
 	struct msm_drm_private *priv = crtc->dev->dev_private;
@@ -844,6 +851,8 @@
 	gc_lut->flags = 0;
 }
 
+#define DPU_CP_BLOCKS_RETRIES	8
+
 static void _dpu_crtc_setup_cp_blocks(struct drm_crtc *crtc)
 {
 	struct drm_crtc_state *state = crtc->state;
@@ -853,10 +862,14 @@
 	struct dpu_hw_gc_lut *gc_lut;
 	struct dpu_hw_ctl *ctl;
 	struct dpu_hw_dspp *dspp;
-	int i;
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	unsigned long sb_ctls = 0;
+	bool fresh, retry = false;
+	int i, ret;
 
 
-	if (!state->color_mgmt_changed && !drm_atomic_crtc_needs_modeset(state))
+	fresh = state->color_mgmt_changed || drm_atomic_crtc_needs_modeset(state);
+	if (!fresh && !dpu_crtc->cp_blocks_retries)
 		return;
 
 	for (i = 0; i < cstate->num_mixers; i++) {
@@ -884,18 +897,80 @@
 				dspp->ops.setup_gc(dspp, NULL);
 			} else {
 				gc_lut = kzalloc_obj(*gc_lut);
-				if (!gc_lut)
-					continue;
-				_dpu_crtc_get_gc_lut(state, gc_lut);
-				dspp->ops.setup_gc(dspp, gc_lut);
-				kfree(gc_lut);
+				if (gc_lut) {
+					_dpu_crtc_get_gc_lut(state, gc_lut);
+					dspp->ops.setup_gc(dspp, gc_lut);
+					kfree(gc_lut);
+				}
 			}
 
 			/* stage config flush mask */
 			ctl->ops.update_pending_flush_dspp(ctl,
 				mixer[i].hw_dspp->idx, DPU_DSPP_GC);
 		}
+
+		if (dspp->ops.setup_gamut || dspp->ops.setup_igc) {
+			ret = dpu_hw_dspp_reg_dma_wait(dspp, ctl->idx);
+			if (ret) {
+				DPU_ERROR("dspp %d LUT update skipped: %d\n", dspp->idx, ret);
+				retry = true;
+				continue;
+			}
+		}
+
+		if (dspp->ops.setup_gamut) {
+			ret = dspp->ops.setup_gamut(dspp,
+						    cstate->lut3d ? cstate->lut3d->data : NULL,
+						    ctl->idx);
+			if (ret) {
+				DPU_ERROR("dspp %d gamut setup failed: %d\n", dspp->idx, ret);
+				retry = true;
+			} else {
+				ctl->ops.update_pending_flush_dspp(ctl, dspp->idx, DPU_DSPP_GAMUT);
+				ctl->ops.update_pending_flush_dspp(ctl, dspp->idx, DPU_DSPP_SB);
+				sb_ctls |= BIT(ctl->idx);
+			}
+		}
+
+		if (dspp->ops.setup_igc) {
+			ret = dspp->ops.setup_igc(dspp,
+						  state->degamma_lut ?
+						  state->degamma_lut->data : NULL,
+						  ctl->idx);
+			if (ret) {
+				DPU_ERROR("dspp %d igc setup failed: %d\n", dspp->idx, ret);
+				retry = true;
+				continue;
+			}
+
+			ctl->ops.update_pending_flush_dspp(ctl, dspp->idx, DPU_DSPP_IGC);
+			ctl->ops.update_pending_flush_dspp(ctl, dspp->idx, DPU_DSPP_SB);
+			sb_ctls |= BIT(ctl->idx);
+		}
 	}
+
+	/* one last-command per CTL closes its sideband queue for this frame */
+	for_each_set_bit(i, &sb_ctls, CTL_MAX) {
+		for (int m = 0; m < cstate->num_mixers; m++) {
+			if (mixer[m].lm_ctl->idx == i && mixer[m].hw_dspp) {
+				ret = dpu_reg_dma_last_cmd_sb(mixer[m].hw_dspp->reg_dma, i);
+				if (ret) {
+					DPU_ERROR("ctl %d lutdma last command failed: %d\n",
+						  i, ret);
+					retry = true;
+				}
+				break;
+			}
+		}
+	}
+
+	/* a wedged engine must not pay the wait timeout on every frame */
+	if (!retry)
+		dpu_crtc->cp_blocks_retries = 0;
+	else if (fresh)
+		dpu_crtc->cp_blocks_retries = DPU_CP_BLOCKS_RETRIES;
+	else
+		dpu_crtc->cp_blocks_retries--;
 }
 
 static void dpu_crtc_atomic_begin(struct drm_crtc *crtc,
@@ -1011,6 +1086,7 @@
 	DRM_DEBUG_ATOMIC("crtc%d\n", crtc->base.id);
 
 	__drm_atomic_helper_crtc_destroy_state(state);
+	drm_property_blob_put(cstate->lut3d);
 
 	kfree(cstate);
 }
@@ -1169,10 +1245,46 @@
 
 	/* duplicate base helper */
 	__drm_atomic_helper_crtc_duplicate_state(crtc, &cstate->base);
+	if (cstate->lut3d)
+		drm_property_blob_get(cstate->lut3d);
 
 	return &cstate->base;
 }
 
+static int dpu_crtc_atomic_set_property(struct drm_crtc *crtc,
+					struct drm_crtc_state *state,
+					struct drm_property *property, uint64_t val)
+{
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+	bool replaced = false;
+	int ret;
+
+	if (property != dpu_crtc->lut3d_property)
+		return -EINVAL;
+
+	ret = drm_property_replace_blob_from_id(crtc->dev, &cstate->lut3d, val, -1,
+						DPU_GAMUT_3D_SIZE * sizeof(struct drm_color_lut),
+						sizeof(struct drm_color_lut), &replaced);
+	if (!ret)
+		state->color_mgmt_changed |= replaced;
+	return ret;
+}
+
+static int dpu_crtc_atomic_get_property(struct drm_crtc *crtc,
+					const struct drm_crtc_state *state,
+					struct drm_property *property, uint64_t *val)
+{
+	struct dpu_crtc *dpu_crtc = to_dpu_crtc(crtc);
+	const struct dpu_crtc_state *cstate = to_dpu_crtc_state(state);
+
+	if (property != dpu_crtc->lut3d_property)
+		return -EINVAL;
+
+	*val = cstate->lut3d ? cstate->lut3d->base.id : 0;
+	return 0;
+}
+
 static void dpu_crtc_atomic_print_state(struct drm_printer *p,
 					const struct drm_crtc_state *state)
 {
@@ -1423,7 +1535,7 @@
 	else
 		topology.num_lm = 1;
 
-	if (crtc_state->ctm || crtc_state->gamma_lut)
+	if (dpu_crtc_state_needs_dspp(crtc_state))
 		topology.num_dspp = topology.num_lm;
 
 	return topology;
@@ -1488,8 +1600,8 @@
 
 		cstate->mixers[i].hw_lm = to_dpu_hw_mixer(hw_lm[i]);
 		cstate->mixers[i].lm_ctl = to_dpu_hw_ctl(hw_ctl[ctl_idx]);
-		if (i < num_dspp)
-			cstate->mixers[i].hw_dspp = to_dpu_hw_dspp(hw_dspp[i]);
+		cstate->mixers[i].hw_dspp = i < num_dspp ?
+			to_dpu_hw_dspp(hw_dspp[i]) : NULL;
 	}
 
 	cstate->num_mixers = num_lm;
@@ -1524,6 +1636,38 @@
 	    (!clone_mode_requested && clone_mode_enabled))
 		new_crtc_state->mode_changed = true;
 
+	if (dpu_crtc_state_needs_dspp(old_crtc_state) != dpu_crtc_state_needs_dspp(new_crtc_state))
+		new_crtc_state->mode_changed = true;
+
+	return 0;
+}
+
+/* every DSPP reserved for this CRTC must carry the LUT blocks the state uses */
+static int _dpu_crtc_check_cp_blocks(struct drm_crtc *crtc, struct drm_crtc_state *crtc_state)
+{
+	struct dpu_kms *dpu_kms = _dpu_crtc_get_kms(crtc);
+	struct dpu_crtc_state *cstate = to_dpu_crtc_state(crtc_state);
+	struct dpu_global_state *global_state;
+	struct dpu_hw_blk *hw_dspp[MAX_CHANNELS_PER_CRTC];
+	int i, num_dspp;
+
+	global_state = dpu_kms_get_global_state(crtc_state->state);
+	if (IS_ERR(global_state))
+		return PTR_ERR(global_state);
+
+	num_dspp = dpu_rm_get_assigned_resources(&dpu_kms->rm, global_state, crtc,
+						 DPU_HW_BLK_DSPP, hw_dspp, ARRAY_SIZE(hw_dspp));
+	for (i = 0; i < num_dspp; i++) {
+		struct dpu_hw_dspp *dspp = to_dpu_hw_dspp(hw_dspp[i]);
+
+		if ((crtc_state->degamma_lut && !dspp->ops.setup_igc) ||
+		    (cstate->lut3d && !dspp->ops.setup_gamut)) {
+			DRM_DEBUG_ATOMIC("crtc%d: dspp %d lacks the requested LUT block\n",
+					 crtc->base.id, dspp->idx - DSPP_0);
+			return -EINVAL;
+		}
+	}
+
 	return 0;
 }
 
@@ -1542,14 +1686,31 @@
 
 	bool needs_dirtyfb = dpu_crtc_needs_dirtyfb(crtc_state);
 
-	/* don't reallocate resources if only ACTIVE has beeen changed */
-	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
-	    crtc_state->color_mgmt_changed) {
+	/* DEGAMMA_LUT_SIZE only caps the blob; the IGC table needs every entry */
+	if (crtc_state->degamma_lut &&
+	    drm_color_lut_size(crtc_state->degamma_lut) != DPU_DEGAMMA_LUT_SIZE) {
+		DRM_DEBUG_ATOMIC("crtc%d: degamma lut has %d entries, need %d\n",
+				 crtc->base.id, drm_color_lut_size(crtc_state->degamma_lut),
+				 DPU_DEGAMMA_LUT_SIZE);
+		return -EINVAL;
+	}
+
+	/*
+	 * Reassign only when the encoder is reprogrammed too: a color change
+	 * that alters the topology has already asked for a modeset.
+	 */
+	if (crtc_state->mode_changed || crtc_state->connectors_changed) {
 		rc = dpu_crtc_assign_resources(crtc, crtc_state);
 		if (rc < 0)
 			return rc;
 	}
 
+	if (crtc_state->degamma_lut || cstate->lut3d) {
+		rc = _dpu_crtc_check_cp_blocks(crtc, crtc_state);
+		if (rc)
+			return rc;
+	}
+
 	if (crtc_state->planes_changed || crtc_state->zpos_changed) {
 		if (dpu_use_virtual_planes)
 			rc = dpu_crtc_reassign_planes(crtc, crtc_state);
@@ -1854,6 +2015,8 @@
 	.reset = dpu_crtc_reset,
 	.atomic_duplicate_state = dpu_crtc_duplicate_state,
 	.atomic_destroy_state = dpu_crtc_destroy_state,
+	.atomic_set_property = dpu_crtc_atomic_set_property,
+	.atomic_get_property = dpu_crtc_atomic_get_property,
 	.atomic_print_state = dpu_crtc_atomic_print_state,
 	.late_register = dpu_crtc_late_register,
 	.verify_crc_source = dpu_crtc_verify_crc_source,
@@ -1922,12 +2085,23 @@
 
 	if (dpu_kms->catalog->dspp_count) {
 		const struct dpu_dspp_cfg *dspp = &dpu_kms->catalog->dspp[0];
+		struct dpu_hw_dspp *hw_dspp = dpu_kms->rm.dspp_blks[0] ?
+			to_dpu_hw_dspp(dpu_kms->rm.dspp_blks[0]) : NULL;
+		u32 degamma = hw_dspp && hw_dspp->ops.setup_igc ? DPU_DEGAMMA_LUT_SIZE : 0;
+
+		if (hw_dspp && hw_dspp->ops.setup_gamut) {
+			dpu_crtc->lut3d_property = drm_property_create(dev, DRM_MODE_PROP_BLOB,
+								       "DPU_3D_LUT", 0);
+			if (dpu_crtc->lut3d_property)
+				drm_object_attach_property(&crtc->base,
+							   dpu_crtc->lut3d_property, 0);
+		}
 
 		if (dspp->sblk->gc.base) {
 			drm_mode_crtc_set_gamma_size(crtc, DPU_GAMMA_LUT_SIZE);
-			drm_crtc_enable_color_mgmt(crtc, 0, true, DPU_GAMMA_LUT_SIZE);
+			drm_crtc_enable_color_mgmt(crtc, degamma, true, DPU_GAMMA_LUT_SIZE);
 		} else {
-			drm_crtc_enable_color_mgmt(crtc, 0, true, 0);
+			drm_crtc_enable_color_mgmt(crtc, degamma, true, 0);
 		}
 	}
 
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -156,6 +156,10 @@
 struct dpu_crtc {
 	struct drm_crtc base;
 	char name[DPU_CRTC_NAME_SIZE];
+	struct drm_property *lut3d_property;
+
+	/* flushes left to reprogram color after a LUTDMA wait or setup failure */
+	u8 cp_blocks_retries;
 
 	struct drm_pending_vblank_event *event;
 	u32 vsync_count;
@@ -225,6 +229,16 @@
 
 	enum dpu_crtc_crc_source crc_source;
 	int crc_frame_skip_count;
+
+	/*
+	 * DPU_3D_LUT: DPU_GAMUT_3D_SIZE drm_color_lut entries indexed
+	 * r + 17 * (g + 17 * b), the top 12 bits of each 16-bit value used,
+	 * reserved ignored; tetrahedral interpolation on the display's blended
+	 * output after DEGAMMA_LUT and before CTM and GAMMA_LUT. 0 bypasses
+	 * the block; setting or clearing it while the CRTC has no other color
+	 * property needs a modeset.
+	 */
+	struct drm_property_blob *lut3d;
 };
 
 #define to_dpu_crtc_state(x) \
diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_catalog.c
@@ -451,9 +451,37 @@
 		.len = 0x40, .version = 0x10008},
 };
 
+static const struct dpu_dspp_sub_blks sm8550_dspp_sblk = {
+	.pcc = {.name = "pcc", .base = 0x1700,
+		.len = 0x90, .version = 0x40000},
+	.gc = {.name = "gc", .base = 0x17c0,
+		.len = 0x40, .version = 0x10008},
+	.igc = {.name = "igc", .base = 0x1260,
+		.len = 0x1c, .version = 0x40000},
+	.gamut = {.name = "gamut", .base = 0x1000,
+		.len = 0x1c, .version = 0x40003},
+};
+
+static const struct dpu_reg_dma_cfg sm8550_reg_dma = {
+	.base = 0xac000, .len = 0x800,
+	.db_off = 0x0, .sb_off = 0x400,
+	.version = 0x20000,
+};
+
+static const struct dpu_reg_dma_cfg sm8650_reg_dma = {
+	.base = 0x180000, .len = 0x7000,
+	.db_off = 0x0, .sb_off = 0x800,
+	.version = 0x30000,
+};
+
+/* GC v2 on this DSPP is a LUT bus block too and is not wired up yet */
 static const struct dpu_dspp_sub_blks sm8750_dspp_sblk = {
 	.pcc = {.name = "pcc", .base = 0x1700,
 		.len = 0x90, .version = 0x60000},
