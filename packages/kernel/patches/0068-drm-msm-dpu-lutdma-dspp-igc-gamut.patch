+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * LUTDMA: the DPU's LUT DMA engine. Color LUT blocks on DPU 9.x and later
+ * (DSPP IGC and gamut, VIG IGC and gamut) have no memory-mapped write path;
+ * their tables are streamed over a LUT bus by this engine from a command
+ * buffer in the display IOMMU domain. The sideband (SB) queue is triggered
+ * by the CTL's DSPP_SB flush, so a transfer lands with the frame it was
+ * queued for.
+ */
+
+#ifndef _DPU_HW_REG_DMA_H
+#define _DPU_HW_REG_DMA_H
+
+#include <linux/types.h>
+#include "dpu_hw_mdss.h"
+#include "dpu_hw_catalog.h"
+#include "dpu_hw_util.h"
+
+struct drm_device;
+struct seq_file;
+struct drm_gpuvm;
+struct drm_gem_object;
+
+/* LUT bus block select for the LUT write command */
+#define DPU_LUTBUS_BLOCK_IGC		0
+#define DPU_LUTBUS_BLOCK_GAMUT		1
+/* LUT bus transfer sizes, in dwords per beat */
+#define DPU_LUTBUS_IGC_TRANS_SIZE	3
+#define DPU_LUTBUS_GAMUT_TRANS_SIZE	6
+
+/* decode select bits */
+#define DPU_REG_DMA_SEL_VIG(n)		BIT(n)
+#define DPU_REG_DMA_SEL_DSPP(n)		BIT(17 + (n))
+
+#define DPU_REG_DMA_VER_2_0		0x20000
+#define DPU_REG_DMA_VER_3_0		0x30000
+
+struct dpu_reg_dma_buf {
+	struct drm_gem_object *bo;
+	u64 iova;
+	void *vaddr;
+	u32 size;
+	u32 index;
+	/* CTL whose sideband queue last consumed this buffer, 0 for none */
+	int ctl_idx;
+};
+
+struct dpu_reg_dma_layout;
+
+struct dpu_reg_dma {
+	struct drm_device *dev;
+	struct drm_gpuvm *vm;
+	struct dpu_hw_blk_reg_map sb;
+	const struct dpu_reg_dma_cfg *cfg;
+	const struct dpu_reg_dma_layout *layout;
+	struct dpu_reg_dma_buf last_cmd[CTL_MAX];
+};
+
+struct dpu_reg_dma *dpu_reg_dma_init(struct drm_device *dev, struct drm_gpuvm *vm,
+				     void __iomem *base, const struct dpu_reg_dma_cfg *cfg);
+void dpu_reg_dma_resume(struct dpu_reg_dma *dma);
+void dpu_reg_dma_debugfs_show(struct dpu_reg_dma *dma, struct seq_file *s);
+void dpu_reg_dma_destroy(struct dpu_reg_dma *dma);
+int dpu_reg_dma_buf_alloc(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 size);
+void dpu_reg_dma_buf_free(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+
+/*
+ * Command buffer construction. dpu_reg_dma_buf_begin() waits for the
+ * buffer's previous transfer before it is rewritten.
+ */
+int dpu_reg_dma_buf_wait(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_buf_begin(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_decode_sel(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 sel);
+int dpu_reg_dma_single_write(struct dpu_reg_dma_buf *buf, u32 blk_offset, u32 val);
+void *dpu_reg_dma_lut_reserve(struct dpu_reg_dma_buf *buf, u32 block_sel, u32 trans_size,
+			      u32 len);
+
+bool dpu_reg_dma_ctl_valid(struct dpu_reg_dma *dma, int ctl_idx);
+int dpu_reg_dma_kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf);
+int dpu_reg_dma_last_cmd_sb(struct dpu_reg_dma *dma, int ctl_idx);
+
+#endif /* _DPU_HW_REG_DMA_H */
