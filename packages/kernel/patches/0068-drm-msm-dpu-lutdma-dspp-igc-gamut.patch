diff -ruN a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_hw_reg_dma.c
@@ -0,0 +1,388 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <drm/drm_managed.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/seq_file.h>
+
+#include "msm_drv.h"
+#include "msm_gem.h"
+#include "dpu_hwio.h"
+#include "dpu_hw_reg_dma.h"
+
+/* Command words: opcode in the high bits of the first dword */
+#define SINGLE_REG_WRITE_OPCODE		BIT(28)
+#define LUTBUS_WRITE_OPCODE		(BIT(30) | BIT(29))
+#define NO_OP_OPCODE			0
+#define MAX_RELATIVE_OFF		(BIT(21) - 1)
+#define MAX_DWORDS_SZ			(BIT(14) - 1)
+#define LUTBUS_BLOCK_SEL_MASK		0xffff
+#define LUTBUS_TRANS_SZ_MASK		0xff0000
+#define LUTBUS_LUT_SIZE_MASK		0x3fff
+
+/* queue command word */
+#define CMD_WRITE			BIT(22)
+#define CMD_LAST			BIT(24)
+
+#define REG_DMA_OPMODE			0x4
+#define REG_DMA_ERROR_CLEAR_MASK	(BIT(0) | BIT(1) | BIT(2) | BIT(16) | \
+					 BIT(17) | BIT(18) | BIT(19))
+
+#define ADDR_ALIGN			BIT(8)
+#define GUARD_BYTES			(ADDR_ALIGN - 1)
+#define LAST_CMD_BUF_SIZE		(128 * sizeof(u32))
+#define DONE_TIMEOUT_US			2000
+
+/*
+ * Per-version register layout. The decode select is itself an absolute
+ * register write to the engine, so its address is part of the layout.
+ */
+struct dpu_reg_dma_layout {
+	u32 decode_sel;
+	u32 intr4_status;
+	u32 intr4_clear;
+	u32 (*queue1)(int ctl_idx);
+	u32 (*intr_status)(int ctl_idx);
+	u32 (*intr_clear)(int ctl_idx);
+	u32 (*done_mask)(int ctl_idx);
+};
+
+static const u32 v2_done_mask[CTL_MAX] = {
+	[CTL_0] = BIT(21), [CTL_1] = BIT(22), [CTL_2] = BIT(23),
+	[CTL_3] = BIT(24), [CTL_4] = BIT(27), [CTL_5] = BIT(28),
+};
+
+static u32 v2_queue1(int ctl_idx) { return 0x1c + (ctl_idx - CTL_0) * 0x10; }
+static u32 v2_intr_status(int ctl_idx) { return 0x160; }
+static u32 v2_intr_clear(int ctl_idx) { return 0x1a0; }
+static u32 v2_done(int ctl_idx) { return v2_done_mask[ctl_idx]; }
+
+static const struct dpu_reg_dma_layout dpu_reg_dma_v2 = {
+	.decode_sel = 0x180ac114,
+	.intr4_status = 0x170,
+	.intr4_clear = 0x1b0,
+	.queue1 = v2_queue1,
+	.intr_status = v2_intr_status,
+	.intr_clear = v2_intr_clear,
+	.done_mask = v2_done,
+};
+
+/*
+ * v3: one 4 KiB window per CTL with its own queues, status and reset,
+ * numbered by CTL id, so CTL_0 uses the second window.
+ */
+static u32 v3_queue1(int ctl_idx) { return 0x1000 * ctl_idx + 0x8; }
+static u32 v3_intr_status(int ctl_idx) { return 0x1000 * ctl_idx + 0x44; }
+static u32 v3_intr_clear(int ctl_idx) { return 0x1000 * ctl_idx + 0x48; }
+static u32 v3_done(int ctl_idx) { return BIT(4); }
+
+static const struct dpu_reg_dma_layout dpu_reg_dma_v3 = {
+	.decode_sel = 0x18180114,
+	.intr4_status = 0x170,
+	.intr4_clear = 0x1b0,
+	.queue1 = v3_queue1,
+	.intr_status = v3_intr_status,
+	.intr_clear = v3_intr_clear,
+	.done_mask = v3_done,
+};
+
+int dpu_reg_dma_buf_alloc(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 size)
+{
+	u64 iova, aligned;
+	void *vaddr;
+
+	if (!size || (size / sizeof(u32)) > MAX_DWORDS_SZ)
+		return -EINVAL;
+
+	vaddr = msm_gem_kernel_new(dma->dev, size + GUARD_BYTES, MSM_BO_WC, dma->vm,
+				   &buf->bo, &iova);
+	if (IS_ERR(vaddr))
+		return PTR_ERR(vaddr);
+
+	aligned = ALIGN(iova, ADDR_ALIGN);
+	buf->iova = aligned;
+	buf->vaddr = vaddr + (aligned - iova);
+	buf->size = size;
+	buf->index = 0;
+	buf->ctl_idx = 0;
+	return 0;
+}
+
+void dpu_reg_dma_buf_free(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	if (!buf->bo)
+		return;
+	msm_gem_kernel_put(buf->bo, dma->vm);
+	buf->bo = NULL;
+	buf->vaddr = NULL;
+	buf->iova = 0;
+}
+
+/*
+ * A buffer is rewritten in place, so wait for the transfer that last read
+ * it (the done bit is set by the flush-triggered transfer). On a timeout
+ * the buffer stays owned and the update is refused rather than rewriting
+ * live command memory; dpu_reg_dma_resume() drops the mark after a power
+ * collapse, the only case where the status register reads clear.
+ */
+int dpu_reg_dma_buf_wait(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	u32 status;
+	int ret;
+
+	if (!buf->vaddr)
+		return -EINVAL;
+	if (!buf->ctl_idx)
+		return 0;
+
+	ret = read_poll_timeout(DPU_REG_READ, status,
+				status & dma->layout->done_mask(buf->ctl_idx),
+				10, DONE_TIMEOUT_US, false,
+				&dma->sb, dma->layout->intr_status(buf->ctl_idx));
+	if (ret) {
+		DRM_ERROR_RATELIMITED("LUTDMA ctl%d previous transfer not done (%#x)\n",
+				      buf->ctl_idx - CTL_0, status);
+		return -ETIMEDOUT;
+	}
+	buf->ctl_idx = 0;
+	return 0;
+}
+
+int dpu_reg_dma_buf_begin(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf)
+{
+	int ret = dpu_reg_dma_buf_wait(dma, buf);
+
+	if (ret)
+		return ret;
+	buf->index = 0;
+	return 0;
+}
+
+static __le32 *buf_reserve(struct dpu_reg_dma_buf *buf, u32 bytes)
+{
+	__le32 *loc;
+
+	if (buf->index + bytes > buf->size)
+		return NULL;
+	loc = (__le32 *)((u8 *)buf->vaddr + buf->index);
+	buf->index += bytes;
+	return loc;
+}
+
+static int write_decode_sel(struct dpu_reg_dma_buf *buf, u32 decode_sel, u32 sel)
+{
+	__le32 *loc = buf_reserve(buf, 2 * sizeof(u32));
+
+	if (!loc)
+		return -ENOSPC;
+	loc[0] = cpu_to_le32(decode_sel);
+	loc[1] = cpu_to_le32(sel);
+	return 0;
+}
+
+int dpu_reg_dma_single_write(struct dpu_reg_dma_buf *buf, u32 blk_offset, u32 val)
+{
+	__le32 *loc = buf_reserve(buf, 2 * sizeof(u32));
+
+	if (!loc)
+		return -ENOSPC;
+	loc[0] = cpu_to_le32(SINGLE_REG_WRITE_OPCODE | (blk_offset & MAX_RELATIVE_OFF));
+	loc[1] = cpu_to_le32(val);
+	return 0;
+}
+
+/*
+ * Queue a LUT bus write of len bytes and return its zeroed payload area for
+ * the caller to fill with little-endian LUT bus data.
+ */
+void *dpu_reg_dma_lut_reserve(struct dpu_reg_dma_buf *buf, u32 block_sel, u32 trans_size,
+			      u32 len)
+{
+	u32 beat = trans_size * sizeof(u32);
+	__le32 *loc, *tail;
+
+	if (len % beat)
+		return NULL;
+
+	loc = buf_reserve(buf, 2 * sizeof(u32) + len + 3 * sizeof(u32));
+	if (!loc)
+		return NULL;
+
+	loc[0] = cpu_to_le32(LUTBUS_WRITE_OPCODE | (block_sel & LUTBUS_BLOCK_SEL_MASK));
+	loc[1] = cpu_to_le32(((trans_size << 16) & LUTBUS_TRANS_SZ_MASK) |
+			     ((len / beat) & LUTBUS_LUT_SIZE_MASK));
+	memset(&loc[2], 0, len);
+
+	/* the engine needs residual data plus the next opcode to exceed four dwords */
+	tail = (__le32 *)((u8 *)&loc[2] + len);
+	tail[0] = cpu_to_le32(NO_OP_OPCODE);
+	tail[1] = cpu_to_le32(NO_OP_OPCODE);
+	tail[2] = cpu_to_le32(NO_OP_OPCODE);
+	return &loc[2];
+}
+
+/* the v3 layout maps one window per CTL and the catalog length bounds them */
+bool dpu_reg_dma_ctl_valid(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	u32 sb_len = dma->cfg->len - dma->cfg->sb_off;
+
+	if (ctl_idx < CTL_0 || ctl_idx >= CTL_MAX)
+		return false;
+	return l->queue1(ctl_idx) + 2 * sizeof(u32) <= sb_len &&
+	       l->intr_status(ctl_idx) + sizeof(u32) <= sb_len &&
+	       l->intr_clear(ctl_idx) + sizeof(u32) <= sb_len;
+}
+
+static int kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf, bool last)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	u32 queue, cmd1, status;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx) || !buf->iova || !buf->index)
+		return -EINVAL;
+	queue = l->queue1(ctl_idx);
+
+	/* the command buffer is write-combined; publish it before the engine reads it */
+	wmb();
+
+	cmd1 = CMD_WRITE | ((buf->index / sizeof(u32)) & MAX_DWORDS_SZ);
+	if (last)
+		cmd1 |= CMD_LAST;
+
+	DPU_REG_WRITE(&dma->sb, REG_DMA_OPMODE, BIT(0));
+	status = DPU_REG_READ(&dma->sb, l->intr4_status);
+	if (status) {
+		DRM_ERROR_RATELIMITED("LUTDMA error status %#x\n", status);
+		DPU_REG_WRITE(&dma->sb, l->intr4_clear, REG_DMA_ERROR_CLEAR_MASK);
+	}
+
+	DPU_REG_WRITE(&dma->sb, queue, lower_32_bits(buf->iova));
+	DPU_REG_WRITE(&dma->sb, queue + 0x4, cmd1);
+	buf->ctl_idx = ctl_idx;
+
+	if (last) {
+		/* the last-command descriptor must be queued before the done bit is armed */
+		wmb();
+		DPU_REG_WRITE(&dma->sb, l->intr_clear(ctl_idx), l->done_mask(ctl_idx));
+	}
+	return 0;
+}
+
+int dpu_reg_dma_kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf)
+{
+	return kick_off_sb(dma, ctl_idx, buf, false);
+}
+
+/*
+ * Close the sideband queue for this CTL: a last-command descriptor tells the
+ * engine the batch is complete, and the DSPP_SB flush then starts it.
+ */
+int dpu_reg_dma_last_cmd_sb(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	struct dpu_reg_dma_buf *buf;
+	int ret;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx))
+		return -EINVAL;
+
+	buf = &dma->last_cmd[ctl_idx];
+	ret = dpu_reg_dma_buf_begin(dma, buf);
+	if (ret)
+		return ret;
+	ret = write_decode_sel(buf, dma->layout->decode_sel, 0);
+	if (ret)
+		return ret;
+
+	return kick_off_sb(dma, ctl_idx, buf, true);
+}
+
+int dpu_reg_dma_decode_sel(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 sel)
+{
+	return write_decode_sel(buf, dma->layout->decode_sel, sel);
+}
+
+static bool transfer_done(struct dpu_reg_dma *dma, int ctl_idx)
+{
+	u32 status = DPU_REG_READ(&dma->sb, dma->layout->intr_status(ctl_idx));
+
+	return status & dma->layout->done_mask(ctl_idx);
+}
+
+void dpu_reg_dma_debugfs_show(struct dpu_reg_dma *dma, struct seq_file *s)
+{
+	const struct dpu_reg_dma_layout *l = dma->layout;
+	int i;
+
+	seq_printf(s, "engine v%x sb_off %#x\n", dma->cfg->version, dma->cfg->sb_off);
+	seq_printf(s, "opmode %#010x intr4_status %#010x\n",
+		   DPU_REG_READ(&dma->sb, REG_DMA_OPMODE), DPU_REG_READ(&dma->sb, l->intr4_status));
+	for (i = CTL_0; i < CTL_MAX; i++) {
+		if (!dpu_reg_dma_ctl_valid(dma, i))
+			continue;
+		if (!dma->last_cmd[i].iova)
+			continue;
+		seq_printf(s, "ctl%d q1 addr %#010x cmd %#010x intr_status %#010x done %d last_cmd iova %#llx\n",
+			   i - CTL_0, DPU_REG_READ(&dma->sb, l->queue1(i)),
+			   DPU_REG_READ(&dma->sb, l->queue1(i) + 4),
+			   DPU_REG_READ(&dma->sb, l->intr_status(i)), transfer_done(dma, i),
+			   dma->last_cmd[i].iova);
+	}
+}
+
+struct dpu_reg_dma *dpu_reg_dma_init(struct drm_device *dev, struct drm_gpuvm *vm,
+				     void __iomem *base, const struct dpu_reg_dma_cfg *cfg)
+{
+	struct dpu_reg_dma *dma;
+	int i, ret;
+
+	dma = drmm_kzalloc(dev, sizeof(*dma), GFP_KERNEL);
+	if (!dma)
+		return ERR_PTR(-ENOMEM);
+
+	switch (cfg->version) {
+	case DPU_REG_DMA_VER_2_0:
+		dma->layout = &dpu_reg_dma_v2;
+		break;
+	case DPU_REG_DMA_VER_3_0:
+		dma->layout = &dpu_reg_dma_v3;
+		break;
+	default:
+		return ERR_PTR(-EOPNOTSUPP);
+	}
+
+	dma->dev = dev;
+	dma->vm = vm;
+	dma->cfg = cfg;
+	dma->sb.blk_addr = base + cfg->sb_off;
+	dma->sb.log_mask = DPU_DBG_MASK_TOP;
+
+	for (i = CTL_0; i < CTL_MAX; i++) {
+		ret = dpu_reg_dma_buf_alloc(dma, &dma->last_cmd[i], LAST_CMD_BUF_SIZE);
+		if (ret) {
+			while (--i >= CTL_0)
+				dpu_reg_dma_buf_free(dma, &dma->last_cmd[i]);
+			return ERR_PTR(ret);
+		}
+	}
+
+	return dma;
+}
+
+/* The engine lost its state with the power domain; nothing is in flight */
+void dpu_reg_dma_resume(struct dpu_reg_dma *dma)
+{
+	int i;
+
+	for (i = CTL_0; i < CTL_MAX; i++)
+		dma->last_cmd[i].ctl_idx = 0;
+}
+
+/* Must run while the display VM is still alive */
+void dpu_reg_dma_destroy(struct dpu_reg_dma *dma)
+{
+	int i;
+
+	for (i = CTL_0; i < CTL_MAX; i++)
+		dpu_reg_dma_buf_free(dma, &dma->last_cmd[i]);
+}
