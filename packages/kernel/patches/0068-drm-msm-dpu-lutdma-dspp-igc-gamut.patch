 #define	DPU_PERF_DEFAULT_MAX_CORE_CLK_RATE	412500000
 
+/* The LUTDMA engine sits in the MDSS register space outside "mdp"; the DT names it */
+static int _dpu_kms_reg_dma_init(struct dpu_kms *dpu_kms)
+{
+	const struct dpu_reg_dma_cfg *cfg = dpu_kms->catalog->reg_dma;
+	struct resource *res;
+	void __iomem *base;
+	struct dpu_reg_dma *dma;
+	int i, rc;
+
+	if (!cfg)
+		return 0;
+
+	res = platform_get_resource_byname(dpu_kms->pdev, IORESOURCE_MEM, "lutdma");
+	if (!res) {
+		DPU_DEBUG("no lutdma reg, LUT color blocks unavailable\n");
+		return 0;
+	}
+	if (resource_size(res) < cfg->len) {
+		DPU_ERROR("lutdma reg %pR is smaller than the engine (%#x)\n", res, cfg->len);
+		return -EINVAL;
+	}
+	base = devm_ioremap_resource(&dpu_kms->pdev->dev, res);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+
+	dma = dpu_reg_dma_init(dpu_kms->dev, dpu_kms->base.vm, base, cfg);
+	if (IS_ERR(dma))
+		return PTR_ERR(dma);
+	dpu_kms->reg_dma = dma;
+
+	for (i = 0; i < ARRAY_SIZE(dpu_kms->rm.dspp_blks); i++) {
+		if (!dpu_kms->rm.dspp_blks[i])
+			continue;
+		rc = dpu_hw_dspp_set_reg_dma(to_dpu_hw_dspp(dpu_kms->rm.dspp_blks[i]), dma);
+		if (rc) {
