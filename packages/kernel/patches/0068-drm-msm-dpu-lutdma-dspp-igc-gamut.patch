+/*
+ * DSPP_IGC (v4, v5): opcode register at +0x4, enable bit 8. The table
+ * travels over the LUT bus as 257 samples at i / 256 of three 16-bit values
+ * in G, B, R order (the block's c0, c1, c2); v4 takes 12 bits MSB aligned,
+ * v5 all 16. The order is hardware-measured.
+ */
+#define IGC_OPCODE_OFF		0x4
+#define IGC_EN			BIT(8)
+#define IGC_V4_MASK		0xfff0
+#define IGC_SAMPLES		257
+#define IGC_BEAT		(DPU_LUTBUS_IGC_TRANS_SIZE * sizeof(u32))
+#define IGC_LEN			roundup(IGC_SAMPLES * 3 * sizeof(u16), IGC_BEAT)
+#define IGC_BUF_SIZE		(IGC_LEN + 16 * sizeof(u32))
+
+static u16 lut_chan(const struct drm_color_lut *e, int chan)
+{
+	return chan == 0 ? e->red : chan == 1 ? e->green : e->blue;
+}
+
+/* sample i of the hardware table sits at i / 256, DEGAMMA_LUT entry i at i / 255 */
+static u16 igc_sample(const struct drm_color_lut *lut, int i, int chan)
+{
+	int pos = i * (DPU_DEGAMMA_LUT_SIZE - 1);
+	int idx = pos / (IGC_SAMPLES - 1);
+	int frac = pos % (IGC_SAMPLES - 1);
+	int a = lut_chan(&lut[idx], chan);
+	int b = lut_chan(&lut[min(idx + 1, DPU_DEGAMMA_LUT_SIZE - 1)], chan);
+
+	return (a * (IGC_SAMPLES - 1 - frac) + b * frac + (IGC_SAMPLES - 1) / 2) /
+	       (IGC_SAMPLES - 1);
+}
+
+static int dpu_setup_dspp_igc(struct dpu_hw_dspp *ctx, const struct drm_color_lut *lut,
+			      int ctl_idx)
+{
+	struct dpu_reg_dma_buf *buf = &ctx->igc_buf;
+	u32 base = ctx->cap->sblk->igc.base;
+	u16 mask = ctx->cap->sblk->igc.version >= 0x50000 ? 0xffff : IGC_V4_MASK;
+	__le16 *data;
+	int i, j, ret;
+
+	if (!ctx->reg_dma || !buf->vaddr || !base)
+		return -EOPNOTSUPP;
+
+	ret = dpu_reg_dma_buf_begin(ctx->reg_dma, buf);
+	if (ret)
+		return ret;
+	ret = dpu_reg_dma_decode_sel(ctx->reg_dma, buf, DPU_REG_DMA_SEL_DSPP(ctx->idx - DSPP_0));
+	if (ret)
+		return ret;
+
+	if (!lut) {
+		ret = dpu_reg_dma_single_write(buf, base + IGC_OPCODE_OFF, 0);
+		return ret ? ret : dpu_reg_dma_kick_off_sb(ctx->reg_dma, ctl_idx, buf);
+	}
+
+	data = dpu_reg_dma_lut_reserve(buf, DPU_LUTBUS_BLOCK_IGC, DPU_LUTBUS_IGC_TRANS_SIZE,
+				       IGC_LEN);
+	if (!data)
+		return -ENOSPC;
+
+	for (i = 0, j = 0; i < IGC_SAMPLES; i++) {
+		data[j++] = cpu_to_le16(igc_sample(lut, i, 1) & mask);
+		data[j++] = cpu_to_le16(igc_sample(lut, i, 2) & mask);
+		data[j++] = cpu_to_le16(igc_sample(lut, i, 0) & mask);
+	}
+
+	ret = dpu_reg_dma_single_write(buf, base + IGC_OPCODE_OFF, IGC_EN);
+	return ret ? ret : dpu_reg_dma_kick_off_sb(ctx->reg_dma, ctl_idx, buf);
+}
+
+/*
+ * DSPP_GAMUT (v4.3): opmode at +0x0 (mode 17 = 0 << 2, enable bit 0). The
+ * 17^3 grid lives in four tables of 1229 entries, interleaved entry by
+ * entry over the LUT bus, which is the same as streaming the nodes in
+ * drm_color_lut order (red fastest, blue slowest). Each node is three
+ * 16-bit values (R, G, B), 12 bits MSB aligned, trans size 6. The node
+ * order and component order are hardware-measured, not documented.
+ */
+#define GAMUT_V43_MODE17_EN	BIT(0)
+#define GAMUT_V43_TBL_NUM	4
+#define GAMUT_V43_TBL_LEN	1229
+#define GAMUT_V43_BEAT		(DPU_LUTBUS_GAMUT_TRANS_SIZE * sizeof(u32))
+#define GAMUT_V43_LEN		roundup(GAMUT_V43_TBL_NUM * GAMUT_V43_TBL_LEN * 3 * sizeof(u16), \
+				       GAMUT_V43_BEAT)
+#define GAMUT_V43_BUF_SIZE	(GAMUT_V43_LEN + 16 * sizeof(u32))
+
+static int dpu_setup_dspp_gamut(struct dpu_hw_dspp *ctx, const struct drm_color_lut *lut,
+				int ctl_idx)
+{
+	struct dpu_reg_dma_buf *buf = &ctx->gamut_buf;
+	u32 base = ctx->cap->sblk->gamut.base;
+	__le16 *data;
+	int n, k, ret;
+
+	if (!ctx->reg_dma || !buf->vaddr || !base)
+		return -EOPNOTSUPP;
+
+	ret = dpu_reg_dma_buf_begin(ctx->reg_dma, buf);
+	if (ret)
+		return ret;
+	ret = dpu_reg_dma_decode_sel(ctx->reg_dma, buf, DPU_REG_DMA_SEL_DSPP(ctx->idx - DSPP_0));
+	if (ret)
+		return ret;
+
+	if (!lut) {
+		ret = dpu_reg_dma_single_write(buf, base, 0);
+		return ret ? ret : dpu_reg_dma_kick_off_sb(ctx->reg_dma, ctl_idx, buf);
+	}
+
+	data = dpu_reg_dma_lut_reserve(buf, DPU_LUTBUS_BLOCK_GAMUT, DPU_LUTBUS_GAMUT_TRANS_SIZE,
+				       GAMUT_V43_LEN);
+	if (!data)
+		return -ENOSPC;
+
+	for (n = 0, k = 0; n < DPU_GAMUT_3D_SIZE; n++) {
+		data[k++] = cpu_to_le16(drm_color_lut_extract(lut[n].red, 12) << 4);
+		data[k++] = cpu_to_le16(drm_color_lut_extract(lut[n].green, 12) << 4);
+		data[k++] = cpu_to_le16(drm_color_lut_extract(lut[n].blue, 12) << 4);
+	}
+
+	ret = dpu_reg_dma_single_write(buf, base, GAMUT_V43_MODE17_EN);
+	return ret ? ret : dpu_reg_dma_kick_off_sb(ctx->reg_dma, ctl_idx, buf);
+}
+
+int dpu_hw_dspp_set_reg_dma(struct dpu_hw_dspp *ctx, struct dpu_reg_dma *reg_dma)
+{
+	int ret;
+
+	/* only the block revisions whose LUT bus format is known */
+	if (ctx->cap->sblk->igc.base &&
+	    (ctx->cap->sblk->igc.version == 0x40000 || ctx->cap->sblk->igc.version == 0x50000)) {
+		ret = dpu_reg_dma_buf_alloc(reg_dma, &ctx->igc_buf, IGC_BUF_SIZE);
+		if (ret)
+			return ret;
+		ctx->ops.setup_igc = dpu_setup_dspp_igc;
+	}
+	if (ctx->cap->sblk->gamut.base && ctx->cap->sblk->gamut.version == 0x40003) {
+		ret = dpu_reg_dma_buf_alloc(reg_dma, &ctx->gamut_buf, GAMUT_V43_BUF_SIZE);
+		if (ret) {
+			dpu_reg_dma_buf_free(reg_dma, &ctx->igc_buf);
+			ctx->ops.setup_igc = NULL;
+			return ret;
+		}
+		ctx->ops.setup_gamut = dpu_setup_dspp_gamut;
+	}
+	ctx->reg_dma = reg_dma;
+	return 0;
+}
+
+/* the IGC and gamut updates are queued as one batch: wait for all of it or none */
+int dpu_hw_dspp_reg_dma_wait(struct dpu_hw_dspp *ctx, int ctl_idx)
+{
+	int ret;
+
+	if (!ctx->reg_dma)
+		return 0;
+	ret = dpu_reg_dma_buf_wait(ctx->reg_dma, &ctx->igc_buf);
+	if (!ret)
+		ret = dpu_reg_dma_buf_wait(ctx->reg_dma, &ctx->gamut_buf);
+	if (!ret && ctl_idx >= CTL_0 && ctl_idx < CTL_MAX)
+		ret = dpu_reg_dma_buf_wait(ctx->reg_dma, &ctx->reg_dma->last_cmd[ctl_idx]);
+	return ret;
+}
+
+void dpu_hw_dspp_reg_dma_resume(struct dpu_hw_dspp *ctx)
+{
+	ctx->igc_buf.ctl_idx = 0;
+	ctx->gamut_buf.ctl_idx = 0;
+}
+
+void dpu_hw_dspp_clear_reg_dma(struct dpu_hw_dspp *ctx)
+{
+	if (!ctx->reg_dma)
+		return;
+
+	dpu_reg_dma_buf_free(ctx->reg_dma, &ctx->igc_buf);
+	dpu_reg_dma_buf_free(ctx->reg_dma, &ctx->gamut_buf);
+	ctx->ops.setup_igc = NULL;
+	ctx->ops.setup_gamut = NULL;
+	ctx->reg_dma = NULL;
+}
+
