From: ROCKNIX <noreply@rocknix.org>
Subject: [PATCH] ASoC: qcom: sc8280xp: enable all MI2S bit clocks

Rebase the current ROCKNIX SM8750 MI2S clock fix after the SM8550 Primary
I2S support patch. Keep the earlier Primary MI2S codec format setup while
adding the ROCKNIX refcount and coverage for every MI2S backend.

--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -22,7 +22,8 @@
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	struct clk *i2s_clk;
+	int mi2s_clk_count;
 	bool jack_setup;
 	bool wsa2_only;
 };
 
@@ -77,10 +78,22 @@
 	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
 	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
 
 	switch (cpu_dai->id) {
-	case PRIMARY_MI2S_RX:
-		clk_prepare_enable(pdata->i2s_clk);
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (++pdata->mi2s_clk_count == 1) {
+			ret = clk_prepare_enable(pdata->i2s_clk);
+			if (ret) {
+				pdata->mi2s_clk_count--;
+				return ret;
+			}
+		}
+
+		if (cpu_dai->id != PRIMARY_MI2S_RX)
+			break;
+
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
@@ -98,8 +111,10 @@
 	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
 
 	switch (cpu_dai->id) {
-	case PRIMARY_MI2S_RX:
-		clk_disable_unprepare(pdata->i2s_clk);
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (--pdata->mi2s_clk_count == 0)
+			clk_disable_unprepare(pdata->i2s_clk);
 		break;
 	default:
 		break;
