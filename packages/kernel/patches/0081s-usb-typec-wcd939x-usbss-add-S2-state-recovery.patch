  */
 
@@ -10,6 +10,8 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/pm.h>
+#include <linux/workqueue.h>
 #include <linux/slab.h>
 #include <linux/regmap.h>
 #include <linux/bitfield.h>
@@ -17,6 +19,12 @@
 #include <linux/usb/typec_dp.h>
 #include <linux/usb/typec_mux.h>
 #include <linux/usb/wcd939x-usbss.h>
+
+#include "wcd939x-usbss-quirks.h"
+
+#define WCD_USBSS_PMP_MISC1			0x5
+#define WCD_USBSS_PMP_MISC2			0x6
+#define WCD_USBSS_RCO_MISC2			0x15
 
 #define WCD_USBSS_PMP_OUT1			0x2
 
@@ -199,6 +207,24 @@
 
 #define WCD_USBSS_MAX_REGISTER			0x4c1
 
+struct wcd939x_usbss;
+
+struct wcd939x_usbss_shadow {
+	u8 value[WCD_USBSS_MAX_REGISTER + 1];
+	u8 mask[WCD_USBSS_MAX_REGISTER + 1];
+};
+
+struct wcd939x_usbss_recovery {
+	struct wcd939x_usbss *usbss;
+	struct delayed_work work;
+	struct wcd939x_usbss_shadow state;
+	struct wcd939x_usbss_shadow checkpoint;
+	bool checkpoint_active;
+	bool pending;
+	bool suspended;
+	bool stopping;
+};
+
 struct wcd939x_usbss {
 	struct i2c_client *client;
 	struct gpio_desc *reset_gpio;
@@ -211,6 +237,7 @@
 	struct typec_mux_dev *mux;
 
 	struct regmap *regmap;
+	struct wcd939x_usbss_recovery *recovery;
 
 	struct typec_mux *codec;
 	struct typec_switch *codec_switch;
@@ -269,6 +296,261 @@
 	.ranges = wcd939x_usbss_ranges,
 	.num_ranges = ARRAY_SIZE(wcd939x_usbss_ranges),
 };
+
+static void wcd939x_usbss_remember(struct wcd939x_usbss *usbss,
+				 unsigned int reg, unsigned int mask,
+				 unsigned int value)
+{
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+
+	if (!recovery || reg > WCD_USBSS_MAX_REGISTER ||
+	    reg == WCD_USBSS_AUDIO_FSM_START)
+		return;
+
+	recovery->state.value[reg] &= ~mask;
+	recovery->state.value[reg] |= value & mask;
+	recovery->state.mask[reg] |= mask;
+}
+
+static int wcd939x_usbss_save_new_bits(struct wcd939x_usbss *usbss,
+				     unsigned int reg, unsigned int mask)
+{
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+	unsigned int value, missing;
+	int ret;
+
+	if (!recovery || !recovery->checkpoint_active)
+		return 0;
+	missing = mask & ~recovery->checkpoint.mask[reg];
+	if (!missing)
+		return 0;
+	ret = regmap_read(usbss->regmap, reg, &value);
+	if (ret)
+		return ret;
+	recovery->checkpoint.value[reg] &= ~missing;
+	recovery->checkpoint.value[reg] |= value & missing;
+	recovery->checkpoint.mask[reg] |= missing;
+	return 0;
+}
+
+static int wcd939x_usbss_write(struct wcd939x_usbss *usbss,
+			      unsigned int reg, unsigned int value)
+{
+	int ret = wcd939x_usbss_save_new_bits(usbss, reg, 0xff);
+
+	if (ret)
+		return ret;
+	ret = regmap_write(usbss->regmap, reg, value);
+
+	if (!ret)
+		wcd939x_usbss_remember(usbss, reg, 0xff, value);
+	return ret;
+}
+
+static int wcd939x_usbss_update_bits(struct wcd939x_usbss *usbss,
+				    unsigned int reg, unsigned int mask,
+				    unsigned int value)
+{
+	int ret = wcd939x_usbss_save_new_bits(usbss, reg, mask);
+
+	if (ret)
+		return ret;
+	ret = regmap_update_bits(usbss->regmap, reg, mask, value);
+
+	if (!ret)
+		wcd939x_usbss_remember(usbss, reg, mask, value);
+	return ret;
+}
+
+static int wcd939x_usbss_set_bits(struct wcd939x_usbss *usbss,
+				 unsigned int reg, unsigned int mask)
+{
+	return wcd939x_usbss_update_bits(usbss, reg, mask, mask);
+}
+
+static int wcd939x_usbss_clear_bits(struct wcd939x_usbss *usbss,
+				   unsigned int reg, unsigned int mask)
+{
+	return wcd939x_usbss_update_bits(usbss, reg, mask, 0);
+}
+
+/* A status failure requests replay; an I/O failure is not a status result. */
+static int wcd939x_usbss_check_state(struct wcd939x_usbss *usbss)
+{
+	unsigned int value;
+	int ret, cleanup, i;
+
+	ret = regmap_read(usbss->regmap, WCD_USBSS_CPLDO_CTL2, &value);
+	if (ret)
+		return ret;
+	if (value != 0xff)
+		return 1;
+
+	for (i = 0; i < 10; i++) {
+		ret = regmap_read(usbss->regmap, WCD_USBSS_RCO_MISC2, &value);
+		if (ret)
+			return ret;
+		if (!(value & BIT(1)))
+			break;
+	}
+	if (i == 10)
+		return 2;
+
+	ret = regmap_read(usbss->regmap, WCD_USBSS_USB_SS_CNTL, &value);
+	if (ret || (value & WCD_USBSS_USB_SS_CNTL_STANDBY_STATE))
+		return ret;
+
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_PMP_MISC1, BIT(0));
+	if (!ret)
+		ret = regmap_set_bits(usbss->regmap, WCD_USBSS_PMP_MISC1, BIT(0));
+	/* Clear even after an ambiguous failed transfer; never cache the pulse. */
+	cleanup = regmap_clear_bits(usbss->regmap, WCD_USBSS_PMP_MISC1, BIT(0));
+	if (cleanup)
+		dev_err_ratelimited(&usbss->client->dev,
+				    "USBSS status challenge cleanup failed: %d\n", cleanup);
+	if (ret || cleanup)
+		return ret ?: cleanup;
+
+	ret = regmap_read(usbss->regmap, WCD_USBSS_PMP_MISC2, &value);
+	if (ret)
+		return ret;
+	return value & BIT(0) ? 0 : 3;
+}
+
+static int wcd939x_usbss_replay_state(struct wcd939x_usbss *usbss)
+{
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+	unsigned int reg;
+	int ret, cleanup;
+
+	lockdep_assert_held(&usbss->lock);
+	for (reg = 0; reg <= WCD_USBSS_MAX_REGISTER; reg++) {
+		if (!recovery->state.mask[reg])
+			continue;
+		ret = regmap_write_bits(usbss->regmap, reg,
+					 recovery->state.mask[reg], recovery->state.value[reg]);
+		if (ret)
+			return ret;
+	}
+
+	ret = regmap_write(usbss->regmap, WCD_USBSS_CPLDO_CTL2, 0xff);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(usbss->regmap, WCD_USBSS_USB_SS_CNTL,
+				WCD_USBSS_USB_SS_CNTL_RCO_EN);
+	/* A failed clear can still reach hardware; always attempt the final set. */
+	cleanup = regmap_set_bits(usbss->regmap, WCD_USBSS_USB_SS_CNTL,
+				 WCD_USBSS_USB_SS_CNTL_RCO_EN);
+	if (cleanup)
+		dev_err_ratelimited(&usbss->client->dev,
+				    "USBSS RCO restoration failed: %d\n", cleanup);
+	return ret ?: cleanup;
+}
+
+static int wcd939x_usbss_finish_recovery(struct wcd939x_usbss *usbss)
+{
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+	int ret;
+
+	lockdep_assert_held(&usbss->lock);
+	if (!recovery)
+		return 0;
+	if (recovery->suspended || recovery->stopping)
+		return -EBUSY;
+	if (!recovery->pending)
+		return 0;
+	if (usbss->mode == TYPEC_MODE_AUDIO)
+		return -EBUSY;
+	ret = wcd939x_usbss_replay_state(usbss);
+	if (!ret)
+		recovery->pending = false;
+	return ret;
+}
+
+static int wcd939x_usbss_prepare_route(struct wcd939x_usbss *usbss,
+				      unsigned long mode)
+{
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+
+	lockdep_assert_held(&usbss->lock);
+	if (recovery && (recovery->suspended || recovery->stopping))
+		return -EBUSY;
+	/* Teardown must remain possible without replaying an audio accessory. */
+	if (usbss->mode == TYPEC_MODE_AUDIO && mode != TYPEC_MODE_AUDIO)
+		return 0;
+	return wcd939x_usbss_finish_recovery(usbss);
+}
+
+static void wcd939x_usbss_recovery_work(struct work_struct *work)
+{
+	struct wcd939x_usbss_recovery *recovery =
+		container_of(to_delayed_work(work), struct wcd939x_usbss_recovery, work);
+	struct wcd939x_usbss *usbss = recovery->usbss;
+	int check, ret;
+
+	mutex_lock(&usbss->lock);
+	if (recovery->stopping || recovery->suspended)
+		goto unlock;
+
+	/* Audio-accessory recovery also requires the vendor codec notifier. */
+	if (usbss->mode == TYPEC_MODE_AUDIO)
+		goto requeue;
+
+	check = wcd939x_usbss_check_state(usbss);
+	if (check < 0) {
+		dev_err_ratelimited(&usbss->client->dev,
+				    "USBSS recovery check failed: %d\n", check);
+		goto requeue;
+	}
+	if (check || recovery->pending) {
+		recovery->pending = true;
+		ret = wcd939x_usbss_replay_state(usbss);
+		if (ret)
+			dev_err_ratelimited(&usbss->client->dev,
+					    "USBSS state replay failed: %d\n", ret);
+		else {
+			recovery->pending = false;
+			dev_dbg(&usbss->client->dev, "USBSS state restored (check %d)\n", check);
+		}
+	}
+requeue:
+	queue_delayed_work(system_freezable_wq, &recovery->work,
+			   msecs_to_jiffies(15000));
+unlock:
+	mutex_unlock(&usbss->lock);
+}
+
+static int wcd939x_usbss_suspend(struct device *dev)
+{
+	struct wcd939x_usbss *usbss = dev_get_drvdata(dev);
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+
+	if (!recovery)
+		return 0;
+	mutex_lock(&usbss->lock);
+	recovery->suspended = true;
+	mutex_unlock(&usbss->lock);
+	cancel_delayed_work_sync(&recovery->work);
+	return 0;
+}
+
+static int wcd939x_usbss_resume(struct device *dev)
+{
+	struct wcd939x_usbss *usbss = dev_get_drvdata(dev);
+	struct wcd939x_usbss_recovery *recovery = usbss->recovery;
+
+	if (!recovery)
+		return 0;
+	mutex_lock(&usbss->lock);
+	recovery->suspended = false;
+	if (!recovery->stopping)
+		queue_delayed_work(system_freezable_wq, &recovery->work, 0);
+	mutex_unlock(&usbss->lock);
+	return 0;
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(wcd939x_usbss_pm_ops,
+			       wcd939x_usbss_suspend, wcd939x_usbss_resume);
 
 /* Linearlizer coefficients for 32ohm load */
