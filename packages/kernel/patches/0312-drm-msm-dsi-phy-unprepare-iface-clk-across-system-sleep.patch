From: seilent <github@seilent.net>
Subject: [PATCH] drm/msm/dsi: phy: unprepare iface clk across system sleep on Pocket MICRO 2

pm_clk keeps a clock with an enable op prepared for the device
lifetime, so the DSI PHY holds disp_cc_mdss_ahb_clk, and through it
the bi_tcxo XO vote, during system suspend. On the AYANEO Pocket MICRO
2 manage the iface clock directly: enable and disable it for runtime
PM, unprepare it in suspend_late and prepare it in resume_early. The
runtime PM callbacks stay away from prepare_lock because the PHY is
also a clock provider.

---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
index 1fb3899b8..fdfc22cf3 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.c
@@ -3,7 +3,9 @@
  * Copyright (c) 2015, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/clk.h>
 #include <linux/clk-provider.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/pm_clock.h>
 #include <linux/pm_runtime.h>
@@ -687,13 +689,20 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
-	ret = devm_pm_clk_create(dev);
-	if (ret)
-		return ret;
+	if (of_machine_is_compatible("ayaneo,pocket-micro2")) {
+		phy->ahb_clk = devm_clk_get_prepared(dev, "iface");
+		if (IS_ERR(phy->ahb_clk))
+			return dev_err_probe(dev, PTR_ERR(phy->ahb_clk),
+					     "Unable to get iface clk\n");
+	} else {
+		ret = devm_pm_clk_create(dev);
+		if (ret)
+			return ret;
 
-	ret = pm_clk_add(dev, "iface");
-	if (ret < 0)
-		return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+		ret = pm_clk_add(dev, "iface");
+		if (ret < 0)
+			return dev_err_probe(dev, ret, "Unable to get iface clk\n");
+	}
 
 	if (phy->cfg->ops.pll_init) {
 		ret = phy->cfg->ops.pll_init(phy);
@@ -711,8 +720,63 @@ static int dsi_phy_driver_probe(struct platform_device *pdev)
 	return 0;
 }
 
+static int dsi_phy_runtime_suspend(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	if (!phy->ahb_clk)
+		return pm_clk_suspend(dev);
+
+	clk_disable(phy->ahb_clk);
+
+	return 0;
+}
+
+static int dsi_phy_runtime_resume(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+
+	if (!phy->ahb_clk)
+		return pm_clk_resume(dev);
+
+	return clk_enable(phy->ahb_clk);
+}
+
+static int dsi_phy_suspend_late(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	if (!phy->ahb_clk)
+		return 0;
+
+	ret = pm_runtime_force_suspend(dev);
+	if (ret)
+		return ret;
+
+	clk_unprepare(phy->ahb_clk);
+
+	return 0;
+}
+
+static int dsi_phy_resume_early(struct device *dev)
+{
+	struct msm_dsi_phy *phy = dev_get_drvdata(dev);
+	int ret;
+
+	if (!phy->ahb_clk)
+		return 0;
+
+	ret = clk_prepare(phy->ahb_clk);
+	if (ret)
+		return ret;
+
+	return pm_runtime_force_resume(dev);
+}
+
 static const struct dev_pm_ops dsi_phy_pm_ops = {
-	SET_RUNTIME_PM_OPS(pm_clk_suspend, pm_clk_resume, NULL)
+	SET_RUNTIME_PM_OPS(dsi_phy_runtime_suspend, dsi_phy_runtime_resume, NULL)
+	SET_LATE_SYSTEM_SLEEP_PM_OPS(dsi_phy_suspend_late, dsi_phy_resume_early)
 };
 
 static struct platform_driver dsi_phy_platform_driver = {
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
index f5d3e806f..e658dd283 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy.h
@@ -107,6 +107,7 @@ struct msm_dsi_phy {
 	int id;
 
 	struct regulator_bulk_data *supplies;
+	struct clk *ahb_clk;
 
 	struct msm_dsi_dphy_timing timing;
 	const struct msm_dsi_phy_cfg *cfg;
