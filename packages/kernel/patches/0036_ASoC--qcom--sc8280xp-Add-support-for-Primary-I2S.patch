From: Philippe Simons <simons.philippe@gmail.com>
Subject: [PATCH] ASoC: qcom: sc8280xp: Add Primary I2S support

[Armada: rebased onto Linux 7.3, which sets the MI2S formats and LPAIF
sysclks in hw_params for boards whose card data asks for it. This keeps
the optional "i2s_clk" board clock, enabled with a count across every
MI2S DAI (formerly 0060, folded in), and the Primary MI2S formats set at
startup for cards whose data leaves codec_dai_fmt unset (SM8750).]

---
--- a/sound/soc/qcom/sc8280xp.c
+++ b/sound/soc/qcom/sc8280xp.c
@@ -2,6 +2,7 @@
 // Copyright (c) 2022, Linaro Limited
 
 #include <dt-bindings/sound/qcom,q6afe.h>
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <sound/soc.h>
@@ -80,6 +81,8 @@
 	struct snd_soc_jack jack;
 	struct snd_soc_jack dp_jack[8];
 	const struct qcom_snd_soc_common *priv;
+	struct clk *i2s_clk;
+	int mi2s_clk_count;
 	bool jack_setup;
 };
 
@@ -215,6 +218,59 @@
 	return 0;
 }
 
+static int sc8280xp_snd_startup(struct snd_pcm_substream *substream)
+{
+	unsigned int fmt = SND_SOC_DAIFMT_BP_FP;
+	unsigned int codec_dai_fmt = SND_SOC_DAIFMT_BC_FC | SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct snd_soc_dai *codec_dai = snd_soc_rtd_to_codec(rtd, 0);
+	int ret;
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (++pdata->mi2s_clk_count == 1) {
+			ret = clk_prepare_enable(pdata->i2s_clk);
+			if (ret) {
+				pdata->mi2s_clk_count--;
+				return ret;
+			}
+		}
+
+		if (cpu_dai->id != PRIMARY_MI2S_RX)
+			break;
+
+		snd_soc_dai_set_fmt(cpu_dai, fmt);
+		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
+		break;
+	default:
+		break;
+	}
+
+	return qcom_snd_sdw_startup(substream);
+}
+
+static void sc8280xp_snd_shutdown(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
+	struct sc8280xp_snd_data *pdata = snd_soc_card_get_drvdata(rtd->card);
+
+	switch (cpu_dai->id) {
+	case PRIMARY_MI2S_RX...QUATERNARY_MI2S_TX:
+	case QUINARY_MI2S_RX...QUINARY_MI2S_TX:
+		if (--pdata->mi2s_clk_count == 0)
+			clk_disable_unprepare(pdata->i2s_clk);
+		break;
+	default:
+		break;
+	}
+
+	qcom_snd_sdw_shutdown(substream);
+}
+
 static int sc8280xp_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				     struct snd_pcm_hw_params *params)
 {
@@ -369,8 +425,8 @@
 }
 
 static const struct snd_soc_ops sc8280xp_be_ops = {
-	.startup = qcom_snd_sdw_startup,
-	.shutdown = qcom_snd_sdw_shutdown,
+	.startup = sc8280xp_snd_startup,
+	.shutdown = sc8280xp_snd_shutdown,
 	.hw_params = sc8280xp_snd_hw_params,
 	.hw_free = sc8280xp_snd_hw_free,
 	.prepare = sc8280xp_snd_prepare,
@@ -412,6 +468,11 @@
 
 	card->owner = THIS_MODULE;
 	card->dev = dev;
+
+	data->i2s_clk = devm_clk_get_optional(dev, "i2s_clk");
+	if (IS_ERR(data->i2s_clk))
+		return dev_err_probe(dev, PTR_ERR(data->i2s_clk), "unable to get i2s clock\n");
+
 	dev_set_drvdata(dev, card);
 	snd_soc_card_set_drvdata(card, data);
 	card->dapm_widgets = data->priv->dapm_widgets;
