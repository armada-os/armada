From: Armada <noreply@armada.local>
Subject: [PATCH] drm/panel: visionox-vtdr6130-cog: allow calibrating the Odin 3 Portal frame length

Expose the Odin 3 Portal DDIC frame lengths for 120 Hz and 60 Hz
(register B1 on command page 10, the same layout as the Retroid Pocket
6) as frame_len_120 and frame_len_60 on the DSI device, as the ICNA35xx
driver does, so they can be calibrated per unit. The init sequence
writes the stored values; a write after init also applies them live,
under a mutex that keeps backlight DCS out of its page switch.

--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -9,6 +9,7 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
 #include <linux/regulator/consumer.h>
@@ -32,6 +33,13 @@
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+
+	/* A live frame-length write changes command page; keep other DCS out. */
+	struct mutex lock;
+	bool ready;
+
+	u16 frame_len_120;
+	u16 frame_len_60;
 };
 
 struct vtdr6130_supply_config {
@@ -69,6 +77,9 @@
 	unsigned int sleep_out_delay_ms;
 	unsigned int pps_delay_ms;
 	unsigned int display_on_delay_ms;
+	/* Stock DDIC frame lengths; nonzero exposes them for calibration. */
+	u16 frame_len_120;
+	u16 frame_len_60;
 };
 
 /* SM8250 regulators */
@@ -406,6 +417,19 @@
 	.default_brightness = 2047,
 };
 
+static void vtdr6130_set_frame_len(struct panel_info *pinfo,
+				   struct mipi_dsi_multi_context *ctx)
+{
+	const u8 len_120[] = { 0xb1, pinfo->frame_len_120 >> 8, pinfo->frame_len_120 & 0xff };
+	const u8 len_60[] = { 0xb1, pinfo->frame_len_60 >> 8, pinfo->frame_len_60 & 0xff };
+
+	vtdr6130_write_seq(pinfo, ctx, 0xf0, 0xaa, 0x10);
+	vtdr6130_write_seq(pinfo, ctx, 0x65, 0x04);
+	vtdr6130_write(pinfo, ctx, len_120, sizeof(len_120));
+	vtdr6130_write_seq(pinfo, ctx, 0x65, 0x0b);
+	vtdr6130_write(pinfo, ctx, len_60, sizeof(len_60));
+}
+
 static int vtdr6130_odin3portal_init_sequence(struct panel_info *pinfo)
 {
 	struct mipi_dsi_multi_context ctx = { .dsi = pinfo->dsi };
@@ -439,11 +463,7 @@
 			   0xb6, 0x2a, 0xf4, 0x2a, 0xf4, 0x4b, 0x34, 0x63,
 			   0x74, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
 	vtdr6130_write_seq(pinfo, &ctx, 0x72, 0x00);
-	vtdr6130_write_seq(pinfo, &ctx, 0xf0, 0xaa, 0x10);
-	vtdr6130_write_seq(pinfo, &ctx, 0x65, 0x04);
-	vtdr6130_write_seq(pinfo, &ctx, 0xb1, 0x00, 0x18);
-	vtdr6130_write_seq(pinfo, &ctx, 0x65, 0x0b);
-	vtdr6130_write_seq(pinfo, &ctx, 0xb1, 0x07, 0xbe);
+	vtdr6130_set_frame_len(pinfo, &ctx);
 	vtdr6130_write_seq(pinfo, &ctx, 0xff, 0x5a, 0x80);
 	vtdr6130_write_seq(pinfo, &ctx, 0x65, 0x0a);
 	vtdr6130_write_seq(pinfo, &ctx, 0xf9, 0xa8);
@@ -530,6 +550,8 @@
 	.supply_config = odin3portal_supply_config,
 	.display_off_delay_ms = 20,
 	.default_brightness = 1024,
+	.frame_len_120 = 0x18,
+	.frame_len_60 = 0x7be,
 };
 
 static int vtdr6130_power_off(struct panel_info *pinfo, unsigned int count)
@@ -621,7 +643,10 @@
 
 	vtdr6130_reset(pinfo);
 
-	ret = pinfo->desc->init_sequence(pinfo);
+	scoped_guard(mutex, &pinfo->lock) {
+		ret = pinfo->desc->init_sequence(pinfo);
+		pinfo->ready = ret >= 0;
+	}
 	if (ret < 0) {
 		if (pinfo->desc->supply_config)
 			gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
@@ -638,6 +663,9 @@
 	struct panel_info *pinfo = to_panel_info(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
 
+	scoped_guard(mutex, &pinfo->lock)
+		pinfo->ready = false;
+
 	if (pinfo->desc->off_in_lpm)
 		pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 	else
@@ -722,9 +750,12 @@
 static int vtdr6130_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
 	int ret;
 
+	guard(mutex)(&pinfo->lock);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
@@ -739,9 +770,12 @@
 static int vtdr6130_bl_get_brightness(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness;
 	int ret;
 
+	guard(mutex)(&pinfo->lock);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
@@ -772,6 +806,99 @@
 					      &vtdr6130_bl_ops, &props);
 }
 
+static ssize_t vtdr6130_frame_len_store(struct device *dev, u16 *frame_len,
+					u16 min, u16 max,
+					const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+	struct mipi_dsi_multi_context ctx = { .dsi = pinfo->dsi };
+	u16 val;
+	int ret;
+
+	ret = kstrtou16(buf, 0, &val);
+	if (ret)
+		return ret;
+
+	if (val < min || val > max)
+		return -EINVAL;
+
+	guard(mutex)(&pinfo->lock);
+
+	*frame_len = val;
+	if (!pinfo->ready)
+		return count;
+
+	vtdr6130_set_frame_len(pinfo, &ctx);
+	ret = ctx.accum_err;
+	/* Later DCS commands assume page 0, so restore it even after a failure. */
+	ctx.accum_err = 0;
+	vtdr6130_write_seq(pinfo, &ctx, 0xf0, 0xaa, 0x00);
+
+	return ret ?: ctx.accum_err ?: count;
+}
+
+static ssize_t frame_len_120_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	guard(mutex)(&pinfo->lock);
+
+	return sysfs_emit(buf, "%u\n", pinfo->frame_len_120);
+}
+
+static ssize_t frame_len_120_store(struct device *dev,
+				   struct device_attribute *attr,
+				   const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return vtdr6130_frame_len_store(dev, &pinfo->frame_len_120,
+					0x10, 0x80, buf, count);
+}
+static DEVICE_ATTR_RW(frame_len_120);
+
+static ssize_t frame_len_60_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	guard(mutex)(&pinfo->lock);
+
+	return sysfs_emit(buf, "%u\n", pinfo->frame_len_60);
+}
+
+static ssize_t frame_len_60_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct panel_info *pinfo = dev_get_drvdata(dev);
+
+	return vtdr6130_frame_len_store(dev, &pinfo->frame_len_60,
+					0x76c, 0x834, buf, count);
+}
+static DEVICE_ATTR_RW(frame_len_60);
+
+static struct attribute *vtdr6130_attrs[] = {
+	&dev_attr_frame_len_120.attr,
+	&dev_attr_frame_len_60.attr,
+	NULL
+};
+
+static umode_t vtdr6130_attr_is_visible(struct kobject *kobj,
+					struct attribute *attr, int n)
+{
+	struct panel_info *pinfo = dev_get_drvdata(kobj_to_dev(kobj));
+
+	return pinfo->desc->frame_len_120 ? attr->mode : 0;
+}
+
+static const struct attribute_group vtdr6130_group = {
+	.attrs = vtdr6130_attrs,
+	.is_visible = vtdr6130_attr_is_visible,
+};
+__ATTRIBUTE_GROUPS(vtdr6130);
+
 static int vtdr6130_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -784,6 +911,10 @@
 	if (IS_ERR(pinfo))
 		return PTR_ERR(pinfo);
 
+	ret = devm_mutex_init(dev, &pinfo->lock);
+	if (ret)
+		return ret;
+
 	pinfo->desc = (struct panel_desc *)of_device_get_match_data(dev);
 	if (!pinfo->desc)
 		return -ENODEV;
@@ -800,6 +931,8 @@
 		return dev_err_probe(dev, PTR_ERR(pinfo->reset_gpio), "failed to get reset gpio\n");
 
 	pinfo->dsi = dsi;
+	pinfo->frame_len_120 = pinfo->desc->frame_len_120;
+	pinfo->frame_len_60 = pinfo->desc->frame_len_60;
 	mipi_dsi_set_drvdata(dsi, pinfo);
 
 	ret = of_drm_get_panel_orientation(dev->of_node, &pinfo->orientation);
@@ -848,6 +981,7 @@
 	.driver = {
 		.name = "panel-visionox-vtdr6130-cog",
 		.of_match_table = vtdr6130_of_match,
+		.dev_groups = vtdr6130_groups,
 	},
 };
 module_mipi_dsi_driver(vtdr6130_driver);
