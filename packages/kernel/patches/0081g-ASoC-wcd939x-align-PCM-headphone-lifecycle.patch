From: mrdidit <26687854+mrdidit@users.noreply.github.com>
Subject: [PATCH] ASoC: wcd939x: align PCM headphone lifecycle

Run PCM receive preparation before RDAC startup and release it after
RDAC shutdown. Match the channel-local compander and gain-source
operations, interpolation state, and ULP reference-current release in
the Pocket S2 Android codec callbacks. Preserve unrelated register bits.

Keep the selected Class-H power mode throughout PCM PA startup instead
of appending HiFi and an unconditional power-level rewrite. Preserve
PDM behavior and the explicit PCM chopper restoration after PDM use.

Reference: Qualcomm WCD939x source published by OnePlusOSS, blob
108c2b4bfa69fc5d372dfde2cdc46778422e49b5; relevant callbacks checked
against the installed S2 wcd939x_dlkm.ko, SHA-256
3167f0ed193ded237899593ac5a9d0418a185e24b0f22a99ceb4278a2f9aa54c.
Runtime validation is pending; this does not establish distortion recovery.
---

diff --git a/sound/soc/codecs/wcd939x.c b/sound/soc/codecs/wcd939x.c
--- a/sound/soc/codecs/wcd939x.c
+++ b/sound/soc/codecs/wcd939x.c
@@ -505,29 +505,17 @@
 	return 0;
 }
 
-/*
- * HPH PCM ("HiFi") mode: the HPH stream arrives as PCM samples on SoundWire
- * port 6 (HIFI_PCM) and the codec runs its own interpolator, DC droop filter
- * and analog compander, replacing the legacy PDM receive path. Vendor
- * hph_pcm_enabled behavior; register values match the stock WCD9395 trace
- * (SoundWire clock fixed at 9.6 MHz on this platform).
- */
-static void wcd939x_hph_pcm_pre_dac(struct snd_soc_component *component,
-				    bool hphr)
+static void wcd939x_hph_pcm_pre_rx(struct snd_soc_component *component,
+				   bool hphr)
 {
 	struct wcd939x_priv *wcd939x = snd_soc_component_get_drvdata(component);
 	bool comp_en = hphr ? wcd939x->comp2_enable : wcd939x->comp1_enable;
 	u16 comp_base = hphr ? WCD939X_R_CTL0 : WCD939X_COMPANDER_HPHL_CTL0;
 	u16 sec_base = hphr ? WCD939X_RX_TOP_HPHR_PATH_SEC0 :
 			      WCD939X_RX_TOP_HPHL_PATH_SEC0;
-
-	/*
-	 * PCM mode keeps the RDAC chopper running (stock 0x30d9 = 0x80);
-	 * set it explicitly in case a PDM-mode bring-up cleared it earlier.
-	 */
-	snd_soc_component_write_field(component, WCD939X_HPH_RDAC_CLK_CTL1,
-				      WCD939X_RDAC_CLK_CTL1_OPAMP_CHOP_CLK_EN,
-				      true);
+	u16 gain_reg = hphr ? WCD939X_HPH_R_EN : WCD939X_HPH_L_EN;
+	u8 comp_mask = hphr ? WCD939X_CDC_COMP_CTL_0_HPHR_COMP_EN :
+			     WCD939X_CDC_COMP_CTL_0_HPHL_COMP_EN;
 
 	if (wcd939x->hph_mode == CLS_H_ULP) {
 		snd_soc_component_write_field(component, WCD939X_HPH_REFBUFF_UHQA_CTL,
@@ -536,67 +524,124 @@
 					      WCD939X_REFBUFF_UHQA_CTL_REFBUFN_IOUT_CTL, 1);
 	}
 
-	/* crosstalk coefficients (stock: scale 0x1f, sec2/3 0x11/0x4f) */
-	snd_soc_component_write(component, sec_base + 0, 0x1f);
+	if (comp_en) {
+		if (wcd939x->hph_mode == CLS_H_ULP) {
+			snd_soc_component_update_bits(component, comp_base + 12, 0x7f, 0x21);
+			snd_soc_component_update_bits(component, comp_base + 13, 0x7f, 0x30);
+			snd_soc_component_update_bits(component, comp_base + 14, 0x7f, 0x3f);
+			snd_soc_component_update_bits(component, comp_base + 15, 0x7f, 0x48);
+			snd_soc_component_update_bits(component, comp_base + 17, 0x3f, 0x0c);
+		} else {
+			snd_soc_component_update_bits(component, comp_base + 12, 0x7f, 0x1e);
+			snd_soc_component_update_bits(component, comp_base + 13, 0x7f, 0x2a);
+			snd_soc_component_update_bits(component, comp_base + 14, 0x7f, 0x36);
+			snd_soc_component_update_bits(component, comp_base + 15, 0x7f, 0x3c);
+			snd_soc_component_update_bits(component, comp_base + 17, 0x3f, 0x00);
+		}
+
+		snd_soc_component_update_bits(component, comp_base + 7, 0x1e, 0x00);
+		snd_soc_component_update_bits(component, comp_base, 0x01, 0x01);
+		usleep_range(250, 260);
+		snd_soc_component_update_bits(component, comp_base, 0x02, 0x02);
+		snd_soc_component_update_bits(component, comp_base, 0x02, 0x00);
+		snd_soc_component_update_bits(component, WCD939X_DIGITAL_CDC_COMP_CTL_0,
+					      comp_mask, comp_mask);
+	} else {
+		snd_soc_component_update_bits(component, gain_reg, BIT(5), BIT(5));
+	}
+
+	snd_soc_component_write(component, sec_base + 1, 0x00);
+	snd_soc_component_update_bits(component, sec_base, 0x1f, 0x1f);
 	snd_soc_component_write(component, sec_base + 3, 0x4f);
-	snd_soc_component_write(component, sec_base + 2, 0x11);
-
-	if (!comp_en) {
-		/* compander bypassed, gain from register */
-		if (hphr)
-			snd_soc_component_write_field(component, WCD939X_HPH_R_EN,
-						      WCD939X_R_EN_GAIN_SOURCE_SEL, true);
-		else
-			snd_soc_component_write_field(component, WCD939X_HPH_L_EN,
-						      WCD939X_L_EN_GAIN_SOURCE_SEL, true);
-		return;
-	}
-
-	/* compander zone RMS thresholds + path gain per power mode */
+	snd_soc_component_update_bits(component, sec_base + 2, 0x1f, 0x11);
+}
