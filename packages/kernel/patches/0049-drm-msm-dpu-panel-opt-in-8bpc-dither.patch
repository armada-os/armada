From: enjihn <150061999+enjihn@users.noreply.github.com>
Subject: [PATCH] drm/msm/dpu: let panels opt in to 8bpc output dithering

The DPU helper disables output dithering for 8bpc panels, so the 10-bit
pipeline is hard-truncated at the panel interface and dark gradients band
visibly, most of all with HDR content. Enable the existing static ordered
dither matrix at 8bpc for panels that ask for it. Temporal dithering stays
disabled and the 6bpc and default paths are unchanged.

--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -10,9 +10,11 @@
 #define pr_fmt(fmt)	"[drm:%s:%d] " fmt, __func__, __LINE__
 #include <linux/debugfs.h>
 #include <linux/kthread.h>
+#include <linux/of.h>
 #include <linux/seq_file.h>
 
 #include <drm/drm_atomic.h>
+#include <drm/drm_bridge.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_file.h>
 #include <drm/drm_probe_helper.h>
@@ -386,7 +388,28 @@
 	return entries_added;
 }
 
-static void _dpu_encoder_setup_dither(struct dpu_hw_pingpong *hw_pp, unsigned bpc)
+/*
+ * The DPU disables output dithering at 8bpc, but a panel fed from the 10-bit
+ * pipeline can visibly band without it. Boards opt in per panel with the
+ * armada,dpu-8bpc-dither devicetree property on the panel node.
+ */
+static bool dpu_encoder_panel_dithers_8bpc(struct drm_encoder *drm_enc)
+{
+	struct drm_bridge *last = drm_bridge_chain_get_last_bridge(drm_enc);
+	bool dithers;
+
+	if (!last)
+		return false;
+
+	dithers = last->of_node &&
+		of_property_read_bool(last->of_node, "armada,dpu-8bpc-dither");
+	drm_bridge_put(last);
+
+	return dithers;
+}
+
+static void _dpu_encoder_setup_dither(struct dpu_hw_pingpong *hw_pp, unsigned bpc,
+				      bool panel_dithers_8bpc)
 {
 	struct dpu_hw_dither_cfg dither_cfg = { 0 };
 
@@ -401,6 +424,17 @@
 		dither_cfg.c3_bitdepth = 6;
 		dither_cfg.temporal_en = 0;
 		break;
+	case 8:
+		if (!panel_dithers_8bpc) {
+			hw_pp->ops.setup_dither(hw_pp, NULL);
+			return;
+		}
+		dither_cfg.c0_bitdepth = 8;
+		dither_cfg.c1_bitdepth = 8;
+		dither_cfg.c2_bitdepth = 8;
+		dither_cfg.c3_bitdepth = 8;
+		dither_cfg.temporal_en = 0;
+		break;
 	default:
 		hw_pp->ops.setup_dither(hw_pp, NULL);
 		return;
@@ -1321,10 +1355,12 @@
 	if (dpu_enc->disp_info.intf_type == INTF_DSI &&
 			!WARN_ON(dpu_enc->num_phys_encs == 0)) {
 		unsigned bpc = dpu_enc->connector->display_info.bpc;
+		bool panel_dithers_8bpc = dpu_encoder_panel_dithers_8bpc(drm_enc);
 		for (i = 0; i < ARRAY_SIZE(dpu_enc->hw_pp); i++) {
 			if (!dpu_enc->hw_pp[i])
 				continue;
-			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc);
+			_dpu_encoder_setup_dither(dpu_enc->hw_pp[i], bpc,
+						  panel_dithers_8bpc);
 		}
 	}
 }
