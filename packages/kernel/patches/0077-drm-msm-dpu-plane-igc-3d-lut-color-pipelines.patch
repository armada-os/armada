 	/* flushes left to reprogram color after a LUTDMA wait or setup failure */
 	u8 cp_blocks_retries;
+	bool luts_queued;
 
 	struct drm_pending_vblank_event *event;
 	u32 vsync_count;
@@ -283,4 +284,6 @@
 
 unsigned int dpu_crtc_get_num_lm(const struct drm_crtc_state *state);
 
+int dpu_crtc_lut_ctl_idx(struct drm_crtc *crtc);
+
 #endif /* _DPU_CRTC_H_ */
