 	dma->cfg = cfg;
 	dma->sb.blk_addr = base + cfg->sb_off;
 	dma->sb.log_mask = DPU_DBG_MASK_TOP;
+	dma->db.blk_addr = base + cfg->db_off;
+	dma->db.log_mask = DPU_DBG_MASK_TOP;
 
 	for (i = CTL_0; i < CTL_MAX; i++) {
 		ret = dpu_reg_dma_buf_alloc(dma, &dma->last_cmd[i], LAST_CMD_BUF_SIZE);
+		if (!ret)
+			ret = dpu_reg_dma_buf_alloc(dma, &dma->last_cmd_db[i], LAST_CMD_BUF_SIZE);
 		if (ret) {
-			while (--i >= CTL_0)
-				dpu_reg_dma_buf_free(dma, &dma->last_cmd[i]);
+			dpu_reg_dma_destroy(dma);
 			return ERR_PTR(ret);
 		}
 	}
@@ -376,6 +437,7 @@
 
 	for (i = CTL_0; i < CTL_MAX; i++)
 		dma->last_cmd[i].ctl_idx = 0;
+	dma->db_stuck = false;
 }
 
 /* Must run while the display VM is still alive */
@@ -383,6 +445,8 @@
 {
 	int i;
 
-	for (i = CTL_0; i < CTL_MAX; i++)
+	for (i = CTL_0; i < CTL_MAX; i++) {
 		dpu_reg_dma_buf_free(dma, &dma->last_cmd[i]);
+		dpu_reg_dma_buf_free(dma, &dma->last_cmd_db[i]);
+	}
 }
