 };
 
 int dpu_reg_dma_buf_alloc(struct dpu_reg_dma *dma, struct dpu_reg_dma_buf *buf, u32 size)
@@ -234,14 +250,16 @@
 	       l->intr_clear(ctl_idx) + sizeof(u32) <= sb_len;
 }
 
-static int kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf, bool last)
+static int kick_off(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf,
+		    bool db, bool last)
 {
 	const struct dpu_reg_dma_layout *l = dma->layout;
+	struct dpu_hw_blk_reg_map *win = db ? &dma->db : &dma->sb;
 	u32 queue, cmd1, status;
 
 	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx) || !buf->iova || !buf->index)
 		return -EINVAL;
-	queue = l->queue1(ctl_idx);
+	queue = db ? l->queue0(ctl_idx) : l->queue1(ctl_idx);
 
 	/* the command buffer is write-combined; publish it before the engine reads it */
 	wmb();
@@ -250,28 +268,35 @@
 	if (last)
 		cmd1 |= CMD_LAST;
 
-	DPU_REG_WRITE(&dma->sb, REG_DMA_OPMODE, BIT(0));
-	status = DPU_REG_READ(&dma->sb, l->intr4_status);
+	DPU_REG_WRITE(win, REG_DMA_OPMODE, BIT(0));
+	status = DPU_REG_READ(win, l->intr4_status);
 	if (status) {
 		DRM_ERROR_RATELIMITED("LUTDMA error status %#x\n", status);
-		DPU_REG_WRITE(&dma->sb, l->intr4_clear, REG_DMA_ERROR_CLEAR_MASK);
+		DPU_REG_WRITE(win, l->intr4_clear, REG_DMA_ERROR_CLEAR_MASK);
 	}
 
-	DPU_REG_WRITE(&dma->sb, queue, lower_32_bits(buf->iova));
-	DPU_REG_WRITE(&dma->sb, queue + 0x4, cmd1);
-	buf->ctl_idx = ctl_idx;
+	DPU_REG_WRITE(win, queue, lower_32_bits(buf->iova));
+	DPU_REG_WRITE(win, queue + 0x4, cmd1);
+	if (!db)
+		buf->ctl_idx = ctl_idx;
 
 	if (last) {
 		/* the last-command descriptor must be queued before the done bit is armed */
 		wmb();
-		DPU_REG_WRITE(&dma->sb, l->intr_clear(ctl_idx), l->done_mask(ctl_idx));
+		DPU_REG_WRITE(win, l->intr_clear(ctl_idx),
+			      db ? l->db_done_mask(ctl_idx) : l->done_mask(ctl_idx));
 	}
 	return 0;
 }
 
 int dpu_reg_dma_kick_off_sb(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf)
 {
-	return kick_off_sb(dma, ctl_idx, buf, false);
+	return kick_off(dma, ctl_idx, buf, false, false);
+}
+
+int dpu_reg_dma_kick_off_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_reg_dma_buf *buf)
+{
+	return kick_off(dma, ctl_idx, buf, true, false);
 }
 
 /*
@@ -294,7 +319,40 @@
 	if (ret)
 		return ret;
 
-	return kick_off_sb(dma, ctl_idx, buf, true);
+	return kick_off(dma, ctl_idx, buf, false, true);
+}
+
+/*
+ * The double-buffered queue runs on a software trigger rather than a flush:
+ * close it, start it, and wait so the registers it writes are in place
+ * before the CTL flush that latches them.
+ */
+int dpu_reg_dma_flush_db(struct dpu_reg_dma *dma, int ctl_idx, struct dpu_hw_blk_reg_map *ctl_hw)
+{
+	struct dpu_reg_dma_buf *buf = &dma->last_cmd_db[ctl_idx];
+	u32 status;
+	int ret;
+
+	if (!dpu_reg_dma_ctl_valid(dma, ctl_idx) || !buf->vaddr)
+		return -EINVAL;
+	if (dma->db_stuck)
+		return -EBUSY;
+
+	buf->index = 0;
+	ret = write_decode_sel(buf, dma->layout->decode_sel, 0);
+	if (!ret)
+		ret = kick_off(dma, ctl_idx, buf, true, true);
+	if (ret)
+		return ret;
+
+	DPU_REG_WRITE(ctl_hw, CTL_REG_DMA_TRIGGER, BIT(0));
+	ret = read_poll_timeout(DPU_REG_READ, status, status & dma->layout->db_done_mask(ctl_idx),
+				10, DONE_TIMEOUT_US, false,
+				&dma->db, dma->layout->intr_status(ctl_idx));
+	/* the engine may still be reading the queued buffers; stop rewriting them */
+	if (ret)
+		dma->db_stuck = true;
+	return ret;
 }
 
