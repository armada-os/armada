 };
 
 /*
  * v3: one 4 KiB window per CTL with its own queues, status and reset,
  * numbered by CTL id, so CTL_0 uses the second window.
  */
+static u32 v3_queue0(int ctl_idx) { return 0x1000 * ctl_idx; }
 static u32 v3_queue1(int ctl_idx) { return 0x1000 * ctl_idx + 0x8; }
 static u32 v3_intr_status(int ctl_idx) { return 0x1000 * ctl_idx + 0x44; }
 static u32 v3_intr_clear(int ctl_idx) { return 0x1000 * ctl_idx + 0x48; }
 static u32 v3_done(int ctl_idx) { return BIT(4); }
+static u32 v3_db_done(int ctl_idx) { return BIT(3); }
 
 static const struct dpu_reg_dma_layout dpu_reg_dma_v3 = {
