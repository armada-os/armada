 }
+
+/*
+ * VIG IGC v6 and gamut v6.1 (SM8550, SM8650, SM8750), loaded through the
+ * LUTDMA double-buffered queue, which addresses the pipe from lut_top_off.
+ * The shared opmode register holds the gamut mode and enable in bits 4:0
+ * and the IGC enable and bank in bits 9:8. Each block has two banks: the
+ * idle one is written and the opmode, latched by the pipe's flush,
+ * switches to it.
+ */
+#define LUT_GAMUT_EN		BIT(0)
+#define LUT_GAMUT_MODE_17B	(4 << 2)
+#define LUT_GAMUT_MASK		GENMASK(4, 0)
+#define LUT_IGC_EN		BIT(8)
+#define LUT_IGC_BANK		BIT(9)
+#define LUT_IGC_INDEX		0x1b0
+#define LUT_IGC_DATA(c)		(0x1b4 + 4 * (c))
+#define LUT_IGC_DITHER		0x1c0
+#define LUT_IGC_LAST(c)		(0x1c4 + 4 * (c))
+#define LUT_IGC_WORDS		((DPU_SSPP_IGC_SIZE - 1) / 2)
+#define LUT_GAMUT_TBL_NUM	4
+#define LUT_GAMUT_TBL_LEN	1229
+#define LUT_GAMUT_NODES		(DPU_SSPP_LUT3D_EDGE * DPU_SSPP_LUT3D_EDGE * DPU_SSPP_LUT3D_EDGE)
+#define LUT_GAMUT_LEN		(LUT_GAMUT_TBL_NUM * LUT_GAMUT_TBL_LEN * 3 * sizeof(u16))
+#define LUT_OP_SIZE		(2 * sizeof(u32))
+#define LUT_BUF_SIZE		(LUT_GAMUT_LEN + 5 * sizeof(u32) + \
+				 (3 * (LUT_IGC_WORDS + 2) + 4) * LUT_OP_SIZE)
+
+static u32 igc_val(const struct drm_color_lut32 *lut, int i, int chan)
+{
+	u32 v = chan == 0 ? lut[i].red : chan == 1 ? lut[i].green : lut[i].blue;
+
+	return drm_color_lut32_extract(v, 12);
+}
+
+static int queue_gamut(struct dpu_hw_sspp *ctx, const struct drm_color_lut32 *lut,
+		       bool table_b)
+{
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	__le16 *data;
+	int n, k;
+
+	data = dpu_reg_dma_lut_reserve(buf, DPU_LUTBUS_BLOCK_GAMUT |
+				       (table_b ? DPU_LUTBUS_TABLE_B : 0),
+				       DPU_LUTBUS_GAMUT_TRANS_SIZE, LUT_GAMUT_LEN);
+	if (!data)
+		return -ENOSPC;
+
+	/* same node stream and component order as the DSPP gamut, 10 bits MSB aligned */
+	for (n = 0, k = 0; n < LUT_GAMUT_NODES; n++) {
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].red, 10) << 6);
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].green, 10) << 6);
+		data[k++] = cpu_to_le16(drm_color_lut32_extract(lut[n].blue, 10) << 6);
+	}
+	return 0;
+}
+
+/* ports c0, c1, c2 carry green, blue, red, as the DSPP IGC does */
+static int queue_igc(struct dpu_hw_sspp *ctx, u32 blk, const struct drm_color_lut32 *lut)
+{
+	static const int chans[3] = { 1, 2, 0 };
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	int c, j, ret = 0;
+
+	for (c = 0; c < 3 && !ret; c++) {
+		int chan = chans[c];
+
+		ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_INDEX, 0);
+		for (j = 0; j < LUT_IGC_WORDS && !ret; j++)
+			ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_DATA(c),
+						       igc_val(lut, 2 * j, chan) |
+						       igc_val(lut, 2 * j + 1, chan) << 16);
+		if (!ret)
+			ret = dpu_reg_dma_single_write(buf, blk + LUT_IGC_LAST(c),
+						       igc_val(lut, DPU_SSPP_IGC_SIZE - 1, chan));
+	}
+	return ret ? ret : dpu_reg_dma_single_write(buf, blk + LUT_IGC_DITHER, 0);
+}
+
+int dpu_hw_sspp_setup_luts(struct dpu_hw_sspp *ctx, struct drm_property_blob *igc,
+			   struct drm_property_blob *lut3d, int ctl_idx)
+{
+	const struct dpu_sspp_sub_blks *sblk = ctx->cap->sblk;
+	struct dpu_reg_dma_buf *buf = &ctx->lut_buf;
+	u32 blk = DPU_SSPP_LUT_OPMODE - sblk->lut_top_off;
+	u32 opmode = 0;
+	int ret;
+
+	if (ctx->reg_dma->db_stuck)
+		return -EBUSY;
+
+	ret = dpu_reg_dma_buf_begin(ctx->reg_dma, buf);
+	if (!ret)
+		ret = dpu_reg_dma_decode_sel(ctx->reg_dma, buf,
+					     DPU_REG_DMA_SEL_VIG(ctx->idx - SSPP_VIG0));
+
+	if (!ret && lut3d) {
+		bool table_b = (ctx->lut_opmode & LUT_GAMUT_MASK) == LUT_GAMUT_EN;
+
+		ret = queue_gamut(ctx, lut3d->data, table_b);
+		opmode |= LUT_GAMUT_EN | (table_b ? LUT_GAMUT_MODE_17B : 0);
+	}
+
+	if (!ret && igc) {
+		ret = queue_igc(ctx, blk, igc->data);
+		opmode |= LUT_IGC_EN;
+		if (ctx->lut_opmode & LUT_IGC_EN)
+			opmode |= ~ctx->lut_opmode & LUT_IGC_BANK;
+		else
+			opmode |= ctx->lut_opmode & LUT_IGC_BANK;
+	}
+
+	if (!ret)
+		ret = dpu_reg_dma_single_write(buf, blk, opmode);
+	if (!ret)
+		ret = dpu_reg_dma_kick_off_db(ctx->reg_dma, ctl_idx, buf);
+	if (ret)
+		return ret;
+
+	ctx->lut_opmode = opmode;
+	drm_property_replace_blob(&ctx->igc, igc);
+	drm_property_replace_blob(&ctx->lut3d, lut3d);
+	return 0;
+}
+
+/* the LUT RAM and opmode are lost with the power domain */
+void dpu_hw_sspp_lut_reset(struct dpu_hw_sspp *ctx)
+{
+	ctx->lut_opmode = 0;
+	drm_property_replace_blob(&ctx->igc, NULL);
+	drm_property_replace_blob(&ctx->lut3d, NULL);
+}
+
+int dpu_hw_sspp_set_reg_dma(struct dpu_hw_sspp *ctx, struct dpu_reg_dma *reg_dma)
+{
+	int ret;
+
+	if (!ctx->cap->sblk->lut_top_off)
+		return 0;
+
+	ret = dpu_reg_dma_buf_alloc(reg_dma, &ctx->lut_buf, LUT_BUF_SIZE);
+	if (ret)
+		return ret;
+	ctx->reg_dma = reg_dma;
+	return 0;
+}
+
+void dpu_hw_sspp_clear_reg_dma(struct dpu_hw_sspp *ctx)
+{
+	if (!ctx->reg_dma)
+		return;
+
+	dpu_hw_sspp_lut_reset(ctx);
+	dpu_reg_dma_buf_free(ctx->reg_dma, &ctx->lut_buf);
+	ctx->reg_dma = NULL;
+}
