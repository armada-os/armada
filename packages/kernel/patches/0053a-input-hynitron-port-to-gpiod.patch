From: Armada <noreply@armada.local>
Subject: [PATCH] Input: hynitron: port vendor driver to GPIO descriptors

Linux 7.1 removed the legacy OF GPIO-number API. Keep the Hynitron CST66xx
driver required by the AYANEO Pocket DMG, but acquire and operate its reset
and interrupt lines through GPIO descriptors. Use raw GPIO values so the
vendor driver's existing physical reset/IRQ polarity remains unchanged.

---
diff --git a/drivers/input/touchscreen/hynitron/hyn_chips/hyn_cst1xx.c b/drivers/input/touchscreen/hynitron/hyn_chips/hyn_cst1xx.c
index 3a31a77..ae8a9da 100644
--- a/drivers/input/touchscreen/hynitron/hyn_chips/hyn_cst1xx.c
+++ b/drivers/input/touchscreen/hynitron/hyn_chips/hyn_cst1xx.c
@@ -209,9 +209,9 @@ static void cst1xx_rst(void)
     if(hyn_1xxdata->work_mode==ENTER_BOOT_MODE){
         hyn_set_i2c_addr(hyn_1xxdata,MAIN_I2C_ADDR);
     }
-    gpio_set_value(hyn_1xxdata->plat_data.reset_gpio,0);
+    gpiod_set_raw_value_cansleep(hyn_1xxdata->plat_data.reset_gpio,0);
     msleep(5);
-    gpio_set_value(hyn_1xxdata->plat_data.reset_gpio,1);
+    gpiod_set_raw_value_cansleep(hyn_1xxdata->plat_data.reset_gpio,1);
 }
 
 static int cst1xx_enter_boot(void)
