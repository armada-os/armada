     if (!drv)
     return -ENOMEM;
+    spin_lock_init(&drv->report_lock);
+    INIT_DELAYED_WORK(&drv->chord_work, rsinput_chord_work);
 
     drv->invert_x = device_property_present(&serdev->dev, "invert-x");
