--- /dev/null
+++ b/src/auto_hdr.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+
+#include "color_helpers.h"
+
+namespace gamescope
+{
+	inline float AutoHdrInverseToneMap( float value, float sdrNits, float targetNits )
+	{
+		if ( !( value > 0.0f && sdrNits > 0.0f && targetNits > 0.0f ) )
+			return 0.0f;
+
+		// Expand highlights with the neutral BT.2446 A curve.
+		constexpr float kInverseGamma = 2.4f;
+		constexpr float kGamma = 1.0f / kInverseGamma;
+		const float ySdr = std::pow( clamp01( value ), kGamma );
+		const float pSdr = 1.0f + 32.0f * std::pow( sdrNits / 10000.0f, kGamma );
+		const float yC = std::log( ySdr * ( pSdr - 1.0f ) + 1.0f ) / std::log( pSdr );
+		const float yP0 = yC / 1.0770f;
+		const float yP1 = ( -2.7811f + std::sqrt( 4.83307641f - 4.604f * yC ) ) / -2.302f;
+		const float yP2 = ( yC - 0.5000f ) / 0.5000f;
+		// Rounded segment endpoints must not make the curve decrease.
+		const float yP = yP0 <= 0.7399f ? yP0 : yP1 < 0.9909f ?
+			std::max( yP1, 0.7399f ) : std::max( yP2, 0.9909f );
+		const float pHdr = 1.0f + 32.0f * std::pow( targetNits / 10000.0f, kGamma );
+		const float y = ( std::pow( pHdr, yP ) - 1.0f ) / ( pHdr - 1.0f );
+		return std::pow( y, kInverseGamma );
+	}
+
+	struct AutoHdrTransform
+	{
+		glm::mat3 nativeFromOutput;
+		float sdrNits;
+		float targetNits;
+
+		static glm::vec3 Apply( glm::vec3 color, const void *data )
+		{
+			const auto &transform = *static_cast<const AutoHdrTransform *>( data );
+			// Measure the peak in the panel gamut, including for BT.2020 output.
+			const glm::vec3 native = transform.nativeFromOutput * color;
+			const float maxChannel = std::max( { native.r, native.g, native.b } );
+			if ( !( maxChannel > 0.0f && transform.targetNits > 0.0f ) )
+				return glm::vec3( 0.0f );
+			// One RGB gain preserves the SDR channel ratios.
+			const float mappedPeak = AutoHdrInverseToneMap( maxChannel / transform.targetNits,
+				transform.sdrNits, transform.targetNits ) * transform.targetNits;
+			return color * ( std::min( mappedPeak, transform.targetNits ) / maxChannel );
+		}
+	};
+}
