+#ifndef GAMESCOPE_COLOR_PROVIDER_GLSL
+#define GAMESCOPE_COLOR_PROVIDER_GLSL
+
+uint color_provider_lut_index(uint originalLayer, uint inputEotf) {
+    // RCAS remaps offset slots; only the original game layer uses the extra LUT.
+    return originalLayer == 0 && textureQueryLevels(s_shaperLut[EOTF_Count]) != 0
+        ? EOTF_Count : inputEotf;
+}
+
+vec3 apply_layer_color_mgmt(vec3 color, uint offsetLayerIdx, uint colorspaceLayerIdx, uint colorspace);
+
+vec3 apply_layer_color_mgmt(vec3 color, uint layerIdx, uint colorspace) {
+    return apply_layer_color_mgmt(color, layerIdx, layerIdx, colorspace);
+}
+
+#endif
diff --git a/src/color_provider.h b/src/color_provider.h
new file mode 100644
index 0000000..8e6b539
--- /dev/null
+++ b/src/color_provider.h
@@ -0,0 +1,233 @@
+#pragma once
+
+#include <gamescope-color-provider.h>
+#include <cstdio>
+#include <dlfcn.h>
+#include <span>
+
+#include "rendervulkan.hpp"
+#include "convar.h"
+
+#if HAVE_DRM
+extern "C" {
+#include <libliftoff.h>
+}
+#endif
+
+namespace gamescope
+{
+	inline ConVar<bool> cv_armada_auto_hdr{ "armada_auto_hdr", false, "Enable inverse tone mapping for SDR games." };
+
+	struct ColorProviderConnection
+	{
+		const gamescope_color_provider *api = nullptr;
+		void *instance = nullptr;
+
+		~ColorProviderConnection() { if ( instance ) api->destroy( instance ); }
+	};
+
+	inline const ColorProviderConnection *GetColorProvider( bool enabled )
+	{
+		if ( !enabled )
+			return nullptr;
+		static const ColorProviderConnection provider = []() -> ColorProviderConnection
+		{
+			void *library = dlopen( "libarmada-autohdr.so.2", RTLD_NOW | RTLD_LOCAL );
+			if ( !library )
+			{
+				fprintf( stderr, "Color provider unavailable: %s\n", dlerror() );
+				return {};
+			}
+			const auto query = reinterpret_cast<gamescope_color_provider_get_interface_fn>(
+				dlsym( library, "gamescope_color_provider_get_interface" ) );
+			const auto *api = query ? query( GAMESCOPE_COLOR_PROVIDER_ABI ) : nullptr;
+			if ( !gamescope_color_provider_is_compatible( api ) )
+			{
+				fprintf( stderr, "Incompatible color provider; keeping native presentation\n" );
+				dlclose( library );
+				return {};
+			}
+			void *instance = api->create();
+			if ( !instance )
+			{
+				fprintf( stderr, "Color provider initialization failed\n" );
+				dlclose( library );
+				return {};
+			}
+			// Keep the module loaded while its callbacks can be used.
+			return { api, instance };
+		}();
+		return provider.instance ? &provider : nullptr;
+	}
+
+	inline gamescope_color_plan CreateColorProviderPlan( const gamescope_color_mgmt_t &color, float sdrNits )
+	{
+		const auto *provider = GetColorProvider( true );
+		if ( !provider )
+			return { color.flHDRInputGain, color.flInternalDisplayBrightness, nullptr, nullptr };
+		gamescope_color_config config{ {}, sdrNits, color.flInternalDisplayBrightness, color.flHDRInputGain };
+		const auto &display = color.displayColorimetry;
+		const auto &output = color.outputEncodingColorimetry;
+		const glm::mat3 nativeFromOutput = display == output ? glm::mat3( 1.0f ) :
+			glm::inverse( normalised_primary_matrix( display.primaries, display.white, 1.0f ) ) *
+				normalised_primary_matrix( output.primaries, output.white, 1.0f );
+		for ( int column = 0; column < 3; column++ )
+			for ( int row = 0; row < 3; row++ )
+				config.native_from_output[column * 3 + row] = nativeFromOutput[column][row];
+		return provider->api->configure( provider->instance, &config );
+	}
+
+	inline bool ColorProviderPlaneUsesLuts( const FrameInfo_t::Layer_t &layer, bool hardwareLuts )
+	{
+		return layer.colorProvider && hardwareLuts && layer.applyColorMgmt &&
+			( layer.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB ||
+			  layer.colorspace == GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR );
+	}
+
+	inline uint32_t ColorProviderPlaneMask( const FrameInfo_t &frame, bool hardwareLuts )
+	{
+		uint32_t mask = 0;
+		for ( int i = 0; i < frame.layers.count(); i++ )
+			if ( ColorProviderPlaneUsesLuts( frame.layers.get( i ), hardwareLuts ) )
+				mask |= 1u << i;
+		return mask;
+	}
+
+	inline void BindColorProviderCompositeLuts( const FrameInfo_t &frame, CVulkanCmdBuffer &cmdBuffer )
+	{
+		// Partial composition can omit the game while retaining its LUT pointers.
+		const bool enabled = frame.layers.count() && frame.layers.get( 0 ).colorProvider;
+		cmdBuffer.bindColorMgmtLuts( EOTF_Count,
+			enabled ? frame.shaperLut[EOTF_Count] : nullptr,
+			enabled ? frame.lut3D[EOTF_Count] : nullptr );
+	}
+
+	inline void ClearColorProviderFrameLuts( FrameInfo_t &frame )
+	{
+		// Source-space captures keep the game's original SDR presentation.
+		frame.shaperLut[EOTF_Count] = nullptr;
+		frame.lut3D[EOTF_Count] = nullptr;
+	}
+
+	class ColorProviderHost
+	{
+	public:
+		struct FrameState { bool active; bool primary; bool async; };
+
+		bool Enabled() const { return cv_armada_auto_hdr; }
+		bool Available( const gamescope_color_capabilities &caps ) const
+		{
+			const auto *provider = GetColorProvider( Enabled() );
+			return provider && provider->api->available( &caps );
+		}
+		bool Active( bool available, const gamescope_color_content &content ) const
+		{
+			const auto *provider = GetColorProvider( available );
+			return provider && provider->api->active( available, &content );
+		}
+
+		int PresentFrame( IBackendConnector *connector, FrameInfo_t &frame,
+			const gamescope_color_mgmt_luts &luts, const FrameState &state )
+		{
+			const bool enabled = Enabled();
+			const auto *provider = GetColorProvider( enabled || ( state.primary && m_hdrPresented ) );
+			if ( !provider )
+				return connector ? connector->Present( &frame, state.async ) : 0;
+			const bool hasLayers = frame.layers.count() != 0;
+			const gamescope_color_frame facts{ enabled, state.active, frame.bFadingOut, hasLayers,
+				luts.HasLuts(), hasLayers && ColorspaceIsHDR( frame.layers.get( 0 ).colorspace ),
+				state.primary, connector != nullptr };
+			struct Context
+			{
+				IBackendConnector *connector;
+				FrameInfo_t &frame;
+				const gamescope_color_mgmt_luts &luts;
+				bool async;
+			} context{ connector, frame, luts, state.async };
+			const gamescope_color_present_ops ops{
+				.data = &context,
+				.attach_game_luts = []( void *data ) {
+					auto &ctx = *static_cast<Context *>( data );
+					auto &game = ctx.frame.layers.get( 0 );
+					game.colorProvider = true;
+					// Cached frames also need the scanout color pipeline.
+					game.applyColorMgmt = true;
+					ctx.frame.shaperLut[EOTF_Count] = ctx.luts.vk_lut1d;
+					ctx.frame.lut3D[EOTF_Count] = ctx.luts.vk_lut3d;
+				},
+				.present = []( void *data ) {
+					auto &ctx = *static_cast<Context *>( data );
+					return ctx.connector ? ctx.connector->Present( &ctx.frame, ctx.async ) : 0;
+				},
+			};
+			const auto result = provider->api->present( provider->instance, &facts, &ops );
+			m_hdrPresented = result.hdr_presented;
+			return result.status;
+		}
+
+		template<typename Available, typename ContentActive>
+		void ExtendHdrOutput( bool &capable, bool &active, Available available, ContentActive content ) const
+		{
+			if ( !Enabled() )
+				return;
+			const bool convertedContent = content();
+			capable = capable || available();
+			active |= convertedContent;
+		}
+
+		bool HdrPresented() const { return Enabled() && m_hdrPresented; }
+
+#if HAVE_DRM
+		template<typename Planes>
+		int Apply( const Planes &planes, uint32_t gameLayerMask,
+			std::span<liftoff_layer *const> layers, liftoff_output *output,
+			drmModeAtomicReq *request, uint32_t flags, const liftoff_output_apply_options &options )
+		{
+			if ( !gameLayerMask && !m_constraintsSet )
+				return liftoff_output_apply( output, request, flags, &options );
+			m_constraintsSet = gameLayerMask != 0;
+			const auto *provider = GetColorProvider( true );
+			if ( !provider )
+				return liftoff_output_apply( output, request, flags, &options );
+			struct Context
+			{
+				const Planes &planes;
+				std::span<liftoff_layer *const> layers;
+				liftoff_output *output;
+				drmModeAtomicReq *request;
+				uint32_t flags;
+				const liftoff_output_apply_options &options;
+			} context{ planes, layers, output, request, flags, options };
+			const gamescope_color_scanout_ops ops{
+				.data = &context, .pipeline_count = planes.size(), .layer_count = layers.size(),
+				.pipeline = []( void *data, size_t index ) -> uint64_t {
+					return static_cast<Context *>( data )->planes[index]->GetLutPipeline();
+				},
+				.unset_pipeline = []( void *data, size_t layer ) {
+					liftoff_layer_unset_property( static_cast<Context *>( data )->layers[layer], "COLOR_PIPELINE" );
+				},
+				.set_pipeline = []( void *data, size_t layer, uint64_t pipeline ) {
+					liftoff_layer_set_property( static_cast<Context *>( data )->layers[layer], "COLOR_PIPELINE", pipeline );
+				},
+				.apply = []( void *data ) {
+					const auto &ctx = *static_cast<Context *>( data );
+					return liftoff_output_apply( ctx.output, ctx.request, ctx.flags, &ctx.options );
+				},
+				.needs_composition = []( void *data ) -> uint32_t {
+					return liftoff_output_needs_composition( static_cast<Context *>( data )->output );
+				},
+			};
+			return provider->api->scanout( provider->instance, gameLayerMask, &ops );
+		}
+
+#endif
+
+	private:
+		bool m_hdrPresented = false;
+#if HAVE_DRM
+		bool m_constraintsSet = false;
+#endif
+	};
+
+	inline ColorProviderHost g_ColorProvider;
+}
