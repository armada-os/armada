From 661bd16a25fcd3df1b89b11ed0c9c37e70d27191 Mon Sep 17 00:00:00 2001
From: mydanyi <308664957+mydanyi@users.noreply.github.com>
Date: Thu, 15 Oct 2026 05:19:23 +0800
Subject: [PATCH] mangoapp: restore visible frametimes as the primary HUD
 metric

---
 src/mangoapp.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/mangoapp.cpp b/src/mangoapp.cpp
index 32f1e2aa3..7b9070d6e 100644
--- a/src/mangoapp.cpp
+++ b/src/mangoapp.cpp
@@ -32,10 +32,10 @@ struct mangoapp_msg_v1 {
     struct mangoapp_msg_header hdr;
 
     uint32_t pid;
-    uint64_t app_frametime_ns;
+    uint64_t visible_frametime_ns;
     uint8_t fsrUpscale;
     uint8_t fsrSharpness;
-    uint64_t visible_frametime_ns;
+    uint64_t app_frametime_ns;
     uint64_t latency_ns;
     uint32_t outputWidth;
     uint32_t outputHeight;
