 src/backend.h                        |   3 +
 src/vblankmanager.cpp                |   9 ++-
 tests/test_utils_vblank_schedule.cpp | 113 +++++++++++++++++++++++++++
 7 files changed, 143 insertions(+), 5 deletions(-)

