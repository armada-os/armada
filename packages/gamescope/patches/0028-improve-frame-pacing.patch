+				const bool bVRR = GetBackend()->GetCurrentConnector() && GetBackend()->GetCurrentConnector()->IsVRRActive();
+				const uint64_t ulTargetFloor = VBlank::TargetFloor( m_LastVBlankSchedule,
+				{
