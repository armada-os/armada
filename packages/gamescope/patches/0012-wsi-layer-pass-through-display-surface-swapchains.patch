From: virtudude <virtudude@protonmail.com>
Subject: [PATCH] wsi-layer: pass through VK_KHR_display surfaces and swapchains

VK_KHR_display surfaces (DRM lease clients) are legitimate
non-Gamescope surfaces, but the layer's hook-failure dialogs fire for
them at swapchain creation and present, and abort on Cancel. Track them
by parent handle and pass their swapchains and presents through
untouched. Presents that are not all-Gamescope forward the caller's
original present info (retired Gamescope swapchains still take the
retired path); the warning stays for genuinely unhooked swapchains.

---
diff --git a/layer/VkLayer_FROG_gamescope_wsi.cpp b/layer/VkLayer_FROG_gamescope_wsi.cpp
index 80df9cfa..5a226fb1 100644
--- a/layer/VkLayer_FROG_gamescope_wsi.cpp
+++ b/layer/VkLayer_FROG_gamescope_wsi.cpp
@@ -24,6 +24,8 @@
 #include <algorithm>
 #include <functional>
 #include <unordered_map>
+#include <map>
+#include <mutex>
 #include <optional>
 
 #include <poll.h>
@@ -703,6 +705,32 @@ namespace GamescopeWSILayer {
   };
   static vkroots::ObjectMap<VkSurfaceKHR, GamescopeSurfaceData> gamescopeSurfaces;
 
+  // VK_KHR_display surfaces (DRM lease clients) and their swapchains are
+  // legitimately non-Gamescope; both pass through without the hook warning.
+  // Keys carry the parent handle because non-dispatchable handle values are
+  // not unique across instances/devices; counted to tolerate aliases.
+  template <typename Parent, typename T>
+  struct DisplayHandleMap {
+    std::mutex mutex;
+    std::map<std::pair<Parent, T>, uint32_t> map;
+    void insert(Parent parent, T handle) {
+      std::lock_guard lock(mutex);
+      map[std::pair(parent, handle)]++;
+    }
+    void remove(Parent parent, T handle) {
+      std::lock_guard lock(mutex);
+      auto iter = map.find(std::pair(parent, handle));
+      if (iter != map.end() && --iter->second == 0)
+        map.erase(iter);
+    }
+    bool contains(Parent parent, T handle) {
+      std::lock_guard lock(mutex);
+      return map.find(std::pair(parent, handle)) != map.end();
+    }
+  };
+  static DisplayHandleMap<VkInstance, VkSurfaceKHR> s_displaySurfaces;
+  static DisplayHandleMap<VkDevice, VkSwapchainKHR> s_displaySwapchains;
+
   struct GamescopeSwapchainData {
     gamescope_swapchain *object;
     wl_display* display;
@@ -1047,6 +1075,18 @@ namespace GamescopeWSILayer {
       return GetPhysicalDeviceGamescopePresentationSupport(pDispatch, gamescopeInstance, physicalDevice, queueFamilyIndex);
     }
 
+    static VkResult CreateDisplayPlaneSurfaceKHR(
+      const vkroots::VkInstanceDispatch&   pDispatch,
+            VkInstance                     instance,
+      const VkDisplaySurfaceCreateInfoKHR* pCreateInfo,
+      const VkAllocationCallbacks*         pAllocator,
+            VkSurfaceKHR*                  pSurface) {
+      VkResult res = pDispatch.CreateDisplayPlaneSurfaceKHR(instance, pCreateInfo, pAllocator, pSurface);
+      if (res == VK_SUCCESS)
+        s_displaySurfaces.insert(instance, *pSurface);
+      return res;
+    }
+
     static VkResult CreateXcbSurfaceKHR(
       const vkroots::VkInstanceDispatch & pDispatch,
             VkInstance                   instance,
@@ -1334,6 +1374,12 @@ namespace GamescopeWSILayer {
             VkInstance                   instance,
             VkSurfaceKHR                 surface,
       const VkAllocationCallbacks*       pAllocator) {
+      if (s_displaySurfaces.contains(instance, surface)) {
+        s_displaySurfaces.remove(instance, surface);
+        pDispatch.DestroySurfaceKHR(instance, surface, pAllocator);
+        return;
+      }
+
       std::optional<GamescopeSurfaceData> state;
       if (auto *entry = gamescopeSurfaces.find(surface)) {
         state.emplace(std::move(*entry));
@@ -1532,6 +1578,12 @@ namespace GamescopeWSILayer {
             VkDevice                   device,
             VkSwapchainKHR             swapchain,
       const VkAllocationCallbacks*     pAllocator) {
+      if (s_displaySwapchains.contains(device, swapchain)) {
+        s_displaySwapchains.remove(device, swapchain);
+        pDispatch.DestroySwapchainKHR(device, swapchain, pAllocator);
+        return;
+      }
+
       if (auto state = gamescopeSwapchains.find(swapchain)) {
         gamescope_swapchain_destroy(state->object);
         wl_event_queue_destroy(state->eventQueue);
@@ -1548,6 +1600,14 @@ namespace GamescopeWSILayer {
       const VkSwapchainCreateInfoKHR*  pCreateInfo,
       const VkAllocationCallbacks*     pAllocator,
             VkSwapchainKHR*            pSwapchain) {
+      if (s_displaySurfaces.contains(pDispatch.pPhysicalDeviceDispatch->pInstanceDispatch->Instance,
+                                     pCreateInfo->surface)) {
+        VkResult res = pDispatch.CreateSwapchainKHR(device, pCreateInfo, pAllocator, pSwapchain);
+        if (res == VK_SUCCESS)
+          s_displaySwapchains.insert(device, *pSwapchain);
+        return res;
+      }
+
       auto gamescopeSurface = gamescopeSurfaces.find(pCreateInfo->surface);
 
       if (!gamescopeSurface) {
@@ -1943,8 +2003,11 @@ namespace GamescopeWSILayer {
         }
       }
       if (!anyLayer) {
+        bool allDisplay = true;
+        for (uint32_t i = 0; i < presentInfo.swapchainCount; i++)
+          allDisplay &= s_displaySwapchains.contains(pDispatch.pDeviceDispatch->Device, presentInfo.pSwapchains[i]);
         static bool s_warned = false;
-        if (!s_warned) {
+        if (!s_warned && !allDisplay) {
           int messageId = -1;
           messagey::ShowSimple(
             "QueuePresentKHR: Attempting to present to a non-hooked swapchain.\nHooking has failed somewhere!\nYou may have a bad Vulkan layer interfering.\nPress OK to try to power through this error, or Cancel to stop.",
