From: Lee Ford <472320+leeford@users.noreply.github.com>
Subject: [PATCH] gpu_fdinfo: count a containerized window's whole pid namespace

mangoapp reads GPU load from the fdinfo of the focused window's pid. An
Android app under Lepton presents through the container's composer, which
does no GPU work, while the app renders from its own processes, so the
overlay shows no GPU load. When that pid is in another pid namespace than
mangoapp, read the fdinfo of every process in it. Windows from mangoapp's
own namespace are unchanged.
---
diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index 53cab4f..45f85a5 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -6,25 +6,56 @@
 
 namespace fs = ghc::filesystem;
 
+// A window from another pid namespace, such as an Android container, is
+// presented by a compositor process that does no GPU work itself, while the
+// app renders from other processes. Count the whole namespace then.
+static std::vector<pid_t> pids_to_track(pid_t pid)
+{
+    std::error_code ec, own_ec;
+    auto ns = fs::read_symlink("/proc/" + std::to_string(pid) + "/ns/pid", ec);
+    auto own = fs::read_symlink("/proc/self/ns/pid", own_ec);
+
+    if (ec || own_ec || ns == own)
+        return { pid };
+
+    std::vector<pid_t> pids;
+    for (fs::directory_iterator it("/proc", ec), end; !ec && it != end; it.increment(ec)) {
+        auto name = it->path().filename().string();
+
+        if (name.empty() || name.find_first_not_of("0123456789") != std::string::npos)
+            continue;
+
+        std::error_code proc_ec;
+        if (fs::read_symlink(it->path() / "ns/pid", proc_ec) == ns && !proc_ec)
+            pids.push_back(std::stoi(name));
+    }
+
+    return pids;
+}
