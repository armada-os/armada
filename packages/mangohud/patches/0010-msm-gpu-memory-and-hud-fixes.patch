     else if (module == "panfrost" || module == "panthor")
         hwmon = find_hwmon_sensor_dir("gpu_thermal");
     else
@@ -197,6 +201,9 @@ void GPU_fdinfo::find_hwmon_sensors()
 
     if (hwmon.empty()) {
         SPDLOG_DEBUG("hwmon: failed to find hwmon directory");
+        // Without hwmon, fall back to the SoC thermal zones (gpuss-*).
+        if (module == "msm_dpu")
