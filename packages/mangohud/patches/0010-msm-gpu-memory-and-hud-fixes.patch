--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -184,12 +184,16 @@ float GPU_fdinfo::get_memory_used()
     return static_cast<float>(total) / 1024 / 1024 / 1024;
 }
 
