 }
 
 std::string GPU_fdinfo::find_hwmon_dir() {
@@ -295,6 +306,87 @@ std::string GPU_fdinfo::find_hwmon_sensor_dir(std::string name) {
     return "";
 }
 
+// Qualcomm registers one hwmon device per GPU thermal sensor (gpuss_0_thermal,
+// gpuss_1_thermal, ...). Directory order is arbitrary, so a "name contains
+// gpu" lookup can return any of them; prefer the primary (gpuss_0) sensor.
+static std::string find_msm_hwmon_dir()
+{
+    const std::string base = "/sys/class/hwmon/";
+
+    if (!fs::exists(base))
+        return "";
+
+    std::string fallback;
+
+    for (const auto &entry : fs::directory_iterator(base)) {
+        std::ifstream name_stream((entry.path() / "name").string());
+        std::string name;
+
+        if (!name_stream.is_open() || !std::getline(name_stream, name))
+            continue;
+
+        if (name == "gpuss_0_thermal" || name == "gpuss-0-thermal")
+            return entry.path().string();
+
+        if (fallback.empty() && name.find("gpu") != std::string::npos)
+            fallback = entry.path().string();
+    }
+
+    return fallback;
+}
+
+void GPU_fdinfo::open_msm_thermal_zone()
+{
+    const std::string base = "/sys/class/thermal/";
+
+    if (!fs::exists(base))
+        return;
+
+    std::string fallback;
+
+    for (const auto &entry : fs::directory_iterator(base)) {
+        auto name = entry.path().filename().string();
+
+        if (name.rfind("thermal_zone", 0) != 0)
+            continue;
+
+        std::ifstream type_stream((entry.path() / "type").string());
+        std::string type;
+
+        if (!type_stream.is_open() || !std::getline(type_stream, type))
+            continue;
+
+        auto temp = (entry.path() / "temp").string();
+
+        if (type == "gpuss-0-thermal" || type == "gpu-thermal") {
+            thermal_zone_stream.open(temp);
+            if (thermal_zone_stream.good())
+                return;
+        } else if (fallback.empty() && type.rfind("gpuss", 0) == 0) {
+            fallback = temp;
+        }
+    }
+
+    if (!fallback.empty())
+        thermal_zone_stream.open(fallback);
+}
+
+int GPU_fdinfo::get_thermal_zone_temp()
+{
+    if (!thermal_zone_stream.is_open())
+        return 0;
+
+    thermal_zone_stream.clear();
+    thermal_zone_stream.seekg(0);
+
+    int milli = 0;
+
+    if (!(thermal_zone_stream >> milli))
+        return 0;
+
+    return std::round(milli / 1000.f);
+}
+
 void GPU_fdinfo::get_current_hwmon_readings()
 {
     for (auto& hs : hwmon_sensors) {
@@ -772,6 +864,12 @@ void GPU_fdinfo::main_thread()
         metrics.load = get_gpu_load();
         metrics.proc_vram_used = get_memory_used();
 
+        // msm does not expose a system-wide VRAM counter because the GPU
+        // shares the system RAM. Report the client's allocated GPU memory
+        // instead of always showing 0.
+        if (module == "msm_dpu")
+            metrics.sys_vram_used = metrics.proc_vram_used;
+
         metrics.powerUsage = get_power_usage();
         metrics.powerLimit = static_cast<float>(hwmon_sensors["power_limit"].val) / 1'000'000;
 
@@ -780,10 +878,16 @@ void GPU_fdinfo::main_thread()
 
         if (module == "msm_drm")
             metrics.temp = get_kgsl_temp();
+        else if (module == "msm_dpu" && hwmon_sensors["temp"].filename.empty())
+            metrics.temp = get_thermal_zone_temp();
         else
             metrics.temp = hwmon_sensors["temp"].val / 1000.f;
 
-        metrics.memory_temp = hwmon_sensors["vram_temp"].val / 1000.f;
+        // -1 hides the cell in the VRAM row; 0 would be drawn as a real 0°C.
+        if (hwmon_sensors["vram_temp"].filename.empty())
+            metrics.memory_temp = -1;
+        else
+            metrics.memory_temp = hwmon_sensors["vram_temp"].val / 1000.f;
 
         metrics.fan_speed = hwmon_sensors["fan_speed"].val;
         metrics.fan_rpm = true; // Fan data is pulled from hwmon
