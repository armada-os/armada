From: virtudude <virtudude@protonmail.com>
Subject: [PATCH] mangoapp: show the active gamescope upscaler

Read the appended active-upscaler field from gamescope and label the HUD
row with the filter that produced the frame, including SGSR and HDR's FSR
fallback. Keep the existing FSR row for senders without this field, and
reset the active filter on short messages to avoid retaining stale state.

Account for the message type excluded from msgrcv's returned payload size.
The existing fsr configuration option still controls the row. Limit filter
names to four characters to fit the existing value alignment.

---
diff --git a/src/app/mangoapp_proto.h b/src/app/mangoapp_proto.h
--- a/src/app/mangoapp_proto.h
+++ b/src/app/mangoapp_proto.h
@@ -1,4 +1,13 @@
 #include <stdint.h>
+
+enum mangoapp_upscaler {
+    MANGOAPP_UPSCALER_LINEAR = 0,
+    MANGOAPP_UPSCALER_NEAREST,
+    MANGOAPP_UPSCALER_FSR,
+    MANGOAPP_UPSCALER_NIS,
+    MANGOAPP_UPSCALER_PIXEL,
+    MANGOAPP_UPSCALER_SGSR,
+};
 
 struct mangoapp_msg_header {
     long msg_type;  // Message queue ID, never change
@@ -17,6 +26,11 @@
     uint64_t latency_ns;
     uint32_t outputWidth;
     uint32_t outputHeight;
+    uint16_t displayRefresh;
+    uint8_t flags;
+    char engineName[40];
+    uint8_t upscaler;
+    uint8_t wantedUpscaler;
     // WARNING: Always ADD fields, never remove or repurpose fields
 } __attribute__((packed));
 
diff --git a/src/app/main.cpp b/src/app/main.cpp
--- a/src/app/main.cpp
+++ b/src/app/main.cpp
@@ -210,8 +210,11 @@
                         if (real_params->fsr_steam_sharpness < 0)
                             HUDElements.g_fsrSharpness = mangoapp_v1->fsrSharpness;
                         else
-                        HUDElements.g_fsrSharpness = real_params->fsr_steam_sharpness - mangoapp_v1->fsrSharpness;
+                            HUDElements.g_fsrSharpness = real_params->fsr_steam_sharpness - mangoapp_v1->fsrSharpness;
                     }
+                    // msgrcv counts the payload without the leading message type.
+                    HUDElements.g_upscaler = msg_size >= offsetof(mangoapp_msg_v1, upscaler) + sizeof(mangoapp_v1->upscaler) - sizeof(long)
+                        ? mangoapp_v1->upscaler : -1;
                     if (!real_params->enabled[OVERLAY_PARAM_ENABLED_mangoapp_steam]){
                         steam_focused = get_prop("GAMESCOPE_FOCUSED_APP_GFX") == 769;
                     } else {
