@@ -139,6 +139,8 @@
     fi

     # Move everything to our overlay.
+    # Installed splits have new names; hide the originals before moving their copies.
+    find /data/steam_app -maxdepth 1 -type f -name '*.apk' -delete
     mv "${APP_PATH}"/* /data/steam_app/

     # Now that we know the pm path after installing the package, we can mount
--- a/images/rootfs_overlay/vendor/bin/fix_obb_symlink.sh
+++ b/images/rootfs_overlay/vendor/bin/fix_obb_symlink.sh
