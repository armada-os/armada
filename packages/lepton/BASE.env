# Lepton's rootfs (Steam app 3029110) is Android 11.
ANDROID_API=30

# Lepton always enables the Fossilize capture layer and aborts without it.
FOSSILIZE_COMMIT=556da9ff7d7616704dda515756219ab1dab693ec

# Compile and dex the clipboard stub.
ANDROID_PLATFORM_ZIP=platform-30_r03.zip
ANDROID_PLATFORM_SHA256=f3f5b75744dbf6ee6ed3e8174a71e513bfee502d0bc3463ea97e517bff68d84e
R8_VERSION=8.5.35
R8_SHA256=4733945987ee0a840fafc34080b135259e01678412e07212b23f706334290294

# prebuilt/ is built by hand with build-android.sh, in the base of Valve's Android builder image.
ANDROID_BUILDER_IMAGE=docker.io/library/ubuntu:22.04@sha256:0e5e4a57c2499249aafc3b40fcd541e9a456aab7296681a3994d631587203f97

# Valve's Android 11 tree for Lepton (Steam app 3029110).
LEPTON_REPO=https://gitlab.steamos.cloud/frame-public/lepton.git
LEPTON_TAG=v3.0.3
LEPTON_COMMIT=0ea2492b1981fa2943972f68ed9cbdcb259f01dc
