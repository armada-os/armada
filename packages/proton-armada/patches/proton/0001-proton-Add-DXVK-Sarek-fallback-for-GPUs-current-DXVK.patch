+VK_VERSION_PATCH = lambda version: (version & 0xFFF)
+VK_MAKE_VERSION = lambda major, minor, patch: ((major << 22) | (minor << 12) | patch)
+# https://docs.vulkan.org/refpages/latest/refpages/source/VK_MAKE_API_VERSION.html
