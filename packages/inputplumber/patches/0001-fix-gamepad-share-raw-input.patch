+    pub fn is_shared_gamepad(
+        device_info: &UdevDevice,
+        conf: &Option<config::SourceDevice>,
+    ) -> Result<bool, Box<dyn Error + Send + Sync>> {
+        let is_blocked = conf.as_ref().and_then(|c| c.blocked).unwrap_or(false);
+        let is_ignored = conf.as_ref().and_then(|c| c.ignore).unwrap_or(false);
+        if is_ignored
+            || !matches!(
+                Self::get_driver_type(device_info, is_blocked),
+                DriverType::Gamepad
+            )
+        {
+            return Ok(false);
+        }
+
+        let device = Device::open(device_info.devnode())?;
+        if !gamepad::has_gamepad_controls(device.supported_keys(), device.supported_absolute_axes())
+        {
+            log::debug!(
+                "Not sharing '{}': no gamepad buttons with X/Y axes",
+                device_info.devnode()
+            );
+            return Ok(false);
+        }
+        if gamepad::has_system_controls(device.supported_keys(), device.supported_switches()) {
+            log::warn!(
+                "Not sharing gamepad '{}': power/sleep key or lid switch",
+                device_info.devnode()
+            );
+            return Ok(false);
+        }
+        Ok(true)
+    }
