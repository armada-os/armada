+pub(super) fn has_gamepad_controls(
+    keys: Option<&AttributeSetRef<KeyCode>>,
+    axes: Option<&AttributeSetRef<AbsoluteAxisCode>>,
+) -> bool {
+    let (Some(keys), Some(axes)) = (keys, axes) else {
+        return false;
+    };
+    axes.contains(AbsoluteAxisCode::ABS_X)
+        && axes.contains(AbsoluteAxisCode::ABS_Y)
+        && keys
+            .iter()
+            .any(|key| (KeyCode::BTN_SOUTH.0..=KeyCode::BTN_THUMBR.0).contains(&key.0))
+}
+
+pub(super) fn has_system_controls(
+    keys: Option<&AttributeSetRef<KeyCode>>,
+    switches: Option<&AttributeSetRef<SwitchCode>>,
+) -> bool {
+    keys.is_some_and(|keys| {
+        [KeyCode::KEY_POWER, KeyCode::KEY_SLEEP, KeyCode::KEY_SUSPEND]
+            .iter()
+            .any(|key| keys.contains(*key))
+    }) || switches.is_some_and(|switches| switches.contains(SwitchCode::SW_LID))
+}
+
+#[cfg(test)]
+mod sharing_tests {
+    use super::super::EventDevice;
+    use super::*;
+    use evdev::{AbsoluteAxisCode as Axis, AttributeSet, KeyCode as Key, SwitchCode as Switch};
+
+    fn accepts(keys: &[Key], axes: &[Axis], switches: &[Switch]) -> bool {
+        let keys: AttributeSet<Key> = keys.iter().copied().collect();
+        let axes: AttributeSet<Axis> = axes.iter().copied().collect();
+        let switches: AttributeSet<Switch> = switches.iter().copied().collect();
+        has_gamepad_controls(Some(&keys), Some(&axes))
+            && !has_system_controls(Some(&keys), Some(&switches))
+    }
+
+    #[test]
+    fn requires_gamepad_buttons_and_stick_axes() {
+        assert!(accepts(
+            &[Key::BTN_SOUTH, Key::BTN_MODE, Key::KEY_BACK],
+            &[Axis::ABS_X, Axis::ABS_Y],
+            &[],
+        ));
+        for key in [Key::BTN_SOUTH, Key::KEY_A, Key::KEY_VOLUMEUP, Key::BTN_C] {
+            assert!(!accepts(&[key], &[], &[]));
+        }
+        for key in [Key::BTN_TOUCH, Key::BTN_LEFT] {
+            assert!(!accepts(&[key], &[Axis::ABS_X, Axis::ABS_Y], &[]));
+        }
+        assert!(!accepts(&[Key::BTN_SOUTH], &[Axis::ABS_X], &[]));
+        assert!(!has_gamepad_controls(None, None));
+    }
+
+    #[test]
+    fn excludes_system_controls() {
+        for (keys, switches) in [
+            (&[Key::BTN_SOUTH, Key::KEY_POWER][..], &[][..]),
+            (&[Key::BTN_SOUTH, Key::KEY_SLEEP], &[]),
+            (&[Key::BTN_SOUTH, Key::KEY_SUSPEND], &[]),
+            (&[Key::BTN_SOUTH], &[Switch::SW_LID]),
+        ] {
+            assert!(!accepts(keys, &[Axis::ABS_X, Axis::ABS_Y], switches));
+        }
+    }
+
+    #[test]
+    fn excludes_blocked_and_ignored_sources_before_opening() {
+        for policy in ["blocked", "ignore"] {
+            let config = serde_yaml::from_str(&format!("group: gamepad\n{policy}: true")).unwrap();
+            assert!(
+                !EventDevice::is_shared_gamepad(&UdevDevice::default(), &Some(config),).unwrap()
+            );
+        }
+    }
+}
