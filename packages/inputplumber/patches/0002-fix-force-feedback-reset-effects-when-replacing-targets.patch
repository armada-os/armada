@@ -308,6 +320,28 @@ impl CompositeDeviceTargets {
         self.pending_set_devices.take()
     }
 
+    /// Return whether the requested target devices are already running.
+    pub async fn devices_match(
+        &self,
+        device_types: &[TargetDeviceTypeId],
+    ) -> Result<bool, Box<dyn Error>> {
+        let mut kinds_running: Vec<TargetDeviceTypeId> = self
+            .target_kinds_running()
+            .await?
+            .into_values()
+            .collect();
+        if kinds_running.len() != device_types.len() {
+            return Ok(false);
+        }
+        for kind in device_types {
+            let Some(index) = kinds_running.iter().position(|running| running == kind) else {
+                return Ok(false);
+            };
+            kinds_running.swap_remove(index);
+        }
+        Ok(true)
+    }
+
     /// Return a list of currently running target devices
     async fn target_kinds_running(
         &self,
@@ -595,12 +629,21 @@ impl CompositeDeviceTargets {
             for target_devices in self.target_devices_by_capability.values_mut() {
                 target_devices.remove(&path);
