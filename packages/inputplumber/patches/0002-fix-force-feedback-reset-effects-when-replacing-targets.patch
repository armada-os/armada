index da26e2b..1fa397e 100644
--- a/src/input/source/mod.rs
+++ b/src/input/source/mod.rs
@@ -170,6 +170,11 @@ pub trait SourceOutputDevice {
         Ok(())
     }
 
+    /// Stop and erase every force feedback effect held by this device.
+    fn reset_effects(&mut self) -> Result<(), OutputError> {
+        Ok(())
+    }
+
     /// Stop the source device.
     fn stop(&mut self) -> Result<(), OutputError> {
         Ok(())
@@ -517,6 +522,18 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
                             log::error!("Failed to send erase result: {:?}", err);
                         }
                     }
+                    SourceCommand::ResetEffects(composite_dev) => {
+                        let res = match implementation.reset_effects() {
+                            Ok(_) => composite_dev.send(Ok(())),
+                            Err(e) => {
+                                let err = format!("Failed to reset effects: {e:?}");
+                                composite_dev.send(Err(err.into()))
