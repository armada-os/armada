+                        if let Err(err) = res {
+                            log::error!("Failed to send reset result: {:?}", err);
+                        }
+                    }
                     SourceCommand::WriteEvent(event) => {
                         log::trace!("Received output event: {:?}", event);
                         implementation.write_event(event)?;
