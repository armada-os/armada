-            _gyroscope: gyroscope,
-            _accelerometer: accelerometer,
+            gyroscope: None,
+            accelerometer: None,
+            next_open: Instant::now(),
+            open_failed: false,
+            tx,
             rx,
             filtered_events: Default::default(),
             mount_matrix: mount_matrix.unwrap_or_default(),
         })
     }
 
+    /// Open whichever sensors are still closed, at most once per OPEN_RETRY.
+    fn try_open(&mut self) {
+        if (self.gyroscope.is_some() && self.accelerometer.is_some())
+            || Instant::now() < self.next_open
+        {
+            return;
+        }
+
+        // libssc leaks a QRTR lookup per failed open; see qrtr.rs.
+        if !super::qrtr::service_present(SSC_SERVICE) {
+            self.next_open = Instant::now() + OPEN_RETRY;
+            return;
+        }
+
+        let mut error = None;
+        if self.gyroscope.is_none() {
+            match self.runtime.clone().create_gyroscope() {
+                Ok(sensor) => {
+                    let tx = self.tx.clone();
+                    sensor.set_measurement_handler(move |x, y, z| {
+                        _ = tx.try_send(Event::Gyro(AxisData {
+                            roll: x as f64,
+                            pitch: y as f64,
+                            yaw: z as f64,
+                        }));
+                    });
+                    self.gyroscope = Some(sensor);
+                }
+                Err(e) => error = Some(e),
+            }
+        }
+        if self.accelerometer.is_none() {
+            match self.runtime.clone().create_accelerometer() {
+                Ok(sensor) => {
+                    let tx = self.tx.clone();
+                    sensor.set_measurement_handler(move |x, y, z| {
+                        _ = tx.try_send(Event::Accelerometer(AxisData {
+                            roll: x as f64,
+                            pitch: y as f64,
+                            yaw: z as f64,
+                        }));
+                    });
+                    self.accelerometer = Some(sensor);
+                }
+                Err(e) => error = Some(e),
+            }
+        }
+
+        // Samples queued while an open blocked are stale.
+        while self.rx.try_recv().is_ok() {}
+
+        match error {
+            None => log::info!("SSC sensors opened"),
+            Some(e) => {
+                if !self.open_failed {
+                    log::warn!("SSC not ready, will keep retrying: {e}");
+                    self.open_failed = true;
+                }
+                self.next_open = Instant::now() + OPEN_RETRY;
+            }
+        }
+    }
+
     pub fn update_filtered_events(&mut self, events: HashSet<Capability>) {
         self.filtered_events = events;
     }
@@ -68,6 +125,8 @@ impl Driver {
 
     /// Poll the device for data
     pub fn poll(&mut self) -> Result<Vec<Event>, Box<dyn Error + Send + Sync>> {
+        self.try_open();
+
         // libssc uses GLib and relies on the GLib main loop
         // Instead of creating a main loop and main context then managing it alongside InputPlumber's loop etc,
         // we can just perform an iteration of the GLib context every poll
