From 5d1b119ab2aa8a9f344857fa441da5cd64fea52f Mon Sep 17 00:00:00 2001
From: JPyke3 <github@pyk.ee>
Date: Sun, 13 Sep 2026 08:17:52 +1000
Subject: [PATCH] feat(Hardware Support): Add AYN Thor Lite

---
 .../devices/50-ayn_thor_lite.yaml             | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 rootfs/usr/share/inputplumber/devices/50-ayn_thor_lite.yaml

diff --git a/rootfs/usr/share/inputplumber/devices/50-ayn_thor_lite.yaml b/rootfs/usr/share/inputplumber/devices/50-ayn_thor_lite.yaml
new file mode 100644
index 0000000..93f45c9
--- /dev/null
+++ b/rootfs/usr/share/inputplumber/devices/50-ayn_thor_lite.yaml
@@ -0,0 +1,27 @@
+# yaml-language-server: $schema=https://raw.githubusercontent.com/ShadowBlip/InputPlumber/main/rootfs/usr/share/inputplumber/schema/composite_device_v1.json
+version: 1
+kind: CompositeDevice
+name: AYN Thor Lite
+
+options:
+  auto_manage: true
+
+matches:
+  - udev:
+      sys_path: /sys/firmware/devicetree/base
+      attributes:
+        - name: compatible
+          value: ayn,thor-lite
+
+source_devices:
+  - group: gamepad
+    capability_map_id: ret1
+    evdev:
+      name: Retroid Pocket Gamepad
+      phys_path: retroid-pocket-gamepad/input0
+      vendor_id: "2020"
+      product_id: "3001"
+      handler: event*
+
+target_devices:
+  - xbox-elite
-- 
2.55.0

