 const BUFFER_SIZE: usize = 2048;
 /// Default poll rate (2.5ms/400Hz)
 const POLL_RATE: Duration = Duration::from_micros(2500);
+/// Longest a source thread blocks on an idle device
+const IDLE_WAIT_MS: u16 = 250;
+
+/// Block until `device_fd` has input, `wake` is signalled, or [IDLE_WAIT_MS] passes
+fn wait_for_input(device_fd: RawFd, wake: &EventFd) {
+    // SAFETY: the caller holds the source implementation that owns the fd
+    let device = unsafe { BorrowedFd::borrow_raw(device_fd) };
+    let mut fds = [
+        PollFd::new(device, PollFlags::POLLIN),
+        PollFd::new(wake.as_fd(), PollFlags::POLLIN),
+    ];
+    match poll(&mut fds, IDLE_WAIT_MS) {
+        Ok(_) => {
+            if fds[1]
+                .revents()
+                .is_some_and(|events| events.contains(PollFlags::POLLIN))
+            {
+                let _ = wake.read();
+            }
+        }
+        Err(Errno::EINTR) => (),
+        Err(e) => {
+            log::debug!("Failed to wait for source input: {e}");
+            thread::sleep(POLL_RATE);
+        }
+    }
+}
 
