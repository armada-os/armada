diff --git a/src/drivers/ssc/qrtr.rs b/src/drivers/ssc/qrtr.rs
new file mode 100644
index 0000000..42b487e
--- /dev/null
+++ b/src/drivers/ssc/qrtr.rs
@@ -0,0 +1,121 @@
+//! QRTR name-service lookup without libssc: each failed libssc open leaks a
+//! QRTR lookup, and retrying through it exhausts the kernel's per-node limit.
+
+use std::mem::size_of;
+use std::time::{Duration, Instant};
+
+use nix::libc;
+
+const AF_QIPCRTR: libc::c_int = 42;
+const QRTR_PORT_CTRL: u32 = 0xffff_fffe;
+const QRTR_TYPE_NEW_SERVER: u32 = 4;
+const QRTR_TYPE_NEW_LOOKUP: u32 = 10;
+
+#[repr(C)]
+struct SockaddrQrtr {
+    sq_family: libc::sa_family_t,
+    sq_node: u32,
+    sq_port: u32,
+}
+
+/// struct qrtr_ctrl_pkt with the server member of its union.
+#[repr(C)]
+#[derive(Default)]
+struct CtrlPkt {
+    cmd: u32,
+    service: u32,
+    instance: u32,
+    node: u32,
+    port: u32,
+}
+
+struct Fd(libc::c_int);
+
+impl Drop for Fd {
+    fn drop(&mut self) {
+        // SAFETY: the descriptor is owned here and closed once.
+        unsafe { libc::close(self.0) };
+    }
+}
+
+/// True if the name service lists at least one server for `service`.
+pub fn service_present(service: u32) -> bool {
+    // SAFETY: plain socket calls on a descriptor this function owns; every
+    // buffer passed matches the size given with it.
+    unsafe {
+        let fd = libc::socket(AF_QIPCRTR, libc::SOCK_DGRAM | libc::SOCK_CLOEXEC, 0);
+        if fd < 0 {
+            return false;
+        }
+        let fd = Fd(fd);
+
+        let timeout = libc::timeval {
+            tv_sec: 1,
+            tv_usec: 0,
+        };
+        if libc::setsockopt(
+            fd.0,
+            libc::SOL_SOCKET,
+            libc::SO_RCVTIMEO,
+            &timeout as *const _ as *const libc::c_void,
+            size_of::<libc::timeval>() as libc::socklen_t,
+        ) < 0
+        {
+            return false;
+        }
+
+        let mut local: SockaddrQrtr = std::mem::zeroed();
+        let mut len = size_of::<SockaddrQrtr>() as libc::socklen_t;
+        if libc::getsockname(fd.0, &mut local as *mut _ as *mut libc::sockaddr, &mut len) < 0 {
+            return false;
+        }
+
+        let ctrl = SockaddrQrtr {
+            sq_family: AF_QIPCRTR as libc::sa_family_t,
+            sq_node: local.sq_node,
+            sq_port: QRTR_PORT_CTRL,
+        };
+        let lookup = CtrlPkt {
+            cmd: QRTR_TYPE_NEW_LOOKUP.to_le(),
+            service: service.to_le(),
+            ..Default::default()
+        };
+        if libc::sendto(
+            fd.0,
+            &lookup as *const _ as *const libc::c_void,
+            size_of::<CtrlPkt>(),
+            0,
+            &ctrl as *const _ as *const libc::sockaddr,
+            size_of::<SockaddrQrtr>() as libc::socklen_t,
+        ) < 0
+        {
+            return false;
+        }
+
+        // The name service answers with one NEW_SERVER per match, then an
+        // all-zero NEW_SERVER.
+        let deadline = Instant::now() + Duration::from_secs(1);
+        while Instant::now() < deadline {
+            let mut pkt = CtrlPkt::default();
+            let n = libc::recv(
+                fd.0,
+                &mut pkt as *mut _ as *mut libc::c_void,
+                size_of::<CtrlPkt>(),
+                0,
+            );
+            if n < size_of::<CtrlPkt>() as isize {
+                return false;
+            }
+            if u32::from_le(pkt.cmd) != QRTR_TYPE_NEW_SERVER {
+                continue;
+            }
+            if pkt.service == 0 && pkt.instance == 0 && pkt.node == 0 && pkt.port == 0 {
+                return false;
+            }
+            if u32::from_le(pkt.service) == service {
+                return true;
+            }
+        }
+        false
+    }
+}
diff --git a/src/drivers/ssc/runtime.rs b/src/drivers/ssc/runtime.rs
new file mode 100644
index 0000000..23eaf8d
--- /dev/null
+++ b/src/drivers/ssc/runtime.rs
@@ -0,0 +1,210 @@
+use std::{error::Error, ptr::null_mut, sync::Arc};
+
+use crate::drivers::ssc::bindings::{
+    gpointer, FnSscSensorNewSync, FnSscSensorOpenSync, GCallback, GClosure, GError, GObject,
+    SscDylibs, GFALSE,
+};
+
+pub type MeasurementHandlerCb = Box<dyn FnMut(f32, f32, f32)>;
+
+/// "Trampoline" for the sensor measurement callback. Bounces to the function stored in the data ptr.
+pub unsafe extern "C" fn measurement_handler(
+    _obj: *mut GObject,
+    x: f32,
+    y: f32,
+    z: f32,
+    data: gpointer,
+) {
+    let cb: &mut Box<dyn FnMut(f32, f32, f32) + 'static> =
+        unsafe { &mut *(data as *mut MeasurementHandlerCb) };
+    cb(x, y, z);
+}
+
+/// GClosureNotify that drops the boxed callback when the signal is destroyed.
+pub unsafe extern "C" fn closure_destroy_handler(data: gpointer, _: *mut GClosure) {
+    drop(unsafe { Box::from_raw(data as *mut Box<dyn FnMut(f32, f32, f32)>) });
+}
+
+/// Wrapper for libssc sensor objects (mostly just a wrapper for GObject)
+pub struct SscObject {
+    _ptr: *mut std::ffi::c_void,
+    _runtime: Arc<SscRuntime>,
+}
+
+// SAFETY: The GLib functions we're using this with are thread safe.
+unsafe impl Send for SscObject {}
+
+impl Drop for SscObject {
+    fn drop(&mut self) {
+        // SAFETY: _ptr is always non-null and the library handle is kept alive by the _runtime reference.
+        unsafe {
+            (self._runtime.dylibs.g_object_unref)(self.ptr() as *mut _);
+        }
+    }
+}
+
+impl SscObject {
+    /// Create a SscObject instance. The provided pointer is required to be non-null.
+    fn new(ptr: *mut std::ffi::c_void, runtime: Arc<SscRuntime>) -> Result<Self, ()> {
+        if ptr.is_null() {
+            Err(())
+        } else {
+            Ok(Self {
+                _ptr: ptr,
+                _runtime: runtime,
+            })
+        }
+    }
+
+    pub unsafe fn ptr(&self) -> *mut std::ffi::c_void {
+        self._ptr
+    }
+
+    pub fn set_measurement_handler<F: FnMut(f32, f32, f32) + 'static>(&self, callback: F) {
+        let boxed: Box<MeasurementHandlerCb> = Box::new(Box::new(callback));
+        let user_data = Box::into_raw(boxed) as gpointer;
+
+        // SAFETY: The GObject pointer is guaranteed non-null and g_signal_connect_data is kept valid by the _runtime reference.
+        unsafe {
+            (self._runtime.dylibs.g_signal_connect_data)(
+                self._ptr as *mut _,
+                c"measurement".as_ptr(),
+                std::mem::transmute::<*const (), GCallback>(measurement_handler as *const ()),
+                user_data,
+                Some(closure_destroy_handler),
+                0,
+            );
+        }
+    }
+}
+
+/// Contains the dynamic libraries and all method pointers needed for libssc to work.
+/// This currently consists of: glib-2.0, gobject-2.0, gio-2.0, libssc
+pub struct SscRuntime {
+    pub(crate) dylibs: SscDylibs,
+}
+
+impl SscRuntime {
+    pub fn load() -> Result<Arc<Self>, Box<dyn Error + Send + Sync>> {
+        Ok(Arc::new(Self {
+            // SAFETY: Gives access to a bunch of function handles. This is safe as long as we use them as intended.
+            // The handles are valid as long as this SscRuntime is.
+            dylibs: unsafe { SscDylibs::load()? },
+        }))
+    }
+
+    /// Converts a GLib error ptr to a basic string (or None if the error is null)
+    pub fn convert_glib_error(&self, error: *mut GError) -> Option<String> {
+        if error.is_null() {
+            None
+        } else {
+            // SAFETY: The handle for g_quark_to_string is sure to be alive here
+            let domain_str = unsafe {
+                let domain_cstr =
+                    std::ffi::CStr::from_ptr((self.dylibs.g_quark_to_string)((*error).domain));
+                domain_cstr.to_string_lossy().into_owned()
+            };
+
+            let domain = unsafe { (*error).domain };
+            let code = unsafe { (*error).code };
+            // SAFETY: the caller owns error and does not use it after this.
+            unsafe { (self.dylibs.g_error_free)(error) };
+
+            Some(format!(
+                "GLib error: domain = {} / {}, code = {}",
+                domain, domain_str, code
+            ))
+        }
+    }
+
+    /// Safe wrapper for GLib's g_main_context_iteration. Dispatches everything
+    /// that is ready: a single iteration usually handles one QRTR message, so at
+    /// sensor rates above the poll rate the socket backlog grows until the
+    /// stream stalls for good.
+    pub fn iterate_glib_main_loop(&self) {
+        // Bound the work per poll so a flood can't starve the source loop.
+        const MAX_DISPATCHES: usize = 256;
+        for _ in 0..MAX_DISPATCHES {
+            // SAFETY: This function may have side effects if other parts of InputPlumber start using the main context.
+            // This function handle is always non-null and we don't have to pass anything to it that isn't NULL / 0.
+            let dispatched =
+                unsafe { (self.dylibs.g_main_context_iteration)(std::ptr::null_mut(), GFALSE) };
+            if dispatched == GFALSE {
+                break;
+            }
+        }
+    }
+
+    /// The signatures for gyroscope_(open/new)_sync and accelerometer_(open/new)_sync are the same, so we can reuse some code
+    unsafe fn create_measurement_sensor(
+        self: Arc<Self>,
+        new_fn: FnSscSensorNewSync,
+        open_fn: FnSscSensorOpenSync,
+        sample_rate: f64,
+    ) -> Result<SscObject, Box<dyn Error + Send + Sync>> {
+        let mut err: *mut GError = null_mut();
+        let ptr = unsafe {
+            // No cancellables: libssc frees its init and open tasks on cancel
+            // while QMI replies for them are still in flight.
+            (new_fn)(std::ptr::null_mut(), &mut err)
+        };
+
+        // Instantiate the sensor and get our GObject ptr from it
+        if let Some(v) = self.convert_glib_error(err) {
+            return Err(format!("Failed to instantiate SSC sensor: {v}").into());
+        }
+
+        let sensor = SscObject::new(ptr, self.clone())
+            .map_err(|_| "Failed to instantiate SSC sensor: (got a null pointer)")?;
+
+        if let Some(set_sample_rate) = self.dylibs.ssc_sensor_set_sample_rate {
+            // SAFETY: ptr is a live sensor that has not been opened yet.
+            unsafe { set_sample_rate(ptr as *mut GObject, sample_rate as f32) };
+        }
+
+        // "Open" the sensor (make it start doing stuff)
+        // note: We set the data callback later using set_measurement_handler, so this is just new sensor -> open sensor
+        let opened = unsafe {
+            err = std::ptr::null_mut();
+            (open_fn)(ptr, std::ptr::null_mut(), &mut err)
+        };
+
+        let failed = match self.convert_glib_error(err) {
+            Some(v) => Some(format!("Failed to open SSC sensor: {v}")),
+            None if opened == 0 => Some("Failed to open SSC sensor".to_string()),
+            None => None,
+        };
+        if let Some(msg) = failed {
+            // libssc keeps a report callback on a sensor whose open failed, so
+            // releasing it could leave that callback with a freed pointer.
+            std::mem::forget(sensor);
+            return Err(msg.into());
+        }
+
+        Ok(sensor)
+    }
+
+    pub fn create_gyroscope(
+        self: Arc<Self>,
+        sample_rate: f64,
+    ) -> Result<SscObject, Box<dyn Error + Send + Sync>> {
+        // SAFETY: These handles will stay available as long as this SscRuntime does.
+        unsafe {
+            let new_fn = self.dylibs.ssc_sensor_gyroscope_new_sync;
+            let open_fn = self.dylibs.ssc_sensor_gyroscope_open_sync;
+            self.create_measurement_sensor(new_fn, open_fn, sample_rate)
+        }
+    }
+
+    pub fn create_accelerometer(
+        self: Arc<Self>,
+        sample_rate: f64,
+    ) -> Result<SscObject, Box<dyn Error + Send + Sync>> {
+        // SAFETY: These handles will stay available as long as this SscRuntime does.
+        unsafe {
+            let new_fn = self.dylibs.ssc_sensor_accelerometer_new_sync;
+            let open_fn = self.dylibs.ssc_sensor_accelerometer_open_sync;
+            self.create_measurement_sensor(new_fn, open_fn, sample_rate)
+        }
+    }
+}
