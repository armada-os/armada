From a60b3192eb76b1758a481cbffecbc3487ca2d232 Mon Sep 17 00:00:00 2001
From: tycosnh <98500718+tycosnh@users.noreply.github.com>
Date: Wed, 30 Sep 2026 15:30:44 -0400
Subject: [PATCH] fix(ssc): scale accelerometer to UHID units, keep SSC
 libraries loaded (RTLD_NODELETE)

libssc reports acceleration in m/s^2 but targets expect the same units as the
IIO IMU drivers (1 LSB = 0.0006125 m/s^2), so Steam saw ~7 counts for 1 g.

Dropping the SSC IMU source dlclose()d libssc/gio/gobject/glib while libssc and
libqmi still had sources on the default GLib main context, so the next QMI report
jumped into unmapped code (SIGSEGV in report_large_received on shutdown).
---
 src/drivers/ssc/bindings.rs         | 13 ++++++++++---
 src/input/source/fastrpc/ssc_imu.rs |  9 ++++++---
 3 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/src/drivers/ssc/bindings.rs b/src/drivers/ssc/bindings.rs
index ff935137..5bbb7fec 100644
--- a/src/drivers/ssc/bindings.rs
+++ b/src/drivers/ssc/bindings.rs
@@ -144,12 +144,19 @@ pub struct SscDylibs {
     pub ssc_sensor_accelerometer_open_sync: FnSscSensorOpenSync,
 }
 
-/// Helper function for Library::new to return a nice error
+/// Helper function for Library::new to return a nice error.
+/// Libraries are opened with RTLD_NODELETE: libssc/libqmi keep GLib sources alive on the
+/// default main context, so unmapping them when the IMU source is dropped (e.g. on
+/// shutdown) makes the next QMI report jump into unmapped code.
 #[macro_export]
 macro_rules! load_library {
     ( $library_name:expr ) => {
-        Library::new($library_name)
-            .map_err(|e| format!("Library {} not found: {}", $library_name, e))
+        libloading::os::unix::Library::open(
+            Some($library_name),
+            libloading::os::unix::RTLD_NOW | nix::libc::RTLD_NODELETE,
+        )
+        .map(Library::from)
+        .map_err(|e| format!("Library {} not found: {}", $library_name, e))
     };
 }
 
diff --git a/src/input/source/fastrpc/ssc_imu.rs b/src/input/source/fastrpc/ssc_imu.rs
index 15c5f780..a0f96695 100644
--- a/src/input/source/fastrpc/ssc_imu.rs
+++ b/src/input/source/fastrpc/ssc_imu.rs
@@ -11,6 +11,8 @@ use crate::{
     udev::device::UdevDevice,
 };
 
+const ACCEL_SCALE_FACTOR: f64 = 1632.6530612244898; // 1 / 0.0006125 (m/s² → UHID LSB)
+
 pub struct SscImu {
     driver: Driver,
 }
@@ -80,10 +82,11 @@ fn translate_event(event: ssc::event::Event) -> NativeEvent {
     match event {
         ssc::event::Event::Accelerometer(data) => {
             let cap = Capability::Accelerometer(Source::Center);
+            // libssc reports m/s²; scale to the same units as the IIO IMU drivers
             let value = InputValue::Vector3 {
-                x: Some(data.roll),
-                y: Some(data.pitch),
-                z: Some(data.yaw),
+                x: Some(data.roll * ACCEL_SCALE_FACTOR),
+                y: Some(data.pitch * ACCEL_SCALE_FACTOR),
+                z: Some(data.yaw * ACCEL_SCALE_FACTOR),
             };
             NativeEvent::new(cap, value)
         }
