diff -ruN orig/unl0kr/config.c buffybox-3.5.1/unl0kr/config.c
--- a/unl0kr/config.c	2026-03-03 08:10:59.000000000 +0000
+++ b/unl0kr/config.c	2026-08-29 21:14:44.264393044 +0000
@@ -55,6 +55,22 @@
             /* Use a max ceiling of 60 minutes (3600 secs) */
             opts->general.timeout = (uint16_t)LV_MIN(strtoul(value, (char **)NULL, 10), 3600);
             return 1;
+        } else if (strcmp(key, "rotation") == 0) {
+            /* Quarter turns clockwise, matching buffyboard's --rotate and the
+             * values exposed in /sys/class/graphics/fbcon/rotate. */
+            if (strcmp(value, "0") == 0) {
+                opts->general.rotation = LV_DISPLAY_ROTATION_0;
+                return 1;
+            } else if (strcmp(value, "1") == 0) {
+                opts->general.rotation = LV_DISPLAY_ROTATION_270;
+                return 1;
+            } else if (strcmp(value, "2") == 0) {
+                opts->general.rotation = LV_DISPLAY_ROTATION_180;
+                return 1;
+            } else if (strcmp(value, "3") == 0) {
+                opts->general.rotation = LV_DISPLAY_ROTATION_90;
+                return 1;
+            }
         }
     } else if (strcmp(section, "keyboard") == 0) {
         if (strcmp(key, "autohide") == 0) {
@@ -162,6 +178,7 @@
     opts->general.animations = false;
     opts->general.backend = 0;
     opts->general.timeout = 0;
+    opts->general.rotation = LV_DISPLAY_ROTATION_0;
     opts->keyboard.autohide = true;
     opts->keyboard.layout_id = SQ2LV_LAYOUT_US;
     opts->keyboard.popovers = true;
