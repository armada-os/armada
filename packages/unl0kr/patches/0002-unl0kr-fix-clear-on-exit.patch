+static void clear_screen_and_exit(void) {
+    /* Clear the screen so that when the password field was unobscured, it cannot
+     * leak via stale display buffers after we've exited.
+     *
+     * The cover goes on the system layer, above everything else. As a child of
+     * the active screen, the screen's flex layout would ignore its position and
+     * stack it after the other widgets, entirely off-screen.
+     *
+     * Black rather than the theme background: the kernel can show this frame
+     * again after we exit (fbdev emulation re-commits it to every output when
+     * the next instance unblanks the display), and black reads as "off". */
+    lv_display_t *disp = lv_display_get_default();
+    if (disp) {
+        lv_obj_t *cover = lv_obj_create(lv_display_get_layer_sys(disp));
+        lv_obj_remove_style_all(cover);
+        lv_obj_set_size(cover, LV_PCT(100), LV_PCT(100));
+        lv_obj_set_style_bg_opa(cover, LV_OPA_COVER, LV_PART_MAIN);
+        lv_obj_set_style_bg_color(cover, lv_color_black(), LV_PART_MAIN);
+        lv_refr_now(disp); /* Force the screen to be drawn */
+    }
+
     bbx_terminal_reset_current_terminal();
     exit(0);
 }
 
+static void signal_event_cb(void) {
+    struct signalfd_siginfo info;
+    if (read(fd_signal, &info, sizeof(info)) != sizeof(info)) {
+        return;
+    }
+
+    bbx_log(BBX_LOG_LEVEL_VERBOSE, "Received signal %u, exiting", info.ssi_signo);
+    clear_screen_and_exit();
+}
