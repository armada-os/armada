prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: armada-autohdr
Description: SDR inverse tone mapping and HDR presentation policy
Version: @PROJECT_VERSION@
Libs: -L${libdir} -larmada-autohdr
Cflags: -I${includedir}
