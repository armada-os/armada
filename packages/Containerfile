FROM scratch AS out-mangohud
COPY --from=pkg-mangohud /work/out/ /rpms/


FROM builder-base AS pkg-mesa
COPY mesa/ /work/
WORKDIR /work
RUN --mount=type=cache,id=armada-ccache-mesa,target=/ccache ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-mesa
COPY --from=pkg-mesa /work/out/ /rpms/


FROM builder-base AS pkg-networkmanager
COPY networkmanager/ /work/
