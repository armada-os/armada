# Builder stages: one per package, running its build.sh as a RUN step so the
# result caches as a layer. Each out-<name> stage holds only the artifacts, laid
# out as the armada Containerfile bind-mounts them.
#
# Contract every build.sh sees, here and under ./build-local.sh:
#   /work  the package directory, cwd. Artifacts land in ./out
#   /src   the packages root: toolchain.env, TERRA.env, sibling packages

ARG BUILDER_IMAGE
ARG GUEST_BUILDER_IMAGE

FROM ${BUILDER_IMAGE} AS builder-base
COPY toolchain.env scrub-scratch.sh /src/

FROM builder-base AS pkg-armada-rgb
COPY armada-rgb/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-armada-rgb
COPY --from=pkg-armada-rgb /work/out/ /rpms/


FROM builder-base AS pkg-armada-splash
COPY armada-splash/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-armada-splash
COPY --from=pkg-armada-splash /work/out/ /rpms/


FROM builder-base AS pkg-gamescope
COPY TERRA.env /src/
COPY gamescope/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-gamescope
COPY --from=pkg-gamescope /work/out/ /rpms/


FROM builder-base AS pkg-gamescope-session
COPY TERRA.env /src/
COPY gamescope-session/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-gamescope-session
COPY --from=pkg-gamescope-session /work/out/ /rpms/

FROM builder-base AS pkg-gamescope-session-steam
COPY TERRA.env /src/
COPY gamescope-session-steam/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-gamescope-session-steam
COPY --from=pkg-gamescope-session-steam /work/out/ /rpms/


FROM builder-base AS pkg-inputplumber
COPY inputplumber/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-inputplumber
COPY --from=pkg-inputplumber /work/out/ /rpms/


FROM builder-base AS pkg-jupiter-hw-support
COPY jupiter-hw-support/ /work/
