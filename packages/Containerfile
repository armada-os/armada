FROM ${BUILDER_IMAGE} AS pkg-steam-bootstrap-builder
COPY steam-bootstrap/install-builder-deps.sh /tmp/
RUN /tmp/install-builder-deps.sh

FROM pkg-steam-bootstrap-builder AS pkg-steam-bootstrap
COPY toolchain.env scrub-scratch.sh /src/
COPY steam-bootstrap/ /work/
WORKDIR /work
RUN --mount=type=cache,id=steam-bootstrap-work,target=/work/work ./build.sh
RUN --network=none --mount=type=cache,id=steam-bootstrap-work,target=/work/work \
    bash generate.sh && /src/scrub-scratch.sh

FROM scratch AS out-steam-bootstrap
COPY --from=pkg-steam-bootstrap /work/out/ /steam-bootstrap/


# Cross-builds an arm64 target from an x86_64 host.
# Google ships NDK host binaries for linux-x86_64 only.
FROM --platform=linux/amd64 ${BUILDER_IMAGE} AS pkg-mesa-android
COPY toolchain.env scrub-scratch.sh /src/
COPY mesa/ /src/mesa/
COPY mesa-android/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-mesa-android
COPY --from=pkg-mesa-android /work/out/vendor/ /waydroid/vendor/


# x86 Turnip for the FEX guest rootfs, built in the Arch image
# pinned to the guest rootfs snapshot. Built on an x86_64 runner.
FROM --platform=linux/amd64 ${GUEST_BUILDER_IMAGE} AS pkg-mesa-x86
COPY scrub-scratch.sh /src/
COPY mesa/ /src/mesa/
COPY mesa-x86/ /work/
WORKDIR /work
RUN ./build.sh && /src/scrub-scratch.sh

FROM scratch AS out-mesa-x86
COPY --from=pkg-mesa-x86 /work/out/ArmadaMesa.sqsh /
