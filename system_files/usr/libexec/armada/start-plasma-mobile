#!/usr/bin/bash
# See start-plasma: the launcher may not have gone through session-control.
set -euo pipefail

source "${ARMADA_PLASMA_CONFIG_LIB:-/usr/lib/armada/plasma-config-lib}"

armada_plasma_activate_config mobile

export DESKTOP_SESSION=plasma-mobile
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export XDG_SESSION_TYPE=wayland

if command -v /usr/libexec/armada/device-env >/dev/null 2>&1; then
  set -a
  eval "$(/usr/libexec/armada/device-env)"
  set +a
fi

exec /usr/bin/startplasmamobile
