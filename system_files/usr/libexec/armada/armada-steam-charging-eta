import json
import logging
import subprocess
import time
import urllib.request
import websocket

LOG = logging.getLogger("armada-steam-charging-eta")
UP = [
    "busctl", "--system", "get-property", "org.freedesktop.UPower",
    "/org/freedesktop/UPower/devices/DisplayDevice",
    "org.freedesktop.UPower.Device",
]


def upower(name):
    return int(subprocess.check_output([*UP, name], text=True, timeout=2).split()[-1])


def connect():
    with urllib.request.urlopen("http://127.0.0.1:8080/json/list", timeout=2) as response:
        target = next(t for t in json.load(response) if t.get("title") == "SharedJSContext")
    return websocket.create_connection(target["webSocketDebuggerUrl"], timeout=3, suppress_origin=True)


def set_eta(ws, request_id, seconds):
    expression = (
        "(() => { if (typeof SystemPowerStore === 'undefined') "
        "throw new Error('Steam battery store unavailable'); "
        f"SystemPowerStore.m_nBatterySecondsRemaining = {seconds}; }})()"
    )
    ws.send(json.dumps({
        "id": request_id,
        "method": "Runtime.evaluate",
        "params": {"expression": expression, "returnByValue": True},
    }))
    while True:
        reply = json.loads(ws.recv())
        if reply.get("id") != request_id:
            continue
        if "error" in reply or "exceptionDetails" in reply.get("result", {}):
            raise RuntimeError("Steam rejected battery ETA update")
        return


def main():
    logging.basicConfig(level=logging.WARNING, format="%(asctime)s %(levelname)s %(message)s")
    ws, request_id, last_error = None, 0, None
    while True:
        try:
            if upower("State") == 1:
                seconds = upower("TimeToFull")
                if ws is None:
                    ws = connect()
                request_id += 1
                set_eta(ws, request_id, seconds if seconds > 0 else -1)
            elif ws is not None:
                ws.close()
                ws = None
            last_error = None
        except Exception as error:
            if ws is not None:
                ws.close()
                ws = None
            if str(error) != last_error:
                LOG.warning("ETA update unavailable: %s", error)
                last_error = str(error)
        time.sleep(1)


if __name__ == "__main__":
    main()
