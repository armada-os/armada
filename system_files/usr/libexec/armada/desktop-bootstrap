#!/usr/bin/bash
set -euo pipefail

[[ ${XDG_SESSION_TYPE:-} == wayland ]] || exit 0

activation_env=(
    DESKTOP_SESSION
    XDG_CURRENT_DESKTOP
    XDG_SESSION_DESKTOP
    XDG_SESSION_TYPE
    WAYLAND_DISPLAY
    DISPLAY
    XAUTHORITY
    KDE_FULL_SESSION
    KDE_SESSION_VERSION
)
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd "${activation_env[@]}" 2>/dev/null || true
else
    systemctl --user import-environment "${activation_env[@]}" 2>/dev/null || true
fi

device_env="${ARMADA_DEVICE_ENV:-/usr/libexec/armada/device-env}"
if [[ -x "${device_env}" ]]; then
    eval "$("${device_env}")"
fi

# The gaming session inhibits the secondary touchscreen (the desktop is the
# only session that lights up the secondary panel); re-enable it every start.
if [[ -n "${ARMADA_SECONDARY_TOUCHSCREEN:-}" ]]; then
    /usr/libexec/armada/touchscreen-inhibit "$ARMADA_SECONDARY_TOUCHSCREEN" 0 2>/dev/null || true
fi

display_connector="${ARMADA_PRIMARY_CONNECTOR:-}"
panel_orientation="${ARMADA_PANEL_ORIENTATION:-normal}"

[[ -n "${display_connector}" ]] || exit 0

config_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/armada"
armada_lib_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../lib/armada" && pwd)"
source "${armada_lib_dir}/desktop-bootstrap-lib"
armada_desktop_bootstrap_state "${config_dir}"

[[ "${rotation_complete}" != 1 || "${scale_complete}" != 1 || "${dual_complete}" != 1 ]] || exit 0
mkdir -p "${config_dir}"

for _ in {1..5}; do
    kscreen-doctor -o >/dev/null 2>&1 && break
    sleep 2
done

if [[ "${rotation_complete}" != 1 ]] &&
        kscreen-doctor "output.${display_connector}.rotation.${rotation_value}" >/dev/null 2>&1; then
    if armada_write_marker "${rotation_done}" "${rotation_signature}"; then
        rotation_complete=1
    fi
fi

if [[ "${scale_complete}" != 1 ]] &&
        kscreen-doctor "output.${display_connector}.scale.${desktop_scale}" >/dev/null 2>&1; then
    if armada_write_marker "${scale_done}" "${scale_signature}"; then
        scale_complete=1
    fi
fi

if [[ "${dual_complete}" != 1 && "${rotation_complete}" == 1 && "${scale_complete}" == 1 ]]; then
    if [[ -z "${ARMADA_SECONDARY_CONNECTOR:-}" ]]; then
        armada_write_marker "${dual_done}" "${dual_signature}" || true
    else
        dual_screen_setup="${ARMADA_SETUP_DUAL_SCREEN:-/usr/libexec/armada/setup-dual-screen}"
        if "${dual_screen_setup}"; then
            armada_write_marker "${dual_done}" "${dual_signature}" || true
        fi
    fi
fi
