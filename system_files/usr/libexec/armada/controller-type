#!/usr/bin/env python3
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

CONFIG = Path("/etc/armada/controller.conf")
SERVICE = "org.shadowblip.InputPlumber"
IFACE = "org.shadowblip.Input.CompositeDevice"
DEVICE_ENV = "/usr/libexec/armada/device-env"
CONTROLLER_TYPES = {
    "deck-uhid": "Steam Deck",
    "xbox-series": "Xbox Series",
    "xb360": "Xbox 360",
    "ds5": "DualSense",
    "direct": "Direct (no InputPlumber)",
}
# Direct mode: InputPlumber masked, the raw rsinput gamepad goes to SDL and Steam.
# 65-armada-direct-input.rules and armada-direct-input.service act only while this exists.
DIRECT = "direct"
DIRECT_FLAG = Path("/etc/armada/direct-input")
DIRECT_SERVICE = "armada-direct-input.service"
# rsinput options for direct mode: Xbox face codes (SDL would swap X and Y without
# InputPlumber), back paddles forwarded in the kernel, and on devices whose profile
# sets ARMADA_DIRECT_IMU_MATRIX a motion node that armada-direct-motion fills from
# the Snapdragon Sensor Core.
MOTION_SERVICE = "armada-direct-motion.service"
DIRECT_MODPROBE = Path("/etc/modprobe.d/armada-direct.conf")
# What the back paddles send in direct mode ("left=a", "right=b"). They are real
# gamepad buttons, so they work in every game and app, with or without Steam Input.
PADDLES_CONFIG = Path("/etc/armada/direct-paddles.conf")
DEFAULT_PADDLES = {"left": "a", "right": "b"}
# Button names to evdev codes, as SDL reads them with xbox_face_codes=1.
PADDLE_BUTTONS = {
    "a": 0x130, "b": 0x131, "x": 0x133, "y": 0x134, "lb": 0x136, "rb": 0x137,
    "select": 0x13A, "start": 0x13B, "guide": 0x13C, "l3": 0x13D, "r3": 0x13E,
    "up": 0x220, "down": 0x221, "left": 0x222, "right": 0x223,
}
INPUTPLUMBER_SERVICE = "inputplumber.service"
# InputPlumber's hide rules; a stopped InputPlumber can leave them behind until reboot.
INPUTPLUMBER_RULES = Path("/run/udev/rules.d")
GAMEPAD_PHYS = "rsinput-gamepad/input0"
PADDLES_NAME = "gpio-keys-paddles"


def device_env_value(name):
    """Value of one device-env setting, "" when unset, None when device-env fails."""
    try:
        result = subprocess.run(
            [DEVICE_ENV],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    for line in result.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip() == name:
            try:
                return shlex.split(value)[0] if value.strip() else ""
            except ValueError:
                return value.strip()
    return ""


def available_types():
    raw = device_env_value("ARMADA_IP_TARGETS")
    if raw is None:
        return list(CONTROLLER_TYPES)
    types = []
    for item in raw.split(","):
        item = item.strip()
        if item in CONTROLLER_TYPES and item not in types:
            types.append(item)
    return types or list(CONTROLLER_TYPES)


def load_type(types):
    try:
        lines = CONFIG.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return types[0]
    value = ""
    for line in lines:
        key, sep, raw = line.partition("=")
        if sep and key.strip() == "controller_type":
            value = raw.strip()
            break
    return value if value in types else types[0]


def save_type(value):
    if value not in CONTROLLER_TYPES:
        raise ValueError(f"invalid controller type: {value}")
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_name(f".{CONFIG.name}.tmp")
    tmp.write_text(f"controller_type={value}\n", encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(CONFIG)


def composite_paths():
    try:
        result = subprocess.run(
            ["busctl", "--system", "tree", SERVICE],
            check=True,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    paths = []
    for line in result.stdout.splitlines():
        match = re.search(r"(/org/shadowblip/InputPlumber/CompositeDevice[0-9]+)", line)
        if match:
            paths.append(match.group(1))
    return sorted(set(paths))


def composite_name(path):
    try:
        result = subprocess.run(
            ["busctl", "--system", "get-property", SERVICE, path, IFACE, "Name"],
            check=True,
            capture_output=True,
            text=True,
            timeout=2,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    parts = result.stdout.strip().split('"')
    return parts[1] if len(parts) >= 2 else ""


def target_devices(value):
    # The set OpenGamepadUI sends. Not read back from TargetDevices, which lags target creation.
    targets = [value, "keyboard", "mouse"]
    if value in ("xb360", "xbox-series"):
        targets.append("touchpad")
    return targets


def apply_type(value):
    paths = composite_paths()
    if not paths:
        return False
    ok = False
    for path in paths:
        targets = target_devices(value)
        try:
            subprocess.run(
                ["busctl", "--system", "call", SERVICE, path, IFACE, "SetTargetDevices", "as", str(len(targets)), *targets],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=8,
            )
            ok = True
        except (OSError, subprocess.SubprocessError):
            pass
    return ok


def systemctl(*args):
    subprocess.run(["systemctl", *args], check=True, stdout=subprocess.DEVNULL, timeout=30)


def direct_nodes():
    """Syspaths of the gamepad and paddle event nodes the direct rules match."""
    nodes = []
    for event in Path("/sys/class/input").glob("event*"):
        device = event / "device"
        try:
            phys = (device / "phys").read_text(encoding="utf-8").strip()
            name = (device / "name").read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if phys == GAMEPAD_PHYS or name == PADDLES_NAME:
            nodes.append(str(event))
    return nodes


def reload_direct_nodes():
    subprocess.run(["udevadm", "control", "--reload"], check=True, timeout=10)
    for node in direct_nodes():
        subprocess.run(["udevadm", "trigger", "--action=add", node], check=True, timeout=10)
    subprocess.run(["udevadm", "settle"], check=False, timeout=30)


def reload_rsinput():
    subprocess.run(["modprobe", "-r", "rsinput"], check=True, timeout=30)
    subprocess.run(["modprobe", "rsinput"], check=True, timeout=30)


def load_paddles():
    paddles = dict(DEFAULT_PADDLES)
    try:
        lines = PADDLES_CONFIG.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return paddles
    for line in lines:
        side, sep, button = line.partition("=")
        if sep and side.strip() in paddles and button.strip() in PADDLE_BUTTONS:
            paddles[side.strip()] = button.strip()
    return paddles


def direct_options():
    paddles = load_paddles()
    options = (
        "options rsinput xbox_face_codes=1 forward_paddles=1"
        f" paddle_left={PADDLE_BUTTONS[paddles['left']]} paddle_right={PADDLE_BUTTONS[paddles['right']]}"
    )
    if device_env_value("ARMADA_DIRECT_IMU_MATRIX"):
        options += " motion_sensors=1"
    return options + "\n"


def enable_direct():
    DIRECT_FLAG.parent.mkdir(parents=True, exist_ok=True)
    DIRECT_FLAG.touch()
    systemctl("mask", "--now", INPUTPLUMBER_SERVICE)
    for rule in INPUTPLUMBER_RULES.glob("*-inputplumber-hide-*.rules"):
        rule.unlink(missing_ok=True)
    options = direct_options()
    if not DIRECT_MODPROBE.exists() or DIRECT_MODPROBE.read_text(encoding="utf-8") != options:
        DIRECT_MODPROBE.parent.mkdir(parents=True, exist_ok=True)
        DIRECT_MODPROBE.write_text(options, encoding="utf-8")
        reload_rsinput()
    reload_direct_nodes()
    systemctl("restart", DIRECT_SERVICE)
    systemctl("restart", MOTION_SERVICE)


def disable_direct():
    systemctl("stop", MOTION_SERVICE)
    systemctl("stop", DIRECT_SERVICE)
    DIRECT_FLAG.unlink(missing_ok=True)
    if DIRECT_MODPROBE.exists():
        DIRECT_MODPROBE.unlink()
        reload_rsinput()
    reload_direct_nodes()
    systemctl("unmask", INPUTPLUMBER_SERVICE)
    systemctl("start", INPUTPLUMBER_SERVICE)


def apply_with_retry(value):
    for _ in range(30):
        if apply_type(value):
            return True
        time.sleep(0.5)
    return False


def main(argv):
    command = argv[1] if len(argv) > 1 else "get"
    if command == "get":
        print(load_type(available_types()))
        return 0
    if command == "set":
        types = available_types()
        if len(argv) != 3:
            print(f"usage: controller-type set <{'|'.join(types)}>", file=sys.stderr)
            return 2
        if argv[2] not in types:
            print(f"invalid controller type: {argv[2]}", file=sys.stderr)
            return 2
        if argv[2] == DIRECT:
            enable_direct()
            save_type(DIRECT)
            return 0
        if DIRECT_FLAG.exists():
            disable_direct()
        if not apply_with_retry(argv[2]):
            return 1
        save_type(argv[2])
        return 0
    if command == "apply":
        value = load_type(available_types())
        if value == DIRECT:
            return 0
        return 0 if apply_with_retry(value) else 1
    if command == "paddles":
        if len(argv) == 2:
            paddles = load_paddles()
            print(f"{paddles['left']} {paddles['right']}")
            return 0
        if len(argv) != 4 or argv[2] not in PADDLE_BUTTONS or argv[3] not in PADDLE_BUTTONS:
            print(f"usage: controller-type paddles [<left> <right>], buttons: {' '.join(PADDLE_BUTTONS)}", file=sys.stderr)
            return 2
        PADDLES_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        PADDLES_CONFIG.write_text(f"left={argv[2]}\nright={argv[3]}\n", encoding="utf-8")
        # In direct mode the new codes take effect with one rsinput reload.
        if DIRECT_FLAG.exists():
            enable_direct()
        return 0
    print("usage: controller-type get|set|apply|paddles", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
