#!/usr/bin/awk -f
# Convert Steam's light request into the selected panel's raw range.

function fail(message) {
    print "steam-backlight-value: " message > "/dev/stderr"
    exit 1
}

function number(value,    result) {
    if (value !~ /^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$/)
        fail("invalid numeric parameter")
    result = value + 0
    if (sprintf("%g", result) ~ /[IiNn]/)
        fail("non-finite numeric parameter")
    return result
}

function read_max(directory,    path, value) {
    path = directory "/max_brightness"
    if ((getline value < path) != 1)
        fail("cannot read " path)
    close(path)
    if (value !~ /^[0-9]+$/ || value + 0 <= 0)
        fail("invalid backlight range")
    return number(value)
}

BEGIN {
    if (ARGC < 4 || ARGC > 8)
        fail("expected value, source directory, target directory, optional gamma, minima and maximum")
    if (ARGV[1] !~ /^[0-9]+$/)
        fail("invalid backlight value")
    value = number(ARGV[1])
    source_max = read_max(ARGV[2])
    target_max = read_max(ARGV[3])
    gamma = ARGC >= 5 ? number(ARGV[4]) : 1
    input_min = ARGC >= 6 ? number(ARGV[5]) : 0
    output_min = ARGC >= 7 ? number(ARGV[6]) : 0
    output_max = ARGC >= 8 ? number(ARGV[7]) : 1
    if (value > source_max || gamma <= 0 || input_min < 0 || input_min >= 1 ||
        output_min < 0 || output_max <= 0 || output_max > 1 || output_min > output_max)
        fail("invalid backlight value, gamma, minimum or maximum")
    minimum = int(output_min * target_max)
    if (minimum < output_min * target_max) minimum++
    # Panels whose light stops rising below their raw maximum end the range early.
    top = int(output_max * target_max)
    if (top < minimum) top = minimum
    if (gamma == 1 && input_min == 0) {
        # Preserve linear light requests above the minimum.
        result = int(value * top / source_max)
        print (result < minimum ? minimum : result)
        exit
    }

    # Steam truncates its light request before calling the helper.
    source_min = int(input_min * source_max)
    if (value <= source_min) {
        print minimum
        exit
    }
    if (value == source_max) {
        print top
        exit
    }

    # Anchor the gamma-corrected light range at the configured raw minimum.
    lower = (source_min / source_max) ^ (1 / gamma)
    if (lower >= 1)
        fail("backlight gamma leaves no usable range")
    setting = (value / source_max) ^ (1 / gamma)
    position = (setting - lower) / (1 - lower)
    result = minimum + int(position * (top - minimum) + 0.5)
    print (result > top ? top : result)
    exit
}
