#!/usr/bin/env python3
import os
import shlex
import subprocess
import sys
from pathlib import Path

CONFIG = Path(os.environ.get("ARMADA_CONTROLLER_CONFIG", "/etc/armada/controller.conf"))
DEVICE_ENV = os.environ.get("ARMADA_DEVICE_ENV", "/usr/libexec/armada/device-env")
DEFAULT_LAYOUT = "auto"
LAYOUTS = {"auto", "xbox", "nintendo"}


def load_config():
    try:
        lines = CONFIG.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return {}
    values = {}
    for line in lines:
        key, sep, raw = line.partition("=")
        if sep:
            values[key.strip()] = raw.strip()
    return values


def load_layout():
    value = load_config().get("button_layout", "")
    return value if value in LAYOUTS else DEFAULT_LAYOUT


def save_layout(value):
    if value not in LAYOUTS:
        raise ValueError(f"invalid button layout: {value}")
    values = load_config()
    values["button_layout"] = value
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_name(f".{CONFIG.name}.tmp")
    tmp.write_text("".join(f"{key}={item}\n" for key, item in values.items()), encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(CONFIG)


def device_legends():
    try:
        output = subprocess.check_output([DEVICE_ENV], text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return "xbox"
    for line in output.splitlines():
        key, sep, raw = line.partition("=")
        if not sep or key != "ARMADA_BUILTIN_FACE_BUTTON_LEGENDS":
            continue
        try:
            value = shlex.split(raw)[0] if raw else ""
        except ValueError:
            value = raw
        return value if value in {"xbox", "nintendo"} else "xbox"
    return "xbox"


def resolved_layout():
    value = load_layout()
    return device_legends() if value == "auto" else value


def main(argv):
    command = argv[1] if len(argv) > 1 else "get"
    if command == "get":
        print(load_layout())
        return 0
    if command == "resolve":
        print(resolved_layout())
        return 0
    if command == "set":
        if len(argv) != 3:
            print("usage: controller-layout set <auto|xbox|nintendo>", file=sys.stderr)
            return 2
        if argv[2] not in LAYOUTS:
            print(f"invalid button layout: {argv[2]}", file=sys.stderr)
            return 2
        save_layout(argv[2])
        return 0
    print("usage: controller-layout get|resolve|set", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
