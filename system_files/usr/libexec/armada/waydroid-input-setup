#!/bin/bash
set -euo pipefail

boot_completed=
deadline=$((SECONDS + 90))
while (( SECONDS < deadline )); do
    boot_completed=$(timeout 3s waydroid shell -- getprop sys.boot_completed 2>/dev/null | tr -d '\r' || true)
    if [[ "$boot_completed" == "1" ]]; then
        break
    fi
    sleep 1
done

if [[ "$boot_completed" != "1" ]]; then
    echo "Android did not finish booting before the controller setup timeout" >&2
    exit 1
fi

keylayout_source=/usr/share/armada/waydroid/keylayout
keylayout_target=/var/home/armada/.local/share/waydroid/data/system/devices/keylayout
if [[ -d "$keylayout_source" ]]; then
    install -d -m 0755 "$keylayout_target"
    for keylayout in "$keylayout_source"/*.kl; do
        [[ -e "$keylayout" ]] || continue
        install -m 0644 "$keylayout" "$keylayout_target/$(basename "$keylayout")"
    done
fi

events=()
for event in /sys/class/input/event*; do
    if ! udevadm info --query=property --path="$event" 2>/dev/null | grep -qx 'ARMADA_WAYDROID_GAMEPAD=1'; then
        continue
    fi
    events+=("$event")
done

if (( ! ${#events[@]} )); then
    echo "No Waydroid passthrough gamepad found"
    exit 0
fi

if [[ -e /run/user/1000/armada-bottom-screen-active ]]; then
    waydroid shell -- setprop persist.waydroid.uevent false
    for event in "${events[@]}"; do
        name=$(basename "$event")
        waydroid shell -- rm -f "/dev/input/$name"
        echo "Hid $name from Waydroid while the bottom screen is active"
    done
    exit 0
fi

waydroid shell -- setprop persist.waydroid.uevent true
for event in "${events[@]}"; do
    echo add > "$event/uevent"
    echo "Exposed $(basename "$event") to Waydroid"
done
