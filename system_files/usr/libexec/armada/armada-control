def action_set_sleep_mode(request):
    value = str(request.get("value", ""))
    if value not in available_sleep_modes():
        raise RuntimeError("sleep mode is not supported on this device")

    select_mem_sleep(value)
    write_sleep_config(value)
    set_networkmanager_sleep_allowed(value != "fake")
    return {"value": value}


