def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def run(command, timeout=20):
    subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)


def ssh_enabled():
    result = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "sshd"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.stdout.strip() == "active"


def device_env():
    result = subprocess.check_output(["/usr/libexec/armada/device-env"], text=True, timeout=5)
    env = {}
    for line in result.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        try:
            env[key] = shlex.split(value)[0] if value else ""
        except ValueError:
            env[key] = value
    return env


def abl_version():
    versions = []
    for name, partition in ABL_PARTITIONS:
        result = subprocess.run(
            ["/usr/bin/python3", ABL_VERSION_TOOL, partition],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        version = result.stdout.strip() if result.returncode == 0 else ""
        versions.append((name, version))
    if versions[0][1] == versions[1][1]:
        return f"ROCKNIX {versions[0][1]}" if versions[0][1] else "Unknown"
    return ", ".join(
        f"{name}: ROCKNIX {version}" if version else f"{name}: Unknown"
        for name, version in versions
    )


