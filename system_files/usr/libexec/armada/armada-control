    result = subprocess.check_output(["/usr/libexec/armada/controller-type", "get"], text=True, timeout=5).strip()
    return {"value": result}


def action_set_ssh_enabled(request):
    enabled = bool(request.get("enabled"))
    action = "enable" if enabled else "disable"
    run(["/usr/bin/systemctl", action, "--now", "sshd"], timeout=30)
    return {"enabled": ssh_enabled()}


def action_get_ssh_enabled(request):
    return {"enabled": ssh_enabled()}


def action_set_mtp_enabled(request):
    enabled = bool(request.get("enabled"))
    action = "start" if enabled else "stop"
    try:
        run(["/usr/bin/systemctl", action, "armada-mtp.service"], timeout=30)
    except (OSError, subprocess.SubprocessError):
        if enabled:
            try:
                run(["/usr/bin/systemctl", "stop", "armada-mtp.service"], timeout=30)
            except (OSError, subprocess.SubprocessError):
                pass
        raise
    return {"enabled": mtp_enabled()}


def action_get_mtp_enabled(request):
    return {"enabled": mtp_enabled()}


def available_sleep_modes():
    try:
        advertised = {
            word.strip("[]")
            for word in MEM_SLEEP_PATH.read_text(encoding="utf-8", errors="replace").split()
        }
    except OSError:
        advertised = set()
    return {"fake"} | ({"s2idle", "deep"} & advertised)

