def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass


def run(command, timeout=20):
    subprocess.run(command, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=timeout)


def ssh_enabled():
    result = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "sshd"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.stdout.strip() == "active"


def mtp_enabled():
    result = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "armada-mtp.service"],
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        timeout=5,
    )
    return result.stdout.strip() == "active"


def write_sleep_config(mode):
    try:
        lines = SLEEP_CONFIG.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        lines = []
    output = []
    written = False
    for line in lines:
        key, sep, _value = line.partition("=")
        if sep and key.strip() == SUSPEND_MODE_KEY:
            if not written:
                output.append(f"{SUSPEND_MODE_KEY}={mode}")
                written = True
            continue
        output.append(line)
    if not written:
        output.append(f"{SUSPEND_MODE_KEY}={mode}")
    atomic_write(SLEEP_CONFIG, "\n".join(output) + "\n")


def set_networkmanager_sleep_allowed(allow_sleep):
    if allow_sleep:
        NM_IGNORE_SLEEP.unlink(missing_ok=True)
    else:
        NM_IGNORE_SLEEP.touch()

def get_desktop_mode() -> str:
    try:
        mode = DESKTOP_SESSION_PATH.read_text(encoding="utf-8").strip()
    except OSError:
        return "desktop"

    return mode if mode in DESKTOP_MODES else "desktop"


def set_desktop_mode(mode: str):
    if mode not in DESKTOP_MODES:
        raise ValueError("invalid desktop mode")

    atomic_write(DESKTOP_SESSION_PATH, f"{mode}\n")

def select_mem_sleep(mode):
    if mode in {"s2idle", "deep"}:
        MEM_SLEEP_PATH.write_text(f"{mode}\n", encoding="utf-8")


def abl_auto_enabled():
    for path, key in ((ABL_CONFIG, "auto_update_enabled"), (ABL_MANIFEST, "ARMADA_ABL_AUTO")):
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        value = ""
        for line in lines:
            name, sep, raw = line.partition("=")
            if sep and name.strip() == key:
                value = raw.strip()
                break
        if value in {"0", "1"}:
            return value == "1"
    return False


def device_env():
    result = subprocess.check_output(["/usr/libexec/armada/device-env"], text=True, timeout=5)
    env = {}
    for line in result.splitlines():
        if "=" not in line:
            continue
        key, value = line.split("=", 1)
        try:
            env[key] = shlex.split(value)[0] if value else ""
        except ValueError:
            env[key] = value
    return env


def abl_version():
    versions = []
    for name, partition in ABL_PARTITIONS:
        result = subprocess.run(
            ["/usr/bin/python3", ABL_VERSION_TOOL, partition],
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        version = result.stdout.strip() if result.returncode == 0 else ""
        versions.append((name, version))
    if versions[0][1] == versions[1][1]:
        return f"ROCKNIX {versions[0][1]}" if versions[0][1] else "Unknown"
    return ", ".join(
        f"{name}: ROCKNIX {version}" if version else f"{name}: Unknown"
        for name, version in versions
    )


def action_set_controller_type(request):
    value = str(request.get("value", ""))
    if value not in CONTROLLER_TYPES:
        raise ValueError("invalid controller type")
    run(["/usr/libexec/armada/controller-type", "set", value])
    result = subprocess.check_output(["/usr/libexec/armada/controller-type", "get"], text=True, timeout=5).strip()
    return {"value": result}


