def _vless_to_config(link, profile):
    # Convert a vless:// share link into a full sing-box config, reusing the profile's
    # existing config as a template (preserving its dns/tun/route tuning) and swapping the
    # proxy outbound. The connection host is pinned to an IP so the server stays reachable
    # without needing DNS through the not-yet-up tunnel.
    u = urlparse(link)
    if u.scheme != "vless" or not u.username or not u.hostname:
        raise ValueError("not a valid vless:// link")
    q = {k: v[0] for k, v in parse_qs(u.query).items()}
    host = u.hostname
    try:
        server = socket.gethostbyname(host)
    except Exception:
        server = host
    template = Path("/etc/sing-box/config-%s.json" % profile)
    if template.exists():
        cfg = json.loads(template.read_text())
    else:
        cfg = json.loads(json.dumps(_DEFAULT_VPN_TEMPLATE))
    ob = None
    for candidate in cfg.get("outbounds", []):
        if candidate.get("type") == "vless" or candidate.get("tag") == "proxy":
            ob = candidate
            break
    if ob is None:
        raise ValueError("template has no vless/proxy outbound")
    ob["type"] = "vless"
    ob["server"] = server
    ob["server_port"] = int(u.port or 443)
    ob["uuid"] = u.username
    ob["flow"] = q.get("flow", "")
    tls = ob.setdefault("tls", {})
    tls["enabled"] = True
    tls["server_name"] = q.get("sni") or q.get("host") or host
    utls = tls.setdefault("utls", {})
    utls["enabled"] = True
    utls["fingerprint"] = q.get("fp", "chrome")
    alpn = [a for a in q.get("alpn", "").split(",") if a]
    if alpn:
        tls["alpn"] = alpn
    else:
        tls.pop("alpn", None)
    if q.get("security") == "reality":
        reality = tls.setdefault("reality", {})
        reality["enabled"] = True
        reality["public_key"] = q.get("pbk", "")
        reality["short_id"] = q.get("sid", "")
    else:
        tls.pop("reality", None)
    net = q.get("type", "tcp")
    if net == "grpc":
        ob["transport"] = {"type": "grpc", "service_name": q.get("serviceName") or q.get("servicename") or ""}
    elif net == "ws":
        transport = {"type": "ws"}
        if q.get("path"):
            transport["path"] = unquote(q["path"])
        if q.get("host"):
            transport["headers"] = {"Host": q["host"]}
        ob["transport"] = transport
    elif net in ("http", "httpupgrade"):
        transport = {"type": "http"}
        if q.get("path"):
            transport["path"] = unquote(q["path"])
        if q.get("host"):
            transport["host"] = [q["host"]]
        ob["transport"] = transport
    else:
        ob.pop("transport", None)
    return json.dumps(cfg, indent=2)


def action_import_vpn_config(request):
    p = str(request.get("profile", "1"))
    text = request.get("text")
    if p not in ("1", "2") or not isinstance(text, str):
        raise ValueError("invalid vpn config import")
    text = text.strip()
    if len(text.encode("utf-8")) > MAX_REQUEST:
        raise ValueError("config payload too large")
    if text.startswith("vless://"):
        text = _vless_to_config(text, p)
    try:
        cfg = json.loads(text)
    except ValueError:
        raise ValueError("not valid JSON")
    if not isinstance(cfg, dict) or "outbounds" not in cfg:
        raise ValueError("not a sing-box config (missing outbounds)")
    fd, tmp = tempfile.mkstemp(prefix=".sbcheck.", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        chk = subprocess.run(
            ["/usr/bin/sing-box", "check", "-c", tmp],
            check=False, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=15,
        )
        if chk.returncode != 0:
            raise ValueError("sing-box check failed: " + (chk.stdout or "").strip()[:300])
    finally:
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass
    dest = Path(f"/etc/sing-box/config-{p}.json")
    atomic_write(dest, text)
    os.chmod(dest, 0o600)
    active = vpn_profile() == p
    if active and vpn_enabled():
        run(["/usr/bin/systemctl", "restart", "sing-box"], timeout=30)
    return {"profile": p, "active": active}
class PerfManager:
    """Owns the perf state file: global defaults, the per-game override,
    and the pidfd that restores defaults on game exit."""

    def __init__(self, selector):
        self.selector = selector
        self.pidfd = None
        self.pidfd_gen = 0
        self.env = armada_perf.device_env()
        state = armada_perf.read_state()
        override = state.get("override")
        if isinstance(override, dict) and self.pid_alive(override.get("pid")):
            self.arm_pidfd(override["pid"])
            self.refresh(keep_override=True)
        else:
            self.refresh()

    def pid_alive(self, pid):
        return isinstance(pid, int) and os.path.isdir(f"/proc/{pid}")

    def gamescope_layer(self, settings):
        clean = armada_perf.sanitize_perf(settings, self.env)
        layer = {}
        for key in ("gamescopeNice", "gamescopeRr", "gamescopeCores", "scheduler"):
            if key in clean:
                layer[key] = clean[key]
        if clean.get("scheduler") == "cosmos":
            layer["schedulerDomain"] = clean.get("cores")
        return layer

    def refresh(self, keep_override=False):
        # recomputed from game-tweaks.json; powerd applies on its next tick
        tweaks = armada_perf.load_tweaks()
        state = {"global": self.gamescope_layer(tweaks.get("global") or {})}
        if keep_override:
            old = armada_perf.read_state().get("override")
            if isinstance(old, dict) and self.pid_alive(old.get("pid")):
                merged = armada_perf.merged_settings(tweaks, old.get("appid"))
                override = self.gamescope_layer(merged)
                override.update({"appid": old.get("appid"), "pid": old["pid"]})
                state["override"] = override
        armada_perf.write_state(state)

    def arm_pidfd(self, pid):
        self.disarm_pidfd()
        try:
            self.pidfd = os.pidfd_open(pid, 0)
        except OSError:
            return False
        # generation-stamped: a stale event from the same select() batch must
        # not clear a later session (fd numbers get reused)
        self.pidfd_gen += 1
        generation = self.pidfd_gen
        self.selector.register(
            self.pidfd, selectors.EVENT_READ,
            lambda: self.game_exited(generation))
        return True

    def disarm_pidfd(self):
        if self.pidfd is None:
            return
        try:
            self.selector.unregister(self.pidfd)
        except (KeyError, ValueError):
            pass
        try:
            os.close(self.pidfd)
        except OSError:
            pass
        self.pidfd = None

    def game_exited(self, generation=None):
        if generation is not None and generation != self.pidfd_gen:
            return
        self.disarm_pidfd()
        self.refresh()

    def steam_session_pid(self, pid, appid):
        # Steam's reaper (a subreaper tagged SteamLaunch AppId=N) outlives
        # launcher pid swaps: orphaned game processes reparent to it. The
        # OUTERMOST tagged ancestor is the session lifetime - inner tagged
        # wrappers can exit before it.
        current, match = pid, None
        for _ in range(32):
            try:
                with open(f"/proc/{current}/cmdline", "rb") as f:
                    argv = f.read().split(b"\0")
                with open(f"/proc/{current}/stat", encoding="utf-8", errors="replace") as f:
                    stat = f.read()
            except OSError:
                break
            if b"SteamLaunch" in argv and (
                    not appid or f"AppId={appid}".encode() in argv):
                match = current
            try:
                ppid = int(stat.rsplit(")", 1)[1].split()[1])
            except (IndexError, ValueError):
                break
            if ppid <= 1:
                break
            current = ppid
        return match if match is not None else pid

    def game_launched(self, appid, pid):
        tweaks = armada_perf.load_tweaks()
        merged = armada_perf.merged_settings(tweaks, appid)
        clean = armada_perf.sanitize_perf(merged, self.env)
        nice = clean.get("nice", 0)
        if nice < 0:
            # pre-exec so the whole tree inherits the boost
            try:
                os.setpriority(os.PRIO_PROCESS, pid, nice)
            except OSError:
                pass
        # track every launch: re-apply needs the pid, and a new launch must
        # displace a stale override
        session_pid = self.steam_session_pid(pid, appid)
        override = self.gamescope_layer(merged)
        override.update({"appid": appid, "pid": session_pid})
        state = armada_perf.read_state()
        if self.arm_pidfd(session_pid):
            state["override"] = override
            armada_perf.write_state(state)
        return {"applied": True}

    def reapply(self):
        # mask + nice are live; env/topology are exec-time only
        state = armada_perf.read_state()
        override = state.get("override")
        if not isinstance(override, dict) or not self.pid_alive(override.get("pid")):
            raise RuntimeError("no running game to re-apply")
        tweaks = armada_perf.load_tweaks()
        clean = armada_perf.sanitize_perf(
            armada_perf.merged_settings(tweaks, override.get("appid")), self.env)
        cores = clean.get("cores")
        if clean.get("scheduler") == "cosmos":
            cores = None  # composition: cosmos gets the domain, no hard mask
        nice = clean.get("nice", 0)
        pids = [override["pid"]] + armada_perf.descendant_pids(override["pid"])
        for pid in pids:
            for tid in armada_perf.process_tids(pid):
                try:
                    os.setpriority(os.PRIO_PROCESS, tid, nice)
                    if cores:
                        os.sched_setaffinity(tid, cores)
                    else:
                        os.sched_setaffinity(tid, armada_perf.online_cpus())
                except OSError:
                    continue
        self.refresh(keep_override=True)
        return {"pids": len(pids)}


