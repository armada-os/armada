def handle_session(request, conn):
    # pid comes from SO_PEERCRED, never the payload: pre-exec the caller IS
    # the game process (exec preserves the pid)
    pid, uid, _gid = struct.unpack(
        "3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
    if uid == 0:
        raise ValueError("session socket is for the session user")
    action = request.get("action")
    if action == "game_launched":
        appid = str(request.get("appid", "")) or None
        if appid is not None and not appid.isdigit():
            raise ValueError("invalid appid")
        return PERF.game_launched(appid, pid)
    if action == "reapply_perf":
        return PERF.reapply()
    raise ValueError("unknown action")


def serve_client(conn, handler):
    # absolute deadline re-derived per recv: a drip-feeding client must not
    # hold the event loop (and pidfd restores) past CLIENT_TIMEOUT
    with conn:
        deadline = time.monotonic() + CLIENT_TIMEOUT
        try:
            data = b""
            while b"\n" not in data:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise ValueError("request timeout")
                conn.settimeout(remaining)
                chunk = conn.recv(65536)
                if not chunk:
                    break
                data += chunk
                if len(data) > MAX_REQUEST:
                    raise ValueError("request too large")
            request = json.loads(data.split(b"\n", 1)[0].decode("utf-8"))
            response = {"ok": True, "result": handler(request, conn)}
        except Exception as exc:
            response = {"ok": False, "error": str(exc)}
        try:
            conn.settimeout(max(0.5, deadline - time.monotonic()))
            conn.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode("utf-8"))
        except OSError:
            pass


def bind_socket(path, mode, group=None):
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.bind(str(path))
    if group is not None:
        try:
            os.chown(path, 0, grp.getgrnam(group).gr_gid)
        except (KeyError, OSError):
            pass
    os.chmod(path, mode)
    sock.listen(8)
    return sock


def main():
    global PERF
    SOCKET.parent.mkdir(parents=True, exist_ok=True)
    selector = selectors.DefaultSelector()
    PERF = PerfManager(selector)
    # Root-only socket; config rendering still belongs to the plugin client.
    control = bind_socket(SOCKET, 0o600)
    session = bind_socket(SESSION_SOCKET, 0o660, group="armada")

    def accept_control():
        conn, _ = control.accept()
        serve_client(conn, lambda request, _conn: handle(request))

    def accept_session():
        conn, _ = session.accept()
        serve_client(conn, handle_session)

    selector.register(control, selectors.EVENT_READ, accept_control)
    selector.register(session, selectors.EVENT_READ, accept_session)
    while True:
        for key, _events in selector.select():
            key.data()


def handle(request):
    action = ACTIONS.get(request.get("action"))
    if action is None:
        raise ValueError("unknown action")
    return action(request)


if __name__ == "__main__":
    main()
