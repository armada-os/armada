#!/bin/bash
# Sync both boot paths after OSTree finalizes the next deployment.
set -uo pipefail

UPDATE=${UPDATE:-/usr/libexec/armada/armada-boot-update}
BOOTC=${BOOTC:-/usr/bin/bootc}

if "${UPDATE}"; then
    exit 0
else
    update_status=$?
fi

echo "armada-bootimg-finalize: boot update failed (${update_status}); rolling back deployment" >&2
if "${BOOTC}" rollback; then
    "${UPDATE}" || echo "armada-bootimg-finalize: could not resync the rolled-back deployment" >&2
else
    echo "armada-bootimg-finalize: deployment rollback failed ($?)" >&2
fi
exit "${update_status}"
