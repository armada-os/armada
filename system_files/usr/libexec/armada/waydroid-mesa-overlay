#!/bin/bash
# Stage armada's Android Mesa into Waydroid's vendor overlay, which shadows
# vendor.img at container mount.
set -euo pipefail

source_dir=/usr/share/armada/waydroid/vendor/lib64
target_dir=/var/lib/waydroid/overlay/vendor/lib64

if [[ ! -d "$source_dir" ]]; then
    rm -rf "$target_dir"
    exit 0
fi

mkdir -p "$target_dir"
rsync --archive --delete --itemize-changes "$source_dir/" "$target_dir/"
