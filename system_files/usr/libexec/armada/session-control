#!/usr/bin/bash
# zz- sorts after armada.conf so its Session= wins (User=/Relogin= stay there).
#
# Used during early boot and when steamos-manager is unavailable to take control

set -euo pipefail

STEAMOS_MANAGER_STATE=/var/home/armada/.config/steamos-manager/state.toml

logout_plasma() {
    local user=armada
    local uid=1000
    local bus="/run/user/${uid}/bus"
    local qdbus=

    [[ -S "${bus}" ]] || return 1

    for candidate in qdbus-qt6 qdbus6 qdbus /usr/lib64/qt6/bin/qdbus; do
        if command -v "${candidate}" >/dev/null 2>&1; then
            qdbus=$(command -v "${candidate}")
            break
        elif [[ -x "${candidate}" ]]; then
            qdbus="${candidate}"
            break
        fi
    done

    [[ -n "${qdbus}" ]] || return 1

    sudo -Eu "${user}" env \
        XDG_RUNTIME_DIR="/run/user/${uid}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
        "${qdbus}" org.kde.Shutdown /Shutdown org.kde.Shutdown.logout
}

desktop_session=armada-plasma.desktop
if [[ -r "${STEAMOS_MANAGER_STATE}" ]]; then
    state_session=$(sed -n 's/^desktop_session[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "${STEAMOS_MANAGER_STATE}")
    [[ "${state_session}" == armada-plasma-mobile.desktop ]] && desktop_session=armada-plasma-mobile.desktop
fi

case "${1:-}" in
    switch-desktop|default-desktop)   session=$desktop_session ;;
    switch-gamemode|default-gamemode) session=gamescope-session-steam.desktop ;;
    *) echo "usage: $0 {switch-desktop|switch-gamemode|default-gamemode|default-desktop}" >&2; exit 1 ;;
esac

printf '[Autologin]\nSession=%s\n' "${session}" > /etc/sddm.conf.d/zz-holo-autologin.conf
rm -f /etc/sddm.conf.d/zz-steamos-autologin.conf
systemctl reset-failed sddm.service 2>/dev/null || true

if [[ "${1}" == default-* ]]; then
    exit 0
fi

if [[ "${1}" == "switch-gamemode" ]] && logout_plasma; then
    exit 0
fi

systemctl --no-block restart sddm.service
