#!/usr/bin/env python3
import json
import os
import pathlib
import re
import shutil
import stat


STEAM_CONFIGS = (
    pathlib.Path("/var/home/armada/.local/share/Steam/config/config.vdf"),
    pathlib.Path("/var/home/armada/.steam/root/config/config.vdf"),
)
HOME_DIR = pathlib.Path("/var/home/armada")
DESKTOP_DIR = HOME_DIR / "Desktop"

PROTON_11_VERSIONED = re.compile(r"proton-cachyos-11\.0-[^\"\s]+-arm64")
# Keep this in sync with PROTON_TOOL_NAME when changing Proton major/minor lines.
PROTON_11_STABLE = "proton-cachyos-11.0-arm64"

FIXUP_STATE_DIR = pathlib.Path("/var/lib/armada/fixups")


def fix_desktop_ownership():
    try:
        home_stat = HOME_DIR.stat()
        desktop_stat = DESKTOP_DIR.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(desktop_stat.st_mode):
        return
    owner = (home_stat.st_uid, home_stat.st_gid)
    if (desktop_stat.st_uid, desktop_stat.st_gid) == owner:
        return
    try:
        os.chown(DESKTOP_DIR, *owner, follow_symlinks=False)
    except FileNotFoundError:
        return
    print("Corrected Desktop directory ownership")


def rewrite_file(path, pattern, replacement):
    try:
        file_stat = path.stat()
        text = path.read_text(encoding="utf-8", errors="surrogateescape")
    except FileNotFoundError:
        return False

    new_text = pattern.sub(replacement, text)
    if new_text == text:
        return False

    tmp_path = path.with_name(f".{path.name}.armada-fixup")
    tmp_path.write_text(new_text, encoding="utf-8", errors="surrogateescape")
    os.chown(tmp_path, file_stat.st_uid, file_stat.st_gid)
    os.chmod(tmp_path, stat.S_IMODE(file_stat.st_mode))
    os.replace(tmp_path, path)
    return True


def fix_proton_11_tool_id():
    # Normalize the date-versioned cachy id to the stable id so mappings survive updates.
    changed = False
    seen = set()
    for path in STEAM_CONFIGS:
        try:
            key = path.resolve(strict=True)
        except FileNotFoundError:
            key = path
        if key in seen:
            continue
        seen.add(key)
        changed = rewrite_file(path, PROTON_11_VERSIONED, PROTON_11_STABLE) or changed
    if changed:
        print(f"Rewrote CachyOS Proton 11 compatibility tool ID to {PROTON_11_STABLE}")


def strip_compat_wildcard_block(text):
    lines = text.split("\n")
    key = re.compile(r'^\s*"([^"]*)"\s*$')
    out = []
    stack = []
    removed = False
    i = 0
    while i < len(lines):
        line = lines[i]
        match = key.match(line)
        if match and i + 1 < len(lines) and lines[i + 1].strip() == "{":
            name = match.group(1)
            if name == "0" and stack and stack[-1] == "CompatToolMapping":
                depth = 0
                end = i + 1
                while end < len(lines):
                    if lines[end].strip() == "{":
                        depth += 1
                    elif lines[end].strip() == "}":
                        depth -= 1
                        if depth == 0:
                            break
                    end += 1
                i = end + 1
                removed = True
                continue
            out.extend((line, lines[i + 1]))
            stack.append(name)
            i += 2
            continue
        if line.strip() == "}" and stack:
            stack.pop()
        out.append(line)
        i += 1
    return "\n".join(out), removed


def strip_compat_wildcard():
    marker = FIXUP_STATE_DIR / "compat-wildcard-stripped-v2"
    if marker.exists():
        return
    validated = True
    for path in STEAM_CONFIGS:
        try:
            file_stat = path.stat()
            text = path.read_text(encoding="utf-8", errors="surrogateescape")
        except FileNotFoundError:
            continue
        new_text, removed = strip_compat_wildcard_block(text)
        if not removed:
            continue
        if text.count("{") - new_text.count("{") != 1 or text.count("}") - new_text.count("}") != 1:
            validated = False
            continue
        tmp_path = path.with_name(f".{path.name}.armada-fixup")
        tmp_path.write_text(new_text, encoding="utf-8", errors="surrogateescape")
        os.chown(tmp_path, file_stat.st_uid, file_stat.st_gid)
        os.chmod(tmp_path, stat.S_IMODE(file_stat.st_mode))
        os.replace(tmp_path, path)
        print('Removed legacy "0" CompatToolMapping wildcard')
    if not validated:
        return
    try:
        FIXUP_STATE_DIR.mkdir(parents=True, exist_ok=True)
        marker.touch()
    except OSError:
        pass


def fix_lsfg_vulkan_layer():
    # The decky-lsfg-vk plugin upstream installer writes a broken relative library_path
    # ("../../../lib/liblsfg-vk.so") and expects liblsfg-vk.so in ~/.local/lib/.
    # Ensure ~/.local/lib/liblsfg-vk.so exists and the layer manifest points to it.
    plugin_so = HOME_DIR / "homebrew/plugins/Decky LSFG-VK/bin/liblsfg-vk-arm64.so"
    target_lib_dir = HOME_DIR / ".local/lib"
    target_so = target_lib_dir / "liblsfg-vk.so"

    if plugin_so.is_file() and not target_so.is_file():
        try:
            target_lib_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(plugin_so, target_so)
            home_stat = HOME_DIR.stat()
            os.chown(target_so, home_stat.st_uid, home_stat.st_gid)
            print("Installed liblsfg-vk.so to ~/.local/lib/")
        except OSError as exc:
            print(f"Failed to copy liblsfg-vk.so: {exc}")

    manifest_path = HOME_DIR / ".local/share/vulkan/implicit_layer.d/VkLayer_LS_frame_generation.json"
    if manifest_path.is_file():
        try:
            content = json.loads(manifest_path.read_text(encoding="utf-8"))
            lib_path = content.get("layer", {}).get("library_path", "")
            if lib_path.startswith("..") or not pathlib.Path(lib_path).is_file():
                content["layer"]["library_path"] = str(target_so)
                manifest_path.write_text(json.dumps(content, indent=2), encoding="utf-8")
                print("Fixed VkLayer_LS_frame_generation.json library_path to absolute ~/.local/lib/liblsfg-vk.so")
        except (json.JSONDecodeError, OSError) as exc:
            print(f"Failed to normalize LSFG Vulkan manifest: {exc}")


def main():
    fix_desktop_ownership()
    fix_proton_11_tool_id()
    strip_compat_wildcard()
    fix_lsfg_vulkan_layer()


if __name__ == "__main__":
    main()
