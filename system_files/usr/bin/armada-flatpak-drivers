#!/usr/bin/python3
# Lists installed Flatpak apps whose runtime can't load Armada's Mesa drivers, and why.
# Those apps fall back to their runtime's Mesa for GL and get no Vulkan.
import os
import pathlib
import subprocess
import sys

sys.path.insert(0, "/usr/lib/armada")
import armada_turnip


GLOBAL_OVERRIDE = pathlib.Path("/var/lib/flatpak/overrides/global")
OVERRIDE = pathlib.Path("/usr/share/armada/flatpak-override")
# what the global override points apps at, as the sandbox sees it
LIBRARIES = (
    armada_turnip.FLATPAK_SYSTEM_DIR / armada_turnip.DEFAULT_DRIVER / "aarch64"
    / armada_turnip.LIBRARY,
    pathlib.Path("/usr/lib/aarch64-linux-gnu/GL/host/lib/libGLX_armada.so.0"),
    pathlib.Path("/usr/lib/aarch64-linux-gnu/GL/host/lib/libEGL_armada.so.0"),
)
# the probe needs no session services
RUN = ["flatpak", "run", "--no-session-bus", "--no-a11y-bus", "--no-documents-portal"]


def installed_apps():
    result = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                            stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            timeout=60, check=True)
    return sorted(set(result.stdout.split()))


def override_problem():
    # A plain "flatpak override --system" turns the link into a copy that image updates
    # and rollbacks no longer change.
    if not GLOBAL_OVERRIDE.is_symlink():
        return f"{GLOBAL_OVERRIDE} is not a link to {OVERRIDE}" if GLOBAL_OVERRIDE.exists() \
            else f"{GLOBAL_OVERRIDE} is missing"
    if os.readlink(GLOBAL_OVERRIDE) != str(OVERRIDE):
        return f"{GLOBAL_OVERRIDE} links to {os.readlink(GLOBAL_OVERRIDE)}, not {OVERRIDE}"
    return None


def main(apps):
    # The probe runs each app's own sandbox, so run it as the user who runs the apps.
    if os.geteuid() == 0:
        raise SystemExit("armada-flatpak-drivers: run this as your user, not root")
    problems = 0
    problem = override_problem()
    if problem:
        problems += 1
        print(f"global override: {problem}")
    for app in apps or installed_apps():
        problem = armada_turnip.flatpak_problem(
            RUN, app, LIBRARIES, [])
        problems += bool(problem)
        print(f"{app}: {problem or 'ok'}")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
