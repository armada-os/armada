#!/usr/bin/bash
set -uo pipefail

sys_root=${ARMADA_SLEEP_DEBUG_SYS_ROOT:-/sys}
proc_root=${ARMADA_SLEEP_DEBUG_PROC_ROOT:-/proc}
state_dir=${ARMADA_SLEEP_DEBUG_STATE_DIR:-/var/tmp/armada-sleep-debug}
journalctl_bin=${ARMADA_SLEEP_DEBUG_JOURNALCTL:-/usr/bin/journalctl}
systemctl_bin=${ARMADA_SLEEP_DEBUG_SYSTEMCTL:-/usr/bin/systemctl}
device_env=${ARMADA_SLEEP_DEBUG_DEVICE_ENV:-/usr/libexec/armada/device-env}
input_lib=${ARMADA_SLEEP_DEBUG_INPUT_LIB:-/usr/lib/armada/input-lib}
evtest_bin=${ARMADA_SLEEP_DEBUG_EVTEST:-/usr/bin/evtest}
charge_debug_bin=${ARMADA_SLEEP_DEBUG_CHARGE_DEBUG:-/usr/bin/armada-charge-debug}
dev_root=${ARMADA_SLEEP_DEBUG_DEV_ROOT:-/dev}
run_root=${ARMADA_SLEEP_DEBUG_RUN_ROOT:-/run}

usage() {
    echo "Usage: armada-sleep-debug prepare"
    echo "       armada-sleep-debug collect  (default when no command is given)"
}

require_root() {
    if ((EUID != 0)) && [[ ${ARMADA_SLEEP_DEBUG_ALLOW_NONROOT:-0} != 1 ]]; then
        echo "Run this command with sudo." >&2
        exit 1
    fi
}

section() {
    printf '\n## %s\n' "$1"
}

single_line_file() {
    local label=$1 path=$2

    printf '%s=' "$label"
    if [[ -r $path ]]; then
        tr '\n' ' ' <"$path"
        echo
    else
        echo unavailable
    fi
}

read_value() {
    local value=

    [[ -r $1 ]] && value=$(tr -d '\n' <"$1" 2>/dev/null)
    printf '%s' "${value:-${2-unavailable}}"
}

snapshot_wakeup_sources() {
    local source_file="$sys_root/kernel/debug/wakeup_sources"

    [[ -r $source_file ]] || return 0
    cp "$source_file" "$state_dir/wakeup_sources.before"
}

snapshot_interrupts() {
    [[ -r $proc_root/interrupts ]] || return 0
    cp "$proc_root/interrupts" "$state_dir/interrupts.before"
}

snapshot_thermal_temperatures() {
    local zone found=0

    : >"$state_dir/thermal-temperatures.before"
    for zone in "$sys_root"/class/thermal/thermal_zone*; do
        [[ -d $zone && -r $zone/type && -r $zone/temp ]] || continue
        found=1
        printf '%s\t%s\t%s\n' "$(basename "$zone")" \
            "$(read_value "$zone/type")" "$(read_value "$zone/temp")" \
            >>"$state_dir/thermal-temperatures.before"
    done
    ((found)) || rm -f "$state_dir/thermal-temperatures.before"
}

snapshot_input_devices() {
    local ev

    : >"$state_dir/input-devices.before"
    for ev in "$sys_root"/class/input/event*; do
        [[ -r $ev/device/name ]] || continue
        printf '%s\t%s\n' "$(basename "$ev")" "$(read_value "$ev/device/name")" \
            >>"$state_dir/input-devices.before"
    done
    [[ -s $state_dir/input-devices.before ]] || rm -f "$state_dir/input-devices.before"
}

snapshot_charge_state() {
    local supply field found=0
    local fields=(status online current_now voltage_now charge_counter capacity)

    : >"$state_dir/charge.before"
    echo "epoch $(date +%s)" >>"$state_dir/charge.before"
    for supply in "$sys_root"/class/power_supply/*; do
        [[ -d $supply ]] || continue
        found=1
        printf '%s' "$(basename "$supply")" >>"$state_dir/charge.before"
        for field in "${fields[@]}"; do
            printf ' %s=%s' "$field" "$(read_value "$supply/$field" -)" \
                >>"$state_dir/charge.before"
        done
        echo >>"$state_dir/charge.before"
    done
    ((found)) || rm -f "$state_dir/charge.before"
}

# qcom_stats names are opaque: aosd = chip-wide AOSS deep sleep, cxsd = CX
# rail collapse, ddr = DDR self-refresh. cpuidle s2idle counters only tick
# inside suspend-to-idle, so no window bracketing is needed for them.
snapshot_sleep_depth() {
    local stats_dir="$sys_root/kernel/debug/qcom_stats" stat_file count duration
    local cpu state name

    : >"$state_dir/qcom-stats.before"
    for stat_file in "$stats_dir"/*; do
        [[ -f $stat_file && -r $stat_file ]] || continue
        count=$(sed -n 's/^Count: //p' "$stat_file" 2>/dev/null | head -n 1)
        duration=$(sed -n 's/^Accumulated Duration: //p' "$stat_file" 2>/dev/null | head -n 1)
        [[ -n $count ]] || continue
        printf '%s\t%s\t%s\n' "$(basename "$stat_file")" "$count" "${duration:-0}" \
            >>"$state_dir/qcom-stats.before"
    done
    [[ -s $state_dir/qcom-stats.before ]] || rm -f "$state_dir/qcom-stats.before"

    : >"$state_dir/cpuidle-s2idle.before"
    for state in "$sys_root"/devices/system/cpu/cpu*/cpuidle/state*; do
        [[ -r $state/s2idle/usage ]] || continue
        cpu=${state%/cpuidle/*}
        cpu=${cpu##*/}
        name=$(read_value "$state/name" "$(basename "$state")")
        printf '%s/%s\t%s\t%s\t%s\n' "$cpu" "$name" \
            "$(read_value "$state/s2idle/usage" 0)" \
            "$(read_value "$state/s2idle/time" 0)" \
            "$(basename "$state")" \
            >>"$state_dir/cpuidle-s2idle.before"
    done
    [[ -s $state_dir/cpuidle-s2idle.before ]] || rm -f "$state_dir/cpuidle-s2idle.before"
}

snapshot_suspend_stats() {
    local f
    : >"$state_dir/suspend-stats.before"
    for f in success fail; do
        printf '%s\t%s\n' "$f" "$(read_value "$sys_root/power/suspend_stats/$f" 0)" \
            >>"$state_dir/suspend-stats.before"
    done
}

# A PCM left open at suspend keeps the audio DSP awake for the whole sleep;
# capture the state at prepare so a bad night is attributable.
snapshot_audio_state() {
    local f state
    : >"$state_dir/audio.before"
    for f in "$proc_root"/asound/card*/pcm*/sub*/status; do
        [[ -r $f ]] || continue
        state=$(head -n 1 "$f" 2>/dev/null)
        [[ $state == closed ]] && continue
        printf 'open_pcm\t%s\t%s\n' "$f" "$state" >>"$state_dir/audio.before"
    done
    for f in "$sys_root"/kernel/debug/asoc/*/dapm/bias_level; do
        [[ -r $f ]] || continue
        printf 'bias\t%s\t%s\n' "$f" "$(head -n 1 "$f" 2>/dev/null)" >>"$state_dir/audio.before"
    done
}

enable_tsens_dynamic_debug() {
    local control="$sys_root/kernel/debug/dynamic_debug/control"

    if [[ ! -w $control ]]; then
        echo "TSENS dynamic debug is unavailable; sensor threshold details will not be logged."
        return
    fi

    if printf 'file drivers/thermal/qcom/tsens.c +p\n' >"$control"; then
        echo "TSENS threshold and interrupt debug logging enabled."
    else
        echo "TSENS dynamic debug could not be enabled."
    fi
}

prepare() {
    local pm_debug="$sys_root/power/pm_debug_messages"
    local pm_print_times="$sys_root/power/pm_print_times"

    require_root
    umask 077
    mkdir -p "$state_dir"
    date --iso-8601=seconds >"$state_dir/prepared_at"
    if [[ -r $proc_root/sys/kernel/random/boot_id ]]; then
        cp "$proc_root/sys/kernel/random/boot_id" "$state_dir/boot_id"
    fi
    snapshot_wakeup_sources
    snapshot_interrupts
    snapshot_thermal_temperatures
    snapshot_charge_state
    snapshot_sleep_depth
    snapshot_input_devices
    snapshot_suspend_stats
    snapshot_audio_state
    enable_tsens_dynamic_debug

    if [[ -w $pm_debug ]]; then
        echo 1 >"$pm_debug"
        echo "PM debug messages enabled."
    else
        echo "PM debug messages are unavailable; the report will use wake IRQ state and counters."
    fi

    if [[ -w $pm_print_times ]]; then
        echo 1 >"$pm_print_times"
        echo "Per-device suspend/resume timing enabled."
    else
        echo "Per-device suspend/resume timing is unavailable."
    fi

    if [[ -r $state_dir/wakeup_sources.before ]]; then
        echo "Wakeup-source baseline saved in $state_dir."
    else
        echo "Wakeup-source counters are unavailable; no baseline was saved."
    fi
    echo "After the next wake, run:"
    echo "sudo armada-sleep-debug collect > armada-sleep-debug.txt"
    echo "Prepare settings are per-boot; run prepare again after every reboot."
}

wakeup_irq_report() {
    local irq_file="$sys_root/power/pm_wakeup_irq"
    local irq irq_dir

    if [[ ! -r $irq_file ]]; then
        echo "pm_wakeup_irq=unavailable"
        return
    fi

    if ! irq=$(cat "$irq_file" 2>/dev/null) || [[ -z $irq ]]; then
        echo "pm_wakeup_irq=none-recorded"
        return
    fi
    echo "pm_wakeup_irq=$irq"
    [[ $irq =~ ^[1-9][0-9]*$ ]] || return

    irq_dir="$sys_root/kernel/irq/$irq"
    for field in actions name chip_name hwirq type; do
        [[ -r $irq_dir/$field ]] && single_line_file "irq_${field}" "$irq_dir/$field"
    done
    [[ -r $irq_dir/wakeup ]] && single_line_file irq_wakeup_after_resume "$irq_dir/wakeup"
    awk -v irq="${irq}:" '$1 == irq { print }' "$proc_root/interrupts" 2>/dev/null || true
}

wakeup_source_report() {
    local current="$sys_root/kernel/debug/wakeup_sources"
    local before="$state_dir/wakeup_sources.before"
    local current_boot baseline_boot

    if [[ ! -r $current ]]; then
        echo "wakeup_sources=unavailable"
        return
    fi

    current_boot=$(read_value "$proc_root/sys/kernel/random/boot_id" "")
    baseline_boot=$(read_value "$state_dir/boot_id" "")
    if [[ -r $before && -n $current_boot && $current_boot == "$baseline_boot" ]]; then
        echo "name active_delta event_delta wakeup_delta expire_delta"
        awk '
            NR == FNR {
                if (FNR > 1) {
                    active[$1] = $2
                    event[$1] = $3
                    wakeup[$1] = $4
                    expire[$1] = $5
                }
                next
            }
            FNR > 1 {
                active_delta = $2 - active[$1]
                event_delta = $3 - event[$1]
                wakeup_delta = $4 - wakeup[$1]
                expire_delta = $5 - expire[$1]
                if (active_delta || event_delta || wakeup_delta || expire_delta)
                    print $1, active_delta, event_delta, wakeup_delta, expire_delta
            }
        ' "$before" "$current"
    else
        echo "No same-boot prepare baseline was found. Sources with a nonzero wakeup count follow."
        awk 'NR == 1 || $4 != 0 { print }' "$current"
    fi
}

suspend_stats_report() {
    local stats_dir="$sys_root/power/suspend_stats"
    local path found=0

    if [[ ! -d $stats_dir ]]; then
        echo "suspend_stats=unavailable"
        return
    fi

    for path in "$stats_dir"/*; do
        [[ -f $path && -r $path ]] || continue
        found=1
        single_line_file "$(basename "$path")" "$path"
    done
    ((found)) || echo "suspend_stats=unavailable"
}

wakeup_inventory_report() {
    local wakeup path name device power_wakeup found=0

    for wakeup in "$sys_root"/class/wakeup/wakeup*; do
        [[ -d $wakeup ]] || continue
        found=1
        name=$(cat "$wakeup/name" 2>/dev/null || basename "$wakeup")
        device=$(readlink -f "$wakeup/device" 2>/dev/null || true)
        power_wakeup=unavailable
        [[ -r $wakeup/device/power/wakeup ]] && power_wakeup=$(tr -d '\n' <"$wakeup/device/power/wakeup")
        printf 'source=%s device=%s power_wakeup=%s' "$name" "${device:-unavailable}" "$power_wakeup"
        for path in active_count event_count wakeup_count expire_count; do
            [[ -r $wakeup/$path ]] && printf ' %s=%s' "$path" "$(tr -d '\n' <"$wakeup/$path")"
        done
        echo
    done
    ((found)) || echo "wakeup_class=unavailable"
}

rtc_and_timer_report() {
    local rtc found=0

    for rtc in "$sys_root"/class/rtc/rtc*; do
        [[ -d $rtc ]] || continue
        found=1
        printf '%s=' "$(basename "$rtc")_wakealarm"
        if [[ -r $rtc/wakealarm ]]; then
            tr '\n' ' ' <"$rtc/wakealarm"
            echo
        else
            echo unavailable
        fi
    done
    ((found)) || echo "rtc_wakealarm=unavailable"

    if [[ -x $systemctl_bin ]]; then
        echo "Wake-capable timer properties:"
        "$systemctl_bin" show '*.timer' --property=Id --property=WakeSystem 2>/dev/null || true
        echo "Scheduled timers:"
        "$systemctl_bin" list-timers --all --no-pager 2>/dev/null || true
    else
        echo "systemd_timers=unavailable"
    fi
}

input_state_report() {
    local dev name lid_dev= power_dev= lid_state=absent rc

    for dev in "$dev_root"/input/event*; do
        [[ -e $dev ]] || continue
        name=$(cat "$sys_root/class/input/$(basename "$dev")/device/name" 2>/dev/null || true)
        case $name in
            *pwrkey*|*[Pp]ower\ [Bb]utton*) power_dev=$dev; break ;;
        esac
    done
    echo "power_device=${power_dev:-unavailable}"

    if [[ -r $input_lib ]]; then
        # shellcheck source=/usr/lib/armada/input-lib
        source "$input_lib"
        lid_dev=$(armada_find_lid_dev 2>/dev/null || true)
    fi
    if [[ -n $lid_dev ]]; then
        lid_state=unknown
        if [[ -x $evtest_bin ]]; then
            "$evtest_bin" --query "$lid_dev" EV_SW SW_LID >/dev/null 2>&1
            rc=$?
            [[ $rc == 0 ]] && lid_state=open
            [[ $rc == 10 ]] && lid_state=closed
        fi
    fi
    echo "lid_device=${lid_dev:-none}"
    echo "lid_state=$lid_state"
}

# Dead-on-resume input shows as missing-since-prepare (driver unregistered)
# or a parent stuck in runtime_status=suspended (bus never woke).
input_inventory_report() {
    local baseline="$state_dir/input-devices.before" ev name parent status found=0

    for ev in "$sys_root"/class/input/event*; do
        [[ -r $ev/device/name ]] || continue
        found=1
        name=$(read_value "$ev/device/name")
        status=unavailable
        for parent in "$ev/device/device" "$ev/device/device/.."; do
            if [[ -r $parent/power/runtime_status ]]; then
                status=$(read_value "$parent/power/runtime_status")
                break
            fi
        done
        printf 'input=%s name="%s" parent_runtime_status=%s\n' \
            "$(basename "$ev")" "$name" "$status"
    done
    ((found)) || echo "input_devices=none"

    if [[ -r $baseline ]]; then
        while IFS=$'\t' read -r ev name; do
            [[ -r $sys_root/class/input/$ev/device/name ]] ||
                echo "input_missing_since_prepare=$ev \"$name\""
        done <"$baseline"
    else
        echo "input_baseline=unavailable (run prepare before suspending)"
    fi
}

# armada-power pins every CPU policy and the GPU to their lowest OPP for the
# duration of a fake suspend. A resume that dies before restoring them leaves a
# device that runs, but far too slowly to look awake.
power_state_report() {
    local policy gpu cur min max hw_min hw_max lowest found=0

    for policy in "$sys_root"/devices/system/cpu/cpufreq/policy*; do
        [[ -d $policy ]] || continue
        found=1
        cur=$(read_value "$policy/scaling_cur_freq")
        min=$(read_value "$policy/scaling_min_freq")
        max=$(read_value "$policy/scaling_max_freq")
        hw_min=$(read_value "$policy/cpuinfo_min_freq")
        hw_max=$(read_value "$policy/cpuinfo_max_freq")
        printf '%s cur=%s min=%s max=%s hw_min=%s hw_max=%s' \
            "$(basename "$policy")" "$cur" "$min" "$max" "$hw_min" "$hw_max"
        if [[ $max == "$hw_min" && $hw_min != "$hw_max" ]]; then
            printf ' PINNED-LOW (suspend profile not restored)'
        fi
        echo
    done
    ((found)) || echo "cpufreq=unavailable"

    found=0
    for gpu in "$sys_root"/class/devfreq/*.gpu; do
        [[ -d $gpu ]] || continue
        found=1
        min=$(read_value "$gpu/min_freq")
        max=$(read_value "$gpu/max_freq")
        # Lowest OPP only: gpu-manual pins min==max at an arbitrary clock.
        lowest=$(tr ' ' '\n' <"$gpu/available_frequencies" 2>/dev/null | sort -n | head -1)
        printf 'gpu=%s cur=%s min=%s max=%s governor=%s' \
            "$(basename "$gpu")" "$(read_value "$gpu/cur_freq")" \
            "$min" "$max" "$(read_value "$gpu/governor")"
        if [[ -n $lowest && $min == "$max" && $max == "$lowest" ]]; then
            printf ' PINNED-LOW (suspend profile not restored)'
        fi
        echo
    done
    ((found)) || echo "gpu_devfreq=unavailable"
}

thermal_state_report() {
    local zone trip index prepared_temp current_temp delta found=0
    local before="$state_dir/thermal-temperatures.before"

    for zone in "$sys_root"/class/thermal/thermal_zone*; do
        [[ -d $zone ]] || continue
        found=1
        current_temp=$(read_value "$zone/temp")
        printf 'zone=%s type=%s temp_mC=%s mode=%s policy=%s' \
            "$(basename "$zone")" "$(read_value "$zone/type")" \
            "$current_temp" "$(read_value "$zone/mode")" \
            "$(read_value "$zone/policy")"
        prepared_temp=
        if [[ -r $before ]]; then
            prepared_temp=$(awk -v zone="$(basename "$zone")" \
                '$1 == zone { print $3; exit }' "$before")
        fi
        if [[ $prepared_temp =~ ^-?[0-9]+$ && $current_temp =~ ^-?[0-9]+$ ]]; then
            delta=$((current_temp - prepared_temp))
            printf ' prepared_temp_mC=%s temp_delta_mC=%+d' "$prepared_temp" "$delta"
        fi
        for trip in "$zone"/trip_point_*_temp; do
            [[ -r $trip ]] || continue
            index=${trip##*/trip_point_}
            index=${index%_temp}
            printf ' trip%s_type=%s trip%s_temp_mC=%s trip%s_hyst_mC=%s' \
                "$index" "$(read_value "$zone/trip_point_${index}_type")" \
                "$index" "$(read_value "$trip")" \
                "$index" "$(read_value "$zone/trip_point_${index}_hyst")"
        done
        echo
    done
    ((found)) || echo "thermal_zones=unavailable"
}

thermal_irq_report() {
    local current="$proc_root/interrupts" before="$state_dir/interrupts.before"
    local current_boot baseline_boot

    if [[ ! -r $current ]]; then
        echo "thermal_irqs=unavailable"
        return
    fi

    current_boot=$(read_value "$proc_root/sys/kernel/random/boot_id" "")
    baseline_boot=$(read_value "$state_dir/boot_id" "")
    if [[ -r $before && -n $current_boot && $current_boot == "$baseline_boot" ]]; then
        echo "irq total_count count_since_prepare details"
        awk '
            function parse_line(    i) {
                irq = $1
                sub(/:$/, "", irq)
                total = 0
                for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++)
                    total += $i
                details = ""
                for (; i <= NF; i++)
                    details = details (details == "" ? "" : " ") $i
            }
            NR == FNR {
                if (tolower($0) ~ /(thermal|tsens)/ && $1 ~ /^[0-9]+:$/) {
                    parse_line()
                    baseline[irq] = total
                }
                next
            }
            tolower($0) ~ /(thermal|tsens)/ && $1 ~ /^[0-9]+:$/ {
                parse_line()
                printf "%s %d %+d %s\n", irq, total, total - baseline[irq], details
                found = 1
            }
            END { if (!found) print "thermal_irqs=none" }
        ' "$before" "$current"
    else
        grep -Ei 'thermal|tsens' "$current" 2>/dev/null || echo "thermal_irqs=none"
    fi
}

# An IRQ absent from this list while its device is being exercised means the
# line never fired; zero-delta rows are omitted, not shown as +0.
irq_delta_report() {
    local current="$proc_root/interrupts" before="$state_dir/interrupts.before"
    local current_boot baseline_boot

    if [[ ! -r $current || ! -r $before ]]; then
        echo "irq_deltas=unavailable (needs a prepare baseline)"
        return
    fi
    current_boot=$(read_value "$proc_root/sys/kernel/random/boot_id" "")
    baseline_boot=$(read_value "$state_dir/boot_id" "")
    if [[ -z $current_boot || $current_boot != "$baseline_boot" ]]; then
        echo "irq_deltas=unavailable (baseline is from a different boot)"
        return
    fi
    awk '
        function parse_line(    i) {
            irq = $1
            sub(/:$/, "", irq)
            total = 0
            for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++)
                total += $i
            details = ""
            for (; i <= NF; i++)
                details = details (details == "" ? "" : " ") $i
        }
        NR == FNR {
            if ($1 ~ /^[0-9]+:$/) {
                parse_line()
                baseline[irq] = total
            }
            next
        }
        $1 ~ /^[0-9]+:$/ {
            parse_line()
            delta = total - baseline[irq]
            if (delta != 0) {
                printf "%08d %s %d %+d %s\n", delta, irq, total, delta, details
                found = 1
            }
        }
        END { if (!found) print "irq_deltas=none" }
    ' "$before" "$current" | sort -rn | cut -d ' ' -f 2- | head -n 40
}

power_supply_report() {
    local supply field found=0
    local fields=(type status online present health temp current_now voltage_now power_now usb_type)

    for supply in "$sys_root"/class/power_supply/*; do
        [[ -d $supply ]] || continue
        found=1
        printf 'supply=%s' "$(basename "$supply")"
        for field in "${fields[@]}"; do
            [[ -r $supply/$field ]] || continue
            printf ' %s=%s' "$field" "$(read_value "$supply/$field")"
        done
        echo
    done
    ((found)) || echo "power_supplies=unavailable"
}

charge_delta_report() {
    local baseline="$state_dir/charge.before" now_epoch elapsed

    if [[ ! -r $baseline ]]; then
        echo "charge_baseline=unavailable (run prepare before suspending)"
        return
    fi
    now_epoch=$(date +%s)
    awk -v now="$now_epoch" '
        NR == FNR {
            if ($1 == "epoch") { then = $2; next }
            for (i = 2; i <= NF; i++) {
                split($i, kv, "=")
                before[$1 "." kv[1]] = kv[2]
            }
            supplies[$1] = 1
            next
        }
        {
            for (i = 2; i <= NF; i++) {
                split($i, kv, "=")
                current[$1 "." kv[1]] = kv[2]
            }
            supplies[$1] = 1
        }
        END {
            if (!then) { print "charge_baseline=unreadable"; exit }
            elapsed = now - then
            printf "charge_window_seconds=%d\n", elapsed
            for (s in supplies) {
                cb = before[s ".charge_counter"]; ca = current[s ".charge_counter"]
                vb = before[s ".voltage_now"];    va = current[s ".voltage_now"]
                line = s
                if (cb + 0 == cb && ca + 0 == ca && cb != "" && ca != "") {
                    line = line sprintf(" charge_counter_delta_uAh=%+d", ca - cb)
                    if (elapsed > 0)
                        line = line sprintf(" rate_mAh_per_h=%+.1f", (ca - cb) * 3.6 / elapsed)
                }
                if (vb + 0 == vb && va + 0 == va && vb != "" && va != "")
                    line = line sprintf(" voltage_delta_uV=%+d", va - vb)
                if (line != s) print line
            }
        }
    ' "$baseline" <(
        for supply in "$sys_root"/class/power_supply/*; do
            [[ -d $supply ]] || continue
            printf '%s' "$(basename "$supply")"
            for field in status online current_now voltage_now charge_counter capacity; do
                printf ' %s=%s' "$field" "$(read_value "$supply/$field" -)"
            done
            echo
        done
    )
    echo "charge_caveat=gauge deltas are indicative only; voltage and an external meter are ground truth"
}

sleep_depth_report() {
    local stats_dir="$sys_root/kernel/debug/qcom_stats"
    local baseline="$state_dir/qcom-stats.before" stat_file count duration found=0
    local cpuidle_baseline="$state_dir/cpuidle-s2idle.before" cpu state name

    if [[ ! -d $stats_dir ]]; then
        echo "qcom_stats=unavailable (debugfs or CONFIG_QCOM_STATS missing)"
    else
        for stat_file in "$stats_dir"/*; do
            [[ -f $stat_file && -r $stat_file ]] || continue
            count=$(sed -n 's/^Count: //p' "$stat_file" 2>/dev/null | head -n 1)
            duration=$(sed -n 's/^Accumulated Duration: //p' "$stat_file" 2>/dev/null | head -n 1)
            [[ -n $count ]] || continue
            found=1
            printf 'stat=%s count=%s' "$(basename "$stat_file")" "$count"
            if [[ -r $baseline ]]; then
                awk -v name="$(basename "$stat_file")" -v count="$count" \
                    -v duration="${duration:-0}" -F '\t' '
                    $1 == name {
                        printf " count_delta=%+d duration_delta=%+d", count - $2, duration - $3
                        exit
                    }
                ' "$baseline"
            fi
            echo
        done
        ((found)) || echo "qcom_stats=empty"
        if ((found)); then
            echo "reading=aosd/cxsd/ddr deltas of 0 across a real suspend mean the SoC rails never powered down"
            [[ -r $baseline ]] || echo "qcom_stats_baseline=unavailable (deltas need a same-boot prepare)"
        fi
    fi

    found=0
    for state in "$sys_root"/devices/system/cpu/cpu*/cpuidle/state*; do
        [[ -r $state/s2idle/usage ]] || continue
        found=1
        cpu=${state%/cpuidle/*}
        cpu=${cpu##*/}
        name=$(read_value "$state/name" "$(basename "$state")")
        printf 's2idle_state=%s/%s usage=%s time_us=%s' "$cpu" "$name" \
            "$(read_value "$state/s2idle/usage" 0)" "$(read_value "$state/s2idle/time" 0)"
        if [[ -r $cpuidle_baseline ]]; then
            awk -v key="$cpu/$name" -v usage="$(read_value "$state/s2idle/usage" 0)" -F '\t' '
                $1 == key { printf " usage_delta=%+d", usage - $2; exit }
            ' "$cpuidle_baseline"
        fi
        echo
    done
    ((found)) || echo "cpuidle_s2idle=unavailable (expected when the platform suspends via deep)"
}

# Post-wake snapshot of the charger firmware's live state (contract, ICL and
# FCC votes). The firmware log ring is only seconds deep, so events from
# inside the sleep window are usually gone by collect time.
charger_firmware_log_report() {
    local supply online=0

    for supply in "$sys_root"/class/power_supply/*; do
        [[ -r $supply/online && $(read_value "$supply/online") == 1 ]] && online=1
    done
    if ((!online)); then
        echo "charger_firmware_log=skipped (no charger attached; run armada-charge-debug manually if needed)"
        return
    fi
    if [[ ! -x $charge_debug_bin ]]; then
        echo "charger_firmware_log=unavailable (armada-charge-debug missing)"
        return
    fi
    "$charge_debug_bin" --ulog-only --watch 10 2>&1 ||
        echo "charger_firmware_log=failed"
}

tsens_dynamic_debug_report() {
    local control="$sys_root/kernel/debug/dynamic_debug/control" enabled

    if [[ ! -r $control ]]; then
        echo "tsens_dynamic_debug=unavailable"
        return
    fi

    enabled=$(grep -Ec 'drivers/thermal/qcom/tsens\.c:.* =[^ ]*p' "$control" 2>/dev/null || true)
    echo "tsens_dynamic_debug_entries=${enabled:-0}"
}

# Anything left behind here means fake-suspend resume died partway: input stays
# grabbed, the session stays frozen, the panel stays off. The kernel is fine and
# the device still looks hung.
fake_suspend_report() {
    local save_dir="$run_root/armada/fake-suspend" leftovers cgroup grabs frozen bl

    if [[ -e $run_root/armada/fake-suspend.active ]]; then
        echo "fake_suspend=active"
    else
        echo "fake_suspend=inactive"
    fi
    if [[ -e $run_root/armada/fake-suspend.wake ]]; then
        echo "fake_wake_request=pending"
    else
        echo "fake_wake_request=absent"
    fi

    if [[ -d $save_dir ]]; then
        leftovers=$(ls -A "$save_dir" 2>/dev/null | tr '\n' ' ')
        echo "fake_suspend_leftovers=${leftovers:-empty-dir}"
        if [[ -r $save_dir/app-cgroup ]]; then
            read -r cgroup <"$save_dir/app-cgroup"
            single_line_file app_cgroup_freeze "$sys_root/fs/cgroup${cgroup}/cgroup.freeze"
        fi
    else
        echo "fake_suspend_leftovers=none"
    fi

    grabs=$(pgrep -af 'evtest --grab' 2>/dev/null | tr '\n' ';')
    echo "input_grabs=${grabs:-none}"

    frozen=$(find "$sys_root/fs/cgroup" -name cgroup.freeze -readable \
        -exec grep -l '^1$' {} + 2>/dev/null | tr '\n' ' ')
    echo "frozen_cgroups=${frozen:-none}"

    for bl in "$sys_root"/class/backlight/*; do
        [[ -d $bl ]] || continue
        printf 'backlight=%s bl_power=%s brightness=%s\n' "$(basename "$bl")" \
            "$(read_value "$bl/bl_power")" "$(read_value "$bl/brightness")"
    done
}

# D covers a wedged driver; T covers a session the fake-suspend freezer stopped
# and never continued, which is the likelier hang on fake-suspend devices.
blocked_tasks_report() {
    local status pid state comm wchan stack line found=0

    for status in "$proc_root"/[0-9]*/status; do
        [[ -r $status ]] || continue
        state= comm=
        while IFS= read -r line; do
            case $line in
                Name:*) comm=${line#Name:} ;;
                State:*) state=${line#State:}; break ;;
            esac
        done <"$status"
        comm=${comm#"${comm%%[![:space:]]*}"}
        state=${state#"${state%%[![:space:]]*}"}
        state=${state:0:1}
        [[ $state == D || $state == T ]] || continue
        found=1
        pid=${status%/status}
        pid=${pid##*/}
        wchan=$(cat "$proc_root/$pid/wchan" 2>/dev/null || echo unavailable)
        printf 'pid=%s comm=%s state=%s wchan=%s\n' "$pid" "${comm:-unknown}" "$state" "$wchan"
        stack="$proc_root/$pid/stack"
        if [[ -r $stack ]]; then
            sed "s/^/pid_${pid}_stack: /" "$stack"
        else
            echo "pid_${pid}_stack: unavailable"
        fi
    done
    ((found)) || echo "blocked_tasks=none"
}

pstore_report() {
    local pstore_dir="$sys_root/fs/pstore" path found=0

    for path in "$pstore_dir"/console-ramoops-* "$pstore_dir"/dmesg-ramoops-*; do
        [[ -f $path && -r $path ]] || continue
        found=1
        echo "### $(basename "$path")"
        cat "$path"
    done
    ((found)) || echo "pstore_console=unavailable (ramoops may not be configured)"
}

sleep_logs() {
    local boot=$1 output
    local pattern='PM:|suspend|resume|wakeup|wake irq|thermal|tsens|qcom.geni|geni_i2c|i2c|rsinput|ucsi|pmic.gl|ufs|pcie|ath12k|goodix|ft5x|focaltech|hynitron|touchscreen|armada-fake-suspend|powerbuttond|armada-powerd|logind'
    # pm_print_times emits a pair of lines per device per phase, which would
    # otherwise be the whole tail. Device callbacks get their own section.
    local timing='(: (PM: )?calling .* @ [0-9]+|(PM: )?.* returned -?[0-9]+ after [0-9]+ usecs)'

    [[ -x $journalctl_bin ]] || {
        echo "journal=unavailable"
        return
    }

    output="$($journalctl_bin -b "$boot" --no-pager -o short-monotonic 2>/dev/null |
        grep -Ei "$pattern" | grep -Ev "$timing" |
        grep -v 'Existing logind session ID' | tail -n 400)" || true
    if [[ -n $output ]]; then
        printf '%s\n' "$output"
    else
        echo "No matching journal entries."
    fi
}

# The broad sleep log is a capped tail, so on a long boot the PM entry/exit
# markers can be pushed out by chattier matches; this small list cannot be.
suspend_timeline_report() {
    local boot=$1 output

    [[ -x $journalctl_bin ]] || {
        echo "journal=unavailable"
        return
    }
    output="$($journalctl_bin -k -b "$boot" --no-pager -o short-monotonic 2>/dev/null |
        grep -E 'PM: suspend (entry|exit)|Freezing of tasks|Restarting tasks|Wakeup pending' |
        tail -n 30)" || true
    if [[ -n $output ]]; then
        printf '%s\n' "$output"
    else
        echo "suspend_timeline=none"
    fi
}

# With pm_print_times on, a device that never finished suspending or resuming
# has a "calling" line with no matching "returned" line. Those are the suspects.
device_timing_report() {
    local boot=$1 output

    [[ -x $journalctl_bin ]] || {
        echo "journal=unavailable"
        return
    }

    output="$($journalctl_bin -k -b "$boot" --no-pager -o short-monotonic 2>/dev/null | awk '
        function device_key(text, marker) {
            marker = index(text, ": PM: ")
            return marker ? substr(text, 1, marker - 1) : ""
        }
        { line = $0; sub(/^.*kernel: /, "", line) }
        / calling .* @ [0-9]+/ {
            seen = 1
            dev = device_key(line)
            if (dev != "") pending[dev] = line
            next
        }
        / returned -?[0-9]+ after [0-9]+ usecs/ {
            seen = 1
            dev = device_key(line)
            if (dev != "") delete pending[dev]
            next
        }
        END {
            if (!seen) {
                print "ARMADA_SLEEP_DEBUG_NO_TIMING_DATA"
                exit
            }
            for (dev in pending) print pending[dev]
        }
    ')" || true

    if [[ $output == ARMADA_SLEEP_DEBUG_NO_TIMING_DATA ]]; then
        echo "device_callbacks=no-timing-data"
    elif [[ -n $output ]]; then
        echo "Devices whose callback never returned:"
        printf '%s\n' "$output"
    else
        echo "device_callbacks=none-outstanding"
    fi
}

kernel_tail() {
    local boot=$1 output

    [[ -x $journalctl_bin ]] || {
        echo "journal=unavailable"
        return
    }
    output="$($journalctl_bin -k -b "$boot" --no-pager -o short-monotonic 2>/dev/null | tail -n 100)" || true
    if [[ -n $output ]]; then
        printf '%s\n' "$output"
    else
        echo "No kernel journal entries."
    fi
}

verdict_report() {
    local window="" exits="" slept="" cycles="" wake_irq wake_name adsp_pct=""
    local before now dur_delta mdss_delta

    if [[ -r $state_dir/prepared_at ]]; then
        window=$(( $(date +%s) - $(date -d "$(cat "$state_dir/prepared_at")" +%s 2>/dev/null || echo 0) ))
        (( window > 0 )) || window=""
    fi
    echo "window_seconds=${window:-unavailable}"

    if [[ -r $state_dir/suspend-stats.before ]]; then
        before=$(awk -F'\t' '$1 == "success" {print $2}' "$state_dir/suspend-stats.before")
        now=$(read_value "$sys_root/power/suspend_stats/success" 0)
        exits=$(( now - before ))
        echo "suspend_exits_in_window=$exits"
    else
        echo "suspend_exits_in_window=unavailable (no prepare baseline)"
    fi

    # printk time freezes while timekeeping is suspended, so PM-entry/exit
    # timestamps understate sleep; the printed chunk durations are authoritative.
    if [[ -x $journalctl_bin ]]; then
        read -r cycles slept < <($journalctl_bin -k -b 0 --no-pager 2>/dev/null |
            grep -oE 'Timekeeping suspended for [0-9.]+' |
            awk '{n++; s+=$4} END {printf "%d %.0f", n, s}')
        if [[ ${cycles:-0} -gt 0 ]]; then
            echo "real_sleep_this_boot=${slept}s across ${cycles} timekeeping cycles"
        else
            # the kernel only prints these under pm_debug_messages, which prepare enables
            echo "real_sleep_this_boot=none-recorded (only sleeps after a prepare are measured)"
        fi
    fi

    wake_irq=$(read_value "$sys_root/power/pm_wakeup_irq" "")
    if [[ -n $wake_irq ]]; then
        wake_name=$(awk -v irq="$wake_irq:" '$1 == irq {print $NF}' "$proc_root/interrupts")
        echo "last_wake_irq=$wake_irq (${wake_name:-unknown})"
    else
        echo "last_wake_irq=none-recorded"
    fi

    if [[ -r $state_dir/qcom-stats.before && -r $sys_root/kernel/debug/qcom_stats/adsp && -n $window ]]; then
        before=$(awk -F'\t' '$1 == "adsp" {print $3}' "$state_dir/qcom-stats.before")
        now=$(sed -n 's/^Accumulated Duration: //p' "$sys_root/kernel/debug/qcom_stats/adsp" | head -n 1)
        if [[ -n $before && -n $now ]]; then
            # 19.2 MHz ticks
            adsp_pct=$(awk -v d=$((now - before)) -v w="$window" 'BEGIN {printf "%.1f", d / 192000 / w}')
            echo "adsp_sleep_pct_of_window=${adsp_pct}% (near 0 with the system suspended usually means an audio path was left open)"
        fi
    fi

    if [[ -r $state_dir/audio.before ]]; then
        echo "open_pcms_at_prepare=$(grep -c '^open_pcm' "$state_dir/audio.before")"
    fi

    if [[ -r $state_dir/interrupts.before ]]; then
        mdss_delta=$(awk 'FNR == NR { if (/msm_mdss/) { t=0; for (i=2; i<=9; i++) if ($i ~ /^[0-9]+$/) t+=$i; b+=t }; next }
            /msm_mdss/ { t=0; for (i=2; i<=9; i++) if ($i ~ /^[0-9]+$/) t+=$i; a+=t }
            END {print a - b}' "$state_dir/interrupts.before" "$proc_root/interrupts")
        if [[ -n $mdss_delta ]] && (( mdss_delta > 1000 )); then
            echo "display_irqs_in_window=+$mdss_delta (screen rendered during the window; part of it was normal use, not sleep)"
        fi
    fi
}

audio_state_report() {
    local f state
    if [[ -r $state_dir/audio.before ]]; then
        echo "at prepare:"
        sed 's/^/  /' "$state_dir/audio.before"
    else
        echo "at prepare: unavailable (no baseline)"
    fi
    echo "now:"
    for f in "$proc_root"/asound/card*/pcm*/sub*/status; do
        [[ -r $f ]] || continue
        state=$(head -n 1 "$f" 2>/dev/null)
        [[ $state == closed ]] && continue
        printf '  open_pcm\t%s\t%s\n' "$f" "$state"
    done
    for f in "$sys_root"/kernel/debug/asoc/*/dapm/bias_level; do
        [[ -r $f ]] || continue
        printf '  bias\t%s\t%s\n' "$f" "$(head -n 1 "$f" 2>/dev/null)"
    done
}

wake_ledger_report() {
    local ledger=/var/lib/armada/wake-ledger.log
    if [[ -r $ledger ]]; then
        tail -n 40 "$ledger"
    else
        echo "unavailable (ledger hook not installed or no wakes recorded)"
    fi
}

collect() {
    local current_boot baseline_boot device_info sleep_mode

    require_root
    echo "Armada sleep debug report"
    echo "generated=$(date --iso-8601=seconds)"

    section "System"
    single_line_file kernel "$proc_root/sys/kernel/osrelease"
    single_line_file boot_id "$proc_root/sys/kernel/random/boot_id"
    single_line_file uptime "$proc_root/uptime"
    single_line_file cmdline "$proc_root/cmdline"
    if [[ -x $device_env ]]; then
        device_info=$($device_env 2>/dev/null || true)
        grep -E '^ARMADA_(DEVICE_ID|DEVICE_NAME|SOC_CLASS|SUSPEND_MODE)=' <<<"$device_info" || true
        sleep_mode=$(sed -n 's/^ARMADA_SUSPEND_MODE=//p' <<<"$device_info")
    fi
    [[ -r /etc/armada/sleep.conf ]] && sed 's/^/sleep_conf: /' /etc/armada/sleep.conf

    current_boot=$(read_value "$proc_root/sys/kernel/random/boot_id" "")
    baseline_boot=$(read_value "$state_dir/boot_id" "")
    [[ -r $state_dir/prepared_at ]] && single_line_file prepared_at "$state_dir/prepared_at"
    if [[ -n $baseline_boot ]]; then
        if [[ $baseline_boot == "$current_boot" ]]; then
            echo "baseline_boot=current"
        else
            echo "baseline_boot=previous"
        fi
    else
        echo "baseline_boot=unavailable"
    fi

    section "Verdict"
    verdict_report

    section "Sleep state"
    single_line_file power_state "$sys_root/power/state"
    single_line_file mem_sleep "$sys_root/power/mem_sleep"
    single_line_file pm_debug_messages "$sys_root/power/pm_debug_messages"
    single_line_file pm_print_times "$sys_root/power/pm_print_times"
    single_line_file pm_async "$sys_root/power/pm_async"
    single_line_file wakeup_count "$sys_root/power/wakeup_count"
    if [[ ${sleep_mode:-} == fake ]]; then
        echo "kernel_suspend_diagnostics=not-applicable (fake suspend does not enter kernel system suspend)"
    else
        echo "kernel_suspend_diagnostics=applicable"
    fi

    section "Fake suspend state"
    fake_suspend_report

    section "CPU and GPU frequency"
    power_state_report

    section "Thermal and charging state"
    tsens_dynamic_debug_report
    thermal_irq_report
    thermal_state_report
    power_supply_report
    charge_delta_report
    charger_firmware_log_report

    section "Input and lid state"
    input_state_report
    input_inventory_report

    section "First wake IRQ"
    wakeup_irq_report

    section "Wake ledger"
    wake_ledger_report

    section "Audio state"
    audio_state_report

    section "Wakeup source changes"
    wakeup_source_report

    section "Armed wake sources"
    wakeup_inventory_report

    section "IRQ activity since prepare"
    irq_delta_report

    section "RTC alarms and systemd timers"
    rtc_and_timer_report

    section "Suspend statistics"
    suspend_stats_report

    section "Sleep depth"
    sleep_depth_report

    section "Blocked tasks"
    blocked_tasks_report

    section "Persistent crash log"
    pstore_report

    section "Device callbacks (current boot)"
    device_timing_report 0

    section "Device callbacks (previous boot)"
    device_timing_report -1

    section "Suspend timeline (current boot)"
    suspend_timeline_report 0

    section "Suspend timeline (previous boot)"
    suspend_timeline_report -1

    section "Current boot sleep log"
    sleep_logs 0

    section "Previous boot sleep log"
    sleep_logs -1

    section "Current boot kernel tail"
    kernel_tail 0

    section "Previous boot kernel tail"
    kernel_tail -1
}

command=${1:-collect}
(($# == 0)) || shift

case $command in
    prepare)
        [[ $# == 0 ]] || { usage >&2; exit 2; }
        prepare
        ;;
    collect)
        [[ $# == 0 ]] || { usage >&2; exit 2; }
        collect
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
