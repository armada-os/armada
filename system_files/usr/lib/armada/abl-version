#!/usr/bin/python3
# Identify exact payloads from the approved ROCKNIX release catalog.
import csv
import hashlib
import os
import re
import sys

FIELDS = ["version", "soc", "size", "sha256"]
MAX_SIZE = 4 * 1024 * 1024
SHA256_RE = re.compile(r"[0-9a-f]{64}")
SUPPORTED_SOCS = {"SM8250", "SM8550", "SM8650", "SM8750"}
VERSION_RE = re.compile(r"[0-9]+\.[0-9]+(?:\.[0-9]+)?")


def load_catalog(path):
    entries = []
    keys = set()
    identities = set()
    with open(path, encoding="ascii", newline="") as source:
        lines = (
            line for line in source
            if line.strip() and not line.lstrip().startswith("#")
        )
        rows = csv.DictReader(lines, delimiter="\t", strict=True)
        if rows.fieldnames != FIELDS:
            raise ValueError("invalid catalog header")
        for row in rows:
            if None in row or None in row.values():
                raise ValueError("invalid catalog row")
            version = row["version"]
            soc = row["soc"]
            size = int(row["size"])
            digest = row["sha256"]
            key = (version, soc)
            identity = (size, digest)
            if (not VERSION_RE.fullmatch(version) or soc not in SUPPORTED_SOCS or
                    not 0 < size <= MAX_SIZE or not SHA256_RE.fullmatch(digest) or
                    key in keys or identity in identities):
                raise ValueError("invalid catalog row")
            keys.add(key)
            identities.add(identity)
            entries.append((version, soc, size, digest))
    if not entries:
        raise ValueError("empty catalog")
    return entries


def identify(entries, path):
    with open(path, "rb", buffering=0) as firmware:
        image = firmware.read(max(entry[2] for entry in entries))
    hashes = {}
    matches = set()
    for version, soc, size, digest in entries:
        if len(image) < size:
            continue
        if size not in hashes:
            hashes[size] = hashlib.sha256(image[:size]).hexdigest()
        if hashes[size] == digest:
            matches.add((version, soc))
    if len(matches) != 1:
        raise ValueError("payload identity is not unique")
    return matches.pop()


def main(args):
    catalog = os.environ.get(
        "ARMADA_ABL_RELEASES", "/usr/lib/armada/abl/releases.tsv"
    )
    try:
        entries = load_catalog(catalog)
        if len(args) == 3 and args[0] == "--lookup":
            version, soc = args[1:]
            matches = [entry for entry in entries if entry[:2] == (version, soc)]
            if len(matches) != 1:
                return 1
            _, _, size, digest = matches[0]
            print(f"{size} {digest}")
            return 0
        with_soc = len(args) == 2 and args[0] == "--with-soc"
        if len(args) != (2 if with_soc else 1):
            return 2
        version, soc = identify(entries, args[1] if with_soc else args[0])
        print(f"{version} {soc}" if with_soc else version)
        return 0
    except (csv.Error, OSError, UnicodeError, ValueError):
        return 1


raise SystemExit(main(sys.argv[1:]))
