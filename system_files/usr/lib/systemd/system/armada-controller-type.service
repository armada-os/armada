[Unit]
Description=Apply Armada controller type
After=inputplumber.service
Requires=inputplumber.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/armada/controller-type apply

[Install]
WantedBy=multi-user.target
# Re-run whenever InputPlumber (re)starts, e.g. after the gyro toggle.
WantedBy=inputplumber.service
