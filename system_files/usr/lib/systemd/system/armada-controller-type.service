[Unit]
Description=Apply Armada controller type
After=inputplumber.service
Requires=inputplumber.service
Before=display-manager.service
# A container has no built-in controller for InputPlumber to manage.
ConditionVirtualization=!container

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/armada/controller-type apply

[Install]
WantedBy=multi-user.target
