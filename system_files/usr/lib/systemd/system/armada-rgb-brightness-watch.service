[Unit]
Description=Watch display brightness for Armada RGB smart brightness
ConditionPathExists=/etc/armada/rgb.json
Wants=armada-rgb.service
After=armada-rgb.service
Before=display-manager.service

[Service]
Type=simple
ExecStart=/usr/libexec/armada/armada-rgb-env watch
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
