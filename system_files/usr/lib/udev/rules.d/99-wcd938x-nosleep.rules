# Keep WCD938x SoundWire RX/TX awake for jack detection on SM8250.
# headphone pops workaround for MANGMI Pocket Max
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="audio-codec", IMPORT{program}="/usr/libexec/armada/device-env"
ACTION=="bind", SUBSYSTEM=="platform", KERNEL=="audio-codec", ENV{ARMADA_DEVICE_ID}=="mangmi-pocket-max", ATTR{power/control}="on"
ACTION=="bind", SUBSYSTEM=="soundwire", KERNEL=="sdw:*:0217:010d:*", IMPORT{program}="/usr/libexec/armada/device-env"
ACTION=="bind", SUBSYSTEM=="soundwire", KERNEL=="sdw:*:0217:010d:*", ENV{ARMADA_SOC_CLASS}=="SM8250", ATTR{power/control}="on"
