eval "$(/usr/libexec/armada/device-env)"

[[ -n "${ARMADA_PRIMARY_CONNECTOR:-}" ]] && OUTPUT_CONNECTOR="$ARMADA_PRIMARY_CONNECTOR"
[[ -n "${ARMADA_PANEL_TYPE:-}" ]] && PANEL_TYPE="$ARMADA_PANEL_TYPE"
[[ -n "${ARMADA_PANEL_ORIENTATION:-}" ]] && ORIENTATION="$ARMADA_PANEL_ORIENTATION"
[[ -n "${ARMADA_PANEL_NATIVE_WIDTH:-}" ]] && SCREEN_WIDTH="$ARMADA_PANEL_NATIVE_WIDTH"
[[ -n "${ARMADA_PANEL_NATIVE_HEIGHT:-}" ]] && SCREEN_HEIGHT="$ARMADA_PANEL_NATIVE_HEIGHT"
if [[ -n "${ARMADA_PANEL_REFRESH_RATES:-}" ]]; then
    CUSTOM_REFRESH_RATES="$ARMADA_PANEL_REFRESH_RATES"
    IFS=',' read -r -a ARMADA_REFRESH_RATE_LIST <<< "$ARMADA_PANEL_REFRESH_RATES"
    if (( ${#ARMADA_REFRESH_RATE_LIST[@]} > 1 )); then
        STEAM_DISPLAY_REFRESH_LIMITS="${ARMADA_REFRESH_RATE_LIST[0]},${ARMADA_REFRESH_RATE_LIST[-1]}"
    else
        unset STEAM_DISPLAY_REFRESH_LIMITS
    fi
fi
# Gamescope only lights up the primary panel; silence the secondary
# touchscreen so fingers on the dark glass don't move Steam's cursor.
# The desktop session re-enables it (see desktop-bootstrap).
if [[ -n "${ARMADA_SECONDARY_TOUCHSCREEN:-}" ]]; then
    /usr/libexec/armada/touchscreen-inhibit "$ARMADA_SECONDARY_TOUCHSCREEN" 1 2>/dev/null || true
fi
FORCE_COMPOSITION_ROTATION="${ARMADA_GAMESCOPE_FORCE_COMPOSITION_ROTATION:-0}"
if [[ -n "${ARMADA_GAMESCOPE_FAKE_OUTPUT_MM:-}" ]]; then
    export GAMESCOPE_FAKE_OUTPUT_MM="$ARMADA_GAMESCOPE_FAKE_OUTPUT_MM"
fi

# Advertise HDR capability without selecting the output mode. Steam owns HDR
# and ITM enable state through gamescope's runtime properties.
if [[ "${ARMADA_HDR_CAPABLE:-0}" == 1 ]]; then
    export GAMESCOPE_INTERNAL_DEVICE_ID="$ARMADA_DEVICE_ID"
    export GAMESCOPE_EXPOSE_CLIENT_SAMPLEABLE_FORMATS=1
    export GAMESCOPE_HDR_ITM_TARGET_NITS=650
fi

export STEAM_EXTRA_COMPAT_TOOLS_PATHS="/usr/share/steam/compatibilitytools.d:${HOME}/.local/share/Steam/compatibilitytools.d"

# The fallback appid has gamescope show the wrapper's splash window whenever
# Steam has no window of its own; the splash units check the same kill-switch.
export GAMESCOPE_FALLBACK_APPID=0x41524d41
CLIENTCMD='/usr/libexec/armada/launch-steam -gamepadui -steamos3 -steampal -steamdeck -noverifyfiles -noshaders'
[[ -e /etc/armada/splash-disabled ]] || CLIENTCMD="/usr/libexec/armada/armada-splash-run ${CLIENTCMD}"
